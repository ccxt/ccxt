        ],
        "fetchOrder": [
            {
                "description": "fetch order by id",
                "method": "fetchOrder",
                "url": "https://exchange-api.lcx.com/api/order?OrderId=e8737c4a-3804-461c-9e67-4fe0af5aeb06",
                "input": [
                    "e8737c4a-3804-461c-9e67-4fe0af5aeb06"
                ]
            }
        ],
        "fetchOpenOrders": [
            {
                "description": "open orders for a symbol",
