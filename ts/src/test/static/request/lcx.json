{
    "exchange": "lcx",
    "skipKeys": [],
    "outputType": "json",
    "methods": {
        "fetchTicker": [
            {
                "description": "spot ticker",
                "method": "fetchTicker",
                "url": "https://exchange-api.lcx.com/api/ticker?pair=LCX%2FEUR",
                "input": [
                    "LCX/EUR"
                ],
                "output": null
            }
        ],
        "fetchOrderBook": [
            {
                "description": "spot order book",
                "method": "fetchOrderBook",
                "url": "https://exchange-api.lcx.com/api/book?pair=LCX%2FEUR",
                "input": [
                    "LCX/EUR"
                ],
                "output": null
            }
        ],
        "fetchTrades": [
            {
                "description": "spot trades",
                "method": "fetchTrades",
                "url": "https://exchange-api.lcx.com/api/trades?pair=LCX%2FEUR&offset=1",
                "input": [
                    "LCX/EUR",
                    null,
                    5
                ],
                "output": null
            }
        ],
        "fetchOHLCV": [
            {
                "description": "spot ohlcv with since and limit",
                "method": "fetchOHLCV",
                "url": "https://api-kline.lcx.com/v1/market/kline?pair=BTC%2FEUR&resolution=60&from=1769000000&to=1769010799",
                "input": [
                    "BTC/EUR",
                    "1h",
                    1769000000000,
                    3
                ],
                "output": null
            }
        ],
        "createOrder": [
            {
                "description": "limit buy with postOnly and clientOrderId",
                "method": "createOrder",
                "url": "https://exchange-api.lcx.com/api/create",
                "input": [
                    "LCX/EUR",
                    "limit",
                    "buy",
                    100,
                    0.05,
                    {
                        "postOnly": true,
                        "clientOrderId": "7c3e3e96-1227-424f-b062-56bad5d6f2d0"
                    }
                ],
                "output": "{\"Pair\":\"LCX/EUR\",\"Amount\":100,\"OrderType\":\"LIMIT\",\"Side\":\"BUY\",\"Price\":0.05,\"PostOnly\":true,\"ClientOrderId\":\"7c3e3e96-1227-424f-b062-56bad5d6f2d0\"}"
            },
            {
                "description": "market sell",
                "method": "createOrder",
                "url": "https://exchange-api.lcx.com/api/create",
                "input": [
                    "LCX/EUR",
                    "market",
                    "sell",
                    100
                ],
                "output": "{\"Pair\":\"LCX/EUR\",\"Amount\":100,\"OrderType\":\"MARKET\",\"Side\":\"SELL\"}"
            }
        ],
        "editOrder": [
            {
                "description": "edit limit order",
                "method": "editOrder",
                "url": "https://exchange-api.lcx.com/api/modify",
                "input": [
                    "9f898d18-0980-4fb3-b18c-eeb39fc20324",
                    "LCX/EUR",
                    "limit",
                    "buy",
                    120,
                    0.051
                ],
                "output": "{\"OrderId\":\"9f898d18-0980-4fb3-b18c-eeb39fc20324\",\"Amount\":120,\"Price\":0.051}"
            }
        ],
        "cancelOrder": [
            {
                "description": "cancel order",
                "method": "cancelOrder",
                "url": "https://exchange-api.lcx.com/api/cancel?orderId=e8737c4a-3804-461c-9e67-4fe0af5aeb06",
                "input": [
                    "e8737c4a-3804-461c-9e67-4fe0af5aeb06"
                ]
            }
        ],
        "cancelOrders": [
            {
                "description": "cancel multiple orders",
                "method": "cancelOrders",
                "url": "https://exchange-api.lcx.com/api/cancel-all?orderIds=70aba300-0990-481d-ad76-7bd499f473ab&orderIds=ecaf000a-8f4c-459a-b105-784c0e0436df",
                "input": [
                    [
                        "70aba300-0990-481d-ad76-7bd499f473ab",
                        "ecaf000a-8f4c-459a-b105-784c0e0436df"
                    ]
                ]
