        ],
        "fetchMyTrades": [
            {
                "description": "my trades with since and until",
                "method": "fetchMyTrades",
                "url": "https://exchange-api.lcx.com/api/uHistory?offset=1&pair=LCX%2FEUR&fromDate=1760000000&toDate=1762000000",
                "input": [
                    "LCX/EUR",
                    1760000000000,
                    null,
                    {
                        "until": 1762000000000
