{
    "exchange": "insightx",
    "asyncOnly": true,
    "skipKeys": [],
    "outputType": "json",
    "methods": {
        "fetchMarkets": [
            {
                "description": "fetchMarkets active listing with a bounded result",
                "method": "fetchMarkets",
                "url": "https://mainnet-api.insightx.finance/predict/v2/markets?page=1&size=2&status=1",
                "input": [
                    {
                        "limit": 2,
                        "marketStatus": 1
                    }
                ]
            }
        ],
        "fetchEvents": [
            {
                "description": "fetchEvents active listing grouped by event id",
                "method": "fetchEvents",
                "url": "https://mainnet-api.insightx.finance/predict/v2/markets?page=1&size=100&status=1",
                "input": [
                    {
                        "eventId": "9151820",
                        "limit": 1,
                        "marketStatus": 1
                    }
                ]
            }
        ],
        "fetchOutcome": [
            {
                "description": "fetchOutcome direct lookup by raw outcome id",
                "method": "fetchOutcome",
                "url": "https://mainnet-api.insightx.finance/predict/v2/market?market_id=80358378",
                "input": [
                    "80358378:2"
                ]
            }
        ],
        "fetchTicker": [
            {
                "description": "fetchTicker latest probability by raw outcome id",
                "method": "fetchTicker",
                "url": "https://mainnet-api.insightx.finance/predict/v2/market?market_id=80358378",
                "input": [
                    "80358378:2"
                ]
            }
        ],
        "fetchTickers": [
            {
                "description": "fetchTickers groups outcomes sharing one parent market",
                "method": "fetchTickers",
                "url": "https://mainnet-api.insightx.finance/predict/v2/market?market_id=80358378",
                "input": [
                    [
                        "80358378:1",
                        "80358378:2"
                    ]
                ]
            }
        ]
    },
    "options": {
        "loadAllOutcomes": true
    }
}
