{
    "exchange": "insightx",
    "asyncOnly": true,
    "token": "test-jwt-token",
    "skipKeys": [],
    "outputType": "json",
    "methods": {
        "fetchMarkets": [
            {
                "description": "fetchMarkets active listing with a bounded result",
                "method": "fetchMarkets",
                "url": "https://mainnet-api.insightx.finance/predict/v2/markets?page=1&size=2&status=1",
                "input": [
                    {
                        "limit": 2,
                        "marketStatus": 1
                    }
                ]
            }
        ],
        "fetchEvents": [
            {
                "description": "fetchEvents active listing grouped by event id",
                "method": "fetchEvents",
                "url": "https://mainnet-api.insightx.finance/predict/v2/markets?page=1&size=100&status=1",
                "input": [
                    {
                        "eventId": "9151820",
                        "limit": 1,
                        "marketStatus": 1
                    }
                ]
            }
        ],
        "fetchOutcome": [
            {
                "description": "fetchOutcome direct lookup by raw outcome id",
                "method": "fetchOutcome",
                "url": "https://mainnet-api.insightx.finance/predict/v2/market?market_id=80358378",
                "input": [
                    "80358378:2"
                ]
            }
        ],
        "fetchTicker": [
            {
                "description": "fetchTicker latest probability by raw outcome id",
                "method": "fetchTicker",
                "url": "https://mainnet-api.insightx.finance/predict/v2/market?market_id=80358378",
                "input": [
                    "80358378:2"
                ]
            }
        ],
        "fetchTickers": [
            {
                "description": "fetchTickers groups outcomes sharing one parent market",
                "method": "fetchTickers",
                "url": "https://mainnet-api.insightx.finance/predict/v2/market?market_id=80358378",
                "input": [
                    [
                        "80358378:1",
                        "80358378:2"
                    ]
                ]
            }
        ],
        "fetchPosition": [
            {
                "description": "fetchPosition derives market identity from outcome and ignores conflicting raw params",
                "method": "fetchPosition",
                "url": "https://mainnet-api.insightx.finance/predict/v2/position?market_id=80372897&outcome_idx=2",
                "input": [
                    "80372897:2",
                    {
                        "market_id": "99999999",
                        "outcome_idx": 1
                    }
                ]
            }
        ],
        "fetchOrders": [
            {
                "description": "fetchOrders derives market identity from outcome and preserves the larger raw page size for client-side outcome filtering",
                "method": "fetchOrders",
                "url": "https://mainnet-api.insightx.finance/predict/v2/orders?market_id=80372897&page=3&size=50&status=pending",
                "input": [
                    "80372897:2",
                    1786500000000,
                    2,
                    {
                        "market_id": "99999999",
                        "outcome_idx": 1,
                        "page": 3,
                        "size": 50,
                        "status": "pending"
                    }
                ]
            }
        ],
        "fetchOpenOrders": [
            {
                "description": "fetchOpenOrders queries the first native open status while preserving server pagination size",
                "method": "fetchOpenOrders",
                "url": "https://mainnet-api.insightx.finance/predict/v2/orders?market_id=80372897&page=2&size=20&status=pending",
                "input": [
                    "80372897:2",
                    1786500000000,
                    1,
                    {
                        "page": 2,
                        "size": 20
                    }
                ]
            }
        ],
        "fetchClosedOrders": [
            {
                "description": "fetchClosedOrders overrides a conflicting raw status with the first native closed status",
                "method": "fetchClosedOrders",
                "url": "https://mainnet-api.insightx.finance/predict/v2/orders?market_id=80372897&page=1&size=20&status=filled",
                "input": [
                    "80372897:1",
                    null,
                    2,
                    {
                        "outcome_idx": 2,
                        "page": 1,
                        "size": 20,
                        "status": "pending"
                    }
                ]
            }
        ]
    },
    "options": {
        "loadAllOutcomes": true
    }
}
