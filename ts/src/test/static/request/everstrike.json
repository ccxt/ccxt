                        "reduceOnly": true
                    }
                ],
                "method": "createOrder",
                "output": "timestamp=1794240000000&pair=USD_BTC_PERP&side=SELL&qty=0.002&reduce_only=true",
                "url": "https://api.everstrike.io/auth/order"
            },
            {
                "description": "postOnly limit sell on an option",
                "headers": {
                    "x-api-key": "key"
                },
                "input": [
                    "BTC/USD:USD-PERP-0.95-C",
                    "limit",
                    "sell",
                    0.01,
                    3500,
                    {
                        "postOnly": true
                    }
                ],
                "method": "createOrder",
                "output": "timestamp=1794240000000&pair=USD_BTCCALL5_PERP&side=SELL&qty=0.01&price=3500&post_only=true",
                "url": "https://api.everstrike.io/auth/order"
            }
        ],
