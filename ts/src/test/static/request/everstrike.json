{
    "exchange": "everstrike",
    "methods": {
        "cancelOrder": [
            {
                "description": "cancelOrder",
                "headers": {
                    "x-api-key": "key"
                },
                "input": [
                    "781a8e80393f11e98e2643f8c5a993ce"
                ],
                "method": "cancelOrder",
