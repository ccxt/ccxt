                "url": "https://api.everstrike.io/auth/cancel"
            }
        ],
        "cancelOrders": [
            {
                "description": "bulk cancel: ids are sent as indexed keys (the server verifies the HMAC against that form)",
                "headers": {
                    "x-api-key": "key"
                },
                "input": [
                    [
                        "aaa111",
                        "bbb222"
                    ]
                ],
                "method": "cancelOrders",
                "output": "timestamp=1794240000000&ids%5B0%5D=aaa111&ids%5B1%5D=bbb222",
                "url": "https://api.everstrike.io/auth/cancel/bulk"
            }
        ],
        "createOrder": [
            {
                "description": "limit buy: signed form body",
                "headers": {
                    "x-api-key": "key"
                },
                "input": [
                    "BTC/USD:USD",
                    "limit",
                    "buy",
                    0.001,
                    70000
                ],
                "method": "createOrder",
                "output": "timestamp=1794240000000&pair=USD_BTC_PERP&side=BUY&qty=0.001&price=70000",
                "url": "https://api.everstrike.io/auth/order"
            },
            {
                "description": "market sell reduceOnly",
                "headers": {
                    "x-api-key": "key"
                },
                "input": [
                    "BTC/USD:USD",
                    "market",
                    "sell",
                    0.002,
