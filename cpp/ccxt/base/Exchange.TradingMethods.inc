virtual std::shared_future<ccxt::any>
loadOrderBook(ccxt::any client, ccxt::any messageHash, ccxt::any symbol,
              ccxt::any limit = ccxt::any{}, ccxt::any params = ccxt::dict{}) {
  return std::
      async(std::launch::deferred,
            [=]() mutable -> ccxt::any {
              if (!isTrue((inOp(this->orderbooks, symbol)))) {
                this->reject(
                    ExchangeError(add(
                        this->id,
                        std::string(
                            " loadOrderBook() orderbook is not initiated"))),
                    messageHash);
                return ccxt::any{};
              }
              ccxt::any maxRetries =
                  this->handleOption(std::string("watchOrderBook"),
                                     std::string("snapshotMaxRetries"), 3);
              ccxt::any tries = 0;
              ccxt::any error = ccxt::any{};
              try {
                ccxt::any stored = ::getValue(this->orderbooks, symbol);
                while (isLessThan(tries, maxRetries)) {
                  ccxt::any cache = ::getValue(stored, std::string("cache"));
                  ccxt::any orderBook = awaitValue(
                      this->fetchRestOrderBookSafe(symbol, limit, params));
                  ccxt::any index = this->getCacheIndex(orderBook, cache);
                  if (isTrue(isGreaterThanOrEqual(index, 0))) {
                    ::resetOrderBook(stored, orderBook);
                    this->handleDeltas(stored,
                                       slice(cache, index, ccxt::any{}));
                    getArrayLength(::getValue(stored, std::string("cache"))) =
                        0;
                    this->resolve(stored, messageHash);
                    return ccxt::any{};
                  }
                  postFixIncrement(tries);
                }
                error = ExchangeError(add(
                    add(add(this->id,
                            std::string(" nonce is behind the cache after ")),
                        toString(maxRetries)),
                    std::string(" tries.")));
              } catch (const std::exception &e) {
                error = e;
              }
              // a failed synchronization must not recurse into another attempt
              // with the same broken state - previously the catch invoked
              // loadOrderBook again, recursing endlessly when the snapshot
              // request kept failing, see
              // https://github.com/ccxt/ccxt/pull/24224 and
              // https://github.com/ccxt/ccxt/issues/14567 instead, reject the
              // watcher and drop the connection and the cached orderbook, so
              // the next watchOrderBook () call resubscribes cleanly
              this->reject(error, messageHash);
              deleteKey(this->clients, ::getValue(client, std::string("url")));
              ::setValue(
                  this->orderbooks, symbol,
                  this->orderBook()); // clear the orderbook and its cache -
                                      // issue
                                      // https://github.com/ccxt/ccxt/issues/26753
              return ccxt::any{};
            })
          .share();
}

