ccxt::any Exchange::arraysConcat(ccxt::any arraysOfArrays) {
  ccxt::any result = ccxt::list{};
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(arraysOfArrays));
       postFixIncrement(i)) {
    result = this->arrayConcat(result, ::getValue(arraysOfArrays, i));
  }
  return result;
