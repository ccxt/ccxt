      {std::string("info"), info},
      {std::string("withdraw"),
       ccxt::dict{
           {std::string("fee"), ccxt::any{}},
           {std::string("percentage"), ccxt::any{}},
       }},
      {std::string("deposit"),
       ccxt::dict{
