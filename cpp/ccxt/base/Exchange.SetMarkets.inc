ccxt::any Exchange::convertExpireDate(ccxt::any date) {
  if (isTrue(isEqual(date, ccxt::any{}))) {
    return ccxt::any{};
  }
  // parse YYMMDD to datetime string
  ccxt::any year = slice(date, 0, 2);
  ccxt::any month = slice(date, 2, 4);
  ccxt::any day = slice(date, 4, 6);
  ccxt::any reconstructedDate = add(
      add(add(add(add(add(std::string("20"), year), std::string("-")), month),
              std::string("-")),
          day),
      std::string("T00:00:00Z"));
  return reconstructedDate;
}

ccxt::any Exchange::convertExpireDateToMarketIdDate(ccxt::any date) {
  if (isTrue(isEqual(date, ccxt::any{}))) {
    return ccxt::any{};
  }
  // parse 240119 to 19JAN24
  ccxt::any year = slice(date, 0, 2);
  ccxt::any monthRaw = slice(date, 2, 4);
  ccxt::any month = ccxt::any{};
  ccxt::any day = slice(date, 4, 6);
  if (isTrue(isEqual(monthRaw, std::string("01")))) {
    month = std::string("JAN");
  } else if (isTrue(isEqual(monthRaw, std::string("02")))) {
    month = std::string("FEB");
  } else if (isTrue(isEqual(monthRaw, std::string("03")))) {
    month = std::string("MAR");
  } else if (isTrue(isEqual(monthRaw, std::string("04")))) {
    month = std::string("APR");
  } else if (isTrue(isEqual(monthRaw, std::string("05")))) {
    month = std::string("MAY");
  } else if (isTrue(isEqual(monthRaw, std::string("06")))) {
    month = std::string("JUN");
  } else if (isTrue(isEqual(monthRaw, std::string("07")))) {
    month = std::string("JUL");
  } else if (isTrue(isEqual(monthRaw, std::string("08")))) {
    month = std::string("AUG");
  } else if (isTrue(isEqual(monthRaw, std::string("09")))) {
    month = std::string("SEP");
  } else if (isTrue(isEqual(monthRaw, std::string("10")))) {
    month = std::string("OCT");
  } else if (isTrue(isEqual(monthRaw, std::string("11")))) {
    month = std::string("NOV");
  } else if (isTrue(isEqual(monthRaw, std::string("12")))) {
    month = std::string("DEC");
  }
  ccxt::any reconstructedDate = add(add(day, month), year);
  return reconstructedDate;
}

ccxt::any Exchange::convertMarketIdExpireDate(ccxt::any date) {
  if (isTrue(isEqual(date, ccxt::any{}))) {
    return ccxt::any{};
  }
  // parse 03JAN24 to 240103.
  ccxt::any monthMappping = ccxt::dict{
      {std::string("JAN"), std::string("01")},
      {std::string("FEB"), std::string("02")},
      {std::string("MAR"), std::string("03")},
      {std::string("APR"), std::string("04")},
      {std::string("MAY"), std::string("05")},
      {std::string("JUN"), std::string("06")},
      {std::string("JUL"), std::string("07")},
      {std::string("AUG"), std::string("08")},
      {std::string("SEP"), std::string("09")},
      {std::string("OCT"), std::string("10")},
      {std::string("NOV"), std::string("11")},
      {std::string("DEC"), std::string("12")},
  };
  // if exchange omits first zero and provides i.e. '3JAN24' instead of
  // '03JAN24'
  if (isTrue(isEqual(getStringLength(date), 6))) {
    date = add(std::string("0"), date);
  }
  ccxt::any year = slice(date, 0, 2);
  ccxt::any monthName = slice(date, 2, 5);
  ccxt::any month = this->safeString(monthMappping, monthName);
  ccxt::any day = slice(date, 5, 7);
  ccxt::any reconstructedDate = add(add(day, month), year);
  return reconstructedDate;
}

