void Exchange::handleDeltasWithKeys(ccxt::any bookSide, ccxt::any deltas,
                                    ccxt::any priceKey, ccxt::any amountKey,
                                    ccxt::any countOrIdKey) {
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(deltas));
       postFixIncrement(i)) {
