  for (ccxt::any i = 0; isLessThan(i, getArrayLength(codes));
       postFixIncrement(i)) {
    ccxt::any id = this->currencyId(::getValue(codes, i));
    if (isTrue(!isEqual(id, ccxt::any{}))) {
      arrayPush(result, id);
    }
