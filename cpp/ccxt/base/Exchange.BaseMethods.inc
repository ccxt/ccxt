    /* eslint-disable no-unused-vars */
    /* eslint-enable no-unused-vars */
    virtual std::any handleOptionAndParams(std::any params, std::any methodName, std::any optionName, std::any defaultValue = std::any{})
    {
        // This method can be used to obtain method specific properties, i.e: this.handleOptionAndParams (params, 'fetchPosition', 'marginMode', 'isolated')
        std::any defaultOptionName = add(std::string("default"), this->capitalize(optionName)); // we also need to check the 'defaultXyzWhatever'
        // check if params contain the key
        std::any value = this->safeValue2(params, optionName, defaultOptionName);
        if (isTrue(!isEqual(value, std::any{})))
        {
            params = this->omit(params, ccxt::list{optionName, defaultOptionName});
        } else
        {
            // handle routed methods like "watchTrades > watchTradesForSymbols" (or "watchTicker > watchTickers")
            std::any methodNameparamsVariable = this->handleParamString(params, std::string("callerMethodName"), methodName);
            methodName = ::getValue(methodNameparamsVariable, 0);
            params = ::getValue(methodNameparamsVariable, 1);
            // check if exchange has properties for this method
            std::any exchangeWideMethodOptions = this->safeValue(this->options, methodName);
            if (isTrue(!isEqual(exchangeWideMethodOptions, std::any{})))
            {
                // check if the option is defined inside this method's props
                value = this->safeValue2(exchangeWideMethodOptions, optionName, defaultOptionName);
            }
            if (isTrue(isEqual(value, std::any{})))
            {
                // if it's still undefined, check if global exchange-wide option exists
                value = this->safeValue2(this->options, optionName, defaultOptionName);
            }
            // if it's still undefined, use the default value
            value = (isTrue((!isEqual(value, std::any{}))) ? std::any(value) : std::any(defaultValue));
        }
        return ccxt::list{value, params};
    }

    /* eslint-disable no-unused-vars */
    /* eslint-enable no-unused-vars */
    virtual std::any handleOptionAndParams2(std::any params, std::any methodName1, std::any optionName1, std::any optionName2, std::any defaultValue = std::any{})
    {
        std::any value = std::any{};
        std::any valueparamsVariable = this->handleOptionAndParams(params, methodName1, optionName1);
        value = ::getValue(valueparamsVariable, 0);
        params = ::getValue(valueparamsVariable, 1);
        if (isTrue(!isEqual(value, std::any{})))
        {
            // omit optionName2 too from params
            params = this->omit(params, optionName2);
            return ccxt::list{value, params};
        }
        // if still undefined, try optionName2
        std::any value2 = std::any{};
        std::any value2paramsVariable = this->handleOptionAndParams(params, methodName1, optionName2, defaultValue);
        value2 = ::getValue(value2paramsVariable, 0);
        params = ::getValue(value2paramsVariable, 1);
        return ccxt::list{value2, params};
    }

    virtual std::any handleOption(std::any methodName, std::any optionName, std::any defaultValue = std::any{})
    {
        std::any res = this->handleOptionAndParams(ccxt::dict {}, methodName, optionName, defaultValue);
        return this->safeValue(res, 0);
    }

    virtual std::any handleMarketTypeAndParams(std::any methodName, std::any market = std::any{}, std::any params = ccxt::dict {}, std::any defaultValue = std::any{})
    {
        /**
         * @ignore
         * @method
         * @name exchange#handleMarketTypeAndParams
         * @param methodName the method calling handleMarketTypeAndParams
         * @param {Market} market
         * @param {object} params
         * @param {string} [params.type] type assigned by user
         * @param {string} [params.defaultType] same as params.type
         * @param {string} [defaultValue] assigned programatically in the method calling handleMarketTypeAndParams
         * @returns {[string, object]} the market type and params with type and defaultType omitted
         */
        // type from param
        std::any type = this->safeString2(params, std::string("defaultType"), std::string("type"));
        if (isTrue(!isEqual(type, std::any{})))
        {
            params = this->omit(params, ccxt::list{std::string("defaultType"), std::string("type")});
            return ccxt::list{type, params};
        }
        // type from market
        if (isTrue(!isEqual(market, std::any{})))
        {
            return ccxt::list{::getValue(market, std::string("type")), params};
        }
        // type from default-argument
        if (isTrue(!isEqual(defaultValue, std::any{})))
        {
            return ccxt::list{defaultValue, params};
        }
        std::any methodOptions = this->safeDict(this->options, methodName);
        if (isTrue(!isEqual(methodOptions, std::any{})))
        {
            if (isTrue(isString(methodOptions)))
            {
                return ccxt::list{methodOptions, params};
            } else
            {
                std::any typeFromMethod = this->safeString2(methodOptions, std::string("defaultType"), std::string("type"));
                if (isTrue(!isEqual(typeFromMethod, std::any{})))
                {
                    return ccxt::list{typeFromMethod, params};
                }
            }
        }
        std::any defaultType = this->safeString2(this->options, std::string("defaultType"), std::string("type"), std::string("spot"));
        return ccxt::list{defaultType, params};
    }

    virtual std::any handleSubTypeAndParams(std::any methodName, std::any market = std::any{}, std::any params = ccxt::dict {}, std::any defaultValue = std::any{})
    {
        std::any subType = std::any{};
        // if set in params, it takes precedence
        std::any subTypeInParams = this->safeString2(params, std::string("subType"), std::string("defaultSubType"));
        // avoid omitting if it's not present
        if (isTrue(!isEqual(subTypeInParams, std::any{})))
        {
            if (isTrue(isTrue((isEqual(subTypeInParams, std::string("linear")))) || isTrue((isEqual(subTypeInParams, std::string("inverse"))))))
            {
                subType = subTypeInParams;
            }
            params = this->omit(params, ccxt::list{std::string("subType"), std::string("defaultSubType")});
        } else
        {
            // at first, check from market object
            if (isTrue(!isEqual(market, std::any{})))
            {
                if (isTrue(isEqual(::getValue(market, std::string("linear")), true)))
                {
                    subType = std::string("linear");
                } else if (isTrue(isEqual(::getValue(market, std::string("inverse")), true)))
                {
                    subType = std::string("inverse");
                }
            }
            // if it was not defined in market object
            if (isTrue(isEqual(subType, std::any{})))
            {
                std::any values = this->handleOptionAndParams(ccxt::dict {}, methodName, std::string("subType"), defaultValue); // no need to re-test params here
                subType = ::getValue(values, 0);
            }
        }
        return ccxt::list{subType, params};
    }

    virtual std::any handleMarginModeAndParams(std::any methodName, std::any params = ccxt::dict {}, std::any defaultValue = std::any{})
    {
        /**
         * @ignore
         * @method
         * @param {object} [params] extra parameters specific to the exchange API endpoint
         * @returns {Array} the marginMode in lowercase as specified by params["marginMode"], params["defaultMarginMode"] ::getValue(this, std::string("options"))["marginMode"] or ::getValue(this, std::string("options"))["defaultMarginMode"]
         */
        return this->handleOptionAndParams(params, methodName, std::string("marginMode"), defaultValue);
    }

    virtual void throwExactlyMatchedException(std::any exact, std::any string, std::any message)
    {
        if (isTrue(isEqual(string, std::any{})))
        {
            return;
        }
        if (isTrue(inOp(exact, string)))
        {
            throwDynamicException(::getValue(exact, string), message);
        }
    }

    virtual void throwBroadlyMatchedException(std::any broad, std::any string, std::any message)
    {
        std::any broadKey = this->findBroadlyMatchedKey(broad, string);
        if (isTrue(!isEqual(broadKey, std::any{})))
        {
            throwDynamicException(::getValue(broad, broadKey), message);
        }
    }

    virtual std::any findBroadlyMatchedKey(std::any broad, std::any string)
    {
        // a helper for matching error strings exactly vs broadly
        std::any keys = getObjectKeys(broad);
        for (std::any i = 0; isLessThan(i, getArrayLength(keys)); postFixIncrement(i))
        {
            std::any key = ::getValue(keys, i);
            if (isTrue(!isEqual(string, std::any{})))
            {
                if (isTrue(isGreaterThanOrEqual(getIndexOf(string, key), 0)))
                {
                    return key;
                }
            }
        }
        return std::any{};
    }

