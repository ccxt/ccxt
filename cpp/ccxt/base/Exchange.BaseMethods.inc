    virtual std::any checkRequiredCredentials(std::any error = true)
    {
        /**
         * @ignore
         * @method
         * @param {boolean} error throw an error that a credential is required if true
         * @returns {boolean} true if all required credentials have been set, otherwise false or an error is thrown is param error=true
         */
        std::any keys = getObjectKeys(this->requiredCredentials);
        for (std::any i = 0; isLessThan(i, getArrayLength(keys)); postFixIncrement(i))
        {
            std::any key = ::getValue(keys, i);
            std::any credentialValue = getProperty(this, key);
            std::any credentialMissing = isTrue(isTrue(isTrue((isEqual(credentialValue, std::any{}))) || isTrue((isEqual(credentialValue, null)))) || isTrue((isEqual(credentialValue, false)))) || isTrue((isEqual(credentialValue, std::string(""))));
            if (isTrue(isTrue((isEqual(::getValue(this->requiredCredentials, key), true))) && isTrue(credentialMissing)))
            {
                if (isTrue(error))
                {
                    throw AuthenticationError(toString(add(add(add(this->id, std::string(" requires \"")), key), std::string("\" credential"))));
                } else
                {
                    return false;
                }
            }
        }
        return true;
    }

