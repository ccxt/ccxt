    virtual std::any assignDefaultDepositWithdrawFees(std::any fee, std::any currency = std::any{})
    {
        /**
         * @ignore
         * @method
         * @description Takes a depositWithdrawFee structure and assigns the default values for withdraw and deposit
         * @param {object} fee A deposit withdraw fee structure
         * @param {object} currency A currency structure, the response from this.currency ()
         * @returns {object} A deposit withdraw fee structure
         */
        std::any networkKeys = getObjectKeys(::getValue(fee, std::string("networks")));
        std::any numNetworks = getArrayLength(networkKeys);
        if (isTrue(isEqual(numNetworks, 1)))
        {
            ::setValue(fee, std::string("withdraw"), ::getValue(::getValue(::getValue(fee, std::string("networks")), ::getValue(networkKeys, 0)), std::string("withdraw")));
            ::setValue(fee, std::string("deposit"), ::getValue(::getValue(::getValue(fee, std::string("networks")), ::getValue(networkKeys, 0)), std::string("deposit")));
            return fee;
        }
        std::any currencyCode = this->safeString(currency, std::string("code"));
        for (std::any i = 0; isLessThan(i, numNetworks); postFixIncrement(i))
        {
            std::any network = ::getValue(networkKeys, i);
            if (isTrue(isEqual(network, currencyCode)))
            {
                ::setValue(fee, std::string("withdraw"), ::getValue(::getValue(::getValue(fee, std::string("networks")), ::getValue(networkKeys, i)), std::string("withdraw")));
                ::setValue(fee, std::string("deposit"), ::getValue(::getValue(::getValue(fee, std::string("networks")), ::getValue(networkKeys, i)), std::string("deposit")));
            }
        }
        return fee;
    }

