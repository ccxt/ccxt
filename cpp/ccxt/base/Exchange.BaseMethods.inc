    virtual std::any parseLedger(std::any data, std::any currency = std::any{}, std::any since = std::any{}, std::any limit = std::any{}, std::any params = ccxt::dict {})
    {
        std::any result = ccxt::list{};
        std::any arrayData = this->toArray(data);
        for (std::any i = 0; isLessThan(i, getArrayLength(arrayData)); postFixIncrement(i))
        {
            std::any itemOrItems = this->parseLedgerEntry(::getValue(arrayData, i), currency);
            if (isTrue(isArray(itemOrItems)))
            {
                for (std::any j = 0; isLessThan(j, getArrayLength(itemOrItems)); postFixIncrement(j))
                {
                    arrayPush(result, this->extend(::getValue(itemOrItems, j), params));
                }
            } else
            {
                arrayPush(result, this->extend(itemOrItems, params));
            }
        }
        result = this->sortBy(result, std::string("timestamp"));
        std::any code = (isTrue((!isEqual(currency, std::any{}))) ? std::any(::getValue(currency, std::string("code"))) : std::any(std::any{}));
        return this->filterByCurrencySinceLimit(result, code, since, limit);
    }

