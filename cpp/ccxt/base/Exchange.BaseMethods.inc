    virtual std::any convertTradingViewToOHLCV(std::any ohlcvs, std::any timestamp = std::string("t"), std::any open = std::string("o"), std::any high = std::string("h"), std::any low = std::string("l"), std::any close = std::string("c"), std::any volume = std::string("v"), std::any ms = false)
    {
        std::any result = ccxt::list{};
        std::any timestamps = this->safeList(ohlcvs, timestamp, ccxt::list{});
        std::any opens = this->safeList(ohlcvs, open, ccxt::list{});
        std::any highs = this->safeList(ohlcvs, high, ccxt::list{});
        std::any lows = this->safeList(ohlcvs, low, ccxt::list{});
        std::any closes = this->safeList(ohlcvs, close, ccxt::list{});
        std::any volumes = this->safeList(ohlcvs, volume, ccxt::list{});
        for (std::any i = 0; isLessThan(i, getArrayLength(timestamps)); postFixIncrement(i))
        {
            arrayPush(result, ccxt::list{(isTrue(ms) ? std::any(this->safeInteger(timestamps, i)) : std::any(this->safeTimestamp(timestamps, i))), this->safeValue(opens, i), this->safeValue(highs, i), this->safeValue(lows, i), this->safeValue(closes, i), this->safeValue(volumes, i)});
        }
        return result;
    }

    virtual std::any convertOHLCVToTradingView(std::any ohlcvs, std::any timestamp = std::string("t"), std::any open = std::string("o"), std::any high = std::string("h"), std::any low = std::string("l"), std::any close = std::string("c"), std::any volume = std::string("v"), std::any ms = false)
    {
        std::any result = ccxt::dict {};
        ::setValue(result, timestamp, ccxt::list{});
        ::setValue(result, open, ccxt::list{});
        ::setValue(result, high, ccxt::list{});
        ::setValue(result, low, ccxt::list{});
        ::setValue(result, close, ccxt::list{});
        ::setValue(result, volume, ccxt::list{});
        for (std::any i = 0; isLessThan(i, getArrayLength(ohlcvs)); postFixIncrement(i))
        {
            std::any ts = (isTrue(ms) ? std::any(::getValue(::getValue(ohlcvs, i), 0)) : std::any(this->parseToInt(divide(::getValue(::getValue(ohlcvs, i), 0), 1000))));
            std::any resultTimestamp = ::getValue(result, timestamp);
            arrayPush(resultTimestamp, ts);
            std::any resultOpen = ::getValue(result, open);
            arrayPush(resultOpen, ::getValue(::getValue(ohlcvs, i), 1));
            std::any resultHigh = ::getValue(result, high);
            arrayPush(resultHigh, ::getValue(::getValue(ohlcvs, i), 2));
            std::any resultLow = ::getValue(result, low);
            arrayPush(resultLow, ::getValue(::getValue(ohlcvs, i), 3));
            std::any resultClose = ::getValue(result, close);
            arrayPush(resultClose, ::getValue(::getValue(ohlcvs, i), 4));
            std::any resultVolume = ::getValue(result, volume);
            arrayPush(resultVolume, ::getValue(::getValue(ohlcvs, i), 5));
        }
        return result;
    }

    virtual std::shared_future<std::any> fetchWebEndpoint(std::any method, std::any endpointMethod, std::any returnAsJson, std::any startRegex = std::any{}, std::any endRegex = std::any{})
    {
        return std::async(std::launch::async, [=]() mutable -> std::any {
            std::any errorMessage = std::string("");
            std::any options = this->safeValue(this->options, method, ccxt::dict {});
            std::any muteOnFailure = this->safeBool(options, std::string("webApiMuteFailure"), true);
            try
            {
                // if it was not explicitly disabled, then don't fetch
                if (!isTrue(this->safeBool(options, std::string("webApiEnable"), true)))
                {
                    return std::any{};
                }
                std::any maxRetries = this->safeValue(options, std::string("webApiRetries"), 10);
                std::any response = std::any{};
                std::any retry = 0;
                std::any shouldBreak = false;
                while (isLessThan(retry, maxRetries))
                {
                    try
                    {
                        response = awaitValue(callDynamically(this, endpointMethod, ccxt::list{ccxt::dict {}}));
                        shouldBreak = true;
                        break;
                    } catch(const std::exception& e)
                    {
                        retry = add(retry, 1);
                        if (isTrue(isEqual(retry, maxRetries)))
                        {
                            throw e;
                        }
                    }
                    if (isTrue(shouldBreak))
                    {
                        break; // this is needed because of GO
                    }
                }
                std::any content = response;
                if (isTrue(isEqual(content, std::any{})))
                {
                    throw NullResponse(toString(add(this->id, std::string(" fetchWebEndpoint() returned empty content"))));
                }
                if (isTrue(!isEqual(startRegex, std::any{})))
                {
                    std::any splitted_by_start = split(content, startRegex);
                    content = ::getValue(splitted_by_start, 1); // we need second part after start
                }
                if (isTrue(isEqual(content, std::any{})))
                {
                    throw NullResponse(toString(add(this->id, std::string(" fetchWebEndpoint() returned empty content"))));
                }
                if (isTrue(!isEqual(endRegex, std::any{})))
                {
                    std::any splitted_by_end = split(content, endRegex);
                    content = ::getValue(splitted_by_end, 0); // we need first part after start
                }
                if (isTrue(isTrue((isEqual(returnAsJson, true))) && isTrue((isString(content)))))
                {
                    std::any jsoned = this->parseJson(trim(content)); // content should be trimmed before json parsing
                    if (isTrue(isTrue((!isEqual(jsoned, std::any{}))) && isTrue((!isEqual(jsoned, null)))))
                    {
                        return jsoned;  // if parsing was not successfull, exception should be thrown
                    } else
                    {
                        throw BadResponse(toString(std::string("could not parse the response into json")));
                    }
                } else
                {
                    return content;
                }
            } catch(const std::exception& e)
            {
                errorMessage = add(add(add(this->id, std::string(" ")), method), std::string("() failed to fetch correct data from website. Probably webpage markup has been changed, breaking the page custom parser."));
            }
            if (isTrue(isEqual(muteOnFailure, true)))
            {
                return std::any{};
            } else
            {
                throw BadResponse(toString(errorMessage));
            }
            return std::any{};
        }).share();
    }

