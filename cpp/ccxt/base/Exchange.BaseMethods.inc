    virtual std::any handleTriggerPricesAndParams(std::any symbol, std::any params, std::any omitParams = true)
    {
        //
        std::any triggerPrice = this->safeString2(params, std::string("triggerPrice"), std::string("stopPrice"));
        std::any triggerPriceStr = std::any{};
        std::any stopLossPrice = this->safeString(params, std::string("stopLossPrice"));
        std::any stopLossPriceStr = std::any{};
        std::any takeProfitPrice = this->safeString(params, std::string("takeProfitPrice"));
        std::any takeProfitPriceStr = std::any{};
        //
        if (isTrue(!isEqual(triggerPrice, std::any{})))
        {
            if (isTrue(omitParams))
            {
                params = this->omit(params, ccxt::list{std::string("triggerPrice"), std::string("stopPrice")});
            }
            triggerPriceStr = this->priceToPrecision(symbol, parseFloat(triggerPrice));
        }
        if (isTrue(!isEqual(stopLossPrice, std::any{})))
        {
            if (isTrue(omitParams))
            {
                params = this->omit(params, std::string("stopLossPrice"));
            }
            stopLossPriceStr = this->priceToPrecision(symbol, parseFloat(stopLossPrice));
        }
        if (isTrue(!isEqual(takeProfitPrice, std::any{})))
        {
            if (isTrue(omitParams))
            {
                params = this->omit(params, std::string("takeProfitPrice"));
            }
            takeProfitPriceStr = this->priceToPrecision(symbol, parseFloat(takeProfitPrice));
        }
        return ccxt::list{triggerPriceStr, stopLossPriceStr, takeProfitPriceStr, params};
    }

    virtual std::any handleTriggerDirectionAndParams(std::any params, std::any exchangeSpecificKey = std::any{}, std::any allowEmpty = false)
    {
        /**
         * @ignore
         * @method
         * @returns {[string, object]} the trigger-direction value and omited params
         */
        std::any triggerDirection = this->safeString(params, std::string("triggerDirection"));
        std::any exchangeSpecificDefined = isTrue((!isEqual(exchangeSpecificKey, std::any{}))) && isTrue((inOp(params, exchangeSpecificKey)));
        if (isTrue(!isEqual(triggerDirection, std::any{})))
        {
            params = this->omit(params, std::string("triggerDirection"));
        }
        // throw exception if:
        // A) if provided value is not unified (support old "up/down" strings too)
        // B) if exchange specific "trigger direction key" (eg. "stopPriceSide") was not provided
        if (isTrue(isTrue(!isTrue(this->inArray(triggerDirection, ccxt::list{std::string("ascending"), std::string("descending"), std::string("up"), std::string("down"), std::string("above"), std::string("below")})) && !isTrue(exchangeSpecificDefined)) && !isTrue(allowEmpty)))
        {
            throw ArgumentsRequired(toString(add(this->id, std::string(" createOrder() : trigger orders require params[\"triggerDirection\"] to be either \"ascending\" or \"descending\""))));
        }
        // if old format was provided, overwrite to new
        if (isTrue(isTrue(isEqual(triggerDirection, std::string("up"))) || isTrue(isEqual(triggerDirection, std::string("above")))))
        {
            triggerDirection = std::string("ascending");
        } else if (isTrue(isTrue(isEqual(triggerDirection, std::string("down"))) || isTrue(isEqual(triggerDirection, std::string("below")))))
        {
            triggerDirection = std::string("descending");
        }
        return ccxt::list{triggerDirection, params};
    }

    virtual std::any handleTriggerAndParams(std::any params)
    {
        std::any isTrigger = this->safeBool2(params, std::string("trigger"), std::string("stop"));
        if (isTrue(isEqual(isTrigger, true)))
        {
            params = this->omit(params, ccxt::list{std::string("trigger"), std::string("stop")});
        }
        return ccxt::list{isTrigger, params};
    }

    virtual std::any isTriggerOrder(std::any params)
    {
        // for backwards compatibility
        return this->handleTriggerAndParams(params);
    }

    virtual std::any isPostOnly(std::any isMarketOrder, std::any exchangeSpecificParam, std::any params = ccxt::dict {})
    {
        /**
         * @ignore
         * @method
         * @param {string} type Order type
         * @param {boolean} exchangeSpecificParam exchange specific postOnly
         * @param {object} [params] exchange specific params
         * @returns {boolean} true if a post only order, false otherwise
         */
        std::any timeInForce = this->safeStringUpper(params, std::string("timeInForce"));
        std::any postOnly = this->safeBool2(params, std::string("postOnly"), std::string("post_only"), false);
        // we assume timeInForce is uppercase from safeStringUpper (params, 'timeInForce')
        std::any ioc = isEqual(timeInForce, std::string("IOC"));
        std::any fok = isEqual(timeInForce, std::string("FOK"));
        std::any timeInForcePostOnly = isEqual(timeInForce, std::string("PO"));
        if (isTrue(!isEqual(postOnly, true)))
        {
            postOnly = timeInForcePostOnly;
        }
        if (isTrue(!isEqual(postOnly, true)))
        {
            postOnly = exchangeSpecificParam;
        }
        if (isTrue(isEqual(postOnly, true)))
        {
            if (isTrue(isTrue(ioc) || isTrue(fok)))
            {
                throw InvalidOrder(toString(add(add(this->id, std::string(" postOnly orders cannot have timeInForce equal to ")), timeInForce)));
            } else if (isTrue(isMarketOrder))
            {
                throw InvalidOrder(toString(add(this->id, std::string(" market orders cannot be postOnly"))));
            } else
            {
                return true;
            }
        } else
        {
            return false;
        }
    }

    virtual std::any handlePostOnly(std::any isMarketOrder, std::any exchangeSpecificPostOnlyOption, std::any params = ccxt::dict {})
    {
        /**
         * @ignore
         * @method
         * @param {string} type Order type
         * @param {boolean} exchangeSpecificBoolean exchange specific postOnly
         * @param {object} [params] exchange specific params
         * @returns {Array}
         */
        std::any timeInForce = this->safeStringUpper(params, std::string("timeInForce"));
        std::any postOnly = this->safeBool(params, std::string("postOnly"), false);
        std::any ioc = isEqual(timeInForce, std::string("IOC"));
        std::any fok = isEqual(timeInForce, std::string("FOK"));
        std::any po = isEqual(timeInForce, std::string("PO"));
        if (isTrue(!isEqual(postOnly, true)))
        {
            postOnly = po;
        }
        if (isTrue(!isEqual(postOnly, true)))
        {
            postOnly = exchangeSpecificPostOnlyOption;
        }
        if (isTrue(isEqual(postOnly, true)))
        {
            if (isTrue(isTrue(ioc) || isTrue(fok)))
            {
                throw InvalidOrder(toString(add(add(this->id, std::string(" postOnly orders cannot have timeInForce equal to ")), timeInForce)));
            } else if (isTrue(isMarketOrder))
            {
                throw InvalidOrder(toString(add(this->id, std::string(" market orders cannot be postOnly"))));
            } else
            {
                if (isTrue(po))
                {
                    params = this->omit(params, std::string("timeInForce"));
                }
                params = this->omit(params, std::string("postOnly"));
                return ccxt::list{true, params};
            }
        }
        return ccxt::list{false, params};
    }

