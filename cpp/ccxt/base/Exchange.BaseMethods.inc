    virtual std::any handleMaxEntriesPerRequestAndParams(std::any method, std::any maxEntriesPerRequest = std::any{}, std::any params = ccxt::dict {})
    {
        std::any newMaxEntriesPerRequest = std::any{};
        std::any newMaxEntriesPerRequestparamsVariable = this->handleOptionAndParams(params, method, std::string("maxEntriesPerRequest"));
        newMaxEntriesPerRequest = ::getValue(newMaxEntriesPerRequestparamsVariable, 0);
        params = ::getValue(newMaxEntriesPerRequestparamsVariable, 1);
        if (isTrue(isTrue((!isEqual(newMaxEntriesPerRequest, std::any{}))) && isTrue((!isEqual(newMaxEntriesPerRequest, maxEntriesPerRequest)))))
        {
            maxEntriesPerRequest = newMaxEntriesPerRequest;
        }
        if (isTrue(isEqual(maxEntriesPerRequest, std::any{})))
        {
            maxEntriesPerRequest = 1000; // default to 1000
        }
        return ccxt::list{maxEntriesPerRequest, params};
    }

    virtual std::shared_future<std::any> fetchPaginatedCallDynamic(std::any method, std::any symbol = std::any{}, std::any since = std::any{}, std::any limit = std::any{}, std::any params = ccxt::dict {}, std::any maxEntriesPerRequest = std::any{}, std::any removeRepeated = true)
    {
        return std::async(std::launch::async, [=]() mutable -> std::any {
            std::any maxCalls = 10;
            std::any maxCallsparamsVariable = this->handleOptionAndParams(params, method, std::string("paginationCalls"), maxCalls);
            maxCalls = ::getValue(maxCallsparamsVariable, 0);
            params = ::getValue(maxCallsparamsVariable, 1);
            std::any maxRetries = 3;
            std::any maxRetriesparamsVariable = this->handleOptionAndParams(params, method, std::string("maxRetries"), maxRetries);
            maxRetries = ::getValue(maxRetriesparamsVariable, 0);
            params = ::getValue(maxRetriesparamsVariable, 1);
            std::any paginationDirection = std::any{};
            std::any paginationDirectionparamsVariable = this->handleOptionAndParams(params, method, std::string("paginationDirection"), std::string("backward"));
            paginationDirection = ::getValue(paginationDirectionparamsVariable, 0);
            params = ::getValue(paginationDirectionparamsVariable, 1);
            std::any paginationTimestamp = std::any{};
            std::any removeRepeatedOption = removeRepeated;
            std::any removeRepeatedOptionparamsVariable = this->handleOptionAndParams(params, method, std::string("removeRepeated"), removeRepeated);
            removeRepeatedOption = ::getValue(removeRepeatedOptionparamsVariable, 0);
            params = ::getValue(removeRepeatedOptionparamsVariable, 1);
            std::any calls = 0;
            std::any result = ccxt::list{};
            std::any errors = 0;
            std::any until = this->safeIntegerN(params, ccxt::list{std::string("until"), std::string("untill"), std::string("till")}); // do not omit it from params here
            std::any maxEntriesPerRequestparamsVariable = this->handleMaxEntriesPerRequestAndParams(method, maxEntriesPerRequest, params);
            maxEntriesPerRequest = ::getValue(maxEntriesPerRequestparamsVariable, 0);
            params = ::getValue(maxEntriesPerRequestparamsVariable, 1);
            if (isTrue((isEqual(paginationDirection, std::string("forward")))))
            {
                if (isTrue(isEqual(since, std::any{})))
                {
                    throw ArgumentsRequired(toString(add(this->id, std::string(" pagination requires a since argument when paginationDirection set to forward"))));
                }
                paginationTimestamp = since;
            }
            while ((isLessThan(calls, maxCalls)))
            {
                calls = add(calls, 1);
                try
                {
                    if (isTrue(isEqual(paginationDirection, std::string("backward"))))
                    {
                        // do it backwards, starting from the last
                        // UNTIL filtering is required in order to work
                        if (isTrue(!isEqual(paginationTimestamp, std::any{})))
                        {
                            ::setValue(params, std::string("until"), subtract(paginationTimestamp, 1));
                        }
                        std::any response = awaitValue(callDynamically(this, method, ccxt::list{symbol, std::any{}, maxEntriesPerRequest, params}));
                        std::any responseLength = getArrayLength(response);
                        if (isTrue(this->verbose))
                        {
                            std::any backwardMessage = add(add(add(add(add(std::string("Dynamic pagination call "), this->numberToString(calls)), std::string(" method ")), method), std::string(" response length ")), this->numberToString(responseLength));
                            if (isTrue(!isEqual(paginationTimestamp, std::any{})))
                            {
                                backwardMessage = add(backwardMessage, add(std::string(" timestamp "), this->numberToString(paginationTimestamp)));
                            }
                            this->log(backwardMessage);
                        }
                        if (isTrue(isEqual(responseLength, 0)))
                        {
                            break;
                        }
                        errors = 0;
                        result = this->arrayConcat(result, response);
                        std::any firstElement = this->safeValue(response, 0);
                        paginationTimestamp = this->safeInteger2(firstElement, std::string("timestamp"), 0);
                        if (isTrue(isEqual(paginationTimestamp, std::any{})))
                        {
                            break;
                        }
                        if (isTrue(isTrue((!isEqual(since, std::any{}))) && isTrue((isLessThanOrEqual(paginationTimestamp, since)))))
                        {
                            break;
                        }
                    } else
                    {
                        // do it forwards, starting from the since
                        std::any response = awaitValue(callDynamically(this, method, ccxt::list{symbol, paginationTimestamp, maxEntriesPerRequest, params}));
                        std::any responseLength = getArrayLength(response);
                        if (isTrue(this->verbose))
                        {
                            std::any forwardMessage = add(add(add(add(add(std::string("Dynamic pagination call "), this->numberToString(calls)), std::string(" method ")), method), std::string(" response length ")), this->numberToString(responseLength));
                            if (isTrue(!isEqual(paginationTimestamp, std::any{})))
                            {
                                forwardMessage = add(forwardMessage, add(std::string(" timestamp "), this->numberToString(paginationTimestamp)));
                            }
                            this->log(forwardMessage);
                        }
                        if (isTrue(isEqual(responseLength, 0)))
                        {
                            break;
                        }
                        errors = 0;
                        result = this->arrayConcat(result, response);
                        std::any last = this->safeValue(response, subtract(responseLength, 1));
                        std::any lastTimestamp = this->safeInteger(last, std::string("timestamp"), 0);
                        if (isTrue(isEqual(lastTimestamp, std::any{})))
                        {
                            break;
                        }
                        std::any nextPaginationTimestamp = add(lastTimestamp, 1);
                        paginationTimestamp = nextPaginationTimestamp;
                        if (isTrue(isTrue((!isEqual(until, std::any{}))) && isTrue((isGreaterThanOrEqual(nextPaginationTimestamp, until)))))
                        {
                            break;
                        }
                    }
                } catch(const std::exception& e)
                {
                    errors = add(errors, 1);
                    if (isTrue(isGreaterThan(errors, maxRetries)))
                    {
                        throw e;
                    }
                }
            }
            std::any uniqueResults = result;
            if (isTrue(removeRepeatedOption))
            {
                uniqueResults = this->removeRepeatedElementsFromArray(result);
            }
            std::any key = (isTrue((isEqual(method, std::string("fetchOHLCV")))) ? std::any(0) : std::any(std::string("timestamp")));
            std::any sortedRes = this->sortBy(uniqueResults, key);
            return this->filterBySinceLimit(sortedRes, since, limit, key);
        }).share();
    }

    virtual std::shared_future<std::any> safeDeterministicCall(std::any method, std::any symbol = std::any{}, std::any since = std::any{}, std::any limit = std::any{}, std::any timeframe = std::any{}, std::any params = ccxt::dict {})
    {
        return std::async(std::launch::async, [=]() mutable -> std::any {
            std::any maxRetries = 3;
            std::any maxRetriesparamsVariable = this->handleOptionAndParams(params, method, std::string("maxRetries"), maxRetries);
            maxRetries = ::getValue(maxRetriesparamsVariable, 0);
            params = ::getValue(maxRetriesparamsVariable, 1);
            std::any errors = 0;
            while (isLessThanOrEqual(errors, maxRetries))
            {
                try
                {
                    if (isTrue(isTrue((isTrue(!isEqual(timeframe, std::any{})) && isTrue(!isEqual(timeframe, std::string(""))))) && isTrue(!isEqual(method, std::string("fetchFundingRateHistory")))))
                    {
                        return awaitValue(callDynamically(this, method, ccxt::list{symbol, timeframe, since, limit, params}));
                    } else
                    {
                        return awaitValue(callDynamically(this, method, ccxt::list{symbol, since, limit, params}));
                    }
                } catch(const std::exception& e)
                {
                    if (isTrue(isInstanceOf<RateLimitExceeded>(e)))
                    {
                        throw e;
                    }
                    errors = add(errors, 1);
                    if (isTrue(isGreaterThan(errors, maxRetries)))
                    {
                        throw e;
                    }
                }
            }
            return ccxt::list{};
        }).share();
    }

    virtual std::shared_future<std::any> fetchPaginatedCallDeterministic(std::any method, std::any symbol = std::any{}, std::any since = std::any{}, std::any limit = std::any{}, std::any timeframe = std::any{}, std::any params = ccxt::dict {}, std::any maxEntriesPerRequest = std::any{})
    {
        return std::async(std::launch::async, [=]() mutable -> std::any {
            std::any maxCalls = 10;
            std::any maxCallsparamsVariable = this->handleOptionAndParams(params, method, std::string("paginationCalls"), maxCalls);
            maxCalls = ::getValue(maxCallsparamsVariable, 0);
            params = ::getValue(maxCallsparamsVariable, 1);
            std::any maxEntriesPerRequestparamsVariable = this->handleMaxEntriesPerRequestAndParams(method, maxEntriesPerRequest, params);
            maxEntriesPerRequest = ::getValue(maxEntriesPerRequestparamsVariable, 0);
            params = ::getValue(maxEntriesPerRequestparamsVariable, 1);
            // paginationDirection is only relevant to fetchPaginatedCallDynamic/Cursor; deterministic
            // pagination always walks forward internally, so strip it here to avoid leaking an
            // unrecognized param into the underlying exchange request (e.g. binance -1104 errors)
            params = this->omit(params, std::string("paginationDirection"));
            std::any current = this->milliseconds();
            std::any tasks = ccxt::list{};
            std::any time = multiply(this->parseTimeframe(timeframe), 1000);
            maxEntriesPerRequest = this->requireValue(maxEntriesPerRequest, std::string("fetchPaginatedCallDeterministic() maxEntriesPerRequest is required"));
            std::any step = multiply(time, maxEntriesPerRequest);
            std::any until = this->safeInteger2(params, std::string("until"), std::string("till")); // do not omit it here
            std::any currentSince = subtract(subtract(current, (multiply(maxCalls, step))), 1);
            if (isTrue(!isEqual(since, std::any{})))
            {
                if (isTrue(!isEqual(until, std::any{})))
                {
                    // the recent-window floor below would jump past a fully-historical [ since, until ]
                    // range and return an empty result - requiredCalls is validated against maxCalls
                    // further down, so anchoring at since directly is safe here,
                    // see https://github.com/ccxt/ccxt/issues/26252
                    currentSince = since;
                } else
                {
                    currentSince = mathMax(currentSince, since);
                }
            } else
            {
                currentSince = mathMax(currentSince, 1241440531000); // avoid timestamps older than 2009
            }
            if (isTrue(!isEqual(until, std::any{})))
            {
                if (isTrue(isEqual(since, std::any{})))
                {
                    throw ArgumentsRequired(toString(add(this->id, std::string(" fetchPaginatedCallDeterministic() requires a since argument when until is set"))));
                }
                std::any requiredCalls = mathCeil(divide((subtract(until, since)), step));
                if (isTrue(isGreaterThan(requiredCalls, maxCalls)))
                {
                    throw BadRequest(toString(add(add(add(add(this->id, std::string(" the number of required calls is greater than the max number of calls allowed, either increase the paginationCalls or decrease the since-until gap. Current paginationCalls limit is ")), toString(maxCalls)), std::string(" required calls is ")), toString(requiredCalls))));
                }
            }
            for (std::any i = 0; isLessThan(i, maxCalls); postFixIncrement(i))
            {
                if (isTrue(isTrue((!isEqual(until, std::any{}))) && isTrue((isGreaterThanOrEqual(currentSince, until)))))
                {
                    break;
                }
                if (isTrue(isGreaterThanOrEqual(currentSince, current)))
                {
                    break;
                }
                arrayPush(tasks, this->safeDeterministicCall(method, symbol, currentSince, maxEntriesPerRequest, timeframe, params));
                currentSince = subtract(this->sum(currentSince, step), 1);
            }
            std::any results = awaitValue(promiseAll(tasks));
            std::any result = ccxt::list{};
            for (std::any i = 0; isLessThan(i, getArrayLength(results)); postFixIncrement(i))
            {
                result = this->arrayConcat(result, ::getValue(results, i));
            }
            std::any uniqueResults = this->removeRepeatedElementsFromArray(result);
            std::any key = (isTrue((isEqual(method, std::string("fetchOHLCV")))) ? std::any(0) : std::any(std::string("timestamp")));
            return this->filterBySinceLimit(uniqueResults, since, limit, key);
        }).share();
    }

    // the 'symbol' slot is forwarded to `this[method]` untouched and is only compared against
    // undefined here, so fetchPositions/fetchPositionsHistory legitimately pass a symbol list
    virtual std::shared_future<std::any> fetchPaginatedCallCursor(std::any method, std::any symbol = std::any{}, std::any since = std::any{}, std::any limit = std::any{}, std::any params = ccxt::dict {}, std::any cursorReceived = std::any{}, std::any cursorSent = std::any{}, std::any cursorIncrement = std::any{}, std::any maxEntriesPerRequest = std::any{})
    {
        return std::async(std::launch::async, [=]() mutable -> std::any {
            std::any maxCalls = 10;
            std::any maxCallsparamsVariable = this->handleOptionAndParams(params, method, std::string("paginationCalls"), maxCalls);
            maxCalls = ::getValue(maxCallsparamsVariable, 0);
            params = ::getValue(maxCallsparamsVariable, 1);
            std::any maxRetries = 3;
            std::any maxRetriesparamsVariable = this->handleOptionAndParams(params, method, std::string("maxRetries"), maxRetries);
            maxRetries = ::getValue(maxRetriesparamsVariable, 0);
            params = ::getValue(maxRetriesparamsVariable, 1);
            std::any maxEntriesPerRequestparamsVariable = this->handleMaxEntriesPerRequestAndParams(method, maxEntriesPerRequest, params);
            maxEntriesPerRequest = ::getValue(maxEntriesPerRequestparamsVariable, 0);
            params = ::getValue(maxEntriesPerRequestparamsVariable, 1);
            std::any cursorValue = std::any{};
            std::any i = 0;
            std::any errors = 0;
            std::any result = ccxt::list{};
            std::any timeframe = this->safeString(params, std::string("timeframe"));
            params = this->omit(params, std::string("timeframe")); // reading the timeframe from the method arguments to avoid changing the signature
            while (isLessThan(i, maxCalls))
            {
                try
                {
                    if (isTrue(!isEqual(cursorValue, std::any{})))
                    {
                        if (isTrue(!isEqual(cursorIncrement, std::any{})))
                        {
                            cursorValue = add(this->parseToInt(cursorValue), cursorIncrement);
                        }
                        ::setValue(params, cursorSent, cursorValue);
                    }
                    std::any response = std::any{};
                    if (isTrue(isEqual(method, std::string("fetchAccounts"))))
                    {
                        response = awaitValue(callDynamically(this, method, ccxt::list{params}));
                    } else if (isTrue(isTrue(isEqual(method, std::string("getLeverageTiersPaginated"))) || isTrue(isEqual(method, std::string("fetchPositions")))))
                    {
                        response = awaitValue(callDynamically(this, method, ccxt::list{symbol, params}));
                    } else if (isTrue(isEqual(method, std::string("fetchOpenInterestHistory"))))
                    {
                        if (isTrue(!isString(symbol)))
                        {
                            throw ArgumentsRequired(toString(add(this->id, std::string(" fetchPaginatedCallCursor() requires a symbol argument"))));
                        }
                        if (isTrue(isEqual(timeframe, std::any{})))
                        {
                            throw ArgumentsRequired(toString(add(this->id, std::string(" fetchPaginatedCallCursor() requires a timeframe argument"))));
                        }
                        response = awaitValue(callDynamically(this, method, ccxt::list{symbol, timeframe, since, maxEntriesPerRequest, params}));
                    } else
                    {
                        response = awaitValue(callDynamically(this, method, ccxt::list{symbol, since, maxEntriesPerRequest, params}));
                    }
                    errors = 0;
                    if (isTrue(isEqual(response, std::any{})))
                    {
                        throw NullResponse(toString(add(this->id, std::string(" fetchPaginatedCallCursor() returned empty response"))));
                    }
                    std::any responseLength = getArrayLength(response);
                    if (isTrue(this->verbose))
                    {
                        std::any cursorString = (isTrue((isEqual(cursorValue, std::any{}))) ? std::any(std::string("")) : std::any(cursorValue));
                        std::any iteration = (add(i, 1));
                        std::any cursorMessage = add(add(add(add(add(add(add(std::string("Cursor pagination call "), toString(iteration)), std::string(" method ")), method), std::string(" response length ")), toString(responseLength)), std::string(" cursor ")), cursorString);
                        this->log(cursorMessage);
                    }
                    if (isTrue(isEqual(responseLength, 0)))
                    {
                        break;
                    }
                    if (isTrue(!isEqual(response, std::any{})))
                    {
                        result = this->arrayConcat(result, response);
                    }
                    std::any last = this->safeDict(response, subtract(responseLength, 1));
                    // cursorValue = this.safeValue (last['info'], cursorReceived);
                    cursorValue = std::any{}; // search for the cursor
                    for (std::any j = 0; isLessThan(j, responseLength); postFixIncrement(j))
                    {
                        std::any index = subtract(subtract(responseLength, j), 1);
                        std::any entry = this->safeDict(response, index);
                        std::any info = this->safeDict(entry, std::string("info"));
                        std::any cursor = (isTrue((isEqual(cursorReceived, std::any{}))) ? std::any(std::any{}) : std::any(this->safeValue(info, cursorReceived)));
                        if (isTrue(!isEqual(cursor, std::any{})))
                        {
                            cursorValue = cursor;
                            break;
                        }
                    }
                    if (isTrue(isEqual(cursorValue, std::any{})))
                    {
                        break;
                    }
                    std::any lastTimestamp = this->safeInteger(last, std::string("timestamp"));
                    if (isTrue(isEqual(since, std::any{})))
                    {
                        throw ArgumentsRequired(toString(add(this->id, std::string(" fetchPaginatedCallCursor() requires a since argument"))));
                    }
                    if (isTrue(isTrue(!isEqual(lastTimestamp, std::any{})) && isTrue(isLessThan(lastTimestamp, since))))
                    {
                        break;
                    }
                } catch(const std::exception& e)
                {
                    errors = add(errors, 1);
                    if (isTrue(isGreaterThan(errors, maxRetries)))
                    {
                        throw e;
                    }
                }
                i = add(i, 1);
            }
            std::any sorted = this->sortCursorPaginatedResult(result);
            std::any key = (isTrue((isEqual(method, std::string("fetchOHLCV")))) ? std::any(0) : std::any(std::string("timestamp")));
            return this->filterBySinceLimit(sorted, since, limit, key);
        }).share();
    }

    virtual std::shared_future<std::any> fetchPaginatedCallIncremental(std::any method, std::any symbol = std::any{}, std::any since = std::any{}, std::any limit = std::any{}, std::any params = ccxt::dict {}, std::any pageKey = std::any{}, std::any maxEntriesPerRequest = std::any{})
    {
        return std::async(std::launch::async, [=]() mutable -> std::any {
            std::any maxCalls = 10;
            std::any maxCallsparamsVariable = this->handleOptionAndParams(params, method, std::string("paginationCalls"), maxCalls);
            maxCalls = ::getValue(maxCallsparamsVariable, 0);
            params = ::getValue(maxCallsparamsVariable, 1);
            std::any maxRetries = 3;
            std::any maxRetriesparamsVariable = this->handleOptionAndParams(params, method, std::string("maxRetries"), maxRetries);
            maxRetries = ::getValue(maxRetriesparamsVariable, 0);
            params = ::getValue(maxRetriesparamsVariable, 1);
            std::any maxEntriesPerRequestparamsVariable = this->handleMaxEntriesPerRequestAndParams(method, maxEntriesPerRequest, params);
            maxEntriesPerRequest = ::getValue(maxEntriesPerRequestparamsVariable, 0);
            params = ::getValue(maxEntriesPerRequestparamsVariable, 1);
            std::any i = 0;
            std::any errors = 0;
            std::any result = ccxt::list{};
            while (isLessThan(i, maxCalls))
            {
                try
                {
                    ::setValue(params, pageKey, add(i, 1));
                    std::any response = awaitValue(callDynamically(this, method, ccxt::list{symbol, since, maxEntriesPerRequest, params}));
                    errors = 0;
                    std::any responseLength = getArrayLength(response);
                    if (isTrue(this->verbose))
                    {
                        std::any iteration = toString((add(i, 1)));
                        std::any incrementalMessage = add(add(add(add(add(std::string("Incremental pagination call "), iteration), std::string(" method ")), method), std::string(" response length ")), toString(responseLength));
                        this->log(incrementalMessage);
                    }
                    if (isTrue(isEqual(responseLength, 0)))
                    {
                        break;
                    }
                    result = this->arrayConcat(result, response);
                } catch(const std::exception& e)
                {
                    errors = add(errors, 1);
                    if (isTrue(isGreaterThan(errors, maxRetries)))
                    {
                        throw e;
                    }
                }
                i = add(i, 1);
            }
            std::any sorted = this->sortCursorPaginatedResult(result);
            std::any key = (isTrue((isEqual(method, std::string("fetchOHLCV")))) ? std::any(0) : std::any(std::string("timestamp")));
            return this->filterBySinceLimit(sorted, since, limit, key);
        }).share();
    }

    virtual std::any sortCursorPaginatedResult(std::any result)
    {
        std::any first = this->safeValue(result, 0);
        if (isTrue(!isEqual(first, std::any{})))
        {
            if (isTrue(inOp(first, std::string("timestamp"))))
            {
                return this->sortBy(result, std::string("timestamp"), true);
            }
            if (isTrue(inOp(first, std::string("id"))))
            {
                return this->sortBy(result, std::string("id"), true);
            }
        }
        return result;
    }

    virtual std::any removeRepeatedElementsFromArray(std::any input, std::any fallbackToTimestamp = true)
    {
        std::any uniqueDic = ccxt::dict {};
        std::any uniqueResult = ccxt::list{};
        for (std::any i = 0; isLessThan(i, getArrayLength(input)); postFixIncrement(i))
        {
            std::any entry = ::getValue(input, i);
            std::any uniqValue = (isTrue(fallbackToTimestamp) ? std::any(this->safeStringN(entry, ccxt::list{std::string("id"), std::string("timestamp"), 0})) : std::any(this->safeString(entry, std::string("id"))));
            if (isTrue(isTrue(!isEqual(uniqValue, std::any{})) && !isTrue((inOp(uniqueDic, uniqValue)))))
            {
                ::setValue(uniqueDic, uniqValue, 1);
                arrayPush(uniqueResult, entry);
            }
        }
        std::any valuesLength = getArrayLength(uniqueResult);
        if (isTrue(isGreaterThan(valuesLength, 0)))
        {
            return uniqueResult;
        }
        return input;
    }

    virtual std::any removeRepeatedTradesFromArray(std::any input)
    {
        std::any uniqueResult = ccxt::dict {};
        for (std::any i = 0; isLessThan(i, getArrayLength(input)); postFixIncrement(i))
        {
            std::any entry = ::getValue(input, i);
            std::any id = this->safeString(entry, std::string("id"));
            if (isTrue(isEqual(id, std::any{})))
            {
                std::any price = this->safeString(entry, std::string("price"));
                std::any amount = this->safeString(entry, std::string("amount"));
                std::any timestamp = this->safeString(entry, std::string("timestamp"));
                std::any side = this->safeString(entry, std::string("side"));
                // unique trade identifier
                if (isTrue(isEqual(timestamp, std::any{})))
                {
                    throw ExchangeError(toString(add(this->id, std::string(" removeRepeatedTradesFromArray() missing timestamp"))));
                }
                id = add(add(add(add(add(add(add(std::string("t_"), toString(timestamp)), std::string("_")), side), std::string("_")), price), std::string("_")), amount);
            }
            if (isTrue(isTrue(!isEqual(id, std::any{})) && !isTrue((inOp(uniqueResult, id)))))
            {
                ::setValue(uniqueResult, id, entry);
            }
        }
        std::any values = getObjectValues(uniqueResult);
        return values;
    }

    virtual std::any removeKeysFromDict(std::any dict, std::any removeKeys)
    {
        std::any keys = getObjectKeys(dict);
        std::any newDict = ccxt::dict {};
        for (std::any i = 0; isLessThan(i, getArrayLength(keys)); postFixIncrement(i))
        {
            std::any key = ::getValue(keys, i);
            if (!isTrue(this->inArray(key, removeKeys)))
            {
                ::setValue(newDict, key, ::getValue(dict, key));
            }
        }
        return newDict;
    }

    virtual std::any handleUntilOption(std::any key, std::any request, std::any params, std::any multiplier = 1)
    {
        std::any until = this->safeInteger2(params, std::string("until"), std::string("till"));
        if (isTrue(!isEqual(until, std::any{})))
        {
            ::setValue(request, key, this->parseToInt(multiply(until, multiplier)));
            params = this->omit(params, ccxt::list{std::string("until"), std::string("till")});
        }
        return ccxt::list{request, params};
    }

    virtual std::any safeOpenInterest(std::any interest, std::any market = std::any{})
    {
        std::any symbol = this->safeString(interest, std::string("symbol"));
        if (isTrue(isEqual(symbol, std::any{})))
        {
            symbol = this->safeString(market, std::string("symbol"));
        }
        return this->extend(interest, ccxt::dict {
            { std::string("symbol"), symbol },
            { std::string("baseVolume"), this->safeNumber(interest, std::string("baseVolume")) },
            { std::string("quoteVolume"), this->safeNumber(interest, std::string("quoteVolume")) },
            { std::string("openInterestAmount"), this->safeNumber(interest, std::string("openInterestAmount")) },
            { std::string("openInterestValue"), this->safeNumber(interest, std::string("openInterestValue")) },
            { std::string("timestamp"), this->safeInteger(interest, std::string("timestamp")) },
            { std::string("datetime"), this->safeString(interest, std::string("datetime")) },
            { std::string("info"), this->safeValue(interest, std::string("info")) },
        });
    }

