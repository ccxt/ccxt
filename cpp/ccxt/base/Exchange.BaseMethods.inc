    virtual std::shared_future<std::any> fetchFundingRate(std::any symbol, std::any params = ccxt::dict {})
    {
        return std::async(std::launch::async, [=]() mutable -> std::any {
            if (isTrue(isTrue(!isEqual(::getValue(this->has, std::string("fetchFundingRates")), std::any{})) && isTrue(!isEqual(::getValue(this->has, std::string("fetchFundingRates")), false))))
            {
                awaitValue(this->loadMarkets());
                std::any market = this->market(symbol);
                symbol = ::getValue(market, std::string("symbol"));
                if (isTrue(!isEqual(::getValue(market, std::string("contract")), true)))
                {
                    throw BadSymbol(toString(add(this->id, std::string(" fetchFundingRate() supports contract markets only"))));
                }
                std::any rates = awaitValue(this->fetchFundingRates(ccxt::list{symbol}, params));
                std::any rate = this->safeValue(rates, symbol);
                if (isTrue(isEqual(rate, std::any{})))
                {
                    throw NullResponse(toString(add(add(this->id, std::string(" fetchFundingRate () returned no data for ")), symbol)));
                } else
                {
                    return rate;
                }
            } else
            {
                throw NotSupported(toString(add(this->id, std::string(" fetchFundingRate () is not supported yet"))));
            }
            return std::any{};
        }).share();
    }

