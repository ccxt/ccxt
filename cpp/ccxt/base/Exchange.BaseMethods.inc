            } else
            {
                throw NotSupported(toString(add(this->id, std::string(" fetchPositionsADLRank() is not supported yet"))));
            }
            return std::any{};
        }).share();
    }

    virtual std::any setTakeProfitAndStopLossParams(std::any symbol, std::any type, std::any side, std::any amount, std::any price = std::any{}, std::any takeProfit = std::any{}, std::any stopLoss = std::any{}, std::any params = ccxt::dict {})
    {
        if (isTrue(isTrue((isEqual(takeProfit, std::any{}))) && isTrue((isEqual(stopLoss, std::any{})))))
        {
            throw ArgumentsRequired(toString(add(this->id, std::string(" createOrderWithTakeProfitAndStopLoss() requires either a takeProfit or stopLoss argument"))));
        }
        if (isTrue(!isEqual(takeProfit, std::any{})))
        {
            ::setValue(params, std::string("takeProfit"), ccxt::dict {
    { std::string("triggerPrice"), takeProfit },
});
        }
        if (isTrue(!isEqual(stopLoss, std::any{})))
        {
            ::setValue(params, std::string("stopLoss"), ccxt::dict {
    { std::string("triggerPrice"), stopLoss },
});
        }
        std::any takeProfitType = this->safeString(params, std::string("takeProfitType"));
        std::any takeProfitPriceType = this->safeString(params, std::string("takeProfitPriceType"));
        std::any takeProfitLimitPrice = this->safeString(params, std::string("takeProfitLimitPrice"));
        std::any takeProfitAmount = this->safeString(params, std::string("takeProfitAmount"));
        std::any stopLossType = this->safeString(params, std::string("stopLossType"));
        std::any stopLossPriceType = this->safeString(params, std::string("stopLossPriceType"));
        std::any stopLossLimitPrice = this->safeString(params, std::string("stopLossLimitPrice"));
        std::any stopLossAmount = this->safeString(params, std::string("stopLossAmount"));
        if (isTrue(!isEqual(takeProfitType, std::any{})))
        {
            ::setValue(::getValue(params, std::string("takeProfit")), std::string("type"), takeProfitType);
        }
        if (isTrue(!isEqual(takeProfitPriceType, std::any{})))
        {
            ::setValue(::getValue(params, std::string("takeProfit")), std::string("priceType"), takeProfitPriceType);
        }
        if (isTrue(!isEqual(takeProfitLimitPrice, std::any{})))
        {
            ::setValue(::getValue(params, std::string("takeProfit")), std::string("price"), this->parseToNumeric(takeProfitLimitPrice));
        }
        if (isTrue(!isEqual(takeProfitAmount, std::any{})))
        {
            ::setValue(::getValue(params, std::string("takeProfit")), std::string("amount"), this->parseToNumeric(takeProfitAmount));
        }
        if (isTrue(!isEqual(stopLossType, std::any{})))
        {
            ::setValue(::getValue(params, std::string("stopLoss")), std::string("type"), stopLossType);
        }
        if (isTrue(!isEqual(stopLossPriceType, std::any{})))
        {
            ::setValue(::getValue(params, std::string("stopLoss")), std::string("priceType"), stopLossPriceType);
        }
        if (isTrue(!isEqual(stopLossLimitPrice, std::any{})))
        {
            ::setValue(::getValue(params, std::string("stopLoss")), std::string("price"), this->parseToNumeric(stopLossLimitPrice));
        }
        if (isTrue(!isEqual(stopLossAmount, std::any{})))
        {
            ::setValue(::getValue(params, std::string("stopLoss")), std::string("amount"), this->parseToNumeric(stopLossAmount));
        }
        params = this->omit(params, ccxt::list{std::string("takeProfitType"), std::string("takeProfitPriceType"), std::string("takeProfitLimitPrice"), std::string("takeProfitAmount"), std::string("stopLossType"), std::string("stopLossPriceType"), std::string("stopLossLimitPrice"), std::string("stopLossAmount")});
        return params;
    }

