        }
        // socksProxy
        std::any isSocksProxyDefined = this->valueIsDefined(this->socksProxy);
        std::any isSocks_proxy_defined = this->valueIsDefined(this->socks_proxy);
        if (isTrue(isTrue(isSocksProxyDefined) || isTrue(isSocks_proxy_defined)))
