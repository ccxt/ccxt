    virtual std::any parseLastPrices(std::any pricesData, std::any symbols = std::any{}, std::any params = ccxt::dict {})
    {
        //
        // the value of tickers is either a dict or a list
        //
        // dict
        //
        //     {
        //         'marketId1': { ... },
        //         'marketId2': { ... },
        //         ...
        //     }
        //
        // list
        //
        //     [
        //         { 'market': 'marketId1', ... },
        //         { 'market': 'marketId2', ... },
        //         ...
        //     ]
        //
        std::any results = ccxt::list{};
        if (isTrue(isArray(pricesData)))
        {
            for (std::any i = 0; isLessThan(i, getArrayLength(pricesData)); postFixIncrement(i))
            {
                std::any priceData = this->extend(this->parseLastPrice(::getValue(pricesData, i)), params);
                arrayPush(results, priceData);
            }
        } else
        {
            std::any marketIds = getObjectKeys(pricesData);
            for (std::any i = 0; isLessThan(i, getArrayLength(marketIds)); postFixIncrement(i))
            {
                std::any marketId = ::getValue(marketIds, i);
                std::any market = this->safeMarket(marketId);
                std::any priceData = this->extend(this->parseLastPrice(::getValue(pricesData, marketId), market), params);
                arrayPush(results, priceData);
            }
        }
        symbols = this->marketSymbols(symbols);
        return this->filterByArray(results, std::string("symbol"), symbols);
    }

    virtual std::any parseTickers(std::any tickers, std::any symbols = std::any{}, std::any params = ccxt::dict {})
    {
        //
        // the value of tickers is either a dict or a list
        //
        //
        // dict
        //
        //     {
        //         'marketId1': { ... },
        //         'marketId2': { ... },
        //         'marketId3': { ... },
        //         ...
        //     }
        //
        // list
        //
        //     [
        //         { 'market': 'marketId1', ... },
        //         { 'market': 'marketId2', ... },
        //         { 'market': 'marketId3', ... },
        //         ...
        //     ]
        //
        std::any results = ccxt::list{};
        if (isTrue(isArray(tickers)))
        {
            for (std::any i = 0; isLessThan(i, getArrayLength(tickers)); postFixIncrement(i))
            {
                std::any parsedTicker = this->parseTicker(::getValue(tickers, i));
                std::any ticker = this->extend(parsedTicker, params);
                arrayPush(results, ticker);
            }
        } else
        {
            std::any marketIds = getObjectKeys(tickers);
            for (std::any i = 0; isLessThan(i, getArrayLength(marketIds)); postFixIncrement(i))
            {
                std::any marketId = ::getValue(marketIds, i);
                std::any market = this->safeMarket(marketId);
                std::any parsed = this->parseTicker(::getValue(tickers, marketId), market);
                std::any ticker = this->extend(parsed, params);
                arrayPush(results, ticker);
            }
        }
        symbols = this->marketSymbols(symbols);
        return this->filterByArray(results, std::string("symbol"), symbols);
    }

