    virtual std::any safeNetwork(std::any network)
    {
        std::any withdrawEnabled = this->safeBool(network, std::string("withdraw"));
        std::any depositEnabled = this->safeBool(network, std::string("deposit"));
        std::any limits = this->safeDict(network, std::string("limits"));
        std::any withdraw = this->safeDict(limits, std::string("withdraw"));
        std::any deposit = this->safeDict(limits, std::string("deposit"));
        std::any isEnabled = withdrawEnabled;
        if (isTrue(isEqual(withdrawEnabled, true)))
        {
            isEnabled = depositEnabled;
        }
        return ccxt::dict {
            { std::string("info"), ::getValue(network, std::string("info")) },
            { std::string("id"), this->safeString(network, std::string("id")) },
            { std::string("name"), this->safeString(network, std::string("name")) },
            { std::string("network"), this->safeString(network, std::string("network")) },
            { std::string("active"), this->safeBool(network, std::string("active"), isEnabled) },
            { std::string("deposit"), depositEnabled },
            { std::string("withdraw"), withdrawEnabled },
            { std::string("fee"), this->safeNumber(network, std::string("fee")) },
            { std::string("precision"), this->safeNumber(network, std::string("precision")) },
            { std::string("limits"), ccxt::dict {
                { std::string("withdraw"), ccxt::dict {
                    { std::string("min"), this->safeNumber(withdraw, std::string("min")) },
                    { std::string("max"), this->safeNumber(withdraw, std::string("max")) },
                } },
                { std::string("deposit"), ccxt::dict {
                    { std::string("min"), this->safeNumber(deposit, std::string("min")) },
                    { std::string("max"), this->safeNumber(deposit, std::string("max")) },
                } },
            } },
        };
    }

    virtual std::any prioritizedNetworkAliases(std::any networkCode = std::any{}, std::any currencyCode = std::any{}, std::any allowDefault = false)
    {
        /**
         * @method
         * @name Exchange#prioritizedNetworkAliases
         * @description returns the chain pair [preferred, alternative] for the given networkCode & currency, e.g:
         *   ---------------------------------
         *   | input          | output       |
         *   --------------------------------|
         *   | ETH & USDC     | ERC20, ETH   |
         *   | ERC20 & USDC   | ERC20, ETH   |
         *   | ETH & ETH      | ETH, ERC20   |
         *   | ERC20 & ETH    | ETH, ERC20   |
         *   | ERC20          | ERC20, ETH   |
         *   | ETH            | ERC20, ETH   |
         *   ---------------------------------
         * @param {string} networkCode unified network-code
         * @param {string} currencyCode unified currency-code
         * @param {boolean} allowDefault when currencyCode is undefined, order by replacement's "default" instead of by user input
         * @returns {string[]} [preferredChain, alternativeChain]
         */
        if (isTrue(isEqual(networkCode, std::any{})))
        {
            return std::any{};
        }
        std::any replacements = this->safeDict(this->options, std::string("defaultNetworkCodeReplacements"), ccxt::dict {});
        std::any keys = getObjectKeys(replacements);
        for (std::any i = 0; isLessThan(i, getArrayLength(keys)); postFixIncrement(i))
        {
            std::any baseCoin = ::getValue(keys, i);
            std::any entry = ::getValue(replacements, baseCoin);
            std::any primary = ::getValue(entry, std::string("primary"));
            std::any secondary = ::getValue(entry, std::string("secondary"));
            if (isTrue(isTrue(!isEqual(networkCode, primary)) && isTrue(!isEqual(networkCode, secondary))))
            {
                continue;
            }
            // pick which form goes first in the returned pair
            std::any preferPrimary = false;
            if (isTrue(isEqual(currencyCode, baseCoin)))
            {
                preferPrimary = true; // mainnet currency uses primary chain
            } else if (isTrue(!isEqual(currencyCode, std::any{})))
            {
                preferPrimary = false; // any other (token) currency uses secondary chain
            } else if (isTrue(allowDefault))
            {
                preferPrimary = (isEqual(::getValue(entry, std::string("default")), std::string("primary")));
            } else
            {
                preferPrimary = (isEqual(networkCode, primary)); // keep user input first
            }
            return (isTrue((preferPrimary)) ? std::any(ccxt::list{primary, secondary}) : std::any(ccxt::list{secondary, primary}));
        }
        return ccxt::list{networkCode, networkCode};
    }

    virtual std::any networkCodeToId(std::any networkCode, std::any currencyCode = std::any{})
    {
        /**
         * @ignore
         * @method
         * @name exchange#networkCodeToId
         * @description tries to convert the provided networkCode (which is expected to be an unified network code) to a network id. In order to achieve this, derived class needs to have 'options->networks' defined.
         * @param {string} networkCode unified network code
         * @param {string} currencyCode unified currency code, but this argument is not required by default, unless there is an exchange (like huobi) that needs an override of the method to be able to pass currencyCode argument additionally
         * @returns {string|undefined} exchange-specific network id
         */
        if (isTrue(isEqual(networkCode, std::any{})))
        {
            return std::any{};
        }
        std::any networkIdsByCodes = this->safeDict(this->options, std::string("networks"), ccxt::dict {});
        // try the preferred form first, fall back to its alternative (e.g. when only 'ETH' or only 'ERC20' is defined)
        std::any chainPair = this->prioritizedNetworkAliases(networkCode, currencyCode, false);
        std::any preferredChain = (isTrue((isEqual(chainPair, std::any{}))) ? std::any(networkCode) : std::any(::getValue(chainPair, 0)));
        std::any alternativeChain = (isTrue((isEqual(chainPair, std::any{}))) ? std::any(networkCode) : std::any(::getValue(chainPair, 1)));
        std::any networkId = this->safeString2(networkIdsByCodes, preferredChain, alternativeChain);
        if (isTrue(!isEqual(networkId, std::any{})))
        {
            return networkId;
        }
        // fall back to scanning loaded currencies
        std::any currenciesToCheck = ccxt::list{};
        if (isTrue(isEqual(currencyCode, std::any{})))
        {
            currenciesToCheck = getObjectKeys(this->currencies);
        } else
        {
            currenciesToCheck = ccxt::list{this->safeDict(this->currencies, currencyCode)};
        }
        for (std::any i = 0; isLessThan(i, getArrayLength(currenciesToCheck)); postFixIncrement(i))
        {
            std::any networks = this->safeDict(::getValue(currenciesToCheck, i), std::string("networks"), ccxt::dict {});
            if (isTrue(inOp(networks, networkCode)))
            {
                return this->safeString(::getValue(networks, networkCode), std::string("id"));
            }
        }
        // before returning the original input, try to match if it's backward-maintained networkCode
        std::any oldCodes = this->safeDict(this->options, std::string("backwardSupportedNetworkCodes"), ccxt::dict {});
        if (isTrue(inOp(oldCodes, networkCode)))
        {
            return this->networkCodeToId(::getValue(oldCodes, networkCode), currencyCode);
        }
        return networkCode;
    }

    virtual std::any networkIdToCode(std::any networkId = std::any{}, std::any currencyCode = std::any{})
    {
        /**
         * @ignore
         * @method
         * @name exchange#networkIdToCode
         * @description tries to convert the provided exchange-specific networkId to an unified network Code. In order to achieve this, derived class needs to have "options['networksById']" defined.
         * @param {string} networkId exchange specific network id/title, like: TRON, Trc-20, usdt-erc20, etc
         * @param {string|undefined} currencyCode unified currency code, but this argument is not required by default, unless there is an exchange (like huobi) that needs an override of the method to be able to pass currencyCode argument additionally
         * @returns {string|undefined} unified network code
         */
        if (isTrue(isEqual(networkId, std::any{})))
        {
            return std::any{};
        }
        std::any networkCodesByIds = this->safeDict(this->options, std::string("networksById"), ccxt::dict {});
        std::any networkCode = this->safeString(networkCodesByIds, networkId, networkId);
        std::any chainPair = this->prioritizedNetworkAliases(networkCode, currencyCode, true);
        if (isTrue(isEqual(chainPair, std::any{})))
        {
            return networkCode;
        }
        std::any preferredChain = ::getValue(chainPair, 0);
        std::any alternativeChain = ::getValue(chainPair, 1);
        // when the exchange explicitly defines both forms in options.networks (e.g. BTC + BRC20),
        // it disambiguates them — trust the direct id→code inversion instead of guessing
        if (isTrue(isEqual(currencyCode, std::any{})))
        {
            std::any networkIdsByCodes = this->safeDict(this->options, std::string("networks"), ccxt::dict {});
            if (isTrue(isTrue((inOp(networkIdsByCodes, preferredChain))) && isTrue((inOp(networkIdsByCodes, alternativeChain)))))
            {
                return networkCode;
            }
        }
        return preferredChain;
    }

    virtual std::any handleNetworkCodeAndParams(std::any params)
    {
        std::any networkCodeInParams = this->safeString2(params, std::string("networkCode"), std::string("network"));
        if (isTrue(!isEqual(networkCodeInParams, std::any{})))
        {
            params = this->omit(params, ccxt::list{std::string("networkCode"), std::string("network")});
        }
        // if it was not defined by user, we should not set it from 'defaultNetworks', because handleNetworkCodeAndParams is for only request-side and thus we do not fill it with anything. We can only use 'defaultNetworks' after parsing response-side
        return ccxt::list{networkCodeInParams, params};
    }

    virtual std::any defaultNetworkCode(std::any currencyCode)
    {
        std::any defaultNetworkCode = std::any{};
        std::any defaultNetworks = this->safeDict(this->options, std::string("defaultNetworks"), ccxt::dict {});
        if (isTrue(inOp(defaultNetworks, currencyCode)))
        {
            // if currency had set its network in "defaultNetworks", use it
            defaultNetworkCode = ::getValue(defaultNetworks, currencyCode);
        } else
        {
            // otherwise, try to use the global-scope 'defaultNetwork' value (even if that network is not supported by currency, it doesn't make any problem, this will be just used "at first" if currency supports this network at all)
            std::any defaultNetwork = this->safeString(this->options, std::string("defaultNetwork"));
            if (isTrue(!isEqual(defaultNetwork, std::any{})))
            {
                defaultNetworkCode = defaultNetwork;
            }
        }
        return defaultNetworkCode;
    }

