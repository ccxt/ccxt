    virtual std::any parseOrderBook(std::any orderbook, std::any symbol, std::any timestamp = std::any{}, std::any bidsKey = std::string("bids"), std::any asksKey = std::string("asks"), std::any priceKey = 0, std::any amountKey = 1, std::any countOrIdKey = 2)
    {
        if (isTrue(isEqual(orderbook, std::any{})))
        {
            orderbook = ccxt::dict {};
        }
        std::any bids = this->parseOrderBookBidsAsks(this->safeValue(orderbook, bidsKey, ccxt::list{}), priceKey, amountKey, countOrIdKey);
        std::any asks = this->parseOrderBookBidsAsks(this->safeValue(orderbook, asksKey, ccxt::list{}), priceKey, amountKey, countOrIdKey);
        return ccxt::dict {
            { std::string("symbol"), symbol },
            { std::string("bids"), this->sortBy(bids, 0, true) },
            { std::string("asks"), this->sortBy(asks, 0) },
            { std::string("timestamp"), timestamp },
            { std::string("datetime"), this->iso8601(timestamp) },
            { std::string("nonce"), std::any{} },
        };
    }

    virtual std::any parseOHLCVs(std::any ohlcvs, std::any market = std::any{}, std::any timeframe = std::string("1m"), std::any since = std::any{}, std::any limit = std::any{}, std::any tail = false)
    {
        if (isTrue(isEqual(ohlcvs, std::any{})))
        {
            return ccxt::list{};
        }
        std::any results = ccxt::list{};
        for (std::any i = 0; isLessThan(i, getArrayLength(ohlcvs)); postFixIncrement(i))
        {
            arrayPush(results, this->parseOHLCV(::getValue(ohlcvs, i), market));
        }
        std::any sorted = this->sortBy(results, 0);
        return this->filterBySinceLimit(sorted, since, limit, 0, tail);
    }

    virtual std::any parseLeverageTiers(std::any response, std::any symbols = std::any{}, std::any marketIdKey = std::any{})
    {
        // marketIdKey should only be undefined when response is a dictionary.
        symbols = this->marketSymbols(symbols);
        std::any tiers = ccxt::dict {};
        std::any symbolsLength = 0;
        if (isTrue(!isEqual(symbols, std::any{})))
        {
            symbolsLength = getArrayLength(symbols);
        }
        std::any noSymbols = isTrue((isEqual(symbols, std::any{}))) || isTrue((isEqual(symbolsLength, 0)));
        if (isTrue(isArray(response)))
        {
            for (std::any i = 0; isLessThan(i, getArrayLength(response)); postFixIncrement(i))
            {
                std::any item = ::getValue(response, i);
                std::any id = (isTrue((isEqual(marketIdKey, std::any{}))) ? std::any(std::any{}) : std::any(this->safeString(item, marketIdKey)));
                std::any market = this->safeMarket(id, std::any{}, std::any{}, std::string("swap"));
                std::any symbol = ::getValue(market, std::string("symbol"));
                std::any contract = this->safeBool(market, std::string("contract"), false);
                if (isTrue(isTrue((isEqual(contract, true))) && isTrue((isTrue(noSymbols) || isTrue((isTrue((!isEqual(symbols, std::any{}))) && isTrue(this->inArray(symbol, symbols))))))))
                {
                    ::setValue(tiers, symbol, this->parseMarketLeverageTiers(item, market));
                }
            }
        } else
        {
            std::any keys = getObjectKeys(response);
            for (std::any i = 0; isLessThan(i, getArrayLength(keys)); postFixIncrement(i))
            {
                std::any marketId = ::getValue(keys, i);
                std::any item = ::getValue(response, marketId);
                std::any market = this->safeMarket(marketId, std::any{}, std::any{}, std::string("swap"));
                std::any symbol = ::getValue(market, std::string("symbol"));
                std::any contract = this->safeBool(market, std::string("contract"), false);
                if (isTrue(isTrue((isEqual(contract, true))) && isTrue((isTrue(noSymbols) || isTrue((isTrue((!isEqual(symbols, std::any{}))) && isTrue(this->inArray(symbol, symbols))))))))
                {
                    ::setValue(tiers, symbol, this->parseMarketLeverageTiers(item, market));
                }
            }
        }
        return tiers;
    }

    virtual std::shared_future<std::any> loadTradingLimits(std::any symbols = std::any{}, std::any reload = false, std::any params = ccxt::dict {})
    {
        return std::async(std::launch::async, [=]() mutable -> std::any {
            if (isTrue(isTrue(!isEqual(::getValue(this->has, std::string("fetchTradingLimits")), std::any{})) && isTrue(!isEqual(::getValue(this->has, std::string("fetchTradingLimits")), false))))
            {
                if (isTrue(isTrue(reload) || !isTrue((inOp(this->options, std::string("limitsLoaded"))))))
                {
                    std::any response = awaitValue(this->fetchTradingLimits(symbols));
                    std::any symbolsArray = this->requireValue(symbols, std::string("loadTradingLimits() requires a symbols argument"));
                    std::any markets = this->markets;
                    if (isTrue(isEqual(markets, std::any{})))
                    {
                        throw ExchangeError(toString(add(this->id, std::string(" markets not loaded"))));
                    }
                    for (std::any i = 0; isLessThan(i, getArrayLength(symbolsArray)); postFixIncrement(i))
                    {
                        std::any symbol = ::getValue(symbolsArray, i);
                        ::setValue(markets, symbol, this->deepExtend(::getValue(markets, symbol), ::getValue(response, symbol)));
                    }
                    ::setValue(this->options, std::string("limitsLoaded"), this->milliseconds());
                }
            }
            return this->markets;
        }).share();
    }

    virtual std::any safePosition(std::any position)
    {
        // simplified version of: /pull/12765/
        std::any unrealizedPnlString = this->safeString(position, std::string("unrealizedPnl"));
        std::any initialMarginString = this->safeString(position, std::string("initialMargin"));
        //
        // PERCENTAGE
        //
        std::any percentage = this->safeValue(position, std::string("percentage"));
        if (isTrue(isTrue(isTrue((isEqual(percentage, std::any{}))) && isTrue((!isEqual(unrealizedPnlString, std::any{})))) && isTrue((!isEqual(initialMarginString, std::any{})))))
        {
            // as it was done in all implementations ( aax, btcex, bybit, deribit, gate, kucoinfutures, phemex )
            std::any percentageString = ccxt::Precise::stringMul(ccxt::Precise::stringDiv(unrealizedPnlString, initialMarginString, 4), std::string("100"));
            ::setValue(position, std::string("percentage"), this->parseNumber(percentageString));
        }
        // if contractSize is undefined get from market
        std::any contractSize = this->safeNumber(position, std::string("contractSize"));
        std::any symbol = this->safeString(position, std::string("symbol"));
        std::any market = std::any{};
        if (isTrue(!isEqual(symbol, std::any{})))
        {
            market = this->safeValue(this->markets, symbol);
        }
        if (isTrue(isTrue(isEqual(contractSize, std::any{})) && isTrue(!isEqual(market, std::any{}))))
        {
            contractSize = this->safeNumber(market, std::string("contractSize"));
            ::setValue(position, std::string("contractSize"), contractSize);
        }
        return position;
    }

    virtual std::any parsePositions(std::any positions, std::any symbols = std::any{}, std::any params = ccxt::dict {})
    {
        symbols = this->marketSymbols(symbols);
        std::any positionsArray = this->toArray(positions);
        std::any result = ccxt::list{};
        for (std::any i = 0; isLessThan(i, getArrayLength(positionsArray)); postFixIncrement(i))
        {
            std::any position = this->extend(this->parsePosition(::getValue(positionsArray, i)), params);
            arrayPush(result, position);
        }
        return this->filterByArrayPositions(result, std::string("symbol"), symbols, false);
    }

