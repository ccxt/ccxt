    // allowEmpty: false always returns string[] (throws on empty/undefined at runtime)
    virtual std::any marketSymbols(std::any symbols = std::any{}, std::any type = std::any{}, std::any allowEmpty = true, std::any sameTypeOnly = false, std::any sameSubTypeOnly = false)
    {
        /**
         * @param {string[]|undefined} symbols list of unified symbols
         * @param {string|undefined} type filter by market type
         * @param {boolean} allowEmpty whether empty/undefined symbols is allowed
         * @param {boolean} sameTypeOnly require all markets to share type
         * @param {boolean} sameSubTypeOnly require all markets to share linear/inverse subType
         * @returns {string[]|undefined} validated unified symbols
         * Overloads: `allowEmpty: false` or non-null `string[]` input yields `string[]`; permissive form yields `Strings`.
         */
        if (isTrue(isEqual(symbols, std::any{})))
        {
            if (!isTrue(allowEmpty))
            {
                throw ArgumentsRequired(toString(add(this->id, std::string(" empty list of symbols is not supported"))));
            }
            return symbols;
        }
        std::any symbolsLength = getArrayLength(symbols);
        if (isTrue(isEqual(symbolsLength, 0)))
        {
            if (!isTrue(allowEmpty))
            {
                throw ArgumentsRequired(toString(add(this->id, std::string(" empty list of symbols is not supported"))));
            }
            return symbols;
        }
        std::any result = ccxt::list{};
        std::any marketType = std::any{};
        std::any isLinearSubType = std::any{};
        for (std::any i = 0; isLessThan(i, getArrayLength(symbols)); postFixIncrement(i))
        {
            std::any market = this->market(::getValue(symbols, i));
            if (isTrue(isTrue(sameTypeOnly) && isTrue((!isEqual(marketType, std::any{})))))
            {
                if (isTrue(!isEqual(::getValue(market, std::string("type")), marketType)))
                {
                    throw BadRequest(toString(add(add(add(add(add(this->id, std::string(" symbols must be of the same type, either ")), marketType), std::string(" or ")), ::getValue(market, std::string("type"))), std::string("."))));
                }
            }
            if (isTrue(isTrue(sameSubTypeOnly) && isTrue((!isEqual(isLinearSubType, std::any{})))))
            {
                if (isTrue(!isEqual(::getValue(market, std::string("linear")), isLinearSubType)))
                {
                    throw BadRequest(toString(add(this->id, std::string(" symbols must be of the same subType, either linear or inverse."))));
                }
            }
            if (isTrue(isTrue(!isEqual(type, std::any{})) && isTrue(!isEqual(::getValue(market, std::string("type")), type))))
            {
                throw BadRequest(toString(add(add(add(this->id, std::string(" symbols must be of the same type ")), type), std::string(". If the type is incorrect you can change it in options or the params of the request"))));
            }
            marketType = ::getValue(market, std::string("type"));
            if (isTrue(!isEqual(::getValue(market, std::string("spot")), true)))
            {
                isLinearSubType = ::getValue(market, std::string("linear"));
            }
            std::any symbol = this->safeString(market, std::string("symbol"), ::getValue(symbols, i));
            arrayPush(result, symbol);
        }
        return result;
    }

