    virtual std::any parseMarginModifications(std::any response, std::any symbols = std::any{}, std::any symbolKey = std::any{}, std::any marketType = std::any{})
    {
        std::any marginModifications = ccxt::list{};
        if (isTrue(isEqual(response, std::any{})))
        {
            return marginModifications;
        }
        for (std::any i = 0; isLessThan(i, getArrayLength(response)); postFixIncrement(i))
        {
            std::any info = ::getValue(response, i);
            std::any marketId = (isTrue((isEqual(symbolKey, std::any{}))) ? std::any(std::any{}) : std::any(this->safeString(info, symbolKey)));
            std::any market = this->safeMarket(marketId, std::any{}, std::any{}, marketType);
            if (isTrue(isTrue((isEqual(symbols, std::any{}))) || isTrue(this->inArray(::getValue(market, std::string("symbol")), symbols))))
            {
                arrayPush(marginModifications, this->parseMarginModification(info, market));
            }
        }
        return marginModifications;
    }

