    virtual std::any handleTimeInForce(std::any params = ccxt::dict {})
    {
        /**
         * @ignore
         * @method
         * Must add timeInForce to ::getValue(this, std::string("options")) to use this method
         * @returns {string} returns the exchange specific value for timeInForce
         */
        std::any timeInForce = this->safeStringUpper(params, std::string("timeInForce")); // supported values GTC, IOC, PO
        if (isTrue(!isEqual(timeInForce, std::any{})))
        {
            std::any exchangeValue = this->safeString(::getValue(this->options, std::string("timeInForce")), timeInForce);
            if (isTrue(isEqual(exchangeValue, std::any{})))
            {
                throw ExchangeError(toString(add(add(add(this->id, std::string(" does not support timeInForce \"")), timeInForce), std::string("\""))));
            }
            return exchangeValue;
        }
        return std::any{};
    }

    virtual std::any convertTypeToAccount(std::any account)
    {
        /**
         * @ignore
         * @method
         * Must add accountsByType to ::getValue(this, std::string("options")) to use this method
         * @param {string} account key for account name in ::getValue(this, std::string("options"))['accountsByType']
         * @returns the exchange specific account name or the isolated margin id for transfers
         */
        std::any accountsByType = this->safeDict(this->options, std::string("accountsByType"), ccxt::dict {});
        std::any lowercaseAccount = toLowerCase(account);
        if (isTrue(inOp(accountsByType, lowercaseAccount)))
        {
            return ::getValue(accountsByType, lowercaseAccount);
        }
        std::any markets = this->markets;
        std::any marketsById = this->markets_by_id;
        if (isTrue(isTrue((isTrue((!isEqual(markets, std::any{}))) && isTrue((inOp(markets, account))))) || isTrue((isTrue((!isEqual(marketsById, std::any{}))) && isTrue((inOp(marketsById, account)))))))
        {
            std::any market = this->market(account);
            return ::getValue(market, std::string("id"));
        } else
        {
            return account;
        }
    }

    virtual void checkRequiredArgument(std::any methodName, std::any argument, std::any argumentName, std::any options = ccxt::list{})
    {
        /**
         * @ignore
         * @method
         * @param {string} methodName the name of the method that the argument is being checked for
         * @param {string} argument the argument's actual value provided
         * @param {string} argumentName the name of the argument being checked (for logging purposes)
         * @param {string[]} options a list of options that the argument can be
         * @returns {undefined}
         */
        std::any optionsLength = getArrayLength(options);
        if (isTrue(isTrue((isEqual(argument, std::any{}))) || isTrue((isTrue((isGreaterThan(optionsLength, 0))) && isTrue((!isTrue((this->inArray(argument, options)))))))))
        {
            std::any messageOptions = join(options, std::string(", "));
            std::any message = add(add(add(add(add(this->id, std::string(" ")), methodName), std::string("() requires a ")), argumentName), std::string(" argument"));
            if (isTrue(!isEqual(messageOptions, std::string(""))))
            {
                message = add(message, add(add(add(std::string(", one of "), std::string("(")), messageOptions), std::string(")")));
            }
            throw ArgumentsRequired(toString(message));
        }
    }

    virtual void checkRequiredMarginArgument(std::any methodName, std::any symbol, std::any marginMode)
    {
        /**
         * @ignore
         * @method
         * @param {string} symbol unified symbol of the market
         * @param {string} methodName name of the method that requires a symbol
         * @param {string} marginMode is either 'isolated' or 'cross'
         */
        if (isTrue(isTrue((isEqual(marginMode, std::string("isolated")))) && isTrue((isEqual(symbol, std::any{})))))
        {
            throw ArgumentsRequired(toString(add(add(add(this->id, std::string(" ")), methodName), std::string("() requires a symbol argument for isolated margin"))));
        } else if (isTrue(isTrue((isEqual(marginMode, std::string("cross")))) && isTrue((!isEqual(symbol, std::any{})))))
        {
            throw ArgumentsRequired(toString(add(add(add(this->id, std::string(" ")), methodName), std::string("() cannot have a symbol argument for cross margin"))));
        }
    }

    virtual std::any parseDepositWithdrawFees(std::any response, std::any codes = std::any{}, std::any currencyIdKey = std::any{})
    {
        /**
         * @ignore
         * @method
         * @param {object[]|object} response unparsed response from the exchange
         * @param {string[]|undefined} codes the unified currency codes to fetch transactions fees for, returns all currencies when undefined
         * @param {str} currencyIdKey *should only be undefined when response is a dictionary* the object key that corresponds to the currency id
         * @returns {object} objects with withdraw and deposit fees, indexed by currency codes
         */
        std::any depositWithdrawFees = ccxt::dict {};
        std::any isArray = ::isArray(response);
        std::any responseKeys = response;
        if (!isTrue(isArray))
        {
            responseKeys = getObjectKeys(response);
        }
        for (std::any i = 0; isLessThan(i, getArrayLength(responseKeys)); postFixIncrement(i))
        {
            std::any entry = ::getValue(responseKeys, i);
            std::any dictionary = (isTrue(isArray) ? std::any(entry) : std::any(::getValue(response, entry)));
            std::any currencyId = entry;
            if (isTrue(isArray))
            {
                currencyId = (isTrue((isEqual(currencyIdKey, std::any{}))) ? std::any(std::any{}) : std::any(this->safeString(dictionary, currencyIdKey)));
            }
            std::any currency = this->safeCurrency(currencyId);
            std::any code = this->safeString(currency, std::string("code"));
            if (isTrue(isTrue((isEqual(codes, std::any{}))) || isTrue((this->inArray(code, codes)))))
            {
                ::setValue(depositWithdrawFees, code, this->parseDepositWithdrawFee(dictionary, currency));
            }
        }
        return depositWithdrawFees;
    }

