    virtual std::any handleParamBool2(std::any params, std::any paramName1, std::any paramName2, std::any defaultValue = std::any{})
    {
        std::any value = this->safeBool2(params, paramName1, paramName2, defaultValue);
        if (isTrue(!isEqual(value, std::any{})))
        {
            params = this->omit(params, ccxt::list{paramName1, paramName2});
        }
        return ccxt::list{value, params};
    }

    /**
     * @param {object} params - extra parameters
     * @param {object} request - existing dictionary of request
     * @param {string} exchangeSpecificKey - the key for chain id to be set in request
     * @param {object} currencyCode - (optional) existing dictionary of request
     * @param {boolean} isRequired - (optional) whether that param is required to be present
     * @returns {object[]} - returns [request, params] where request is the modified request object and params is the modified params object
     */
    virtual std::any handleRequestNetwork(std::any params, std::any request, std::any exchangeSpecificKey, std::any currencyCode = std::any{}, std::any isRequired = false)
    {
        std::any networkCode = std::any{};
        std::any networkCodeparamsVariable = this->handleNetworkCodeAndParams(params);
        networkCode = ::getValue(networkCodeparamsVariable, 0);
        params = ::getValue(networkCodeparamsVariable, 1);
        if (isTrue(!isEqual(networkCode, std::any{})))
        {
            ::setValue(request, exchangeSpecificKey, this->networkCodeToId(networkCode, currencyCode));
        } else if (isTrue(isRequired))
        {
            throw ArgumentsRequired(toString(add(this->id, std::string(" - \"network\" param is required for this request"))));
        }
        return ccxt::list{request, params};
    }

