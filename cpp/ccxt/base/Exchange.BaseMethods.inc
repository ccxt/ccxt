    virtual void cleanUnsubscription(std::any client, std::any subHash, std::any unsubHash, std::any subHashIsPrefix = false)
    {
        if (isTrue(isTrue((!isEqual(unsubHash, std::any{}))) && isTrue((inOp(::getValue(client, std::string("subscriptions")), unsubHash)))))
        {
            deleteKey(::getValue(client, std::string("subscriptions")), unsubHash);
        }
        if (!isTrue(subHashIsPrefix))
        {
            if (isTrue(isTrue((!isEqual(subHash, std::any{}))) && isTrue((inOp(::getValue(client, std::string("subscriptions")), subHash)))))
            {
                deleteKey(::getValue(client, std::string("subscriptions")), subHash);
            }
            if (isTrue(isTrue((!isEqual(subHash, std::any{}))) && isTrue((inOp(::getValue(client, std::string("futures")), subHash)))))
            {
                UnsubscribeError error = UnsubscribeError(add(add(this->id, std::string(" ")), subHash));
                this->reject(error, subHash);
            }
        } else
        {
            std::any clientSubscriptions = getObjectKeys(::getValue(client, std::string("subscriptions")));
            for (std::any i = 0; isLessThan(i, getArrayLength(clientSubscriptions)); postFixIncrement(i))
            {
                std::any sub = ::getValue(clientSubscriptions, i);
                if (isTrue(isTrue(isTrue((!isEqual(sub, std::any{}))) && isTrue((!isEqual(subHash, std::any{})))) && isTrue(startsWith(sub, subHash))))
                {
                    deleteKey(::getValue(client, std::string("subscriptions")), sub);
                }
            }
            std::any clientFutures = getObjectKeys(::getValue(client, std::string("futures")));
            for (std::any i = 0; isLessThan(i, getArrayLength(clientFutures)); postFixIncrement(i))
            {
                std::any future = ::getValue(clientFutures, i);
                if (isTrue(isTrue(isTrue((!isEqual(future, std::any{}))) && isTrue((!isEqual(subHash, std::any{})))) && isTrue(startsWith(future, subHash))))
                {
                    UnsubscribeError error = UnsubscribeError(add(add(this->id, std::string(" ")), future));
                    this->reject(error, future);
                }
            }
        }
        this->resolve(true, unsubHash);
    }

    virtual void cleanCache(std::any subscription)
    {
        std::any topic = this->safeString(subscription, std::string("topic"));
        std::any symbols = this->safeList(subscription, std::string("symbols"), ccxt::list{});
        std::any symbolsLength = getArrayLength(symbols);
        if (isTrue(isEqual(topic, std::string("ohlcv"))))
        {
            std::any symbolsAndTimeframes = this->safeList(subscription, std::string("symbolsAndTimeframes"), ccxt::list{});
            for (std::any i = 0; isLessThan(i, getArrayLength(symbolsAndTimeframes)); postFixIncrement(i))
            {
                std::any symbolAndTimeFrame = ::getValue(symbolsAndTimeframes, i);
                std::any symbol = this->safeString(symbolAndTimeFrame, 0);
                std::any timeframe = this->safeString(symbolAndTimeFrame, 1);
                if (isTrue(isEqual(symbol, std::any{})))
                {
                    throw ArgumentsRequired(toString(add(this->id, std::string(" cleanCache() requires a symbol argument"))));
                }
                if (isTrue(isEqual(timeframe, std::any{})))
                {
                    throw ArgumentsRequired(toString(add(this->id, std::string(" cleanCache() requires a timeframe argument"))));
                }
                if (isTrue(isTrue((!isEqual(this->ohlcvs, std::any{}))) && isTrue((inOp(this->ohlcvs, symbol)))))
                {
                    if (isTrue(inOp(::getValue(this->ohlcvs, symbol), timeframe)))
                    {
                        deleteKey(::getValue(this->ohlcvs, symbol), timeframe);
                    }
                }
            }
        } else if (isTrue(isGreaterThan(symbolsLength, 0)))
        {
            for (std::any i = 0; isLessThan(i, getArrayLength(symbols)); postFixIncrement(i))
            {
                std::any symbol = ::getValue(symbols, i);
                if (isTrue(isEqual(topic, std::string("trades"))))
                {
                    if (isTrue(inOp(this->trades, symbol)))
                    {
                        deleteKey(this->trades, symbol);
                    }
                } else if (isTrue(isEqual(topic, std::string("orderbook"))))
                {
                    if (isTrue(inOp(this->orderbooks, symbol)))
                    {
                        deleteKey(this->orderbooks, symbol);
                    }
                } else if (isTrue(isEqual(topic, std::string("ticker"))))
                {
                    if (isTrue(inOp(this->tickers, symbol)))
                    {
                        deleteKey(this->tickers, symbol);
                    }
                } else if (isTrue(isEqual(topic, std::string("bidsasks"))))
                {
                    if (isTrue(inOp(this->bidsasks, symbol)))
                    {
                        deleteKey(this->bidsasks, symbol);
                    }
                }
            }
        } else
        {
            if (isTrue(isTrue(isEqual(topic, std::string("myTrades"))) && isTrue((!isEqual(this->myTrades, std::any{})))))
            {
                this->myTrades = std::any{};
            } else if (isTrue(isTrue(isEqual(topic, std::string("orders"))) && isTrue((!isEqual(this->orders, std::any{})))))
            {
                this->orders = std::any{};
            } else if (isTrue(isTrue(isEqual(topic, std::string("positions"))) && isTrue((!isEqual(this->positions, std::any{})))))
            {
                this->positions = std::any{};
                std::any clients = getObjectValues(this->clients);
                for (std::any i = 0; isLessThan(i, getArrayLength(clients)); postFixIncrement(i))
                {
                    std::any client = ::getValue(clients, i);
                    std::any futures = ::getValue(client, std::string("futures"));
                    if (isTrue(isTrue((!isEqual(futures, std::any{}))) && isTrue((inOp(futures, std::string("fetchPositionsSnapshot"))))))
                    {
                        deleteKey(futures, std::string("fetchPositionsSnapshot"));
                    }
                }
            } else if (isTrue(isTrue((isTrue(isEqual(topic, std::string("ticker"))) || isTrue(isEqual(topic, std::string("markPrice"))))) && isTrue((!isEqual(this->tickers, std::any{})))))
            {
                std::any tickerSymbols = getObjectKeys(this->tickers);
                for (std::any i = 0; isLessThan(i, getArrayLength(tickerSymbols)); postFixIncrement(i))
                {
                    std::any tickerSymbol = ::getValue(tickerSymbols, i);
                    if (isTrue(inOp(this->tickers, tickerSymbol)))
                    {
                        deleteKey(this->tickers, tickerSymbol);
                    }
                }
            } else if (isTrue(isTrue(isEqual(topic, std::string("bidsasks"))) && isTrue((!isEqual(this->bidsasks, std::any{})))))
            {
                std::any bidsaskSymbols = getObjectKeys(this->bidsasks);
                for (std::any i = 0; isLessThan(i, getArrayLength(bidsaskSymbols)); postFixIncrement(i))
                {
                    std::any bidsaskSymbol = ::getValue(bidsaskSymbols, i);
                    if (isTrue(inOp(this->bidsasks, bidsaskSymbol)))
                    {
                        deleteKey(this->bidsasks, bidsaskSymbol);
                    }
                }
            }
        }
    }

    virtual std::any timeframeFromMilliseconds(std::any ms)
    {
        if (isTrue(isLessThanOrEqual(ms, 0)))
        {
            return std::string("");
        }
        std::any second = 1000;
        std::any minute = multiply(60, second);
        std::any hour = multiply(60, minute);
        std::any day = multiply(24, hour);
        std::any week = multiply(7, day);
        if (isTrue(isEqual(mod(ms, week), 0)))
        {
            return add((divide(ms, week)), std::string("w"));
        }
        if (isTrue(isEqual(mod(ms, day), 0)))
        {
            return add((divide(ms, day)), std::string("d"));
        }
        if (isTrue(isEqual(mod(ms, hour), 0)))
        {
            return add((divide(ms, hour)), std::string("h"));
        }
        if (isTrue(isEqual(mod(ms, minute), 0)))
        {
            return add((divide(ms, minute)), std::string("m"));
        }
        if (isTrue(isEqual(mod(ms, second), 0)))
        {
            return add((divide(ms, second)), std::string("s"));
        }
        return std::string("");
    }

