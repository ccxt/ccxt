    virtual std::any currencyToPrecision(std::any code, std::any fee, std::any networkCode = std::any{})
    {
        if (isTrue(isEqual(code, std::any{})))
        {
            throw ArgumentsRequired(toString(add(this->id, std::string(" currencyToPrecision() requires a code argument"))));
        }
        std::any currency = ::getValue(this->currencies, code);
        std::any precision = this->safeValue(currency, std::string("precision"));
        if (isTrue(!isEqual(networkCode, std::any{})))
        {
            std::any networks = this->safeDict(currency, std::string("networks"), ccxt::dict {});
            std::any networkItem = this->safeDict(networks, networkCode, ccxt::dict {});
            precision = this->safeValue(networkItem, std::string("precision"), precision);
        }
        if (isTrue(isEqual(precision, std::any{})))
        {
            return this->forceString(fee);
        } else
        {
            std::any roundingMode = this->safeInteger(this->options, std::string("currencyToPrecisionRoundingMode"), ROUND);
            return this->decimalToPrecision(fee, roundingMode, precision, this->precisionMode, this->paddingMode);
        }
    }

