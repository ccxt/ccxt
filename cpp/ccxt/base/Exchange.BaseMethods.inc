    virtual std::any getListFromObjectValues(std::any objects, std::any key)
    {
        std::any newArray = objects;
        if (!isTrue(isArray(objects)))
        {
            newArray = this->toArray(objects);
        }
        std::any results = ccxt::list{};
        for (std::any i = 0; isLessThan(i, getArrayLength(newArray)); postFixIncrement(i))
        {
            arrayPush(results, ::getValue(::getValue(newArray, i), key));
        }
        return results;
    }

    virtual std::any getSymbolsForMarketType(std::any marketType = std::any{}, std::any subType = std::any{}, std::any symbolWithActiveStatus = true, std::any symbolWithUnknownStatus = true)
    {
        std::any filteredMarkets = this->markets;
        if (isTrue(!isEqual(marketType, std::any{})))
        {
            filteredMarkets = this->filterBy(filteredMarkets, std::string("type"), marketType);
        }
        if (isTrue(!isEqual(subType, std::any{})))
        {
            this->checkRequiredArgument(std::string("getSymbolsForMarketType"), subType, std::string("subType"), ccxt::list{std::string("linear"), std::string("inverse"), std::string("quanto")});
            filteredMarkets = this->filterBy(filteredMarkets, std::string("subType"), subType);
        }
        std::any activeStatuses = ccxt::list{};
        if (isTrue(symbolWithActiveStatus))
        {
            arrayPush(activeStatuses, true);
        }
        if (isTrue(symbolWithUnknownStatus))
        {
            arrayPush(activeStatuses, std::any{});
        }
        filteredMarkets = this->filterByArray(filteredMarkets, std::string("active"), activeStatuses, false);
        return this->getListFromObjectValues(filteredMarkets, std::string("symbol"));
    }

    virtual std::any filterByArray(std::any objects, std::any key, std::any values = std::any{}, std::any indexed = true)
    {
        objects = this->toArray(objects);
        // return all of them if no values were passed
        if (isTrue(isTrue(isTrue(isTrue(isTrue((isEqual(values, std::any{}))) || isTrue((isEqual(values, null)))) || isTrue((isEqual(values, false)))) || isTrue((isEqual(values, 0)))) || isTrue((isEqual(values, std::string(""))))))
        {
            // return indexed ? this.indexBy (objects, key) : objects;
            if (isTrue(indexed))
            {
                return this->indexBy(objects, key);
            } else
            {
                return objects;
            }
        }
        std::any results = ccxt::list{};
        for (std::any i = 0; isLessThan(i, getArrayLength(objects)); postFixIncrement(i))
        {
            if (isTrue(this->inArray(::getValue(::getValue(objects, i), key), values)))
            {
                arrayPush(results, ::getValue(objects, i));
            }
        }
        // return indexed ? this.indexBy (results, key) : results;
        if (isTrue(indexed))
        {
            return this->indexBy(results, key);
        }
        return results;
    }

    virtual std::any filterOutByArray(std::any objects, std::any key, std::any values = std::any{}, std::any indexed = true)
    {
        objects = this->toArray(objects);
        // return all of them if no values were passed
        if (isTrue(isTrue(isTrue(isTrue(isTrue((isEqual(values, std::any{}))) || isTrue((isEqual(values, null)))) || isTrue((isEqual(values, false)))) || isTrue((isEqual(values, 0)))) || isTrue((isEqual(values, std::string(""))))))
        {
            // return indexed ? this.indexBy (objects, key) : objects;
            if (isTrue(indexed))
            {
                return this->indexBy(objects, key);
            } else
            {
                return objects;
            }
        }
        std::any results = ccxt::list{};
        for (std::any i = 0; isLessThan(i, getArrayLength(objects)); postFixIncrement(i))
        {
            if (!isTrue(this->inArray(::getValue(::getValue(objects, i), key), values)))
            {
                arrayPush(results, ::getValue(objects, i));
            }
        }
        // return indexed ? this.indexBy (results, key) : results;
        if (isTrue(indexed))
        {
            return this->indexBy(results, key);
        }
        return results;
    }

    virtual std::shared_future<std::any> fetch2(std::any path, std::any api = std::string("public"), std::any method = std::string("GET"), std::any params = ccxt::dict {}, std::any headers = std::any{}, std::any body = std::any{}, std::any config = ccxt::dict {})
    {
        return std::async(std::launch::async, [=]() mutable -> std::any {
            if (isTrue(this->enableRateLimit))
            {
                std::any cost = this->calculateRateLimiterCost(api, method, path, params, config);
                awaitValue(this->throttle(cost));
            }
            std::any retries = 0;
            std::any retriesparamsVariable = this->handleOptionAndParams(params, path, std::string("maxRetriesOnFailure"), retries);
            retries = ::getValue(retriesparamsVariable, 0);
            params = ::getValue(retriesparamsVariable, 1);
            std::any retryDelay = 0;
            std::any retryDelayparamsVariable = this->handleOptionAndParams(params, path, std::string("maxRetriesOnFailureDelay"), retryDelay);
            retryDelay = ::getValue(retryDelayparamsVariable, 0);
            params = ::getValue(retryDelayparamsVariable, 1);
            std::any fetchData = std::any{};
            std::any fetchDataCacheEnabled = isGreaterThan(this->fetchHistoryCacheSize, 0);
            for (std::any i = 0; isLessThan(i, add(retries, 1)); postFixIncrement(i))
            {
                if (isTrue(fetchDataCacheEnabled))
                {
                    fetchData = ccxt::dict {
                        { std::string("request"), std::any{} },
                        { std::string("response"), ccxt::dict {
                            { std::string("body"), std::any{} },
                        } },
                        { std::string("error"), std::any{} },
                    };
                }
                try
                {
                    this->setLastRestRequestTimestamp();
                    std::any request = this->sign(path, api, method, params, headers, body);
                    if (isTrue(isTrue(fetchDataCacheEnabled) && isTrue((!isEqual(fetchData, std::any{})))))
                    {
                        ::setValue(fetchData, std::string("request"), request);
                    }
                    this->setLastRequest(request);
                    std::any response = awaitValue(this->fetch(::getValue(request, std::string("url")), ::getValue(request, std::string("method")), ::getValue(request, std::string("headers")), ::getValue(request, std::string("body"))));
                    if (isTrue(isTrue(fetchDataCacheEnabled) && isTrue((!isEqual(fetchData, std::any{})))))
                    {
                        ::setValue(::getValue(fetchData, std::string("response")), std::string("body"), response);
                        this->addFetchCache(fetchData);
                    }
                    return response;
                } catch(const std::exception& e)
                {
                    if (isTrue(isTrue(fetchDataCacheEnabled) && isTrue((!isEqual(fetchData, std::any{})))))
                    {
                        ::setValue(fetchData, std::string("error"), e);
                        this->addFetchCache(fetchData);
                    }
                    if (isTrue(isInstanceOf<OperationFailed>(e)))
                    {
                        if (isTrue(isLessThan(i, retries)))
                        {
                            if (isTrue(this->verbose))
                            {
                                std::any index = add(i, 1);
                                this->log(add(add(add(add(add(add(std::string("Request failed with the error: "), toString(e)), std::string(", retrying ")), toString(index)), std::string(" of ")), toString(retries)), std::string("...")));
                            }
                            if (isTrue(isTrue((!isEqual(retryDelay, std::any{}))) && isTrue((!isEqual(retryDelay, 0)))))
                            {
                                awaitValue(this->sleep(retryDelay));
                            }
                        } else
                        {
                            throw e;
                        }
                    } else
                    {
                        throw e;
                    }
                }
            }
            return std::any{};  // this line is never reached, but exists for c# value return requirement
        }).share();
    }

    virtual std::shared_future<std::any> request(std::any path, std::any api = std::string("public"), std::any method = std::string("GET"), std::any params = ccxt::dict {}, std::any headers = std::any{}, std::any body = std::any{}, std::any config = ccxt::dict {})
    {
        return std::async(std::launch::async, [=]() mutable -> std::any {
            return awaitValue(this->fetch2(path, api, method, params, headers, body, config));
        }).share();
    }

    virtual std::shared_future<std::any> loadAccounts(std::any reload = false, std::any params = ccxt::dict {})
    {
        return std::async(std::launch::async, [=]() mutable -> std::any {
            if (isTrue(reload))
            {
                this->accounts = awaitValue(this->fetchAccounts(params));
            } else
            {
                if (isTrue(!isEqual(this->accounts, std::any{})))
                {
                    return this->accounts;
                } else
                {
                    this->accounts = awaitValue(this->fetchAccounts(params));
                }
            }
            this->accountsById = this->indexBy(this->accounts, std::string("id"));
            return this->accounts;
        }).share();
    }

    virtual std::any buildOHLCVC(std::any trades, std::any timeframe = std::string("1m"), std::any since = 0, std::any limit = 2147483647)
    {
        // given a sorted arrays of trades (recent last) and a timeframe builds an array of OHLCV candles
        // note, default limit value (2147483647) is max int32 value
        std::any ms = multiply(this->parseTimeframe(timeframe), 1000);
        std::any ohlcvs = ccxt::list{};
        std::any i_timestamp = 0;
        // const open = 1;
        std::any i_high = 2;
        std::any i_low = 3;
        std::any i_close = 4;
        std::any i_volume = 5;
        std::any i_count = 6;
        std::any tradesLength = getArrayLength(trades);
        std::any oldest = mathMin(tradesLength, limit);
        std::any options = this->safeDict(this->options, std::string("buildOHLCVC"), ccxt::dict {});
        std::any skipZeroPrices = this->safeBool(options, std::string("skipZeroPrices"), true);
        for (std::any i = 0; isLessThan(i, oldest); postFixIncrement(i))
        {
            std::any trade = ::getValue(trades, i);
            std::any ts = ::getValue(trade, std::string("timestamp"));
            std::any price = ::getValue(trade, std::string("price"));
            if (isTrue(isTrue((isEqual(ts, std::any{}))) || isTrue((isEqual(price, std::any{})))))
            {
                continue;
            }
            if (isTrue(isLessThan(ts, since)))
            {
                continue;
            }
            if (isTrue(isEqual(ts, std::any{})))
            {
                throw ExchangeError(toString(add(this->id, std::string(" buildOHLCVC() missing ts"))));
            }
            std::any openingTime = multiply(mathFloor(divide(ts, ms)), ms); // shift to the edge of m/h/d (but not M)
            if (isTrue(isLessThan(openingTime, since)))
            {
                continue;
            }
            std::any ohlcv_length = getArrayLength(ohlcvs);
            std::any candle = subtract(ohlcv_length, 1);
            if (isTrue(isEqual(price, std::any{})))
            {
                throw ArgumentsRequired(toString(add(this->id, std::string(" buildOHLCVC() requires a price argument"))));
            }
            if (isTrue(isTrue(isTrue((isEqual(skipZeroPrices, true))) && !isTrue((isGreaterThan(price, 0)))) && !isTrue((isLessThan(price, 0)))))
            {
                continue;
            }
            std::any isFirstCandle = isEqual(candle, -1);
            if (isTrue(isTrue(isFirstCandle) || isTrue(isGreaterThanOrEqual(openingTime, this->sum(::getValue(::getValue(ohlcvs, candle), i_timestamp), ms)))))
            {
                // moved to a new timeframe -> create a new candle from opening trade
                arrayPush(ohlcvs, ccxt::list{openingTime, price, price, price, price, ::getValue(trade, std::string("amount")), 1});
            } else
            {
                // still processing the same timeframe -> update opening trade
                std::any prevHigh = ::getValue(::getValue(ohlcvs, candle), i_high);
                std::any prevLow = ::getValue(::getValue(ohlcvs, candle), i_low);
                std::any prevHighValue = (isTrue((isEqual(prevHigh, std::any{}))) ? std::any(price) : std::any(prevHigh));
                std::any prevLowValue = (isTrue((isEqual(prevLow, std::any{}))) ? std::any(price) : std::any(prevLow));
                ::setValue(::getValue(ohlcvs, candle), i_high, mathMax(prevHighValue, price));
                ::setValue(::getValue(ohlcvs, candle), i_low, mathMin(prevLowValue, price));
                ::setValue(::getValue(ohlcvs, candle), i_close, price);
                ::setValue(::getValue(ohlcvs, candle), i_volume, this->sum(::getValue(::getValue(ohlcvs, candle), i_volume), ::getValue(trade, std::string("amount"))));
                ::setValue(::getValue(ohlcvs, candle), i_count, this->sum(::getValue(::getValue(ohlcvs, candle), i_count), 1));
            }
        }
        return ohlcvs;
    }

    virtual std::any parseTradingViewOHLCV(std::any ohlcvs, std::any market = std::any{}, std::any timeframe = std::string("1m"), std::any since = std::any{}, std::any limit = std::any{})
    {
        std::any result = this->convertTradingViewToOHLCV(ohlcvs);
        return this->parseOHLCVs(result, market, timeframe, since, limit);
    }

