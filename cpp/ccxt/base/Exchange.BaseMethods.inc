    virtual std::any selectNetworkKeyFromNetworks(std::any currencyCode, std::any networkCode, std::any indexedNetworkEntries, std::any isIndexedByUnifiedNetworkCode = false)
    {
        // this method is used against raw & unparse network entries, which are just indexed by network id
        std::any chosenNetworkId = std::any{};
        std::any availableNetworkIds = getObjectKeys(indexedNetworkEntries);
        std::any responseNetworksLength = getArrayLength(availableNetworkIds);
        if (isTrue(!isEqual(networkCode, std::any{})))
        {
            if (isTrue(isEqual(responseNetworksLength, 0)))
            {
                throw NotSupported(toString(add(add(add(add(this->id, std::string(" - ")), networkCode), std::string(" network did not return any result for ")), currencyCode)));
            } else
            {
                // if networkCode was provided by user, we should check it after response, as the referenced exchange doesn't support network-code during request
                std::any networkIdOrCode = (isTrue(isIndexedByUnifiedNetworkCode) ? std::any(networkCode) : std::any(this->networkCodeToId(networkCode, currencyCode)));
                if (isTrue(inOp(indexedNetworkEntries, networkIdOrCode)))
                {
                    chosenNetworkId = networkIdOrCode;
                } else
                {
                    throw NotSupported(toString(add(add(add(add(add(add(this->id, std::string(" - ")), networkIdOrCode), std::string(" network was not found for ")), currencyCode), std::string(", use one of ")), join(availableNetworkIds, std::string(", ")))));
                }
            }
        } else
        {
            if (isTrue(isEqual(responseNetworksLength, 0)))
            {
                throw NotSupported(toString(add(add(this->id, std::string(" - no networks were returned for ")), currencyCode)));
            } else
            {
                // if networkCode was not provided by user, then we try to use the default network (if it was defined in "defaultNetworks"), otherwise, we just return the first network entry
                std::any defaultNetworkCode = this->defaultNetworkCode(currencyCode);
                std::any defaultNetworkId = (isTrue(isIndexedByUnifiedNetworkCode) ? std::any(defaultNetworkCode) : std::any(this->networkCodeToId(defaultNetworkCode, currencyCode)));
                if (isTrue(isEqual(defaultNetworkId, std::any{})))
                {
                    throw ExchangeError(toString(add(this->id, std::string(" selectNetworkKeyFromNetworks() missing defaultNetworkId"))));
                }
                if (isTrue(inOp(indexedNetworkEntries, defaultNetworkId)))
                {
                    return defaultNetworkId;
                }
                throw NotSupported(toString(add(add(this->id, std::string(" - can not determine the default network, please pass param[\"network\"] one from : ")), join(availableNetworkIds, std::string(", ")))));
            }
        }
        return chosenNetworkId;
    }

    virtual std::any safeNumber2(std::any dictionary, std::any key1, std::any key2, std::any d = std::any{})
    {
        std::any value = this->safeString2(dictionary, key1, key2);
