    virtual std::any parseConversions(std::any conversions, std::any code = std::any{}, std::any fromCurrencyKey = std::any{}, std::any toCurrencyKey = std::any{}, std::any since = std::any{}, std::any limit = std::any{}, std::any params = ccxt::dict {})
    {
        std::any conversionsArray = this->toArray(conversions);
        std::any result = ccxt::list{};
        std::any fromCurrency = std::any{};
        std::any toCurrency = std::any{};
        for (std::any i = 0; isLessThan(i, getArrayLength(conversionsArray)); postFixIncrement(i))
        {
            std::any entry = ::getValue(conversionsArray, i);
            std::any fromId = (isTrue((isEqual(fromCurrencyKey, std::any{}))) ? std::any(std::any{}) : std::any(this->safeString(entry, fromCurrencyKey)));
            std::any toId = (isTrue((isEqual(toCurrencyKey, std::any{}))) ? std::any(std::any{}) : std::any(this->safeString(entry, toCurrencyKey)));
            if (isTrue(!isEqual(fromId, std::any{})))
            {
                fromCurrency = this->safeCurrency(fromId);
            }
            if (isTrue(!isEqual(toId, std::any{})))
            {
                toCurrency = this->safeCurrency(toId);
            }
            std::any conversion = this->extend(this->parseConversion(entry, fromCurrency, toCurrency), params);
            arrayPush(result, conversion);
        }
        std::any sorted = this->sortBy(result, std::string("timestamp"));
        std::any currency = std::any{};
        if (isTrue(!isEqual(code, std::any{})))
        {
            currency = this->safeCurrency(code);
            if (isTrue(isEqual(currency, std::any{})))
            {
                throw ExchangeError(toString(add(this->id, std::string(" parseConversions() could not resolve currency"))));
            }
            code = ::getValue(currency, std::string("code"));
        }
        if (isTrue(isEqual(code, std::any{})))
        {
            return this->filterBySinceLimit(sorted, since, limit);
        }
        std::any fromConversion = this->filterBy(sorted, std::string("fromCurrency"), code);
        std::any toConversion = this->filterBy(sorted, std::string("toCurrency"), code);
        std::any both = this->arrayConcat(fromConversion, toConversion);
        return this->filterBySinceLimit(both, since, limit);
    }

