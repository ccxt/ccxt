    virtual std::any isLeveragedCurrency(std::any currencyCode, std::any checkBaseCoin = false, std::any existingCurrencies = std::any{})
    {
        std::any leverageSuffixes = ccxt::list{std::string("2L"), std::string("2S"), std::string("3L"), std::string("3S"), std::string("4L"), std::string("4S"), std::string("5L"), std::string("5S"), std::string("UP"), std::string("DOWN"), std::string("BULL"), std::string("BEAR")};
        for (std::any i = 0; isLessThan(i, getArrayLength(leverageSuffixes)); postFixIncrement(i))
        {
            std::any leverageSuffix = ::getValue(leverageSuffixes, i);
            std::any endsWithSuffix = endsWith(currencyCode, leverageSuffix);
            if (isTrue(endsWithSuffix))
            {
                if (!isTrue(checkBaseCoin))
                {
                    return true;
                } else
                {
                    // check if base currency is inside dict
                    std::any baseCurrencyCode = replace(currencyCode, leverageSuffix, std::string(""));
                    if (isTrue(isTrue((!isEqual(existingCurrencies, std::any{}))) && isTrue((inOp(existingCurrencies, baseCurrencyCode)))))
                    {
                        return true;
                    }
                }
            }
        }
        return false;
    }

