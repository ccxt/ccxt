    virtual std::shared_future<std::any> fetchDepositAddress(std::any code, std::any params = ccxt::dict {})
    {
        return std::async(std::launch::async, [=]() mutable -> std::any {
            if (isTrue(isTrue(!isEqual(::getValue(this->has, std::string("fetchDepositAddresses")), std::any{})) && isTrue(!isEqual(::getValue(this->has, std::string("fetchDepositAddresses")), false))))
            {
                std::any depositAddresses = awaitValue(this->fetchDepositAddresses(ccxt::list{code}, params));
                std::any depositAddress = this->safeValue(depositAddresses, code);
                if (isTrue(isEqual(depositAddress, std::any{})))
                {
                    throw InvalidAddress(toString(add(add(add(this->id, std::string(" fetchDepositAddress() could not find a deposit address for ")), code), std::string(", make sure you have created a corresponding deposit address in your wallet on the exchange website"))));
                } else
                {
                    return depositAddress;
                }
            } else if (isTrue(isTrue(!isEqual(::getValue(this->has, std::string("fetchDepositAddressesByNetwork")), std::any{})) && isTrue(!isEqual(::getValue(this->has, std::string("fetchDepositAddressesByNetwork")), false))))
            {
                std::any network = this->safeString(params, std::string("network"));
                params = this->omit(params, std::string("network"));
                std::any addressStructures = awaitValue(this->fetchDepositAddressesByNetwork(code, params));
                if (isTrue(!isEqual(network, std::any{})))
                {
                    return this->safeDict(addressStructures, network);
                } else
                {
                    std::any keys = getObjectKeys(addressStructures);
                    std::any key = ::getValue(keys, 0);
                    return this->safeDict(addressStructures, key);
                }
            } else
            {
                throw NotSupported(toString(add(this->id, std::string(" fetchDepositAddress() is not supported yet"))));
            }
            return std::any{};
        }).share();
    }

