    virtual std::any safeLedgerEntry(std::any entry, std::any currency = std::any{})
    {
        currency = this->safeCurrency(std::any{}, currency);
        std::any direction = this->safeString(entry, std::string("direction"));
        std::any before = this->safeString(entry, std::string("before"));
        std::any after = this->safeString(entry, std::string("after"));
        std::any amount = this->safeString(entry, std::string("amount"));
        if (isTrue(!isEqual(amount, std::any{})))
        {
            if (isTrue(isTrue(isEqual(before, std::any{})) && isTrue(!isEqual(after, std::any{}))))
            {
                before = ccxt::Precise::stringSub(after, amount);
            } else if (isTrue(isTrue(!isEqual(before, std::any{})) && isTrue(isEqual(after, std::any{}))))
            {
                after = ccxt::Precise::stringAdd(before, amount);
            }
        }
        if (isTrue(isTrue(!isEqual(before, std::any{})) && isTrue(!isEqual(after, std::any{}))))
        {
            if (isTrue(isEqual(direction, std::any{})))
            {
                if (isTrue(ccxt::Precise::stringGt(before, after)))
                {
                    direction = std::string("out");
                }
                if (isTrue(ccxt::Precise::stringGt(after, before)))
                {
                    direction = std::string("in");
                }
            }
        }
        std::any fee = this->safeValue(entry, std::string("fee"));
        if (isTrue(!isEqual(fee, std::any{})))
        {
            ::setValue(fee, std::string("cost"), this->safeNumber(fee, std::string("cost")));
        }
        std::any timestamp = this->safeInteger(entry, std::string("timestamp"));
        std::any info = this->safeDict(entry, std::string("info"), ccxt::dict {});
        return ccxt::dict {
            { std::string("id"), this->safeString(entry, std::string("id")) },
            { std::string("timestamp"), timestamp },
            { std::string("datetime"), this->iso8601(timestamp) },
            { std::string("direction"), direction },
            { std::string("account"), this->safeString(entry, std::string("account")) },
            { std::string("referenceId"), this->safeString(entry, std::string("referenceId")) },
            { std::string("referenceAccount"), this->safeString(entry, std::string("referenceAccount")) },
            { std::string("type"), this->safeString(entry, std::string("type")) },
            { std::string("currency"), ::getValue(currency, std::string("code")) },
            { std::string("amount"), this->parseNumber(amount) },
            { std::string("before"), this->parseNumber(before) },
            { std::string("after"), this->parseNumber(after) },
            { std::string("status"), this->safeString(entry, std::string("status")) },
            { std::string("fee"), fee },
            { std::string("info"), info },
        };
    }

    virtual std::any safeCurrencyStructure(std::any currency)
    {
        // derive data from networks: deposit, withdraw, active, fee, limits, precision
        std::any networks = this->safeDict(currency, std::string("networks"), ccxt::dict {});
        std::any keys = getObjectKeys(networks);
        std::any length = getArrayLength(keys);
        if (isTrue(!isEqual(length, 0)))
        {
            for (std::any i = 0; isLessThan(i, length); postFixIncrement(i))
            {
                std::any key = ::getValue(keys, i);
                std::any network = ::getValue(networks, key);
                std::any deposit = this->safeBool(network, std::string("deposit"));
                std::any currencyDeposit = this->safeBool(currency, std::string("deposit"));
                if (isTrue(isTrue(isEqual(currencyDeposit, std::any{})) || isTrue((isEqual(deposit, true)))))
                {
                    ::setValue(currency, std::string("deposit"), deposit);
                }
                std::any withdraw = this->safeBool(network, std::string("withdraw"));
                std::any currencyWithdraw = this->safeBool(currency, std::string("withdraw"));
                if (isTrue(isTrue(isEqual(currencyWithdraw, std::any{})) || isTrue((isEqual(withdraw, true)))))
                {
                    ::setValue(currency, std::string("withdraw"), withdraw);
                }
                // find lowest fee (which is more desired)
                std::any fee = this->safeString(network, std::string("fee"));
                std::any feeMain = this->safeString(currency, std::string("fee"));
                if (isTrue(isTrue(isEqual(feeMain, std::any{})) || isTrue(ccxt::Precise::stringLt(fee, feeMain))))
                {
                    ::setValue(currency, std::string("fee"), this->parseNumber(fee));
                }
                // find lowest precision (which is more desired)
                std::any precision = this->safeString(network, std::string("precision"));
                std::any precisionMain = this->safeString(currency, std::string("precision"));
                if (isTrue(isTrue(isEqual(precisionMain, std::any{})) || isTrue(ccxt::Precise::stringGt(precision, precisionMain))))
                {
                    ::setValue(currency, std::string("precision"), this->parseNumber(precision));
                }
                // limits
                std::any limits = this->safeDict(network, std::string("limits"));
                std::any limitsMain = this->safeDict(currency, std::string("limits"));
                if (isTrue(isEqual(limitsMain, std::any{})))
                {
                    ::setValue(currency, std::string("limits"), ccxt::dict {});
                }
                // deposits
                std::any limitsDeposit = this->safeDict(limits, std::string("deposit"));
                std::any limitsDepositMain = this->safeDict(limitsMain, std::string("deposit"));
                if (isTrue(isEqual(limitsDepositMain, std::any{})))
                {
                    ::setValue(::getValue(currency, std::string("limits")), std::string("deposit"), ccxt::dict {});
                }
                std::any limitsDepositMin = this->safeString(limitsDeposit, std::string("min"));
                std::any limitsDepositMax = this->safeString(limitsDeposit, std::string("max"));
                std::any limitsDepositMinMain = this->safeString(limitsDepositMain, std::string("min"));
                std::any limitsDepositMaxMain = this->safeString(limitsDepositMain, std::string("max"));
                // find min
                if (isTrue(isTrue(isEqual(limitsDepositMinMain, std::any{})) || isTrue(ccxt::Precise::stringLt(limitsDepositMin, limitsDepositMinMain))))
                {
                    ::setValue(::getValue(::getValue(currency, std::string("limits")), std::string("deposit")), std::string("min"), this->parseNumber(limitsDepositMin));
                }
                // find max
                if (isTrue(isTrue(isEqual(limitsDepositMaxMain, std::any{})) || isTrue(ccxt::Precise::stringGt(limitsDepositMax, limitsDepositMaxMain))))
                {
                    ::setValue(::getValue(::getValue(currency, std::string("limits")), std::string("deposit")), std::string("max"), this->parseNumber(limitsDepositMax));
                }
                // withdrawals
                std::any limitsWithdraw = this->safeDict(limits, std::string("withdraw"));
                std::any limitsWithdrawMain = this->safeDict(limitsMain, std::string("withdraw"));
                if (isTrue(isEqual(limitsWithdrawMain, std::any{})))
                {
                    ::setValue(::getValue(currency, std::string("limits")), std::string("withdraw"), ccxt::dict {});
                }
                std::any limitsWithdrawMin = this->safeString(limitsWithdraw, std::string("min"));
                std::any limitsWithdrawMax = this->safeString(limitsWithdraw, std::string("max"));
                std::any limitsWithdrawMinMain = this->safeString(limitsWithdrawMain, std::string("min"));
                std::any limitsWithdrawMaxMain = this->safeString(limitsWithdrawMain, std::string("max"));
                // find min
                if (isTrue(isTrue(isEqual(limitsWithdrawMinMain, std::any{})) || isTrue(ccxt::Precise::stringLt(limitsWithdrawMin, limitsWithdrawMinMain))))
                {
                    ::setValue(::getValue(::getValue(currency, std::string("limits")), std::string("withdraw")), std::string("min"), this->parseNumber(limitsWithdrawMin));
                }
                // find max
                if (isTrue(isTrue(isEqual(limitsWithdrawMaxMain, std::any{})) || isTrue(ccxt::Precise::stringGt(limitsWithdrawMax, limitsWithdrawMaxMain))))
                {
                    ::setValue(::getValue(::getValue(currency, std::string("limits")), std::string("withdraw")), std::string("max"), this->parseNumber(limitsWithdrawMax));
                }
            }
        }
        return this->extend(ccxt::dict {
            { std::string("info"), std::any{} },
            { std::string("id"), std::any{} },
            { std::string("numericId"), std::any{} },
            { std::string("code"), std::any{} },
            { std::string("precision"), std::any{} },
            { std::string("type"), std::any{} },
            { std::string("name"), std::any{} },
            { std::string("active"), std::any{} },
            { std::string("deposit"), std::any{} },
            { std::string("withdraw"), std::any{} },
            { std::string("fee"), std::any{} },
            { std::string("fees"), ccxt::dict {} },
            { std::string("networks"), ccxt::dict {} },
            { std::string("limits"), ccxt::dict {
                { std::string("deposit"), ccxt::dict {
                    { std::string("min"), std::any{} },
                    { std::string("max"), std::any{} },
                } },
                { std::string("withdraw"), ccxt::dict {
                    { std::string("min"), std::any{} },
                    { std::string("max"), std::any{} },
                } },
            } },
        }, currency);
    }

    virtual std::any safeMarketStructure(std::any market = std::any{})
    {
        std::any cleanStructure = ccxt::dict {
            { std::string("id"), std::any{} },
            { std::string("lowercaseId"), std::any{} },
            { std::string("symbol"), std::any{} },
            { std::string("base"), std::any{} },
            { std::string("quote"), std::any{} },
            { std::string("settle"), std::any{} },
            { std::string("baseId"), std::any{} },
            { std::string("quoteId"), std::any{} },
            { std::string("settleId"), std::any{} },
            { std::string("type"), std::any{} },
            { std::string("spot"), std::any{} },
            { std::string("margin"), std::any{} },
            { std::string("swap"), std::any{} },
            { std::string("future"), std::any{} },
            { std::string("option"), std::any{} },
            { std::string("index"), std::any{} },
            { std::string("active"), std::any{} },
            { std::string("contract"), std::any{} },
            { std::string("linear"), std::any{} },
            { std::string("inverse"), std::any{} },
            { std::string("subType"), std::any{} },
            { std::string("taker"), std::any{} },
            { std::string("maker"), std::any{} },
            { std::string("contractSize"), std::any{} },
            { std::string("expiry"), std::any{} },
            { std::string("expiryDatetime"), std::any{} },
            { std::string("strike"), std::any{} },
            { std::string("optionType"), std::any{} },
            { std::string("precision"), ccxt::dict {
                { std::string("amount"), std::any{} },
                { std::string("price"), std::any{} },
                { std::string("cost"), std::any{} },
                { std::string("base"), std::any{} },
                { std::string("quote"), std::any{} },
            } },
            { std::string("limits"), ccxt::dict {
                { std::string("leverage"), ccxt::dict {
                    { std::string("min"), std::any{} },
                    { std::string("max"), std::any{} },
                } },
                { std::string("amount"), ccxt::dict {
                    { std::string("min"), std::any{} },
                    { std::string("max"), std::any{} },
                } },
                { std::string("price"), ccxt::dict {
                    { std::string("min"), std::any{} },
                    { std::string("max"), std::any{} },
                } },
                { std::string("cost"), ccxt::dict {
                    { std::string("min"), std::any{} },
                    { std::string("max"), std::any{} },
                } },
            } },
            { std::string("marginModes"), ccxt::dict {
                { std::string("cross"), std::any{} },
                { std::string("isolated"), std::any{} },
            } },
            { std::string("created"), std::any{} },
            { std::string("info"), std::any{} },
        };
        if (isTrue(!isEqual(market, std::any{})))
        {
            std::any result = this->extend(cleanStructure, market);
            // set undefined swap/future/etc
            if (isTrue(isEqual(::getValue(result, std::string("spot")), true)))
            {
                if (isTrue(isEqual(::getValue(result, std::string("contract")), std::any{})))
                {
                    ::setValue(result, std::string("contract"), false);
                }
                if (isTrue(isEqual(::getValue(result, std::string("swap")), std::any{})))
                {
                    ::setValue(result, std::string("swap"), false);
                }
                if (isTrue(isEqual(::getValue(result, std::string("future")), std::any{})))
                {
                    ::setValue(result, std::string("future"), false);
                }
                if (isTrue(isEqual(::getValue(result, std::string("option")), std::any{})))
                {
                    ::setValue(result, std::string("option"), false);
                }
                if (isTrue(isEqual(::getValue(result, std::string("index")), std::any{})))
                {
                    ::setValue(result, std::string("index"), false);
                }
            }
            return result;
        }
        return this->extend(cleanStructure);
    }

    virtual std::any setMarkets(std::any markets, std::any currencies = std::any{})
    {
        std::any values = ccxt::list{};
        this->markets_by_id = this->createSafeDictionary();
        // handle marketId conflicts
        // we insert spot markets first
        std::any marketValues = this->sortBy(this->toArray(markets), std::string("spot"), true, true);
        for (std::any i = 0; isLessThan(i, getArrayLength(marketValues)); postFixIncrement(i))
        {
            std::any value = ::getValue(marketValues, i);
            if (isTrue(inOp(this->markets_by_id, ::getValue(value, std::string("id")))))
            {
                std::any marketsByIdArray = ::getValue(this->markets_by_id, ::getValue(value, std::string("id")));
                arrayPush(marketsByIdArray, value);
                ::setValue(this->markets_by_id, ::getValue(value, std::string("id")), marketsByIdArray);
            } else
            {
                ::setValue(this->markets_by_id, ::getValue(value, std::string("id")), ccxt::list{value});
            }
            // strip undefined-valued keys from the parsed market before deepExtend,
            // otherwise an explicit `taker: undefined` (from safeMarketStructure)
            // would clobber the fee defaults from this.fees['trading'] in the merge
            std::any valueDefined = ccxt::dict {};
            std::any valueKeys = getObjectKeys(value);
            for (std::any j = 0; isLessThan(j, getArrayLength(valueKeys)); postFixIncrement(j))
            {
                std::any valueKey = ::getValue(valueKeys, j);
                if (isTrue(!isEqual(::getValue(value, valueKey), std::any{})))
                {
                    ::setValue(valueDefined, valueKey, ::getValue(value, valueKey));
                }
            }
            std::any market = this->deepExtend(this->safeMarketStructure(), ccxt::dict {
                { std::string("precision"), this->precision },
                { std::string("limits"), this->limits },
            }, ::getValue(this->fees, std::string("trading")), valueDefined);
            if (isTrue(isEqual(::getValue(market, std::string("linear")), true)))
            {
                ::setValue(market, std::string("subType"), std::string("linear"));
            } else if (isTrue(isEqual(::getValue(market, std::string("inverse")), true)))
            {
                ::setValue(market, std::string("subType"), std::string("inverse"));
            } else
            {
                ::setValue(market, std::string("subType"), std::any{});
            }
            arrayPush(values, market);
        }
        this->markets = this->mapToSafeMap(this->indexBy(values, std::string("symbol")));
        std::any marketsSortedBySymbol = this->keysort(this->markets);
        std::any marketsSortedById = this->keysort(this->markets_by_id);
        this->symbols = getObjectKeys(marketsSortedBySymbol);
        this->ids = getObjectKeys(marketsSortedById);
        std::any numCurrencies = 0;
        if (isTrue(!isEqual(currencies, std::any{})))
        {
            std::any keys = getObjectKeys(currencies);
            numCurrencies = getArrayLength(keys);
        }
        if (isTrue(isGreaterThan(numCurrencies, 0)))
        {
            // currencies is always undefined when called in constructor but not when called from loadMarkets
            this->currencies = this->mapToSafeMap(this->deepExtend(this->currencies, currencies));
        } else
        {
            std::any baseCurrencies = ccxt::list{};
            std::any quoteCurrencies = ccxt::list{};
            for (std::any i = 0; isLessThan(i, getArrayLength(values)); postFixIncrement(i))
            {
                std::any market = ::getValue(values, i);
                std::any defaultCurrencyPrecision = (isTrue((isEqual(this->precisionMode, DECIMAL_PLACES))) ? std::any(8) : std::any(this->parseNumber(std::string("1e-8"))));
                std::any marketPrecision = this->safeDict(market, std::string("precision"), ccxt::dict {});
                if (isTrue(inOp(market, std::string("base"))))
                {
                    std::any currency = this->safeCurrencyStructure(ccxt::dict {
                        { std::string("id"), this->safeString2(market, std::string("baseId"), std::string("base")) },
                        { std::string("numericId"), this->safeInteger(market, std::string("baseNumericId")) },
                        { std::string("code"), this->safeString(market, std::string("base")) },
                        { std::string("precision"), this->safeValue2(marketPrecision, std::string("base"), std::string("amount"), defaultCurrencyPrecision) },
                    });
                    arrayPush(baseCurrencies, currency);
                }
                if (isTrue(inOp(market, std::string("quote"))))
                {
                    std::any currency = this->safeCurrencyStructure(ccxt::dict {
                        { std::string("id"), this->safeString2(market, std::string("quoteId"), std::string("quote")) },
                        { std::string("numericId"), this->safeInteger(market, std::string("quoteNumericId")) },
                        { std::string("code"), this->safeString(market, std::string("quote")) },
                        { std::string("precision"), this->safeValue2(marketPrecision, std::string("quote"), std::string("price"), defaultCurrencyPrecision) },
                    });
                    arrayPush(quoteCurrencies, currency);
                }
            }
            baseCurrencies = this->sortBy(baseCurrencies, std::string("code"), false, std::string(""));
            quoteCurrencies = this->sortBy(quoteCurrencies, std::string("code"), false, std::string(""));
            this->baseCurrencies = this->mapToSafeMap(this->indexBy(baseCurrencies, std::string("code")));
            this->quoteCurrencies = this->mapToSafeMap(this->indexBy(quoteCurrencies, std::string("code")));
            std::any allCurrencies = this->arrayConcat(baseCurrencies, quoteCurrencies);
            std::any groupedCurrencies = this->groupBy(allCurrencies, std::string("code"));
            std::any codes = getObjectKeys(groupedCurrencies);
            std::any resultingCurrencies = ccxt::list{};
            for (std::any i = 0; isLessThan(i, getArrayLength(codes)); postFixIncrement(i))
            {
                std::any code = ::getValue(codes, i);
                std::any groupedCurrenciesCode = this->safeList(groupedCurrencies, code, ccxt::list{});
                std::any highestPrecisionCurrency = this->safeValue(groupedCurrenciesCode, 0);
                for (std::any j = 1; isLessThan(j, getArrayLength(groupedCurrenciesCode)); postFixIncrement(j))
                {
                    std::any currentCurrency = ::getValue(groupedCurrenciesCode, j);
                    if (isTrue(isEqual(this->precisionMode, TICK_SIZE)))
                    {
                        highestPrecisionCurrency = (isTrue((isLessThan(::getValue(currentCurrency, std::string("precision")), ::getValue(highestPrecisionCurrency, std::string("precision"))))) ? std::any(currentCurrency) : std::any(highestPrecisionCurrency));
                    } else
                    {
                        highestPrecisionCurrency = (isTrue((isGreaterThan(::getValue(currentCurrency, std::string("precision")), ::getValue(highestPrecisionCurrency, std::string("precision"))))) ? std::any(currentCurrency) : std::any(highestPrecisionCurrency));
                    }
                }
                arrayPush(resultingCurrencies, highestPrecisionCurrency);
            }
            std::any sortedCurrencies = this->sortBy(resultingCurrencies, std::string("code"));
            this->currencies = this->mapToSafeMap(this->deepExtend(this->currencies, this->indexBy(sortedCurrencies, std::string("code"))));
        }
        this->currencies_by_id = this->indexBySafe(this->currencies, std::string("id"));
        std::any currenciesSortedByCode = this->keysort(this->currencies);
        this->codes = getObjectKeys(currenciesSortedByCode);
        if (isTrue(isEqual(this->markets, std::any{})))
        {
            throw ExchangeError(toString(add(this->id, std::string(" setMarkets() markets not set"))));
        }
        return this->markets;
    }

    virtual std::any setMarketsFromExchange(std::any sourceExchange)
    {
        // Validate that both exchanges are of the same type
        if (isTrue(!isEqual(this->id, ::getValue(sourceExchange, std::string("id")))))
        {
            throw ArgumentsRequired(toString(add(add(add(this->id, std::string(" shareMarkets() can only share markets with exchanges of the same type (got ")), ::getValue(sourceExchange, std::string("id"))), std::string(")"))));
        }
        // Validate that source exchange has loaded markets
        if (isTrue(isTrue((isEqual(::getValue(sourceExchange, std::string("markets")), std::any{}))) || isTrue((isEqual(::getValue(sourceExchange, std::string("markets")), null)))))
        {
            throw ExchangeError(toString(std::string("setMarketsFromExchange() source exchange must have loaded markets first. Can call by using loadMarkets function")));
        }
        // Set all market-related data
        this->markets = ::getValue(sourceExchange, std::string("markets"));
        this->markets_by_id = ::getValue(sourceExchange, std::string("markets_by_id"));
        this->symbols = ::getValue(sourceExchange, std::string("symbols"));
        this->ids = ::getValue(sourceExchange, std::string("ids"));
        this->currencies = ::getValue(sourceExchange, std::string("currencies"));
        this->currencies_by_id = ::getValue(sourceExchange, std::string("currencies_by_id"));
        this->baseCurrencies = ::getValue(sourceExchange, std::string("baseCurrencies"));
        this->quoteCurrencies = ::getValue(sourceExchange, std::string("quoteCurrencies"));
        this->codes = ::getValue(sourceExchange, std::string("codes"));
        // check marketHelperProps
        std::any sourceExchangeHelpers = this->safeList(::getValue(sourceExchange, std::string("options")), std::string("marketHelperProps"), ccxt::list{});
        for (std::any i = 0; isLessThan(i, getArrayLength(sourceExchangeHelpers)); postFixIncrement(i))
        {
            std::any helper = ::getValue(sourceExchangeHelpers, i);
            if (isTrue(!isEqual(::getValue(::getValue(sourceExchange, std::string("options")), helper), std::any{})))
            {
                ::setValue(this->options, helper, ::getValue(::getValue(sourceExchange, std::string("options")), helper));
            }
        }
        return this;
    }

    virtual std::any getDescribeForExtendedWsExchange(std::any currentRestInstance, std::any parentRestInstance, std::any wsBaseDescribe)
    {
        std::any extendedRestDescribe = this->deepExtend(::describeOf(parentRestInstance), ::describeOf(currentRestInstance));
        std::any superWithRestDescribe = this->deepExtend(extendedRestDescribe, wsBaseDescribe);
        return superWithRestDescribe;
    }

    virtual std::any safeBalance(std::any balance)
    {
        std::any balances = this->omit(balance, ccxt::list{std::string("info"), std::string("timestamp"), std::string("datetime"), std::string("free"), std::string("used"), std::string("total")});
        std::any codes = getObjectKeys(balances);
        ::setValue(balance, std::string("free"), ccxt::dict {});
        ::setValue(balance, std::string("used"), ccxt::dict {});
        ::setValue(balance, std::string("total"), ccxt::dict {});
        std::any debtBalance = ccxt::dict {};
        for (std::any i = 0; isLessThan(i, getArrayLength(codes)); postFixIncrement(i))
        {
            std::any code = ::getValue(codes, i);
            std::any total = this->safeString(::getValue(balance, code), std::string("total"));
            std::any free = this->safeString(::getValue(balance, code), std::string("free"));
            std::any used = this->safeString(::getValue(balance, code), std::string("used"));
            std::any debt = this->safeString(::getValue(balance, code), std::string("debt"));
            if (isTrue(isTrue(isTrue((isEqual(total, std::any{}))) && isTrue((!isEqual(free, std::any{})))) && isTrue((!isEqual(used, std::any{})))))
            {
                total = ccxt::Precise::stringAdd(free, used);
            }
            if (isTrue(isTrue(isTrue((isEqual(free, std::any{}))) && isTrue((!isEqual(total, std::any{})))) && isTrue((!isEqual(used, std::any{})))))
            {
                free = ccxt::Precise::stringSub(total, used);
            }
            if (isTrue(isTrue(isTrue((isEqual(used, std::any{}))) && isTrue((!isEqual(total, std::any{})))) && isTrue((!isEqual(free, std::any{})))))
            {
                used = ccxt::Precise::stringSub(total, free);
            }
            ::setValue(::getValue(balance, code), std::string("free"), this->parseNumber(free));
            ::setValue(::getValue(balance, code), std::string("used"), this->parseNumber(used));
            ::setValue(::getValue(balance, code), std::string("total"), this->parseNumber(total));
            ::setValue(::getValue(balance, std::string("free")), code, ::getValue(::getValue(balance, code), std::string("free")));
            ::setValue(::getValue(balance, std::string("used")), code, ::getValue(::getValue(balance, code), std::string("used")));
            ::setValue(::getValue(balance, std::string("total")), code, ::getValue(::getValue(balance, code), std::string("total")));
            if (isTrue(!isEqual(debt, std::any{})))
            {
                ::setValue(::getValue(balance, code), std::string("debt"), this->parseNumber(debt));
                ::setValue(debtBalance, code, ::getValue(::getValue(balance, code), std::string("debt")));
            }
        }
        std::any debtBalanceArray = getObjectKeys(debtBalance);
        std::any length = getArrayLength(debtBalanceArray);
        if (isTrue(isTrue((!isEqual(length, std::any{}))) && isTrue((!isEqual(length, 0)))))
        {
            ::setValue(balance, std::string("debt"), debtBalance);
        }
        return balance;
    }

    virtual std::any safeOrder(std::any order, std::any market = std::any{})
    {
        // parses numbers as strings
        // * it is important pass the trades as unparsed rawTrades
        if (isTrue(isEqual(order, std::any{})))
        {
            order = ccxt::dict {};
        }
        std::any amount = this->omitZero(this->safeString(order, std::string("amount")));
        std::any remaining = this->safeString(order, std::string("remaining"));
        std::any filled = this->safeString(order, std::string("filled"));
        std::any cost = this->safeString(order, std::string("cost"));
        std::any average = this->omitZero(this->safeString(order, std::string("average")));
        std::any price = this->omitZero(this->safeString(order, std::string("price")));
        std::any lastTradeTimeTimestamp = this->safeInteger(order, std::string("lastTradeTimestamp"));
        std::any symbol = this->safeString(order, std::string("symbol"));
        std::any side = this->safeString(order, std::string("side"));
        std::any status = this->safeString(order, std::string("status"));
        std::any parseFilled = (isEqual(filled, std::any{}));
        std::any parseCost = (isEqual(cost, std::any{}));
        std::any parseLastTradeTimeTimestamp = (isEqual(lastTradeTimeTimestamp, std::any{}));
        std::any fee = this->safeValue(order, std::string("fee"));
        std::any parseFee = (isEqual(fee, std::any{}));
        std::any parseFees = isEqual(this->safeValue(order, std::string("fees")), std::any{});
        std::any parseSymbol = isEqual(symbol, std::any{});
        std::any parseSide = isEqual(side, std::any{});
        std::any shouldParseFees = isTrue(parseFee) || isTrue(parseFees);
        std::any fees = this->safeList(order, std::string("fees"), ccxt::list{});
        std::any trades = ccxt::list{};
        std::any isTriggerOrSLTpOrder = (isTrue((isTrue(!isEqual(this->safeString(order, std::string("triggerPrice")), std::any{})) || isTrue((!isEqual(this->safeString(order, std::string("stopLossPrice")), std::any{}))))) || isTrue((!isEqual(this->safeString(order, std::string("takeProfitPrice")), std::any{}))));
        if (isTrue(isTrue(isTrue(parseFilled) || isTrue(parseCost)) || isTrue(shouldParseFees)))
        {
            std::any rawTrades = this->safeValue(order, std::string("trades"), trades);
            // const oldNumber = this.number;
            // we parse trades as strings here!
            // i don't think this is needed anymore
            // (this as any).number = String;
            std::any firstTrade = this->safeValue(rawTrades, 0);
            // parse trades if they haven't already been parsed
            std::any tradesAreParsed = (isTrue(isTrue((!isEqual(firstTrade, std::any{}))) && isTrue((inOp(firstTrade, std::string("info"))))) && isTrue((inOp(firstTrade, std::string("id")))));
            if (!isTrue(tradesAreParsed))
            {
                trades = this->parseTrades(rawTrades, market);
            } else
            {
                trades = rawTrades;
            }
            // this.number = oldNumber; why parse trades as strings if you read the value using `safeString` ?
            std::any tradesLength = 0;
            std::any isArray = ::isArray(trades);
            if (isTrue(isArray))
            {
                tradesLength = getArrayLength(trades);
            }
            if (isTrue(isTrue(isArray) && isTrue((isGreaterThan(tradesLength, 0)))))
            {
                // move properties that are defined in trades up into the order
                if (isTrue(isEqual(::getValue(order, std::string("symbol")), std::any{})))
                {
                    ::setValue(order, std::string("symbol"), ::getValue(::getValue(trades, 0), std::string("symbol")));
                }
                if (isTrue(isEqual(::getValue(order, std::string("side")), std::any{})))
                {
                    ::setValue(order, std::string("side"), ::getValue(::getValue(trades, 0), std::string("side")));
                }
                if (isTrue(isEqual(::getValue(order, std::string("type")), std::any{})))
                {
                    ::setValue(order, std::string("type"), ::getValue(::getValue(trades, 0), std::string("type")));
                }
                if (isTrue(isEqual(::getValue(order, std::string("id")), std::any{})))
                {
                    ::setValue(order, std::string("id"), ::getValue(::getValue(trades, 0), std::string("order")));
                }
                if (isTrue(parseFilled))
                {
                    filled = std::string("0");
                }
                if (isTrue(parseCost))
                {
                    cost = std::string("0");
                }
                for (std::any i = 0; isLessThan(i, getArrayLength(trades)); postFixIncrement(i))
                {
                    std::any trade = ::getValue(trades, i);
                    std::any tradeAmount = this->safeString(trade, std::string("amount"));
                    if (isTrue(isTrue(parseFilled) && isTrue((!isEqual(tradeAmount, std::any{})))))
                    {
                        filled = ccxt::Precise::stringAdd(filled, tradeAmount);
                    }
                    std::any tradeCost = this->safeString(trade, std::string("cost"));
                    if (isTrue(isTrue(parseCost) && isTrue((!isEqual(tradeCost, std::any{})))))
                    {
                        cost = ccxt::Precise::stringAdd(cost, tradeCost);
                    }
                    if (isTrue(parseSymbol))
                    {
                        symbol = this->safeString(trade, std::string("symbol"));
                    }
                    if (isTrue(parseSide))
                    {
                        side = this->safeString(trade, std::string("side"));
                    }
                    std::any tradeTimestamp = this->safeValue(trade, std::string("timestamp"));
                    if (isTrue(isTrue(parseLastTradeTimeTimestamp) && isTrue((!isEqual(tradeTimestamp, std::any{})))))
                    {
                        if (isTrue(isEqual(lastTradeTimeTimestamp, std::any{})))
                        {
                            lastTradeTimeTimestamp = tradeTimestamp;
                        } else
                        {
                            lastTradeTimeTimestamp = mathMax(lastTradeTimeTimestamp, tradeTimestamp);
                        }
                    }
                    if (isTrue(shouldParseFees))
                    {
                        std::any tradeFees = this->safeValue(trade, std::string("fees"));
                        if (isTrue(!isEqual(tradeFees, std::any{})))
                        {
                            for (std::any j = 0; isLessThan(j, getArrayLength(tradeFees)); postFixIncrement(j))
                            {
                                std::any tradeFee = ::getValue(tradeFees, j);
                                arrayPush(fees, this->extend(ccxt::dict {}, tradeFee));
                            }
                        } else
                        {
                            std::any tradeFee = this->safeValue(trade, std::string("fee"));
                            if (isTrue(!isEqual(tradeFee, std::any{})))
                            {
                                arrayPush(fees, this->extend(ccxt::dict {}, tradeFee));
                            }
                        }
                    }
                }
            }
        }
        if (isTrue(shouldParseFees))
        {
            std::any reducedFees = fees;
            if (isTrue(this->reduceFees))
            {
                reducedFees = this->reduceFeesByCurrency(fees);
            }
            if (isTrue(isEqual(reducedFees, std::any{})))
            {
                reducedFees = ccxt::list{};
            }
            std::any reducedLength = getArrayLength(reducedFees);
            for (std::any i = 0; isLessThan(i, reducedLength); postFixIncrement(i))
            {
                ::setValue(::getValue(reducedFees, i), std::string("cost"), this->safeNumber(::getValue(reducedFees, i), std::string("cost")));
                if (isTrue(inOp(::getValue(reducedFees, i), std::string("rate"))))
                {
                    ::setValue(::getValue(reducedFees, i), std::string("rate"), this->safeNumber(::getValue(reducedFees, i), std::string("rate")));
                }
            }
            if (isTrue(!isTrue(parseFee) && isTrue((isEqual(reducedLength, 0)))))
            {
                // copy fee to avoid modification by reference
                std::any feeCopy = this->deepExtend(fee);
                ::setValue(feeCopy, std::string("cost"), this->safeNumber(feeCopy, std::string("cost")));
                if (isTrue(inOp(feeCopy, std::string("rate"))))
                {
                    ::setValue(feeCopy, std::string("rate"), this->safeNumber(feeCopy, std::string("rate")));
                }
                arrayPush(reducedFees, feeCopy);
            }
            ::setValue(order, std::string("fees"), reducedFees);
            if (isTrue(isTrue(parseFee) && isTrue((isEqual(reducedLength, 1)))))
            {
                ::setValue(order, std::string("fee"), ::getValue(reducedFees, 0));
            }
        }
        if (isTrue(isEqual(amount, std::any{})))
        {
            // ensure amount = filled + remaining
            if (isTrue(isTrue(!isEqual(filled, std::any{})) && isTrue(!isEqual(remaining, std::any{}))))
            {
                amount = ccxt::Precise::stringAdd(filled, remaining);
            } else if (isTrue(isEqual(status, std::string("closed"))))
            {
                amount = filled;
            }
        }
        if (isTrue(isEqual(filled, std::any{})))
        {
            if (isTrue(isTrue(!isEqual(amount, std::any{})) && isTrue(!isEqual(remaining, std::any{}))))
            {
                filled = ccxt::Precise::stringSub(amount, remaining);
            } else if (isTrue(isTrue(isEqual(status, std::string("closed"))) && isTrue(!isEqual(amount, std::any{}))))
            {
                filled = amount;
            }
        }
        if (isTrue(isEqual(remaining, std::any{})))
        {
            if (isTrue(isTrue(!isEqual(amount, std::any{})) && isTrue(!isEqual(filled, std::any{}))))
            {
                remaining = ccxt::Precise::stringSub(amount, filled);
            } else if (isTrue(isEqual(status, std::string("closed"))))
            {
                remaining = std::string("0");
            }
        }
        // ensure that the average field is calculated correctly
        std::any inverse = this->safeBool(market, std::string("inverse"), false);
        std::any contractSize = this->numberToString(this->safeValue(market, std::string("contractSize"), 1));
        // inverse
        // price = filled * contract size / cost
        //
        // linear
        // price = cost / (filled * contract size)
        if (isTrue(isEqual(average, std::any{})))
        {
            if (isTrue(isTrue(isTrue((!isEqual(filled, std::any{}))) && isTrue((!isEqual(cost, std::any{})))) && isTrue(ccxt::Precise::stringGt(filled, std::string("0")))))
            {
                std::any filledTimesContractSize = ccxt::Precise::stringMul(filled, contractSize);
                if (isTrue(isEqual(inverse, true)))
                {
                    average = ccxt::Precise::stringDiv(filledTimesContractSize, cost);
                } else
                {
                    average = ccxt::Precise::stringDiv(cost, filledTimesContractSize);
                }
            }
        }
        // similarly
        // inverse
        // cost = filled * contract size / price
        //
        // linear
        // cost = filled * contract size * price
        std::any costPriceExists = isTrue((!isEqual(average, std::any{}))) || isTrue((!isEqual(price, std::any{})));
        if (isTrue(isTrue(isTrue(parseCost) && isTrue((!isEqual(filled, std::any{})))) && isTrue(costPriceExists)))
        {
            std::any multiplyPrice = std::any{};
            if (isTrue(isEqual(average, std::any{})))
            {
                multiplyPrice = price;
            } else
            {
                multiplyPrice = average;
            }
            // contract trading
            std::any filledTimesContractSize = ccxt::Precise::stringMul(filled, contractSize);
            if (isTrue(isEqual(inverse, true)))
            {
                cost = ccxt::Precise::stringDiv(filledTimesContractSize, multiplyPrice);
            } else
            {
                cost = ccxt::Precise::stringMul(filledTimesContractSize, multiplyPrice);
            }
        }
        // support for market orders
        std::any orderType = this->safeValue(order, std::string("type"));
        std::any emptyPrice = isTrue((isEqual(price, std::any{}))) || isTrue(ccxt::Precise::stringEquals(price, std::string("0")));
        if (isTrue(isTrue(emptyPrice) && isTrue((isEqual(orderType, std::string("market"))))))
        {
            price = average;
        }
        // we have trades with string values at this point so we will mutate them
        for (std::any i = 0; isLessThan(i, getArrayLength(trades)); postFixIncrement(i))
        {
            std::any entry = ::getValue(trades, i);
            ::setValue(entry, std::string("amount"), this->safeNumber(entry, std::string("amount")));
            ::setValue(entry, std::string("price"), this->safeNumber(entry, std::string("price")));
            ::setValue(entry, std::string("cost"), this->safeNumber(entry, std::string("cost")));
            std::any tradeFee = this->safeDict(entry, std::string("fee"), ccxt::dict {});
            ::setValue(tradeFee, std::string("cost"), this->safeNumber(tradeFee, std::string("cost")));
            if (isTrue(inOp(tradeFee, std::string("rate"))))
            {
                ::setValue(tradeFee, std::string("rate"), this->safeNumber(tradeFee, std::string("rate")));
            }
            std::any entryFees = this->safeList(entry, std::string("fees"), ccxt::list{});
            for (std::any j = 0; isLessThan(j, getArrayLength(entryFees)); postFixIncrement(j))
            {
                ::setValue(::getValue(entryFees, j), std::string("cost"), this->safeNumber(::getValue(entryFees, j), std::string("cost")));
            }
            ::setValue(entry, std::string("fees"), entryFees);
            ::setValue(entry, std::string("fee"), tradeFee);
        }
        std::any timeInForce = this->safeString(order, std::string("timeInForce"));
        std::any postOnly = this->safeValue(order, std::string("postOnly"));
        // timeInForceHandling
        if (isTrue(isEqual(timeInForce, std::any{})))
        {
            if (isTrue(!isTrue(isTriggerOrSLTpOrder) && isTrue((isEqual(this->safeString(order, std::string("type")), std::string("market"))))))
            {
                timeInForce = std::string("IOC");
            }
            // allow postOnly override
            if (isTrue(isEqual(postOnly, true)))
            {
                timeInForce = std::string("PO");
            }
        } else if (isTrue(isEqual(postOnly, std::any{})))
        {
            // timeInForce is not undefined here
            postOnly = isEqual(timeInForce, std::string("PO"));
        }
        std::any timestamp = this->safeInteger(order, std::string("timestamp"));
        std::any lastUpdateTimestamp = this->safeInteger(order, std::string("lastUpdateTimestamp"));
        std::any datetime = this->safeString(order, std::string("datetime"));
        if (isTrue(isEqual(datetime, std::any{})))
        {
            datetime = this->iso8601(timestamp);
        }
        std::any triggerPrice = this->parseNumber(this->safeString2(order, std::string("triggerPrice"), std::string("stopPrice")));
        std::any takeProfitPrice = this->parseNumber(this->safeString(order, std::string("takeProfitPrice")));
        std::any stopLossPrice = this->parseNumber(this->safeString(order, std::string("stopLossPrice")));
        return this->extend(order, ccxt::dict {
            { std::string("id"), this->safeString(order, std::string("id")) },
            { std::string("clientOrderId"), this->safeString(order, std::string("clientOrderId")) },
            { std::string("timestamp"), timestamp },
            { std::string("datetime"), datetime },
            { std::string("symbol"), symbol },
            { std::string("type"), this->safeString(order, std::string("type")) },
            { std::string("side"), side },
            { std::string("lastTradeTimestamp"), lastTradeTimeTimestamp },
            { std::string("lastUpdateTimestamp"), lastUpdateTimestamp },
            { std::string("price"), this->parseNumber(price) },
            { std::string("amount"), this->parseNumber(amount) },
            { std::string("cost"), this->parseNumber(cost) },
            { std::string("average"), this->parseNumber(average) },
            { std::string("filled"), this->parseNumber(filled) },
            { std::string("remaining"), this->parseNumber(remaining) },
            { std::string("timeInForce"), timeInForce },
            { std::string("postOnly"), postOnly },
            { std::string("trades"), trades },
            { std::string("reduceOnly"), this->safeValue(order, std::string("reduceOnly")) },
            { std::string("stopPrice"), triggerPrice },
            { std::string("triggerPrice"), triggerPrice },
            { std::string("takeProfitPrice"), takeProfitPrice },
            { std::string("stopLossPrice"), stopLossPrice },
            { std::string("status"), status },
            { std::string("fee"), this->safeValue(order, std::string("fee")) },
        });
    }

    virtual std::any parseOrders(std::any orders, std::any market = std::any{}, std::any since = std::any{}, std::any limit = std::any{}, std::any params = ccxt::dict {})
    {
        //
        // the value of orders is either a dict or a list
        //
        // dict
        //
        //     {
        //         'id1': { ... },
        //         'id2': { ... },
        //         'id3': { ... },
        //         ...
        //     }
        //
        // list
        //
        //     [
        //         { 'id': 'id1', ... },
        //         { 'id': 'id2', ... },
        //         { 'id': 'id3', ... },
        //         ...
        //     ]
        //
        if (isTrue(isEqual(orders, std::any{})))
        {
            return ccxt::list{};
        }
        std::any results = ccxt::list{};
        if (isTrue(isArray(orders)))
        {
            for (std::any i = 0; isLessThan(i, getArrayLength(orders)); postFixIncrement(i))
            {
                std::any parsed = this->parseOrder(::getValue(orders, i), market); // don't inline this call
                std::any order = this->extend(parsed, params);
                arrayPush(results, order);
            }
        } else
        {
            std::any ids = getObjectKeys(orders);
            for (std::any i = 0; isLessThan(i, getArrayLength(ids)); postFixIncrement(i))
            {
                std::any id = ::getValue(ids, i);
                std::any idExtended = this->extend(ccxt::dict {
                    { std::string("id"), id },
                }, ::getValue(orders, id));
                std::any parsedOrder = this->parseOrder(idExtended, market); // don't  inline these calls
                std::any order = this->extend(parsedOrder, params);
                arrayPush(results, order);
            }
        }
        results = this->sortBy(results, std::string("timestamp"));
        std::any symbol = this->safeString(market, std::string("symbol"));
        return this->filterBySymbolSinceLimit(results, symbol, since, limit);
    }

    virtual std::any calculateFeeWithRate(std::any symbol, std::any type, std::any side, std::any amount, std::any price, std::any takerOrMaker = std::string("taker"), std::any feeRate = std::any{}, std::any params = ccxt::dict {})
    {
        if (isTrue(isTrue(isEqual(type, std::string("market"))) && isTrue(isEqual(takerOrMaker, std::string("maker")))))
        {
            throw ArgumentsRequired(toString(add(this->id, std::string(" calculateFee() - you have provided incompatible arguments - \"market\" type order can not be \"maker\". Change either the \"type\" or the \"takerOrMaker\" argument to calculate the fee."))));
        }
        std::any markets = this->markets;
        if (isTrue(isEqual(markets, std::any{})))
        {
            throw ExchangeError(toString(add(this->id, std::string(" markets not loaded"))));
        }
        std::any market = ::getValue(markets, symbol);
        std::any feeSide = this->safeString(market, std::string("feeSide"), std::string("quote"));
        std::any useQuote = std::any{};
        if (isTrue(isEqual(feeSide, std::string("get"))))
        {
            // the fee is always in the currency you get
            useQuote = isEqual(side, std::string("sell"));
        } else if (isTrue(isEqual(feeSide, std::string("give"))))
        {
            // the fee is always in the currency you give
            useQuote = isEqual(side, std::string("buy"));
        } else
        {
            // the fee is always in feeSide currency
            useQuote = isEqual(feeSide, std::string("quote"));
        }
        std::any cost = this->numberToString(amount);
        std::any key = std::any{};
        if (isTrue(useQuote))
        {
            std::any priceString = this->numberToString(price);
            cost = ccxt::Precise::stringMul(cost, priceString);
            key = std::string("quote");
        } else
        {
            key = std::string("base");
        }
        // for derivatives, the fee is in 'settle' currency
        if (isTrue(!isEqual(::getValue(market, std::string("spot")), true)))
        {
            key = std::string("settle");
        }
        // even if `takerOrMaker` argument was set to 'maker', for 'market' orders we should forcefully override it to 'taker'
        if (isTrue(isEqual(type, std::string("market"))))
        {
            takerOrMaker = std::string("taker");
        }
        std::any rate = (isTrue((!isEqual(feeRate, std::any{}))) ? std::any(this->numberToString(feeRate)) : std::any(this->safeString(market, takerOrMaker)));
        cost = ccxt::Precise::stringMul(cost, rate);
        return ccxt::dict {
            { std::string("type"), takerOrMaker },
            { std::string("currency"), ::getValue(market, key) },
            { std::string("rate"), this->parseNumber(rate) },
            { std::string("cost"), this->parseNumber(cost) },
        };
    }

    virtual std::any calculateFee(std::any symbol, std::any type, std::any side, std::any amount, std::any price, std::any takerOrMaker = std::string("taker"), std::any params = ccxt::dict {})
    {
        /**
         * @method
         * @description calculates the presumptive fee that would be charged for an order
         * @param {string} symbol unified market symbol
         * @param {string} type 'market' or 'limit'
         * @param {string} side 'buy' or 'sell'
         * @param {float} amount how much you want to trade, in units of the base currency on most exchanges, or number of contracts
         * @param {float} price the price for the order to be filled at, in units of the quote currency
         * @param {string} takerOrMaker 'taker' or 'maker'
         * @param {object} params
         * @returns {object} contains the rate, the percentage multiplied to the order amount to obtain the fee amount, and cost, the total value of the fee in units of the quote currency, for the order
         */
        return this->calculateFeeWithRate(symbol, type, side, amount, price, takerOrMaker, std::any{}, params);
    }

    virtual std::any safeLiquidation(std::any liquidation, std::any market = std::any{})
    {
        std::any contracts = this->safeString(liquidation, std::string("contracts"));
        std::any contractSize = this->safeString(market, std::string("contractSize"));
        std::any price = this->safeString(liquidation, std::string("price"));
        std::any baseValue = this->safeString(liquidation, std::string("baseValue"));
        std::any quoteValue = this->safeString(liquidation, std::string("quoteValue"));
        if (isTrue(isTrue(isTrue(isTrue((isEqual(baseValue, std::any{}))) && isTrue((!isEqual(contracts, std::any{})))) && isTrue((!isEqual(contractSize, std::any{})))) && isTrue((!isEqual(price, std::any{})))))
        {
            baseValue = ccxt::Precise::stringMul(contracts, contractSize);
        }
        if (isTrue(isTrue(isTrue((isEqual(quoteValue, std::any{}))) && isTrue((!isEqual(baseValue, std::any{})))) && isTrue((!isEqual(price, std::any{})))))
        {
            quoteValue = ccxt::Precise::stringMul(baseValue, price);
        }
        ::setValue(liquidation, std::string("contracts"), this->parseNumber(contracts));
        ::setValue(liquidation, std::string("contractSize"), this->parseNumber(contractSize));
        ::setValue(liquidation, std::string("price"), this->parseNumber(price));
        ::setValue(liquidation, std::string("baseValue"), this->parseNumber(baseValue));
        ::setValue(liquidation, std::string("quoteValue"), this->parseNumber(quoteValue));
        return liquidation;
    }

    virtual std::any safeTrade(std::any trade, std::any market = std::any{})
    {
        std::any amount = this->safeString(trade, std::string("amount"));
        std::any price = this->safeString(trade, std::string("price"));
        std::any cost = this->safeString(trade, std::string("cost"));
        if (isTrue(isEqual(cost, std::any{})))
        {
            // contract trading
            std::any contractSize = this->safeString(market, std::string("contractSize"));
            std::any multiplyPrice = price;
            if (isTrue(!isEqual(contractSize, std::any{})))
            {
                std::any inverse = this->safeBool(market, std::string("inverse"), false);
                if (isTrue(isEqual(inverse, true)))
                {
                    multiplyPrice = ccxt::Precise::stringDiv(std::string("1"), price);
                }
                multiplyPrice = ccxt::Precise::stringMul(multiplyPrice, contractSize);
            }
            cost = ccxt::Precise::stringMul(multiplyPrice, amount);
        }
        std::any resultFeeresultFeesVariable = this->parsedFeeAndFees(trade);
        std::any resultFee = ::getValue(resultFeeresultFeesVariable, 0);
        std::any resultFees = ::getValue(resultFeeresultFeesVariable, 1);
        ::setValue(trade, std::string("fee"), resultFee);
        ::setValue(trade, std::string("fees"), resultFees);
        ::setValue(trade, std::string("amount"), this->parseNumber(amount));
        ::setValue(trade, std::string("price"), this->parseNumber(price));
        ::setValue(trade, std::string("cost"), this->parseNumber(cost));
        return trade;
    }

    virtual std::any createCcxtTradeId(std::any timestamp = std::any{}, std::any side = std::any{}, std::any amount = std::any{}, std::any price = std::any{}, std::any takerOrMaker = std::any{})
    {
        // this approach is being used by multiple exchanges (mexc, woo, coinsbit, dydx, ...)
        std::any id = std::any{};
        if (isTrue(!isEqual(timestamp, std::any{})))
        {
            id = this->numberToString(timestamp);
            if (isTrue(!isEqual(side, std::any{})))
            {
                id = add(id, add(std::string("-"), side));
            }
            if (isTrue(!isEqual(amount, std::any{})))
            {
                id = add(id, add(std::string("-"), this->numberToString(amount)));
            }
            if (isTrue(!isEqual(price, std::any{})))
            {
                id = add(id, add(std::string("-"), this->numberToString(price)));
            }
            if (isTrue(!isEqual(takerOrMaker, std::any{})))
            {
                id = add(id, add(std::string("-"), takerOrMaker));
            }
        }
        return id;
    }

    virtual std::any parsedFeeAndFees(std::any container)
    {
        std::any fee = this->safeDict(container, std::string("fee"));
        std::any fees = this->safeList(container, std::string("fees"));
        std::any feeDefined = !isEqual(fee, std::any{});
        std::any feesDefined = !isEqual(fees, std::any{});
        // parsing only if at least one of them is defined
        std::any shouldParseFees = (isTrue(feeDefined) || isTrue(feesDefined));
        if (isTrue(shouldParseFees))
        {
            if (isTrue(feeDefined))
            {
                fee = this->parseFeeNumeric(fee);
            }
            if (!isTrue(feesDefined))
            {
                // just set it directly, no further processing needed.
                fees = ccxt::list{fee};
            }
            // 'fees' were set, so reparse them
            std::any reducedFees = fees;
            if (isTrue(this->reduceFees))
            {
                reducedFees = this->reduceFeesByCurrency(fees);
            }
            if (isTrue(isEqual(reducedFees, std::any{})))
            {
                reducedFees = ccxt::list{};
            }
            std::any reducedLength = getArrayLength(reducedFees);
            for (std::any i = 0; isLessThan(i, reducedLength); postFixIncrement(i))
            {
                ::setValue(reducedFees, i, this->parseFeeNumeric(::getValue(reducedFees, i)));
            }
            fees = reducedFees;
            if (isTrue(isEqual(reducedLength, 1)))
            {
                fee = ::getValue(reducedFees, 0);
            } else if (isTrue(isEqual(reducedLength, 0)))
            {
                fee = std::any{};
            }
        }
        // in case `fee & fees` are undefined, set `fees` as empty array
        if (isTrue(isEqual(fee, std::any{})))
        {
            fee = ccxt::dict {
                { std::string("cost"), std::any{} },
                { std::string("currency"), std::any{} },
            };
        }
        if (isTrue(isEqual(fees, std::any{})))
        {
            fees = ccxt::list{};
        }
        return ccxt::list{fee, fees};
    }

    virtual std::any parseFeeNumeric(std::any fee)
    {
        ::setValue(fee, std::string("cost"), this->safeNumber(fee, std::string("cost"))); // ensure numeric
        if (isTrue(inOp(fee, std::string("rate"))))
        {
            ::setValue(fee, std::string("rate"), this->safeNumber(fee, std::string("rate")));
        }
        return fee;
    }

    virtual std::any findNearestCeiling(std::any arr, std::any providedValue)
    {
        //  i.e. findNearestCeiling ([ 10, 30, 50],  23) returns 30
        std::any length = getArrayLength(arr);
        for (std::any i = 0; isLessThan(i, length); postFixIncrement(i))
        {
            std::any current = ::getValue(arr, i);
            if (isTrue(isLessThanOrEqual(providedValue, current)))
            {
                return current;
            }
        }
        return ::getValue(arr, subtract(length, 1));
    }

    virtual std::any addKeyInArrayItems(std::any obj, std::any keyName)
    {
        std::any result = ccxt::list{};
        std::any keys = getObjectKeys(obj);
        for (std::any i = 0; isLessThan(i, getArrayLength(keys)); postFixIncrement(i))
        {
            std::any key = ::getValue(keys, i);
            std::any item = ::getValue(obj, key);
            if (isTrue(isEqual(item, std::any{})))
            {
                continue;
            }
            std::any itemWithKey = this->extend(ccxt::dict {}, item);
            ::setValue(itemWithKey, keyName, key);
            arrayPush(result, itemWithKey);
        }
        return result;
    }

    virtual std::any invertFlatStringDictionary(std::any dict)
    {
        std::any reversed = ccxt::dict {};
        std::any keys = getObjectKeys(dict);
        for (std::any i = 0; isLessThan(i, getArrayLength(keys)); postFixIncrement(i))
        {
            std::any key = ::getValue(keys, i);
            std::any value = ::getValue(dict, key);
            if (isTrue(isString(value)))
            {
                ::setValue(reversed, value, key);
            }
        }
        return reversed;
    }

    virtual std::any stringToBase16(std::any str)
    {
        return add(std::string("0x"), this->binaryToBase16(this->base64ToBinary(this->stringToBase64(str))));
    }

    virtual std::any reduceFeesByCurrency(std::any fees)
    {
        //
        // this function takes a list of fee structures having the following format
        //
        //     string = true
        //
        //     [
        //         { 'currency': 'BTC', 'cost': '0.1' },
        //         { 'currency': 'BTC', 'cost': '0.2'  },
        //         { 'currency': 'BTC', 'cost': '0.2', 'rate': '0.00123' },
        //         { 'currency': 'BTC', 'cost': '0.4', 'rate': '0.00123' },
        //         { 'currency': 'BTC', 'cost': '0.5', 'rate': '0.00456' },
        //         { 'currency': 'USDT', 'cost': '12.3456' },
        //     ]
        //
        //     string = false
        //
        //     [
        //         { 'currency': 'BTC', 'cost': 0.1 },
        //         { 'currency': 'BTC', 'cost': 0.2 },
        //         { 'currency': 'BTC', 'cost': 0.2, 'rate': 0.00123 },
        //         { 'currency': 'BTC', 'cost': 0.4, 'rate': 0.00123 },
        //         { 'currency': 'BTC', 'cost': 0.5, 'rate': 0.00456 },
        //         { 'currency': 'USDT', 'cost': 12.3456 },
        //     ]
        //
        // and returns a reduced fee list, where fees are summed per currency and rate (if any)
        //
        //     string = true
        //
        //     [
        //         { 'currency': 'BTC', 'cost': '0.4'  },
        //         { 'currency': 'BTC', 'cost': '0.6', 'rate': '0.00123' },
        //         { 'currency': 'BTC', 'cost': '0.5', 'rate': '0.00456' },
        //         { 'currency': 'USDT', 'cost': '12.3456' },
        //     ]
        //
        //     string  = false
        //
        //     [
        //         { 'currency': 'BTC', 'cost': 0.3  },
        //         { 'currency': 'BTC', 'cost': 0.6, 'rate': 0.00123 },
        //         { 'currency': 'BTC', 'cost': 0.5, 'rate': 0.00456 },
        //         { 'currency': 'USDT', 'cost': 12.3456 },
        //     ]
        //
        std::any reduced = ccxt::dict {};
        for (std::any i = 0; isLessThan(i, getArrayLength(fees)); postFixIncrement(i))
        {
            std::any fee = ::getValue(fees, i);
            std::any code = this->safeString(fee, std::string("currency"));
            std::any feeCurrencyCode = (isTrue((!isEqual(code, std::any{}))) ? std::any(code) : std::any(toString(i)));
            if (isTrue(!isEqual(feeCurrencyCode, std::any{})))
            {
                std::any rate = this->safeString(fee, std::string("rate"));
                std::any cost = this->safeString(fee, std::string("cost"));
                if (isTrue(isEqual(cost, std::any{})))
                {
                    continue;
                }
                if (!isTrue((inOp(reduced, feeCurrencyCode))))
                {
                    ::setValue(reduced, feeCurrencyCode, ccxt::dict {});
                }
                std::any rateKey = (isTrue((isEqual(rate, std::any{}))) ? std::any(std::string("")) : std::any(rate));
                if (isTrue(inOp(::getValue(reduced, feeCurrencyCode), rateKey)))
                {
                    ::setValue(::getValue(::getValue(reduced, feeCurrencyCode), rateKey), std::string("cost"), ccxt::Precise::stringAdd(::getValue(::getValue(::getValue(reduced, feeCurrencyCode), rateKey), std::string("cost")), cost));
                } else
                {
                    ::setValue(::getValue(reduced, feeCurrencyCode), rateKey, ccxt::dict {
    { std::string("currency"), code },
    { std::string("cost"), cost },
});
                    if (isTrue(!isEqual(rate, std::any{})))
                    {
                        ::setValue(::getValue(::getValue(reduced, feeCurrencyCode), rateKey), std::string("rate"), rate);
                    }
                }
            }
        }
        std::any result = ccxt::list{};
        std::any feeValues = getObjectValues(reduced);
        for (std::any i = 0; isLessThan(i, getArrayLength(feeValues)); postFixIncrement(i))
        {
            std::any reducedFeeValues = getObjectValues(::getValue(feeValues, i));
            result = this->arrayConcat(result, reducedFeeValues);
        }
        return result;
    }

    virtual std::any safeTicker(std::any ticker, std::any market = std::any{})
    {
        std::any open = this->omitZero(this->safeString(ticker, std::string("open")));
        std::any close = this->omitZero(this->safeString2(ticker, std::string("close"), std::string("last")));
        std::any change = this->safeString(ticker, std::string("change")); // change can be a legitimate zero on a flat day, do not omitZero it, see https://github.com/ccxt/ccxt/issues/25971
        std::any percentage = this->omitZero(this->safeString(ticker, std::string("percentage")));
        std::any average = this->omitZero(this->safeString(ticker, std::string("average")));
        std::any vwap = this->safeString(ticker, std::string("vwap"));
        std::any baseVolume = this->safeString(ticker, std::string("baseVolume"));
        std::any quoteVolume = this->safeString(ticker, std::string("quoteVolume"));
        if (isTrue(isEqual(vwap, std::any{})))
        {
            vwap = ccxt::Precise::stringDiv(this->omitZero(quoteVolume), baseVolume);
        }
        // calculate open
        if (isTrue(!isEqual(change, std::any{})))
        {
            if (isTrue(isTrue(isEqual(close, std::any{})) && isTrue(!isEqual(average, std::any{}))))
            {
                close = ccxt::Precise::stringAdd(average, ccxt::Precise::stringDiv(change, std::string("2")));
            }
            if (isTrue(isTrue(isEqual(open, std::any{})) && isTrue(!isEqual(close, std::any{}))))
            {
                open = ccxt::Precise::stringSub(close, change);
            }
        } else if (isTrue(!isEqual(percentage, std::any{})))
        {
            if (isTrue(isTrue(isEqual(close, std::any{})) && isTrue(!isEqual(average, std::any{}))))
            {
                std::any openAddClose = ccxt::Precise::stringMul(average, std::string("2"));
                // openAddClose = open * (1 + (100 + percentage)/100)
                std::any denominator = ccxt::Precise::stringAdd(std::string("2"), ccxt::Precise::stringDiv(percentage, std::string("100")));
                std::any calcOpen = (isTrue((!isEqual(open, std::any{}))) ? std::any(open) : std::any(ccxt::Precise::stringDiv(openAddClose, denominator)));
                close = ccxt::Precise::stringMul(calcOpen, ccxt::Precise::stringAdd(std::string("1"), ccxt::Precise::stringDiv(percentage, std::string("100"))));
            }
            if (isTrue(isTrue(isEqual(open, std::any{})) && isTrue(!isEqual(close, std::any{}))))
            {
                open = ccxt::Precise::stringDiv(close, ccxt::Precise::stringAdd(std::string("1"), ccxt::Precise::stringDiv(percentage, std::string("100"))));
            }
        }
        // change
        if (isTrue(isEqual(change, std::any{})))
        {
            if (isTrue(isTrue(!isEqual(close, std::any{})) && isTrue(!isEqual(open, std::any{}))))
            {
                change = ccxt::Precise::stringSub(close, open);
            } else if (isTrue(isTrue(!isEqual(close, std::any{})) && isTrue(!isEqual(percentage, std::any{}))))
            {
                change = ccxt::Precise::stringMul(ccxt::Precise::stringDiv(percentage, std::string("100")), ccxt::Precise::stringDiv(close, std::string("100")));
            } else if (isTrue(isTrue(!isEqual(open, std::any{})) && isTrue(!isEqual(percentage, std::any{}))))
            {
                change = ccxt::Precise::stringMul(open, ccxt::Precise::stringDiv(percentage, std::string("100")));
            }
        }
        // calculate things according to "open" (similar can be done with "close")
        if (isTrue(!isEqual(open, std::any{})))
        {
            // percentage (using change)
            if (isTrue(isTrue(isEqual(percentage, std::any{})) && isTrue(!isEqual(change, std::any{}))))
            {
                percentage = ccxt::Precise::stringMul(ccxt::Precise::stringDiv(change, open), std::string("100"));
            }
            // close (using change)
            if (isTrue(isTrue(isEqual(close, std::any{})) && isTrue(!isEqual(change, std::any{}))))
            {
                close = ccxt::Precise::stringAdd(open, change);
            }
            // close (using average)
            if (isTrue(isTrue(isEqual(close, std::any{})) && isTrue(!isEqual(average, std::any{}))))
            {
                close = ccxt::Precise::stringMul(average, std::string("2"));
            }
            // average
            if (isTrue(isTrue(isEqual(average, std::any{})) && isTrue(!isEqual(close, std::any{}))))
            {
                std::any precision = 18;
                if (isTrue(isTrue(!isEqual(market, std::any{})) && isTrue(this->isTickPrecision())))
                {
                    std::any marketPrecision = this->safeDict(market, std::string("precision"));
                    std::any precisionPrice = this->safeString(marketPrecision, std::string("price"));
                    if (isTrue(!isEqual(precisionPrice, std::any{})))
                    {
                        precision = this->precisionFromString(precisionPrice);
                    }
                }
                average = ccxt::Precise::stringDiv(ccxt::Precise::stringAdd(open, close), std::string("2"), precision);
            }
        }
        // timestamp and symbol operations don't belong in safeTicker
        // they should be done in the derived classes
        std::any closeParsed = this->parseNumber(this->omitZero(close));
        return this->extend(ticker, ccxt::dict {
            { std::string("bid"), this->parseNumber(this->omitZero(this->safeString(ticker, std::string("bid")))) },
            { std::string("bidVolume"), this->safeNumber(ticker, std::string("bidVolume")) },
            { std::string("ask"), this->parseNumber(this->omitZero(this->safeString(ticker, std::string("ask")))) },
            { std::string("askVolume"), this->safeNumber(ticker, std::string("askVolume")) },
            { std::string("high"), this->parseNumber(this->omitZero(this->safeString(ticker, std::string("high")))) },
            { std::string("low"), this->parseNumber(this->omitZero(this->safeString(ticker, std::string("low")))) },
            { std::string("open"), this->parseNumber(this->omitZero(open)) },
            { std::string("close"), closeParsed },
            { std::string("last"), closeParsed },
            { std::string("change"), this->parseNumber(change) },
            { std::string("percentage"), this->parseNumber(percentage) },
            { std::string("average"), this->parseNumber(average) },
            { std::string("vwap"), this->parseNumber(vwap) },
            { std::string("baseVolume"), this->parseNumber(baseVolume) },
            { std::string("quoteVolume"), this->parseNumber(quoteVolume) },
            { std::string("previousClose"), this->safeNumber(ticker, std::string("previousClose")) },
            { std::string("indexPrice"), this->safeNumber(ticker, std::string("indexPrice")) },
            { std::string("markPrice"), this->safeNumber(ticker, std::string("markPrice")) },
        });
    }

