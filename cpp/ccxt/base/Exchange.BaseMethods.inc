    virtual std::any checkAddress(std::any address = std::any{})
    {
        if (isTrue(isEqual(address, std::any{})))
        {
            throw InvalidAddress(toString(add(this->id, std::string(" address is undefined"))));
        }
        // check the address is not the same letter like 'aaaaa' nor too short nor has a space
        std::any uniqChars = (this->unique(this->stringToCharsArray(address)));
        std::any length = getArrayLength(uniqChars); // py transpiler trick
        if (isTrue(isTrue(isTrue(isEqual(length, 1)) || isTrue(isLessThan(getStringLength(address), this->minFundingAddressLength))) || isTrue(isGreaterThan(getIndexOf(address, std::string(" ")), -1))))
        {
            throw InvalidAddress(toString(add(add(add(add(add(this->id, std::string(" address is invalid or has less than ")), toString(this->minFundingAddressLength)), std::string(" characters: \"")), toString(address)), std::string("\""))));
        }
        return address;
    }

