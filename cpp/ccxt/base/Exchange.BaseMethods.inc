    virtual std::any parseToInt(std::any number)
    {
        // Solve Common parseInt misuse ex: parseInt ((since / 1000).toString ())
        // using a number as parameter which is not valid in ts
        // numberToString is typed as nullable under strictNullChecks; cast to string
        // the cast is erased at transpile-time, so output matches every target language, rather than
        // branching to a bare `NaN` literal, which has no symbol in Go/Java/C#
        std::any stringifiedNumber = this->numberToString(number);
        std::any convertedNumber = parseFloat(stringifiedNumber);
        return parseInt(convertedNumber);
    }

    virtual std::any parseToNumeric(std::any number)
    {
        std::any stringVersion = this->numberToString(number); // this will convert 1.0 and 1 to "1" and 1.1 to "1.1"
        // keep this in mind:
        // in JS:     1 === 1.0 is true
        // in Python: 1 == 1.0 is true
        // in PHP:    1 == 1.0 is true, but 1 === 1.0 is false.
        if (isTrue(isGreaterThanOrEqual(getIndexOf(stringVersion, std::string(".")), 0)))
        {
            return parseFloat(stringVersion);
        }
        return parseInt(stringVersion);
    }

    virtual std::any isRoundNumber(std::any value)
    {
        // this method is similar to isInteger, but this is more loyal and does not check for types.
        // i.e. isRoundNumber(1.000) returns true, while isInteger(1.000) returns false
        std::any res = this->parseToNumeric((mod(value, 1)));
        return isEqual(res, 0);
    }

    virtual std::any isEmptyString(std::any value)
    {
        return !isTrue(this->valueIsDefined(value)) || isTrue(isEqual(value, std::string("")));
    }

    virtual std::any safeNumberOmitZero(std::any obj, std::any key, std::any defaultValue = std::any{})
    {
        std::any value = this->safeString(obj, key);
        std::any final = this->parseNumber(this->omitZero(value));
        return (isTrue((isEqual(final, std::any{}))) ? std::any(defaultValue) : std::any(final));
    }

    virtual std::any safeIntegerOmitZero(std::any obj, std::any key, std::any defaultValue = std::any{})
    {
        std::any timestamp = this->safeInteger(obj, key, defaultValue);
        if (isTrue(isTrue(isEqual(timestamp, std::any{})) || isTrue(isEqual(timestamp, 0))))
        {
            return std::any{};
        }
        return timestamp;
    }

    virtual void afterConstruct()
    {
        // networks
        this->createNetworksByIdObject();
        this->featuresGenerator();
        // init predefined markets if any
        if (isTrue(!isEqual(this->markets, std::any{})))
        {
            this->setMarkets(this->markets);
        }
        // init the request rate limiter
        this->initRestRateLimiter();
        // sanbox mode
        std::any isSandbox = this->safeBool2(this->options, std::string("sandbox"), std::string("testnet"), false);
        if (isTrue(isEqual(isSandbox, true)))
        {
            this->setSandboxMode(isSandbox);
        }
    }

    virtual void initRestRateLimiter()
    {
        if (isTrue(isTrue(isEqual(this->rateLimit, std::any{})) || isTrue((isTrue(!isEqual(this->id, std::any{})) && isTrue(isEqual(this->rateLimit, -1))))))
        {
            throw ExchangeError(toString(add(this->id, std::string(".rateLimit property is not configured"))));
        }
        std::any refillRate = this->MAX_VALUE;
        if (isTrue(isGreaterThan(this->rateLimit, 0)))
        {
            refillRate = divide(1, this->rateLimit);
        }
        std::any useLeaky = isTrue((isEqual(this->rollingWindowSize, 0))) || isTrue((isEqual(this->rateLimiterAlgorithm, std::string("leakyBucket"))));
        std::any algorithm = (isTrue(useLeaky) ? std::any(std::string("leakyBucket")) : std::any(std::string("rollingWindow")));
        std::any defaultBucket = ccxt::dict {
            { std::string("delay"), 0.001 },
            { std::string("capacity"), 1 },
            { std::string("cost"), 1 },
            { std::string("refillRate"), refillRate },
            { std::string("algorithm"), algorithm },
            { std::string("windowSize"), this->rollingWindowSize },
            { std::string("rateLimit"), this->rateLimit },
        };
        std::any existingBucket = (isTrue((isEqual(this->tokenBucket, std::any{}))) ? std::any(ccxt::dict {}) : std::any(this->tokenBucket));
        this->tokenBucket = this->extend(defaultBucket, existingBucket);
        this->initThrottler();
    }

    virtual void featuresGenerator()
    {
        //
        // in the exchange-specific features can be something like this, where we support 'string' aliases too:
        //
        //     {
        //         'my' : {
        //             'createOrder' : {...},
        //         },
        //         'swap': {
        //             'linear': {
        //                 'extends': my',
        //             },
        //         },
        //     }
        //
        if (isTrue(isEqual(this->features, std::any{})))
        {
            return;
        }
        // reconstruct
        std::any initialFeatures = this->features;
        this->features = ccxt::dict {};
        std::any unifiedMarketTypes = ccxt::list{std::string("spot"), std::string("swap"), std::string("future"), std::string("option")};
        std::any subTypes = ccxt::list{std::string("linear"), std::string("inverse")};
        // atm only support basic methods, eg: 'createOrder', 'fetchOrder', 'fetchOrders', 'fetchMyTrades'
        for (std::any i = 0; isLessThan(i, getArrayLength(unifiedMarketTypes)); postFixIncrement(i))
        {
            std::any marketType = ::getValue(unifiedMarketTypes, i);
            // if marketType is not filled for this exchange, don't add that in `features`
            if (!isTrue((inOp(initialFeatures, marketType))))
            {
                ::setValue(this->features, marketType, std::any{});
            } else
            {
                if (isTrue(isEqual(marketType, std::string("spot"))))
                {
                    ::setValue(this->features, marketType, this->featuresMapper(initialFeatures, marketType));
                } else
                {
                    ::setValue(this->features, marketType, ccxt::dict {});
                    for (std::any j = 0; isLessThan(j, getArrayLength(subTypes)); postFixIncrement(j))
                    {
                        std::any subType = ::getValue(subTypes, j);
                        ::setValue(::getValue(this->features, marketType), subType, this->featuresMapper(initialFeatures, marketType, subType));
                    }
                }
            }
        }
    }

    virtual std::any featuresMapper(std::any initialFeatures, std::any marketType, std::any subType = std::any{})
    {
        std::any featuresObj = (isTrue((!isEqual(subType, std::any{}))) ? std::any(::getValue(::getValue(initialFeatures, marketType), subType)) : std::any(::getValue(initialFeatures, marketType)));
        // if exchange does not have that market-type (eg. future>inverse)
        if (isTrue(isEqual(featuresObj, std::any{})))
        {
            return std::any{};
        }
        std::any extendsStr = this->safeString(featuresObj, std::string("extends"));
        if (isTrue(!isEqual(extendsStr, std::any{})))
        {
            featuresObj = this->omit(featuresObj, std::string("extends"));
            std::any extendObj = this->featuresMapper(initialFeatures, extendsStr);
            featuresObj = this->deepExtend(extendObj, featuresObj);
        }
        //
        // ### corrections ###
        //
        // createOrder
        if (isTrue(inOp(featuresObj, std::string("createOrder"))))
        {
            std::any value = this->safeDict(::getValue(featuresObj, std::string("createOrder")), std::string("attachedStopLossTakeProfit"));
            ::setValue(::getValue(featuresObj, std::string("createOrder")), std::string("stopLoss"), value);
            ::setValue(::getValue(featuresObj, std::string("createOrder")), std::string("takeProfit"), value);
            if (isTrue(isEqual(marketType, std::string("spot"))))
            {
                // default 'hedged': false
                ::setValue(::getValue(featuresObj, std::string("createOrder")), std::string("hedged"), false);
                // default 'leverage': false
                if (!isTrue((inOp(::getValue(featuresObj, std::string("createOrder")), std::string("leverage")))))
                {
                    ::setValue(::getValue(featuresObj, std::string("createOrder")), std::string("leverage"), false);
                }
            }
            // default 'GTC' to true
            if (isTrue(isEqual(this->safeBool(::getValue(::getValue(featuresObj, std::string("createOrder")), std::string("timeInForce")), std::string("GTC")), std::any{})))
            {
                ::setValue(::getValue(::getValue(featuresObj, std::string("createOrder")), std::string("timeInForce")), std::string("GTC"), true);
            }
        }
        // other methods
        std::any keys = getObjectKeys(featuresObj);
        for (std::any i = 0; isLessThan(i, getArrayLength(keys)); postFixIncrement(i))
        {
            std::any key = ::getValue(keys, i);
            std::any featureBlock = ::getValue(featuresObj, key);
            if (isTrue(!isTrue(this->inArray(key, ccxt::list{std::string("sandbox")})) && isTrue(!isEqual(featureBlock, std::any{}))))
            {
                // default "symbolRequired" to false to all methods (except `createOrder`)
                if (!isTrue((inOp(featureBlock, std::string("symbolRequired")))))
                {
                    ::setValue(featureBlock, std::string("symbolRequired"), this->inArray(key, ccxt::list{std::string("createOrder"), std::string("createOrders"), std::string("fetchOHLCV")}));
                }
            }
        }
        return featuresObj;
    }

    virtual std::any featureValue(std::any symbol, std::any methodName = std::any{}, std::any paramName = std::any{}, std::any defaultValue = std::any{})
    {
        /**
         * @method
         * @name exchange#featureValue
         * @description this method is a very deterministic to help users to know what feature is supported by the exchange
         * @param {string} [symbol] unified symbol
         * @param {string} [methodName] view currently supported methods: https://docs.ccxt.com/README?id=features
         * @param {string} [paramName] unified param value, like: `triggerPrice`, `stopLoss.triggerPrice` (check docs for supported param names)
         * @param {object} [defaultValue] return default value if no result found
         * @returns {object} returns feature value
         */
        std::any market = this->market(symbol);
        return this->featureValueByType(::getValue(market, std::string("type")), ::getValue(market, std::string("subType")), methodName, paramName, defaultValue);
    }

    virtual std::any featureValueByType(std::any marketType, std::any subType, std::any methodName = std::any{}, std::any paramName = std::any{}, std::any defaultValue = std::any{})
    {
        /**
         * @method
         * @name exchange#featureValueByType
         * @description this method is a very deterministic to help users to know what feature is supported by the exchange
         * @param {string} [marketType] supported only: "spot", "swap", "future"
         * @param {string} [subType] supported only: "linear", "inverse"
         * @param {string} [methodName] view currently supported methods: https://docs.ccxt.com/README?id=features
         * @param {string} [paramName] unified param value (check docs for supported param names)
         * @param {object} [defaultValue] return default value if no result found
         * @returns {object} returns feature value
         */
        // if exchange does not yet have features manually implemented
        if (isTrue(isEqual(this->features, std::any{})))
        {
            return defaultValue;
        }
        if (isTrue(isEqual(marketType, std::any{})))
        {
            return defaultValue;  // marketType is required
        }
        // if marketType (e.g. 'option') does not exist in features
        if (!isTrue((inOp(this->features, marketType))))
        {
            return defaultValue;  // unsupported marketType, check "exchange.features" for details
        }
        // if marketType dict undefined
        if (isTrue(isEqual(::getValue(this->features, marketType), std::any{})))
        {
            return defaultValue;
        }
        std::any methodsContainer = ::getValue(this->features, marketType);
        if (isTrue(isEqual(subType, std::any{})))
        {
            if (isTrue(!isEqual(marketType, std::string("spot"))))
            {
                return defaultValue;  // subType is required for non-spot markets
            }
        } else
        {
            if (!isTrue((inOp(::getValue(this->features, marketType), subType))))
            {
                return defaultValue;  // unsupported subType, check "exchange.features" for details
            }
            // if subType dict undefined
            if (isTrue(isEqual(::getValue(::getValue(this->features, marketType), subType), std::any{})))
            {
                return defaultValue;
            }
            methodsContainer = ::getValue(::getValue(this->features, marketType), subType);
        }
        // if user wanted only marketType and didn't provide methodName, eg: featureIsSupported('spot')
        if (isTrue(isEqual(methodName, std::any{})))
        {
            return (isTrue((!isEqual(defaultValue, std::any{}))) ? std::any(defaultValue) : std::any(methodsContainer));
        }
        if (!isTrue((inOp(methodsContainer, methodName))))
        {
            return defaultValue;  // unsupported method, check "exchange.features" for details');
        }
        std::any methodDict = ::getValue(methodsContainer, methodName);
        if (isTrue(isEqual(methodDict, std::any{})))
        {
            return defaultValue;
        }
        // if user wanted only method and didn't provide `paramName`, eg: featureIsSupported('swap', 'linear', 'createOrder')
        if (isTrue(isEqual(paramName, std::any{})))
        {
            return (isTrue((!isEqual(defaultValue, std::any{}))) ? std::any(defaultValue) : std::any(methodDict));
        }
        std::any splited = split(paramName, std::string(".")); // can be only parent key (`stopLoss`) or with child (`stopLoss.triggerPrice`)
        std::any parentKey = ::getValue(splited, 0);
        std::any subKey = this->safeString(splited, 1);
        if (!isTrue((inOp(methodDict, parentKey))))
        {
            return defaultValue;  // unsupported paramName, check "exchange.features" for details');
        }
        std::any dictionary = this->safeDict(methodDict, parentKey);
        if (isTrue(isEqual(dictionary, std::any{})))
        {
            // if the value is not dictionary but a scalar value (or undefined), return as is
            return ::getValue(methodDict, parentKey);
        } else
        {
            // return as is, when calling without subKey eg: featureValueByType('spot', undefined, 'createOrder', 'stopLoss')
            if (isTrue(isEqual(subKey, std::any{})))
            {
                return ::getValue(methodDict, parentKey);
            }
            // throw an exception for unsupported subKey
            if (!isTrue((inOp(::getValue(methodDict, parentKey), subKey))))
            {
                return defaultValue;  // unsupported subKey, check "exchange.features" for details
            }
            return ::getValue(::getValue(methodDict, parentKey), subKey);
        }
    }

    virtual std::any orderbookChecksumMessage(std::any symbol)
    {
