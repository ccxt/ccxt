    virtual std::any currency(std::any code)
    {
        if (isTrue(isEqual(code, std::any{})))
        {
            throw ArgumentsRequired(toString(add(this->id, std::string(" currency() requires a code argument"))));
        }
        std::any keys = getObjectKeys(this->currencies);
        std::any numCurrencies = getArrayLength(keys);
        if (isTrue(isEqual(numCurrencies, 0)))
        {
            throw ExchangeError(toString(add(this->id, std::string(" currencies not loaded"))));
        }
        if (isTrue(isString(code)))
        {
            std::any currencies = this->currencies;
            std::any currenciesById = this->currencies_by_id;
            if (isTrue(inOp(currencies, code)))
            {
                return ::getValue(currencies, code);
            } else if (isTrue(isTrue((!isEqual(currenciesById, std::any{}))) && isTrue((inOp(currenciesById, code)))))
            {
                return ::getValue(currenciesById, code);
            }
        }
        throw ExchangeError(toString(add(add(this->id, std::string(" does not have currency code ")), code)));
    }

    virtual std::any market(std::any symbol)
    {
        if (isTrue(isEqual(symbol, std::any{})))
        {
            throw ArgumentsRequired(toString(add(this->id, std::string(" market() requires a symbol argument"))));
        }
        std::any markets = this->markets;
        if (isTrue(isEqual(markets, std::any{})))
        {
            throw ExchangeError(toString(add(this->id, std::string(" markets not loaded"))));
        }
        std::any marketsById = this->markets_by_id;
        if (isTrue(inOp(markets, symbol)))
        {
            return ::getValue(markets, symbol);
        } else if (isTrue(isTrue((!isEqual(marketsById, std::any{}))) && isTrue((inOp(marketsById, symbol)))))
        {
            std::any marketsList = ::getValue(marketsById, symbol);
            std::any defaultType = this->safeString2(this->options, std::string("defaultType"), std::string("defaultSubType"), std::string("spot"));
            for (std::any i = 0; isLessThan(i, getArrayLength(marketsList)); postFixIncrement(i))
            {
                std::any market = ::getValue(marketsList, i);
                if (isTrue(isEqual(::getValue(market, defaultType), true)))
                {
                    return market;
                }
            }
            return ::getValue(marketsList, 0);
        } else if (isTrue(isTrue(isTrue(isTrue((endsWith(symbol, std::string("-C")))) || isTrue((endsWith(symbol, std::string("-P"))))) || isTrue((startsWith(symbol, std::string("C-"))))) || isTrue((startsWith(symbol, std::string("P-"))))))
        {
            return this->createExpiredOptionMarket(symbol);
        }
        throw BadSymbol(toString(add(add(this->id, std::string(" does not have market symbol ")), symbol)));
    }

