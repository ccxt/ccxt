    virtual std::any filterByLimit(std::any array, std::any limit = std::any{}, std::any key = std::string("timestamp"), std::any fromStart = false)
    {
        if (isTrue(this->valueIsDefined(limit)))
        {
            std::any arrayLength = getArrayLength(array);
            if (isTrue(isGreaterThan(arrayLength, 0)))
            {
                std::any ascending = true;
                if (isTrue((inOp(::getValue(array, 0), key))))
                {
                    std::any first = ::getValue(::getValue(array, 0), key);
                    std::any last = ::getValue(::getValue(array, subtract(arrayLength, 1)), key);
                    if (isTrue(isTrue(!isEqual(first, std::any{})) && isTrue(!isEqual(last, std::any{}))))
                    {
                        ascending = isLessThanOrEqual(first, last); // true if array is sorted in ascending order based on 'timestamp'
                    }
                }
                if (isTrue(fromStart))
                {
                    if (isTrue(isGreaterThan(limit, arrayLength)))
                    {
                        limit = arrayLength;
                    }
                    // array = ascending ? this.arraySlice (array, 0, limit) : this.arraySlice (array, -limit);
                    if (isTrue(ascending))
                    {
                        array = this->arraySlice(array, 0, limit);
                    } else
                    {
                        array = this->arraySlice(array, prefixUnaryNeg(limit));
                    }
                } else
                {
                    // array = ascending ? this.arraySlice (array, -limit) : this.arraySlice (array, 0, limit);
                    if (isTrue(ascending))
                    {
                        array = this->arraySlice(array, prefixUnaryNeg(limit));
                    } else
                    {
                        array = this->arraySlice(array, 0, limit);
                    }
                }
            }
        }
        return array;
    }

    virtual std::any filterBySinceLimit(std::any array, std::any since = std::any{}, std::any limit = std::any{}, std::any key = std::string("timestamp"), std::any tail = false)
    {
        if (isTrue(isEqual(array, std::any{})))
        {
            return ccxt::list{};
        }
        std::any sinceIsDefined = this->valueIsDefined(since);
        std::any parsedArray = this->toArray(array);
        std::any result = parsedArray;
        if (isTrue(sinceIsDefined))
        {
            result = ccxt::list{};
            for (std::any i = 0; isLessThan(i, getArrayLength(parsedArray)); postFixIncrement(i))
            {
                std::any entry = ::getValue(parsedArray, i);
                std::any value = this->safeValue(entry, key);
                if (isTrue(isTrue(isTrue(isTrue((!isEqual(value, std::any{}))) && isTrue((!isEqual(value, null)))) && isTrue((!isEqual(value, 0)))) && isTrue((isGreaterThanOrEqual(value, since)))))
                {
                    arrayPush(result, entry);
                }
            }
        }
        if (isTrue(isTrue(tail) && isTrue(!isEqual(limit, std::any{}))))
        {
            return this->arraySlice(result, prefixUnaryNeg(limit));
        }
        // if the user provided a 'since' argument
        // we want to limit the result starting from the 'since'
        std::any shouldFilterFromStart = !isTrue(tail) && isTrue(sinceIsDefined);
        return this->filterByLimit(result, limit, key, shouldFilterFromStart);
    }

    virtual std::any filterByValueSinceLimit(std::any array, std::any field, std::any value = std::any{}, std::any since = std::any{}, std::any limit = std::any{}, std::any key = std::string("timestamp"), std::any tail = false)
    {
        std::any valueIsDefined = this->valueIsDefined(value);
        std::any sinceIsDefined = this->valueIsDefined(since);
        std::any parsedArray = this->toArray(array);
        std::any result = parsedArray;
        // single-pass filter for both symbol and since
        if (isTrue(isTrue(valueIsDefined) || isTrue(sinceIsDefined)))
        {
            result = ccxt::list{};
            for (std::any i = 0; isLessThan(i, getArrayLength(parsedArray)); postFixIncrement(i))
            {
                std::any entry = ::getValue(parsedArray, i);
                // safeValue (not entry[field]) so a missing field is a non-match, not a
                // KeyError in python/php — prediction structures key on outcome, not symbol
                std::any entryFiledEqualValue = isEqual(this->safeValue(entry, field), value);
                std::any firstCondition = (isTrue(valueIsDefined) ? std::any(entryFiledEqualValue) : std::any(true));
                std::any entryKeyValue = this->safeValue(entry, key);
                std::any entryKeyGESince = isTrue(isTrue(isTrue(isTrue((!isEqual(entryKeyValue, std::any{}))) && isTrue((!isEqual(entryKeyValue, null)))) && isTrue((!isEqual(entryKeyValue, 0)))) && isTrue((!isEqual(since, std::any{})))) && isTrue((isGreaterThanOrEqual(entryKeyValue, since)));
                std::any secondCondition = (isTrue(sinceIsDefined) ? std::any(entryKeyGESince) : std::any(true));
                if (isTrue(isTrue(firstCondition) && isTrue(secondCondition)))
                {
                    arrayPush(result, entry);
                }
            }
        }
        if (isTrue(isTrue(tail) && isTrue(!isEqual(limit, std::any{}))))
        {
            return this->arraySlice(result, prefixUnaryNeg(limit));
        }
        return this->filterByLimit(result, limit, key, sinceIsDefined);
    }

    /**
     * @method
     * @name Exchange#setSandboxMode
     * @description set the sandbox mode for the exchange
     * @param {boolean} enabled true to enable sandbox mode, false to disable it
     */
    virtual void setSandboxMode(std::any enabled)
    {
        if (isTrue(enabled))
        {
            if (isTrue(inOp(this->urls, std::string("test"))))
            {
                if (isTrue(isString(::getValue(this->urls, std::string("api")))))
                {
                    ::setValue(this->urls, std::string("apiBackup"), ::getValue(this->urls, std::string("api")));
                    ::setValue(this->urls, std::string("api"), ::getValue(this->urls, std::string("test")));
                } else
                {
                    ::setValue(this->urls, std::string("apiBackup"), this->clone(::getValue(this->urls, std::string("api"))));
                    ::setValue(this->urls, std::string("api"), this->clone(::getValue(this->urls, std::string("test"))));
                }
            } else
            {
                throw NotSupported(toString(add(this->id, std::string(" does not have a sandbox URL"))));
            }
            // set flag
            this->isSandboxModeEnabled = true;
        } else if (isTrue(inOp(this->urls, std::string("apiBackup"))))
        {
            if (isTrue(isString(::getValue(this->urls, std::string("api")))))
            {
                ::setValue(this->urls, std::string("api"), ::getValue(this->urls, std::string("apiBackup")));
            } else
            {
                ::setValue(this->urls, std::string("api"), this->clone(::getValue(this->urls, std::string("apiBackup"))));
            }
            std::any newUrls = this->omit(this->urls, std::string("apiBackup"));
            this->urls = newUrls;
            // set flag
            this->isSandboxModeEnabled = false;
        }
    }

    /**
     * @method
     * @name Exchange#enableDemoTrading
     * @description enables or disables demo trading mode
     * @param {boolean} [enable] true if demo trading should be enabled, false otherwise
     */
    virtual void enableDemoTrading(std::any enable)
    {
        if (isTrue(this->isSandboxModeEnabled))
        {
            throw NotSupported(toString(add(this->id, std::string(" demo trading does not support in sandbox environment. Please check https://www.binance.com/en/support/faq/detail/9be58f73e5e14338809e3b705b9687dd to see the differences"))));
        }
        if (isTrue(enable))
        {
            ::setValue(this->urls, std::string("apiBackupDemoTrading"), ::getValue(this->urls, std::string("api")));
            ::setValue(this->urls, std::string("api"), ::getValue(this->urls, std::string("demo")));
        } else if (isTrue(inOp(this->urls, std::string("apiBackupDemoTrading"))))
        {
            ::setValue(this->urls, std::string("api"), ::getValue(this->urls, std::string("apiBackupDemoTrading")));
            std::any newUrls = this->omit(this->urls, std::string("apiBackupDemoTrading"));
            this->urls = newUrls;
        }
        ::setValue(this->options, std::string("enableDemoTrading"), enable);
    }

