virtual ccxt::any loadStaticData(ccxt::any folder,
                                 ccxt::any targetExchange = ccxt::any{}) {
  ccxt::any result = ccxt::dict{};
  if (isTrue(isTrue(!isEqual(targetExchange, ccxt::any{})) &&
             isTrue(!isEqual(targetExchange, std::string(""))))) {
    // read a single exchange
    ccxt::any path = add(add(folder, targetExchange), std::string(".json"));
    if (!isTrue(ioFileExists(path))) {
      dump(add(std::string("[WARN] tests not found: "), path));
      return ccxt::any{};
    }
    ::setValue(result, targetExchange, ioFileRead(path));
    return result;
  }
  ccxt::any files = ioDirRead(folder);
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(files));
       postFixIncrement(i)) {
    ccxt::any file = ::getValue(files, i);
    // the only non-json entry in the static dirs is the prediction/ subfolder
    // (prediction fixtures live under static/<type>/prediction/). skip it by
    // name — a string-equality check the AST transpiler renders correctly in
    // every language (indexOf/slice on this entry mis-transpile in PHP:
    // array_search / mb_strpos(...) < 0 / ccxt::any{})
    if (isTrue(isEqual(file, std::string("prediction")))) {
      continue;
    }
    ccxt::any exchangeName =
        replace(file, std::string(".json"), std::string(""));
    ccxt::any content = ioFileRead(add(folder, file));
    ::setValue(result, exchangeName, content);
  }
  return result;
}

virtual ccxt::any removeHostnamefromUrl(ccxt::any url) {
  if (isTrue(isEqual(url, ccxt::any{}))) {
    return ccxt::any{};
  }
  ccxt::any urlParts = split(url, std::string("/"));
  ccxt::any res = std::string("");
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(urlParts));
       postFixIncrement(i)) {
    if (isTrue(isGreaterThan(i, 2))) {
      ccxt::any current = ::getValue(urlParts, i);
      if (isTrue(isGreaterThan(getIndexOf(current, std::string("?")), -1))) {
        // handle urls like this: /v1/account/accounts?AccessK
        ccxt::any currentParts = split(current, std::string("?"));
        res = add(res, std::string("/"));
        res = add(res, ::getValue(currentParts, 0));
        break;
      }
      res = add(res, std::string("/"));
      res = add(res, current);
    }
  }
  return res;
}

virtual ccxt::any urlencodedToDict(ccxt::any url) {
  ccxt::any result = ccxt::dict{};
  ccxt::any parts = split(url, std::string("&"));
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(parts));
       postFixIncrement(i)) {
    ccxt::any part = ::getValue(parts, i);
    ccxt::any keyValue = split(part, std::string("="));
    ccxt::any keysLength = getArrayLength(keyValue);
    if (isTrue(!isEqual(keysLength, 2))) {
      continue;
    }
    ccxt::any key = ::getValue(keyValue, 0);
    ccxt::any value = ::getValue(keyValue, 1);
    if (isTrue(isTrue((!isEqual(value, ccxt::any{}))) &&
               isTrue((isTrue((startsWith(value, std::string("[")))) ||
                       isTrue((startsWith(value, std::string("{")))))))) {
      // some exchanges might return something like this:
      // timestamp=1699382693405&batchOrders=[{\"symbol\":\"LTCUSDT\",\"side\":\"BUY\",\"newClientOrderI
      value = jsonParse(value);
    }
    ::setValue(result, key, value);
  }
  return result;
}

// reproduces the JS falsiness of `!value` for the output values compared below.
// note: a plain `value === 0` is not enough, php's strict comparison says `0.0
// !== 0`, so a computed float zero would not be treated as empty and would
// mismatch a stored null (#30082)
virtual ccxt::any isEmptyOutputValue(ccxt::any exchange, ccxt::any value) {
  if (isTrue(isTrue(isTrue((isEqual(value, ccxt::any{}))) ||
                    isTrue((isEqual(value, false)))) ||
             isTrue((isEqual(value, std::string("")))))) {
    return true;
  }
  if (isTrue(isTrue(callDynamically(exchange, std::string("isDictionary"),
                                    ccxt::list{value})) ||
             isTrue(isArray(value)))) {
    return false; // a non-empty container, `!value` is false for containers in
                  // js
  }
  if (isTrue(isTrue((isString(value))) || isTrue((isBool(value))))) {
    return false; // non-empty string / true, both handled above
  }
  // whatever is left is numeric - compare with inequalities so that int and
  // float zero are both detected in every language
  return isTrue((isLessThanOrEqual(value, 0))) &&
         isTrue((isGreaterThanOrEqual(value, 0)));
}

virtual ccxt::any isVacantValue(ccxt::any exchange, ccxt::any value) {
  // C# only. The unified types are structs, so the two sides of the comparison
  // carry different key sets for reasons that are structural, not behavioural:
  //   - a struct field the venue never populated is still a field, and comes
  //     back as an explicit null the fixture may not carry (Balance.debt);
  //   - a unified key the struct has no field for cannot come back at all,
  //     however the fixture carries it (Order has no `fees` field, and the
  //     stored value is `[]` or a list of all-null Fee objects).
  // Neither direction is recoverable from the struct, so a key that is absent
  // on one side counts as a difference only when it actually carries data.
  if (isTrue(isNullValue(value))) {
    return true;
  }
  if (isTrue(isArray(value))) {
    for (ccxt::any i = 0; isLessThan(i, getArrayLength(value));
         postFixIncrement(i)) {
      if (!isTrue(this->isVacantValue(exchange, ::getValue(value, i)))) {
        return false;
      }
    }
    return true;
  }
  if (isTrue(callDynamically(exchange, std::string("isDictionary"),
                             ccxt::list{value}))) {
    ccxt::any keys = getObjectKeys(value);
    for (ccxt::any i = 0; isLessThan(i, getArrayLength(keys));
         postFixIncrement(i)) {
      if (!isTrue(this->isVacantValue(
              exchange, ::getValue(value, ::getValue(keys, i))))) {
        return false;
      }
    }
    return true;
  }
  return false;
}

virtual ccxt::any countSignificantKeys(ccxt::any exchange, ccxt::any target,
                                       ccxt::any otherKeys) {
  // count the keys of `target`, skipping those the other side does not have at
  // all and which carry no data here (see isVacantValue)
  ccxt::any keys = getObjectKeys(target);
  ccxt::any count = 0;
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(keys));
       postFixIncrement(i)) {
    ccxt::any key = ::getValue(keys, i);
    if (isTrue(
            !isTrue((callDynamically(exchange, std::string("inArray"),
                                     ccxt::list{key, otherKeys}))) &&
            isTrue(this->isVacantValue(exchange, ::getValue(target, key))))) {
      continue;
    }
    count = add(count, 1);
  }
  return count;
}

virtual ccxt::any
assertNewAndStoredOutputInner(ccxt::any exchange, ccxt::any skipKeys,
                              ccxt::any newOutput, ccxt::any storedOutput,
                              ccxt::any strictTypeCheck = true,
                              ccxt::any assertingKey = ccxt::any{}) {
  if (isTrue(isTrue(isNullValue(newOutput)) &&
             isTrue(isNullValue(storedOutput)))) {
    return true;
  }
  ccxt::any newOutputIsEmpty = this->isEmptyOutputValue(exchange, newOutput);
  ccxt::any storedOutputIsEmpty =
      this->isEmptyOutputValue(exchange, storedOutput);
  if (isTrue(isTrue(newOutputIsEmpty) && isTrue(storedOutputIsEmpty))) {
    return true;
  }
  if (isTrue(isTrue((isEqual(this->lang, std::string("C#")))) ||
             isTrue((isEqual(this->lang, std::string("C++")))))) {
    // a struct is never null: an absent `fee` comes back as a Fee whose every
    // field is null, and an absent `fees` as []. The stored fixture writes the
    // same thing as a bare null. Treat "carries no data" as equal on both
    // sides, but only when neither side carries data (see isVacantValue).
    if (isTrue(isTrue(this->isVacantValue(exchange, newOutput)) &&
               isTrue(this->isVacantValue(exchange, storedOutput)))) {
      return true;
    }
  }
  // if needed convert stringified jsons to objects
  if (isTrue(isTrue(isTrue(isTrue((isString(storedOutput))) &&
                           isTrue((isString(newOutput)))) &&
                    isTrue(startsWith(storedOutput, std::string("{")))) &&
             isTrue(startsWith(newOutput, std::string("{"))))) {
    storedOutput = jsonParse(storedOutput);
    newOutput = jsonParse(newOutput);
  }
  if (isTrue(isTrue(callDynamically(exchange, std::string("isDictionary"),
                                    ccxt::list{storedOutput})) &&
             isTrue(callDynamically(exchange, std::string("isDictionary"),
                                    ccxt::list{newOutput})))) {
    ccxt::any storedOutputKeys = getObjectKeys(storedOutput);
    ccxt::any newOutputKeys = getObjectKeys(newOutput);
    ccxt::any storedKeysLength = getArrayLength(storedOutputKeys);
    ccxt::any newKeysLength = getArrayLength(newOutputKeys);
    if (isTrue(isTrue((isEqual(this->lang, std::string("C#")))) ||
               isTrue((isEqual(this->lang, std::string("C++")))))) {
      // the unified types are structs there, so an unpopulated field still
      // comes back (as an explicit null) and a unified key with no struct
      // field cannot come back at all; count only the keys that carry data
      storedKeysLength =
          this->countSignificantKeys(exchange, storedOutput, newOutputKeys);
      newKeysLength =
          this->countSignificantKeys(exchange, newOutput, storedOutputKeys);
    }
    this->assertStaticError(isEqual(storedKeysLength, newKeysLength),
                            std::string("output length mismatch"), storedOutput,
                            newOutput);
    // iterate over the keys
    for (ccxt::any i = 0; isLessThan(i, getArrayLength(storedOutputKeys));
         postFixIncrement(i)) {
      ccxt::any key = ::getValue(storedOutputKeys, i);
      if (isTrue(callDynamically(exchange, std::string("inArray"),
                                 ccxt::list{key, skipKeys}))) {
        continue;
      }
      if (!isTrue((callDynamically(exchange, std::string("inArray"),
                                   ccxt::list{key, newOutputKeys})))) {
        if (isTrue(
                isTrue((isTrue((isEqual(this->lang, std::string("C#")))) ||
                        isTrue((isEqual(this->lang, std::string("C++")))))) &&
                isTrue(this->isVacantValue(exchange,
                                           ::getValue(storedOutput, key))))) {
          continue;
        }
        this->assertStaticError(false,
                                add(std::string("output key missing: "), key),
                                storedOutput, newOutput);
      }
      ccxt::any storedValue = ::getValue(storedOutput, key);
      ccxt::any newValue = ::getValue(newOutput, key);
      // Recurse into the *inner* (non-try/catch) variant: the
      // wrapper's try/catch is only for top-level failure
      // reporting, and in the Rust port it transpiles to a
      // `catch_unwind` per node — setting that up at every one
      // of a result's thousands of nodes made `--responseTests`
      // take minutes. A failure still unwinds to the single
      // top-level wrapper.
      this->assertNewAndStoredOutputInner(exchange, skipKeys, newValue,
                                          storedValue, strictTypeCheck, key);
    }
  } else if (isTrue(
                 isTrue(isTrue(isTrue((!isEqual(storedOutput, ccxt::any{}))) &&
                               isTrue((!isEqual(newOutput, ccxt::any{})))) &&
                        isTrue(isArray(storedOutput))) &&
                 isTrue((isArray(newOutput))))) {
    ccxt::any storedArrayLength = getArrayLength(storedOutput);
    ccxt::any newArrayLength = getArrayLength(newOutput);
    this->assertStaticError(isEqual(storedArrayLength, newArrayLength),
                            std::string("output length mismatch"), storedOutput,
                            newOutput);
    for (ccxt::any i = 0; isLessThan(i, getArrayLength(storedOutput));
         postFixIncrement(i)) {
      ccxt::any storedItem = ::getValue(storedOutput, i);
      ccxt::any newItem = ::getValue(newOutput, i);
      this->assertNewAndStoredOutputInner(exchange, skipKeys, newItem,
                                          storedItem, strictTypeCheck);
    }
  } else {
    // built-in types like strings, numbers, booleans
    ccxt::any sanitizedNewOutput =
        (isTrue((isNullValue(newOutput)))
             ? ccxt::any(ccxt::any{})
             : ccxt::any(newOutput)); // we store ccxt::any{} as nulls in the
                                      // json file so we need to convert it back
    ccxt::any sanitizedStoredOutput =
        (isTrue((isNullValue(storedOutput))) ? ccxt::any(ccxt::any{})
                                             : ccxt::any(storedOutput));
    // a truthiness test here turns a real 0 / 0.0 / "" into "ccxt::any{}",
    // which a typed core hits constantly (its Num fields are real doubles, so
    // an unset cost arrives as 0.0 rather than as a string). Test for
    // ccxt::any{} instead.
    ccxt::any newOutputString =
        (isTrue((!isEqual(sanitizedNewOutput, ccxt::any{})))
             ? ccxt::any(toString(sanitizedNewOutput))
             : ccxt::any(std::string("undefined")));
    ccxt::any storedOutputString =
        (isTrue((!isEqual(sanitizedStoredOutput, ccxt::any{})))
             ? ccxt::any(toString(sanitizedStoredOutput))
             : ccxt::any(std::string("undefined")));
    ccxt::any messageError =
        add(add(add(std::string("output value mismatch:"), newOutputString),
                std::string(" != ")),
            storedOutputString);
    if (isTrue(isTrue(strictTypeCheck) &&
               isTrue((!isEqual(this->lang, std::string("C#")))))) {
      // upon building the request we want strict type check to make sure all
      // the types are correct when comparing the response we want to allow some
      // flexibility, because a 50.0 can be equal to 50 after saving it to the
      // json file
      this->assertStaticError(
          isEqual(sanitizedNewOutput, sanitizedStoredOutput), messageError,
          storedOutput, newOutput, assertingKey);
    } else {
      ccxt::any isComputedBool = (isBool(sanitizedNewOutput));
      ccxt::any isStoredBool = (isBool(sanitizedStoredOutput));
      ccxt::any isComputedString = (isString(sanitizedNewOutput));
      ccxt::any isStoredString = (isString(sanitizedStoredOutput));
      ccxt::any isComputedUndefined =
          (isEqual(sanitizedNewOutput, ccxt::any{}));
      ccxt::any isStoredUndefined =
          (isEqual(sanitizedStoredOutput, ccxt::any{}));
      ccxt::any shouldBeSame =
          isTrue(isTrue((isEqual(isComputedBool, isStoredBool))) &&
                 isTrue((isEqual(isComputedString, isStoredString)))) &&
          isTrue((isEqual(isComputedUndefined, isStoredUndefined)));
      if (isTrue(
              isTrue(isTrue(isTrue(isTrue(!isTrue(shouldBeSame) &&
                                          isTrue((isTrue((isEqual(
                                                      this->lang,
                                                      std::string("PY")))) ||
                                                  isTrue((isEqual(
                                                      this->lang,
                                                      std::string("C#"))))))) &&
                                   !isTrue(isComputedBool)) &&
                            !isTrue(isStoredBool)) &&
                     !isTrue(isComputedUndefined)) &&
              !isTrue(isStoredUndefined))) {
        // python parses json numbers natively (arbitrary-precision ints), while
        // fixtures captured under number-quoting store them as strings -
        // compare numerically like C#/GO c#: a typed core returns the unified
        // `Num` fields as a real double, whereas the fixture was captured
        // through the untyped path and kept the venue's quoted string (cost
        // "0.02" vs 0.02) - same value, different json spelling pass the
        // sanitized VALUES, not their string forms: C# renders a small double
        // as "6.79E-05", which parseToNumeric cannot parse. And only the STRING
        // side needs parsing - parseToNumeric round-trips a double through
        // numberToString/decimal and drops its last significant digit, so a
        // real 81003.30644700001 stopped matching the stored
        // "81003.306447000009".
        ccxt::any isNumber = false;
        ccxt::any computedNumeric = sanitizedNewOutput;
        ccxt::any storedNumeric = sanitizedStoredOutput;
        try {
          if (isTrue(isComputedString)) {
            computedNumeric =
                callDynamically(exchange, std::string("parseToNumeric"),
                                ccxt::list{sanitizedNewOutput});
          }
          if (isTrue(isStoredString)) {
            storedNumeric =
                callDynamically(exchange, std::string("parseToNumeric"),
                                ccxt::list{sanitizedStoredOutput});
          }
          isNumber = true;
        } catch (const std::exception &e) {
          isNumber = false;
        }
        if (isTrue(isNumber)) {
          this->assertStaticError(isEqual(computedNumeric, storedNumeric),
                                  messageError, storedOutput, newOutput,
                                  assertingKey);
          return true;
        }
      }
      this->assertStaticError(shouldBeSame, std::string("output type mismatch"),
                              storedOutput, newOutput, assertingKey);
      ccxt::any isBoolean = isTrue(isComputedBool) || isTrue(isStoredBool);
      ccxt::any isString = isTrue(isComputedString) || isTrue(isStoredString);
      ccxt::any isUndefined =
          isTrue(isComputedUndefined) ||
          isTrue(isStoredUndefined); // ccxt::any{} is a perfetly valid value
      if (isTrue(isTrue(isTrue(isBoolean) || isTrue(isString)) ||
                 isTrue(isUndefined))) {
        if (isTrue(isTrue((isEqual(this->lang, std::string("C#")))) ||
                   isTrue((isEqual(this->lang, std::string("GO")))))) {
          // tmp c# number comparsion
          ccxt::any isNumber = false;
          try {
            callDynamically(exchange, std::string("parseToNumeric"),
                            ccxt::list{sanitizedNewOutput});
            isNumber = true;
          } catch (const std::exception &e) {
            // if we can't parse it to number, then it's not a number
            isNumber = false;
          }
          if (isTrue(isNumber)) {
            this->assertStaticError(
                isEqual(callDynamically(exchange, std::string("parseToNumeric"),
                                        ccxt::list{sanitizedNewOutput}),
                        callDynamically(exchange, std::string("parseToNumeric"),
                                        ccxt::list{sanitizedStoredOutput})),
                messageError, storedOutput, newOutput, assertingKey);
            return true;
          } else {
            this->assertStaticError(isEqual(convertAscii(newOutputString),
                                            convertAscii(storedOutputString)),
                                    messageError, storedOutput, newOutput,
                                    assertingKey);
            return true;
          }
        } else {
          this->assertStaticError(isEqual(convertAscii(newOutputString),
                                          convertAscii(storedOutputString)),
                                  messageError, storedOutput, newOutput,
                                  assertingKey);
          return true;
        }
      } else {
        if (isTrue(isEqual(this->lang, std::string("C#")))) {
          ccxt::any stringifiedNewOutput =
              callDynamically(exchange, std::string("numberToString"),
                              ccxt::list{sanitizedNewOutput});
          ccxt::any stringifiedStoredOutput =
              callDynamically(exchange, std::string("numberToString"),
                              ccxt::list{sanitizedStoredOutput});
          this->assertStaticError(isEqual(toString(stringifiedNewOutput),
                                          toString(stringifiedStoredOutput)),
                                  messageError, storedOutput, newOutput,
                                  assertingKey);
        } else {
          ccxt::any numericNewOutput =
              callDynamically(exchange, std::string("parseToNumeric"),
                              ccxt::list{newOutputString});
          ccxt::any numericStoredOutput =
              callDynamically(exchange, std::string("parseToNumeric"),
                              ccxt::list{storedOutputString});
          this->assertStaticError(
              isEqual(numericNewOutput, numericStoredOutput), messageError,
              storedOutput, newOutput, assertingKey);
        }
      }
    }
  }
  return true; // c# requ
}

virtual ccxt::any
assertNewAndStoredOutput(ccxt::any exchange, ccxt::any skipKeys,
                         ccxt::any newOutput, ccxt::any storedOutput,
                         ccxt::any strictTypeCheck = true,
                         ccxt::any assertingKey = ccxt::any{}) {
  ccxt::any res = true;
  try {
    res = this->assertNewAndStoredOutputInner(exchange, skipKeys, newOutput,
                                              storedOutput, strictTypeCheck,
                                              assertingKey);
  } catch (const std::exception &e) {
    if (isTrue(this->info)) {
      ccxt::any errorMessage = add(add(add(add(this->varToString(newOutput),
                                               std::string("(calculated)")),
                                           std::string(" != ")),
                                       this->varToString(storedOutput)),
                                   std::string("(stored)"));
      dump(add(std::string("[TEST_FAILURE_DETAIL]"), errorMessage));
    }
    throw;
  }
  return res;
}

virtual ccxt::any varToString(ccxt::any obj = ccxt::any{}) {
  ccxt::any newString = ccxt::any{};
  if (isTrue(isEqual(obj, ccxt::any{}))) {
    newString = std::string("undefined");
  } else if (isTrue(isNullValue(obj))) {
    newString = std::string("null");
  } else {
    newString = jsonStringify(obj);
  }
  return newString;
}

virtual ccxt::any assertStaticRequestOutput(
    ccxt::any exchange, ccxt::any type, ccxt::any skipKeys, ccxt::any storedUrl,
    ccxt::any requestUrl, ccxt::any storedOutput, ccxt::any newOutput) {
  if (isTrue(!isEqual(storedUrl, requestUrl))) {
    // remove the host part from the url
    ccxt::any firstPath = this->removeHostnamefromUrl(storedUrl);
    ccxt::any secondPath = this->removeHostnamefromUrl(requestUrl);
    this->assertStaticError(isEqual(firstPath, secondPath),
                            std::string("url mismatch"), firstPath, secondPath);
  }
  // body (aka storedOutput and newOutput) is not defined and information is in
  // the url example:
  // "https://open-api.bingx.com/openApi/spot/v1/trade/order?quoteOrderQty=5&side=BUY&symbol=LTC-USDT&timestamp=1698777135343&type=MARKET&signature=d55a7e4f7f9dbe56c4004c9f3ab340869d3cb004e2f0b5b861e5fbd1762fd9a0
  if (isTrue(isTrue((isEqual(storedOutput, ccxt::any{}))) &&
             isTrue((isEqual(newOutput, ccxt::any{}))))) {
    if (isTrue(isTrue((!isEqual(storedUrl, ccxt::any{}))) &&
               isTrue((!isEqual(requestUrl, ccxt::any{}))))) {
      ccxt::any storedUrlParts = split(storedUrl, std::string("?"));
      ccxt::any newUrlParts = split(requestUrl, std::string("?"));
      ccxt::any storedUrlQuery = callDynamically(
          exchange, std::string("safeValue"), ccxt::list{storedUrlParts, 1});
      ccxt::any newUrlQuery = callDynamically(
          exchange, std::string("safeValue"), ccxt::list{newUrlParts, 1});
      if (isTrue(isTrue((isEqual(storedUrlQuery, ccxt::any{}))) &&
                 isTrue((isEqual(newUrlQuery, ccxt::any{}))))) {
        // might be a get request without any query parameters
        // example: https://api.gateio.ws/api/v4/delivery/usdt/positions
        return true;
      }
      ccxt::any storedUrlParams = this->urlencodedToDict(storedUrlQuery);
      ccxt::any newUrlParams = this->urlencodedToDict(newUrlQuery);
      this->assertNewAndStoredOutput(exchange, skipKeys, newUrlParams,
                                     storedUrlParams);
      return true;
    }
  }
  if (isTrue(isTrue(isTrue(isEqual(type, std::string("json"))) &&
                    isTrue((!isEqual(storedOutput, ccxt::any{})))) &&
             isTrue((!isEqual(newOutput, ccxt::any{}))))) {
    if (isTrue(isString(storedOutput))) {
      storedOutput = jsonParse(storedOutput);
    }
    if (isTrue(isString(newOutput))) {
      newOutput = jsonParse(newOutput);
    }
  } else if (isTrue(isTrue(isTrue(isEqual(type, std::string("urlencoded"))) &&
                           isTrue((!isEqual(storedOutput, ccxt::any{})))) &&
                    isTrue((!isEqual(newOutput, ccxt::any{}))))) {
    storedOutput = this->urlencodedToDict(storedOutput);
    newOutput = this->urlencodedToDict(newOutput);
  } else if (isTrue(isEqual(type, std::string("both")))) {
    if (isTrue(isTrue((isEqual(startsWith(storedOutput, std::string("{")),
                               true))) ||
               isTrue((isEqual(startsWith(storedOutput, std::string("[")),
                               true))))) {
      storedOutput = jsonParse(storedOutput);
      newOutput = jsonParse(newOutput);
    } else {
      storedOutput = this->urlencodedToDict(storedOutput);
      newOutput = this->urlencodedToDict(newOutput);
    }
  }
  this->assertNewAndStoredOutput(exchange, skipKeys, newOutput, storedOutput);
  return true;
}

virtual void assertStaticResponseOutput(ccxt::any exchange, ccxt::any skipKeys,
                                        ccxt::any computedResult,
                                        ccxt::any storedResult) {
  this->assertNewAndStoredOutput(exchange, skipKeys, computedResult,
                                 storedResult, false);
}

virtual ccxt::any sanitizeDataInput(ccxt::any input) {
  // remove nulls and replace with unefined instead
  if (isTrue(isEqual(input, ccxt::any{}))) {
    return ccxt::any{};
  }
  ccxt::any newInput = ccxt::list{};
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(input));
       postFixIncrement(i)) {
    ccxt::any current = ::getValue(input, i);
    if (isTrue(isNullValue(current))) {
      arrayPush(newInput, ccxt::any{});
    } else {
      arrayPush(newInput, current);
    }
  }
  return newInput;
}

virtual std::shared_future<ccxt::any>
testRequestStatically(ccxt::any exchange, ccxt::any method, ccxt::any data,
                      ccxt::any type, ccxt::any skipKeys) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               ccxt::any output = ccxt::any{};
               ccxt::any requestUrl = ccxt::any{};
               if (isTrue(this->info)) {
                 dump(std::string("[INFO] STATIC REQUEST TEST:"), method,
                      std::string(":"),
                      ::getValue(data, std::string("description")));
               }
               try {
                 if (!isTrue(isSync())) {
                   awaitValue(callExchangeMethodDynamically(
                       exchange, method,
                       this->sanitizeDataInput(
                           ::getValue(data, std::string("input")))));
                 } else {
                   callExchangeMethodDynamicallySync(
                       exchange, method,
                       this->sanitizeDataInput(
                           ::getValue(data, std::string("input"))));
                 }
               } catch (const std::exception &e) {
                 if (!isTrue((isInstanceOf<InvalidProxySettings>(e)))) {
                   throw;
                 }
                 output =
                     getProperty(exchange, std::string("last_request_body"));
                 requestUrl =
                     getProperty(exchange, std::string("last_request_url"));
               }
               try {
                 ccxt::any callOutput =
                     callDynamically(exchange, std::string("safeValue"),
                                     ccxt::list{data, std::string("output")});
                 this->assertStaticRequestOutput(
                     exchange, type, skipKeys,
                     ::getValue(data, std::string("url")), requestUrl,
                     callOutput, output);
               } catch (const std::exception &e) {
                 this->requestTestsFailed = true;
                 ccxt::any errorMessage = add(
                     add(add(add(add(add(add(add(add(add(add(add(std::string(
                                                                     "["),
                                                                 this->lang),
                                                             std::string(
                                                                 "][STATIC_"
                                                                 "REQUEST]")),
                                                         std::string("[")),
                                                     getProperty(
                                                         exchange,
                                                         std::string("id"))),
                                                 std::string("]")),
                                             std::string("[")),
                                         method),
                                     std::string("]")),
                                 std::string("[")),
                             ::getValue(data, std::string("description"))),
                         std::string("]")),
                     exceptionMessage(e));
                 dump(add(std::string("[TEST_FAILURE]"), errorMessage));
               }
               return true;
             })
      .share();
}

virtual std::shared_future<ccxt::any> testResponseStatically(ccxt::any exchange,
                                                             ccxt::any method,
                                                             ccxt::any skipKeys,
                                                             ccxt::any data) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               ccxt::any expectedResult = callDynamically(
                   exchange, std::string("safeValue"),
                   ccxt::list{data, std::string("parsedResponse")});
               ccxt::any mockedExchange = setFetchResponse(
                   exchange, ::getValue(data, std::string("httpResponse")));
               if (isTrue(this->info)) {
                 dump(std::string("[INFO] STATIC RESPONSE TEST:"), method,
                      std::string(":"),
                      ::getValue(data, std::string("description")));
               }
               try {
                 if (!isTrue(isSync())) {
                   ccxt::any unifiedResult =
                       awaitValue(callExchangeMethodDynamically(
                           exchange, method,
                           this->sanitizeDataInput(
                               ::getValue(data, std::string("input")))));
                   this->assertStaticResponseOutput(
                       mockedExchange, skipKeys, unifiedResult, expectedResult);
                 } else {
                   ccxt::any unifiedResultSync =
                       callExchangeMethodDynamicallySync(
                           exchange, method,
                           this->sanitizeDataInput(
                               ::getValue(data, std::string("input"))));
                   this->assertStaticResponseOutput(mockedExchange, skipKeys,
                                                    unifiedResultSync,
                                                    expectedResult);
                 }
               } catch (const std::exception &e) {
                 this->responseTestsFailed = true;
                 ccxt::any errorMessage = add(
                     add(add(add(add(add(add(add(add(add(add(add(std::string(
                                                                     "["),
                                                                 this->lang),
                                                             std::string(
                                                                 "][STATIC_"
                                                                 "RESPONSE]")),
                                                         std::string("[")),
                                                     getProperty(
                                                         exchange,
                                                         std::string("id"))),
                                                 std::string("]")),
                                             std::string("[")),
                                         method),
                                     std::string("]")),
                                 std::string("[")),
                             ::getValue(data, std::string("description"))),
                         std::string("]")),
                     exceptionMessage(e));
                 dump(add(std::string("[TEST_FAILURE]"), errorMessage));
               }
               setFetchResponse(exchange, ccxt::any{}); // reset state
               return true;
             })
      .share();
}

virtual std::shared_future<ccxt::any>
injectWsMessages(ccxt::any exchange, ccxt::any url, ccxt::any messages,
                 ccxt::any sequential = false) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               // before every frame, wait until the watch flow is actually
               // awaiting something — a fixed head-start sleep is not enough on
               // slow ci runners and the frame's resolution would be dropped
               for (ccxt::any i = 0; isLessThan(i, getArrayLength(messages));
                    postFixIncrement(i)) {
                 ccxt::any waited = 0;
                 while (!isTrue(wsClientHasPendingFutures(exchange, url)) &&
                        isTrue((isLessThan(waited, 5000)))) {
                   awaitValue(callDynamically(exchange, std::string("sleep"),
                                              ccxt::list{50}));
                   waited = add(waited, 50);
                 }
                 injectWsMessage(exchange, url, ::getValue(messages, i));
                 // threaded runtimes resolve futures on another thread — wait
                 // for the consumed frame to settle so the pending check above
                 // does not observe a stale future and burn the next frame
                 // early; frames that resolve nothing (e.g. subscribe acks)
                 // fall through on the timeout
                 ccxt::any settled = 0;
                 while (isTrue(wsClientHasPendingFutures(exchange, url)) &&
                        isTrue((isLessThan(settled, 500)))) {
                   awaitValue(callDynamically(exchange, std::string("sleep"),
                                              ccxt::list{20}));
                   settled = add(settled, 20);
                 }
               }
               awaitValue(callDynamically(exchange, std::string("sleep"),
                                          ccxt::list{50}));
               if (isTrue(sequential)) {
                 // a watch call of a sequence can register its future after
                 // every frame was already consumed — keep rejecting until the
                 // watch side reports completion (the rejections force it to
                 // finish). the time bound is a backstop for threaded runtimes
                 // where this task can be executed inline on a stack that
                 // blocks the watch side (forkjoin work stealing): give up
                 // eventually so the stack unwinds instead of deadlocking
                 ccxt::any waitedDone = 0;
                 while (!isTrue(isWsTestCompleted(exchange, url)) &&
                        isTrue((isLessThan(waitedDone, 30000)))) {
                   rejectPendingWsFutures(exchange, url);
                   awaitValue(callDynamically(exchange, std::string("sleep"),
                                              ccxt::list{50}));
                   waitedDone = add(waitedDone, 50);
                 }
               }
               // reject anything still pending so a wrong fixture fails fast
               // instead of hanging the test run forever
               rejectPendingWsFutures(exchange, url);
               return true; // c# methods used with promiseAll need to return
                            // something
             })
      .share();
}

virtual std::shared_future<ccxt::any>
watchAndAssertSequence(ccxt::any exchange, ccxt::any url, ccxt::any method,
                       ccxt::any input, ccxt::any skipKeys,
                       ccxt::any expectedResults) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               try {
                 for (ccxt::any i = 0;
                      isLessThan(i, getArrayLength(expectedResults));
                      postFixIncrement(i)) {
                   ccxt::any result = awaitValue(
                       callExchangeMethodDynamically(exchange, method, input));
                   // ws structures can be live typed objects (e.g. orderbooks)
                   // in some runtimes — roundtrip through json so the
                   // deep-compare sees plain dicts in every language
                   ccxt::any unifiedResult = jsonParse(jsonStringify(result));
                   this->assertStaticResponseOutput(
                       exchange, skipKeys, unifiedResult,
                       ::getValue(expectedResults, i));
                 }
               } catch (const std::exception &e) {
                 // let the injector's rejection loop exit before the caller
                 // reports — the explicit try/catch also keeps the java
                 // transpilation compilable (checked exceptions)
                 markWsTestCompleted(exchange, url);
                 throw;
               }
               markWsTestCompleted(exchange, url);
               return true; // c# methods used with promiseAll need to return
                            // something
             })
      .share();
}

virtual void assertWsSentMessages(ccxt::any exchange, ccxt::any url,
                                  ccxt::any data) {
  // the ws analog of the static request tests: assert the frames the
  // watch method sent over the mocked transport (subscribe requests etc)
  ccxt::any expectedSent =
      callDynamically(exchange, std::string("safeList"),
                      ccxt::list{data, std::string("sentMessages")});
  if (isTrue(isEqual(expectedSent, ccxt::any{}))) {
    return;
  }
  // ids/signatures/timestamps inside outgoing frames can be volatile —
  // exclude them per entry without touching the response skipKeys
  ccxt::any sentSkipKeys = callDynamically(
      exchange, std::string("safeList"),
      ccxt::list{data, std::string("sentSkipKeys"), ccxt::list{}});
  ccxt::any sentMessages = getWsSentMessages(exchange, url);
  ccxt::any sentLength = getArrayLength(sentMessages);
  ccxt::any expectedLength = getArrayLength(expectedSent);
  assertTrue(
      isEqual(sentLength, expectedLength),
      add(add(add(add(add(std::string("sent ws messages count mismatch: sent "),
                          toString(sentLength)),
                      std::string(", expected ")),
                  toString(expectedLength)),
              std::string(" ")),
          jsonStringify(sentMessages)));
  for (ccxt::any i = 0; isLessThan(i, expectedLength); postFixIncrement(i)) {
    ccxt::any unifiedSent =
        jsonParse(jsonStringify(::getValue(sentMessages, i)));
    this->assertStaticResponseOutput(exchange, sentSkipKeys, unifiedSent,
                                     ::getValue(expectedSent, i));
  }
}

virtual std::shared_future<ccxt::any> testWsStatically(ccxt::any exchange,
                                                       ccxt::any method,
                                                       ccxt::any skipKeys,
                                                       ccxt::any data) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               ccxt::any url =
                   callDynamically(exchange, std::string("safeString"),
                                   ccxt::list{data, std::string("url")});
               setupWsMockTransport(exchange, url);
               ccxt::any httpResponse = callDynamically(
                   exchange, std::string("safeValue"),
                   ccxt::list{data, std::string("httpResponse")});
               if (isTrue(!isEqual(httpResponse, ccxt::any{}))) {
                 // some watch methods fetch a rest snapshot (e.g.
                 // watchOrderBook)
                 setFetchResponse(exchange, httpResponse);
               }
               if (isTrue(this->info)) {
                 dump(std::string("[INFO] STATIC WS TEST:"), method,
                      std::string(":"),
                      ::getValue(data, std::string("description")));
               }
               try {
                 ccxt::any messages = callDynamically(
                     exchange, std::string("safeList"),
                     ccxt::list{data, std::string("messages"), ccxt::list{}});
                 ccxt::any input = this->sanitizeDataInput(
                     ::getValue(data, std::string("input")));
                 ccxt::any expectedResults = callDynamically(
                     exchange, std::string("safeList"),
                     ccxt::list{data, std::string("parsedResponses")});
                 if (isTrue(!isEqual(expectedResults, ccxt::any{}))) {
                   // 'parsedResponses' asserts one result per successive watch
                   // resolution (e.g. an order going from open to closed)
                   // start the injector before the watch side: it must never
                   // sit queued while the watch chain blocks on a join — a
                   // forkjoin worker could execute it inline on the blocked
                   // stack and the rejection loop would then wait on the very
                   // watch side it is buried on top of
                   ccxt::any promises = ccxt::list{
                       this->injectWsMessages(exchange, url, messages, true),
                       this->watchAndAssertSequence(exchange, url, method,
                                                    input, skipKeys,
                                                    expectedResults)};
                   awaitValue(promiseAllConcurrent(promises));
                   this->assertWsSentMessages(exchange, url, data);
                 } else {
                   // 'parsedResponse' asserts the final state after every frame
                   // was replayed — live structures like orderbooks keep
                   // updating after the first resolution, so serialize only at
                   // the end
                   ccxt::any promises = ccxt::list{
                       std::async(std::launch::deferred,
                                  [=]() -> ccxt::any {
                                    return callExchangeMethodDynamically(
                                        exchange, method, input);
                                  })
                           .share(),
                       this->injectWsMessages(exchange, url, messages)};
                   ccxt::any results =
                       awaitValue(promiseAllConcurrent(promises));
                   ccxt::any unifiedResult =
                       jsonParse(jsonStringify(::getValue(results, 0)));
                   this->assertStaticResponseOutput(
                       exchange, skipKeys, unifiedResult,
                       ::getValue(data, std::string("parsedResponse")));
                   this->assertWsSentMessages(exchange, url, data);
                 }
               } catch (const std::exception &e) {
                 this->staticWsTestsFailed = true;
                 ccxt::any errorMessage = add(
                     add(add(add(add(add(add(add(add(add(add(add(std::string(
                                                                     "["),
                                                                 this->lang),
                                                             std::string(
                                                                 "][STATIC_"
                                                                 "WS]")),
                                                         std::string("[")),
                                                     getProperty(
                                                         exchange,
                                                         std::string("id"))),
                                                 std::string("]")),
                                             std::string("[")),
                                         method),
                                     std::string("]")),
                                 std::string("[")),
                             ::getValue(data, std::string("description"))),
                         std::string("]")),
                     exceptionMessage(e));
                 dump(add(std::string("[TEST_FAILURE]"), errorMessage));
               }
               setFetchResponse(exchange, ccxt::any{}); // reset state
               return true;
             })
      .share();
}

virtual std::shared_future<ccxt::any>
testExchangeWsStatically(ccxt::any exchangeName, ccxt::any exchangeData,
                         ccxt::any testName = ccxt::any{}) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               ccxt::any globalOptions =
                   (isTrue(isEqual(
                        ::getValue(exchangeData, std::string("options")),
                        ccxt::any{}))
                        ? ccxt::any(ccxt::dict{})
                        : ccxt::any(::getValue(exchangeData,
                                               std::string("options"))));
               ccxt::any methods =
                   (isTrue(isEqual(
                        ::getValue(exchangeData, std::string("methods")),
                        ccxt::any{}))
                        ? ccxt::any(ccxt::dict{})
                        : ccxt::any(::getValue(exchangeData,
                                               std::string("methods"))));
               ccxt::any methodsNames = getObjectKeys(methods);
               for (ccxt::any i = 0;
                    isLessThan(i, getArrayLength(methodsNames));
                    postFixIncrement(i)) {
                 ccxt::any method = ::getValue(methodsNames, i);
                 ccxt::any results = ::getValue(methods, method);
                 for (ccxt::any j = 0; isLessThan(j, getArrayLength(results));
                      postFixIncrement(j)) {
                   ccxt::any result = ::getValue(results, j);
                   ccxt::any description =
                       ::getValue(result, std::string("description"));
                   if (isTrue(isTrue((!isEqual(testName, ccxt::any{}))) &&
                              isTrue((!isEqual(testName, description))))) {
                     continue;
                   }
                   // a fresh exchange per entry: ws caches (trades, orderbooks,
                   // ohlcvs) and request-id counters survive between watch
                   // calls and would leak state across entries otherwise
                   ccxt::any exchange =
                       this->initOfflineExchange(exchangeName, true);
                   ccxt::any isDisabled = callDynamically(
                       exchange, std::string("safeBool"),
                       ccxt::list{result, std::string("disabled"), false});
                   if (isTrue(isEqual(isDisabled, true))) {
                     continue;
                   }
                   ccxt::any disabledString = callDynamically(
                       exchange, std::string("safeString"),
                       ccxt::list{result, std::string("disabled"),
                                  std::string("")});
                   if (isTrue(!isEqual(disabledString, std::string("")))) {
                     continue;
                   }
                   ccxt::any isDisabledCSharp = callDynamically(
                       exchange, std::string("safeString"),
                       ccxt::list{result, std::string("disabledCS")});
                   if (isTrue(
                           isTrue((!isEqual(isDisabledCSharp, ccxt::any{}))) &&
                           isTrue((isEqual(this->lang, std::string("C#")))))) {
                     continue;
                   }
                   ccxt::any isDisabledGo = callDynamically(
                       exchange, std::string("safeString"),
                       ccxt::list{result, std::string("disabledGO")});
                   if (isTrue(
                           isTrue((!isEqual(isDisabledGo, ccxt::any{}))) &&
                           isTrue((isEqual(this->lang, std::string("GO")))))) {
                     continue;
                   }
                   ccxt::any isDisabledJava = callDynamically(
                       exchange, std::string("safeString"),
                       ccxt::list{result, std::string("disabledJava")});
                   if (isTrue(isTrue((!isEqual(isDisabledJava, ccxt::any{}))) &&
                              isTrue((
                                  isEqual(this->lang, std::string("java")))))) {
                     continue;
                   }
                   ccxt::any isDisabledPhp = callDynamically(
                       exchange, std::string("safeString"),
                       ccxt::list{result, std::string("disabledPHP")});
                   if (isTrue(
                           isTrue((!isEqual(isDisabledPhp, ccxt::any{}))) &&
                           isTrue((isEqual(this->lang, std::string("PHP")))))) {
                     continue;
                   }
                   callDynamically(exchange,
                                   std::string("extendExchangeOptions"),
                                   ccxt::list{globalOptions});
                   ccxt::any testExchangeOptions = callDynamically(
                       exchange, std::string("safeValue"),
                       ccxt::list{result, std::string("options"),
                                  ccxt::dict{}});
                   callDynamically(exchange,
                                   std::string("extendExchangeOptions"),
                                   ccxt::list{testExchangeOptions});
                   ccxt::any skipKeys = callDynamically(
                       exchange, std::string("safeValue"),
                       ccxt::list{exchangeData, std::string("skipKeys"),
                                  ccxt::list{}});
                   awaitValue(this->testWsStatically(exchange, method, skipKeys,
                                                     result));
                   if (!isTrue(isSync())) {
                     awaitValue(close(exchange));
                   }
                 }
               }
               return true; // in c# methods that will be used with promiseAll
                            // need to return something
             })
      .share();
}

virtual ccxt::any initOfflineExchange(ccxt::any exchangeName,
                                      ccxt::any isWs = false) {
  // prediction exchanges load their outcome markets from an event -> markets ->
  // outcomes fixture (static/events/<id>.json) instead of the
  // markets/currencies fixtures. this is the standard prediction path
  // (kalshi/limitless/myriad/polymarket/hyperliquid all ship one) and is
  // required for ids present in both namespaces (e.g. hyperliquid), whose
  // markets/<id>.json holds the crypto markets. when a fixture is present, skip
  // markets/currencies entirely so setMarkets rebuilds cleanly from the outcome
  // markets
  ccxt::any predictionEvents = ccxt::any{};
  if (isTrue(this->predictionTests)) {
    predictionEvents = this->loadEventsFromFile(exchangeName);
  }
  ccxt::any markets = ccxt::any{};
  ccxt::any currencies = ccxt::any{};
  if (isTrue(isEqual(predictionEvents, ccxt::any{}))) {
    markets = this->loadMarketsFromFile(exchangeName);
    currencies = this->loadCurrenciesFromFile(exchangeName);
  }
  ccxt::any wasmExecPath = ccxt::any{};
  ccxt::any libraryPath = ccxt::any{};
  // const wasmExecPath = getRootDir () +
  // '/src/test/static/binaries/wasm_exec.js'; const ligherWasmPath = getRootDir
  // () + 'ts/src/test/static/binaries/lighter.wasm'; const binaryPath =
  // getRootDir () +
  // '/ts/src/test/static/binaries/lighter-signer-linux-amd64.so'; const
  // librarypath = (this.lang === 'JS') ? ligherWasmPath : binaryPath;
  ccxt::any basePath =
      add(getRootDir(), std::string("ts/src/test/static/binaries/"));
  if (isTrue(isEqual(exchangeName, std::string("lighter")))) {
    if (isTrue(isEqual(this->lang, std::string("JS")))) {
      wasmExecPath = add(basePath, std::string("wasm_exec.js"));
      libraryPath = add(basePath, std::string("lighter.wasm"));
    } else {
      if (isTrue(isWindows())) {
        libraryPath =
            add(basePath, std::string("lighter-signer-windows-amd64.dll"));
      } else if (isTrue(isLinux())) {
        if (isTrue(isAmd64())) {
          libraryPath =
              add(basePath, std::string("lighter-signer-linux-amd64.so"));
        } else {
          libraryPath =
              add(basePath, std::string("lighter-signer-linux-arm64.so"));
        }
      } else {
        if (isTrue(isAmd64())) {
          libraryPath =
              add(basePath, std::string("lighter-signer-darwin-x86.dylib"));
        } else {
          libraryPath =
              add(basePath, std::string("lighter-signer-darwin-arm64.dylib"));
        }
      }
    }
  }
  ccxt::any options = ccxt::dict{
      {std::string("markets"), markets},
      {std::string("currencies"), currencies},
      {std::string("enableRateLimit"), false},
      {std::string("rateLimit"), 1},
      {std::string("httpProxy"), std::string("http://fake:8080")},
      {std::string("httpsProxy"), std::string("http://fake:8080")},
      {std::string("apiKey"), std::string("key")},
      {std::string("secret"), std::string("secretsecret")},
      {std::string("password"), std::string("password")},
      {std::string("walletAddress"), std::string("wallet")},
      {std::string("privateKey"),
       std::string("0xff3bdd43534543d421f05aec535965b5050ad6ac15345435345435453"
                   "495e771")},
      {std::string("uid"), std::string("uid")},
      {std::string("token"), std::string("token")},
      {std::string("login"), std::string("login")},
      {std::string("accountId"), std::string("12345")},
      {std::string("accounts"),
       ccxt::list{ccxt::dict{
                      {std::string("id"), std::string("myAccount")},
                      {std::string("code"), std::string("USDT")},
                  },
                  ccxt::dict{
                      {std::string("id"), std::string("myAccount")},
                      {std::string("code"), std::string("USDC")},
                  }}},
      {std::string("options"),
       ccxt::dict{
           {std::string("enableUnifiedAccount"), true},
           {std::string("enableUnifiedMargin"), false},
           {std::string("accessToken"), std::string("token")},
           {std::string("expires"), 999999999999999},
           {std::string("leverageBrackets"), ccxt::dict{}},
           {std::string("libraryPath"), libraryPath},
           {std::string("wasmExecPath"), wasmExecPath},
       }},
  };
  if (isTrue(isEqual(exchangeName, std::string("grvt")))) {
    ::setValue(options, std::string("apiKey"), std::string(""));
    ::setValue(options, std::string("secret"), std::string(""));
  }
  ccxt::any exchange = initExchange(exchangeName, options, isWs);
  if (isTrue(!isEqual(currencies, ccxt::any{}))) {
    setProperty(exchange, std::string("currencies"), currencies);
  }
  // rebuild ::getValue(this, std::string("markets")) from the events' nested
  // markets (event -> markets -> outcomes) so outcome-addressed methods
  // (fetchOrderBook/fetchTrades/createOrder/...) resolve offline
  if (isTrue(!isEqual(predictionEvents, ccxt::any{}))) {
    ccxt::any eventMarkets = ccxt::list{};
    for (ccxt::any i = 0; isLessThan(i, getArrayLength(predictionEvents));
         postFixIncrement(i)) {
      ccxt::any evMarkets =
          callDynamically(exchange, std::string("safeList"),
                          ccxt::list{::getValue(predictionEvents, i),
                                     std::string("markets"), ccxt::list{}});
      for (ccxt::any j = 0; isLessThan(j, getArrayLength(evMarkets));
           postFixIncrement(j)) {
        ccxt::any evMarket = ::getValue(evMarkets, j);
        // every market row must carry the unified market handle
        // (PredictionMarket declares it required) — enforce it on the fixtures
        // so a venue that stops setting it fails offline, not just in live
        // tests. 'symbol' is deprecated on prediction structures and must be
        // absent
        assertTrue(!isEqual(callDynamically(
                                exchange, std::string("safeString"),
                                ccxt::list{evMarket, std::string("market")}),
                            ccxt::any{}),
                   add(exchangeName,
                       std::string(" static events fixture: market row missing "
                                   "the unified market handle")));
        assertTrue(isEqual(callDynamically(
                               exchange, std::string("safeString"),
                               ccxt::list{evMarket, std::string("symbol")}),
                           ccxt::any{}),
                   add(exchangeName,
                       std::string(" static events fixture: market row must "
                                   "not carry the deprecated symbol key")));
        arrayPush(eventMarkets, evMarket);
      }
    }
    if (isTrue(isGreaterThan(getArrayLength(eventMarkets), 0))) {
      callDynamically(exchange, std::string("setMarkets"),
                      ccxt::list{eventMarkets});
    }
  }
  // not working in python if assigned  in the config dict
  return exchange;
}

virtual std::shared_future<ccxt::any>
testExchangeRequestStatically(ccxt::any exchangeName, ccxt::any exchangeData,
                              ccxt::any testName = ccxt::any{}) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               // instantiate the exchange and make sure that we sink the
               // requests to avoid an actual request
               ccxt::any exchange = this->initOfflineExchange(exchangeName);
               ccxt::any globalOptions = callDynamically(
                   exchange, std::string("safeDict"),
                   ccxt::list{exchangeData, std::string("options"),
                              ccxt::dict{}});
               // read apiKey/secret from the test file
               ccxt::any apiKey = callDynamically(
                   exchange, std::string("safeString"),
                   ccxt::list{exchangeData, std::string("apiKey")});
               if (!isTrue(callDynamically(exchange,
                                           std::string("isEmptyString"),
                                           ccxt::list{apiKey}))) {
                 // c# to string requirement
                 setProperty(exchange, std::string("apiKey"), toString(apiKey));
               }
               ccxt::any secret = callDynamically(
                   exchange, std::string("safeString"),
                   ccxt::list{exchangeData, std::string("secret")});
               if (!isTrue(callDynamically(exchange,
                                           std::string("isEmptyString"),
                                           ccxt::list{secret}))) {
                 // c# to string requirement
                 setProperty(exchange, std::string("secret"), toString(secret));
               }
               ccxt::any privateKey = callDynamically(
                   exchange, std::string("safeString"),
                   ccxt::list{exchangeData, std::string("privateKey")});
               if (!isTrue(callDynamically(exchange,
                                           std::string("isEmptyString"),
                                           ccxt::list{privateKey}))) {
                 // c# to string requirement
                 setProperty(exchange, std::string("privateKey"),
                             toString(privateKey));
               }
               ccxt::any walletAddress = callDynamically(
                   exchange, std::string("safeString"),
                   ccxt::list{exchangeData, std::string("walletAddress")});
               if (!isTrue(callDynamically(exchange,
                                           std::string("isEmptyString"),
                                           ccxt::list{walletAddress}))) {
                 // c# to string requirement
                 setProperty(exchange, std::string("walletAddress"),
                             toString(walletAddress));
               }
               ccxt::any accounts = callDynamically(
                   exchange, std::string("safeList"),
                   ccxt::list{exchangeData, std::string("accounts")});
               if (isTrue(isTrue(!isEqual(accounts, ccxt::any{})) &&
                          isTrue(!isEqual(accounts, null)))) {
                 setProperty(exchange, std::string("accounts"), accounts);
               }
               // setProperty(exchange, std::string("options"),
               // callDynamically(exchange, std::string("deepExtend"),
               // ccxt::list{getProperty(exchange, std::string("options")),
               // globalOptions})); // custom options to be used in the tests
               callDynamically(exchange, std::string("extendExchangeOptions"),
                               ccxt::list{globalOptions});
               ccxt::any methods = callDynamically(
                   exchange, std::string("safeValue"),
                   ccxt::list{exchangeData, std::string("methods"),
                              ccxt::dict{}});
               ccxt::any methodsNames = getObjectKeys(methods);
               for (ccxt::any i = 0;
                    isLessThan(i, getArrayLength(methodsNames));
                    postFixIncrement(i)) {
                 ccxt::any method = ::getValue(methodsNames, i);
                 ccxt::any results = ::getValue(methods, method);
                 for (ccxt::any j = 0; isLessThan(j, getArrayLength(results));
                      postFixIncrement(j)) {
                   ccxt::any result = ::getValue(results, j);
                   ccxt::any oldExchangeOptions = getProperty(
                       exchange, std::string("options")); // snapshot options;
                   ccxt::any testExchangeOptions = callDynamically(
                       exchange, std::string("safeValue"),
                       ccxt::list{result, std::string("options"),
                                  ccxt::dict{}});
                   // setProperty(exchange, std::string("options"),
                   // callDynamically(exchange, std::string("deepExtend"),
                   // ccxt::list{oldExchangeOptions, testExchangeOptions})); //
                   // custom options to be used in the tests
                   callDynamically(exchange,
                                   std::string("extendExchangeOptions"),
                                   ccxt::list{callDynamically(
                                       exchange, std::string("deepExtend"),
                                       ccxt::list{oldExchangeOptions,
                                                  testExchangeOptions})});
                   ccxt::any description = callDynamically(
                       exchange, std::string("safeValue"),
                       ccxt::list{result, std::string("description")});
                   if (isTrue(isTrue((!isEqual(testName, ccxt::any{}))) &&
                              isTrue((!isEqual(testName, description))))) {
                     continue;
                   }
                   ccxt::any isDisabled = callDynamically(
                       exchange, std::string("safeBool"),
                       ccxt::list{result, std::string("disabled"), false});
                   if (isTrue(isEqual(isDisabled, true))) {
                     continue;
                   }
                   ccxt::any disabledString = callDynamically(
                       exchange, std::string("safeString"),
                       ccxt::list{result, std::string("disabled"),
                                  std::string("")});
                   if (isTrue(!isEqual(disabledString, std::string("")))) {
                     continue;
                   }
                   ccxt::any isDisabledCSharp = callDynamically(
                       exchange, std::string("safeBool"),
                       ccxt::list{result, std::string("disabledCS"), false});
                   if (isTrue(
                           isTrue((isEqual(isDisabledCSharp, true))) &&
                           isTrue((isEqual(this->lang, std::string("C#")))))) {
                     continue;
                   }
                   ccxt::any isDisabledGo = callDynamically(
                       exchange, std::string("safeBool"),
                       ccxt::list{result, std::string("disabledGO"), false});
                   if (isTrue(
                           isTrue((isEqual(isDisabledGo, true))) &&
                           isTrue((isEqual(this->lang, std::string("GO")))))) {
                     continue;
                   }
                   ccxt::any isDisabledRust = callDynamically(
                       exchange, std::string("safeBool"),
                       ccxt::list{result, std::string("disabledRS"), false});
                   if (isTrue(isTrue(isDisabledRust) &&
                              isTrue((
                                  isEqual(this->lang, std::string("RUST")))))) {
                     continue;
                   }
                   ccxt::any isDisabledCpp = callDynamically(
                       exchange, std::string("safeBool"),
                       ccxt::list{result, std::string("disabledCPP"), false});
                   if (isTrue(
                           isTrue(isDisabledCpp) &&
                           isTrue((isEqual(this->lang, std::string("C++")))))) {
                     continue;
                   }
                   ccxt::any isDisabledJava = callDynamically(
                       exchange, std::string("safeBool"),
                       ccxt::list{result, std::string("disabledJava"), false});
                   if (isTrue(isTrue((isEqual(isDisabledJava, true))) &&
                              isTrue((
                                  isEqual(this->lang, std::string("java")))))) {
                     continue;
                   }
                   ccxt::any type = callDynamically(
                       exchange, std::string("safeString"),
                       ccxt::list{exchangeData, std::string("outputType")});
                   ccxt::any skipKeys = callDynamically(
                       exchange, std::string("safeValue"),
                       ccxt::list{exchangeData, std::string("skipKeys"),
                                  ccxt::list{}});
                   awaitValue(this->testRequestStatically(
                       exchange, method, result, type, skipKeys));
                   // reset options
                   setProperty(
                       exchange, std::string("options"),
                       callDynamically(
                           exchange, std::string("convertToSafeDictionary"),
                           ccxt::list{callDynamically(
                               exchange, std::string("deepExtend"),
                               ccxt::list{oldExchangeOptions, ccxt::dict{}})}));
                 }
               }
               if (!isTrue(isSync())) {
                 awaitValue(close(exchange));
               }
               return true; // in c# methods that will be used with promiseAll
                            // need to return something
             })
      .share();
}

virtual std::shared_future<ccxt::any>
testExchangeResponseStatically(ccxt::any exchangeName, ccxt::any exchangeData,
                               ccxt::any testName = ccxt::any{}) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               ccxt::any exchange = this->initOfflineExchange(exchangeName);
               // read apiKey/secret from the test file
               ccxt::any apiKey = callDynamically(
                   exchange, std::string("safeString"),
                   ccxt::list{exchangeData, std::string("apiKey")});
               if (!isTrue(callDynamically(exchange,
                                           std::string("isEmptyString"),
                                           ccxt::list{apiKey}))) {
                 // c# to string requirement
                 setProperty(exchange, std::string("apiKey"), toString(apiKey));
               }
               ccxt::any secret = callDynamically(
                   exchange, std::string("safeString"),
                   ccxt::list{exchangeData, std::string("secret")});
               if (!isTrue(callDynamically(exchange,
                                           std::string("isEmptyString"),
                                           ccxt::list{secret}))) {
                 // c# to string requirement
                 setProperty(exchange, std::string("secret"), toString(secret));
               }
               ccxt::any privateKey = callDynamically(
                   exchange, std::string("safeString"),
                   ccxt::list{exchangeData, std::string("privateKey")});
               if (!isTrue(callDynamically(exchange,
                                           std::string("isEmptyString"),
                                           ccxt::list{privateKey}))) {
                 // c# to string requirement
                 setProperty(exchange, std::string("privateKey"),
                             toString(privateKey));
               }
               ccxt::any walletAddress = callDynamically(
                   exchange, std::string("safeString"),
                   ccxt::list{exchangeData, std::string("walletAddress")});
               if (!isTrue(callDynamically(exchange,
                                           std::string("isEmptyString"),
                                           ccxt::list{walletAddress}))) {
                 // c# to string requirement
                 setProperty(exchange, std::string("walletAddress"),
                             toString(walletAddress));
               }
               ccxt::any methods = callDynamically(
                   exchange, std::string("safeValue"),
                   ccxt::list{exchangeData, std::string("methods"),
                              ccxt::dict{}});
               ccxt::any options = callDynamically(
                   exchange, std::string("safeValue"),
                   ccxt::list{exchangeData, std::string("options"),
