virtual std::shared_future<ccxt::any>
runStaticTests(ccxt::any type, ccxt::any targetExchange = ccxt::any{},
               ccxt::any testName = ccxt::any{}) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               // prediction-market exchanges keep their fixtures under
               // static/<type>/prediction/ and are run separately via the
               // --prediction flag (npm run request-ts-prediction /
               // response-ts-prediction)
               ccxt::any folder = add(
                   add(add(getRootDir(), std::string("./ts/src/test/static/")),
                       type),
                   std::string("/"));
               if (isTrue(this->predictionTests)) {
                 folder = add(folder, std::string("prediction/"));
               }
               ccxt::any staticData =
                   this->loadStaticData(folder, targetExchange);
               if (isTrue(isEqual(staticData, ccxt::any{}))) {
                 return true;
               }
               ccxt::any exchanges = getObjectKeys(staticData);
               ccxt::any exchange = initExchange(
                   std::string("Exchange"),
                   ccxt::dict{}); // tmp to do the calculations until we have
                                  // the ast-transpiler transpiling this code
               ccxt::any promises = ccxt::list{};
               ccxt::any sum = 0;
               if (isTrue(isTrue(!isEqual(targetExchange, ccxt::any{})) &&
                          isTrue(!isEqual(targetExchange, std::string(""))))) {
                 dump(add(std::string("[INFO:MAIN] Exchange to test: "),
                          targetExchange));
               }
               if (isTrue(isTrue(!isEqual(testName, ccxt::any{})) &&
                          isTrue(!isEqual(testName, std::string(""))))) {
                 dump(add(std::string("[INFO:MAIN] Testing only: "), testName));
               }
               for (ccxt::any i = 0; isLessThan(i, getArrayLength(exchanges));
                    postFixIncrement(i)) {
                 ccxt::any exchangeName = ::getValue(exchanges, i);
                 ccxt::any exchangeData = ::getValue(staticData, exchangeName);
                 ccxt::any disabled = this->checkIfExchangeIsDisabled(
                     exchangeName, exchangeData);
                 if (isTrue(disabled)) {
                   continue;
                 }
                 ccxt::any numberOfTests = this->getNumberOfTestsFromExchange(
                     exchange, exchangeData, testName);
                 sum = callDynamically(exchange, std::string("sum"),
                                       ccxt::list{sum, numberOfTests});
                 if (isTrue(isEqual(type, std::string("request")))) {
                   arrayPush(promises,
                             this->testExchangeRequestStatically(
                                 exchangeName, exchangeData, testName));
                 } else if (isTrue(isEqual(type, std::string("ws")))) {
                   arrayPush(promises,
                             this->testExchangeWsStatically(
                                 exchangeName, exchangeData, testName));
                 } else {
                   arrayPush(promises,
                             this->testExchangeResponseStatically(
                                 exchangeName, exchangeData, testName));
                 }
               }
               try {
                 awaitValue(promiseAll(promises));
               } catch (const std::exception &e) {
                 if (isTrue(isEqual(type, std::string("request")))) {
                   this->requestTestsFailed = true;
                 } else if (isTrue(isEqual(type, std::string("ws")))) {
                   this->staticWsTestsFailed = true;
                 } else {
                   this->responseTestsFailed = true;
                 }
                 ccxt::any errorMessage =
                     add(add(add(std::string("["), this->lang),
                             std::string("][STATIC_REQUEST]")),
                         exceptionMessage(e));
                 dump(add(std::string("[TEST_FAILURE]"), errorMessage));
               }
               if (isTrue(isTrue(isTrue(this->requestTestsFailed) ||
                                 isTrue(this->responseTestsFailed)) ||
                          isTrue(this->staticWsTestsFailed))) {
                 exitScript(1);
               } else {
                 ccxt::any prefix =
                     (isTrue((isSync())) ? ccxt::any(std::string("[SYNC]"))
                                         : ccxt::any(std::string("")));
                 ccxt::any successMessage = add(
                     add(add(add(add(add(add(add(std::string("["), this->lang),
                                             std::string("]")),
                                         prefix),
                                     std::string("[TEST_SUCCESS] ")),
                                 toString(sum)),
                             std::string(" static ")),
                         type),
                     std::string(" tests passed."));
                 dump(add(std::string("[INFO]"), successMessage));
               }
               return true; // required in c#
             })
      .share();
}

