               if (!isTrue(isSync())) {
                 awaitValue(close(exchange));
               }
               return true; // in c# methods that will be used with promiseAll
                            // need to return something
             })
      .share();
}

virtual ccxt::any
getNumberOfTestsFromExchange(ccxt::any exchange, ccxt::any exchangeData,
                             ccxt::any testName = ccxt::any{}) {
  if (isTrue(!isEqual(testName, ccxt::any{}))) {
    return 1;
  }
  ccxt::any sum = 0;
  ccxt::any methods = ::getValue(exchangeData, std::string("methods"));
  ccxt::any methodsNames = getObjectKeys(methods);
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(methodsNames));
       postFixIncrement(i)) {
    ccxt::any method = ::getValue(methodsNames, i);
    ccxt::any results = ::getValue(methods, method);
    ccxt::any resultsLength = getArrayLength(results);
    sum = callDynamically(exchange, std::string("sum"),
                          ccxt::list{sum, resultsLength});
  }
  return sum;
}

virtual ccxt::any checkIfExchangeIsDisabled(ccxt::any exchangeName,
                                            ccxt::any exchangeData) {
  ccxt::any exchange = initExchange(std::string("Exchange"), ccxt::dict{});
  // prediction-market exchanges exist only in the async namespaces in
  // python/php, so their fixtures declare asyncOnly and the sync harness skips
  // them
  ccxt::any isAsyncOnly = callDynamically(
      exchange, std::string("safeBool"),
      ccxt::list{exchangeData, std::string("asyncOnly"), false});
  if (isTrue(isTrue((isEqual(isAsyncOnly, true))) && isTrue(isSync()))) {
    dump(add(add(std::string("[TEST_WARNING] Exchange "), exchangeName),
             std::string(" is async-only, skipped by the sync test harness")));
    return true;
  }
  ccxt::any isDisabledPy = callDynamically(
      exchange, std::string("safeBool"),
      ccxt::list{exchangeData, std::string("disabledPy"), false});
  if (isTrue(isTrue((isEqual(isDisabledPy, true))) &&
             isTrue((isEqual(this->lang, std::string("PY")))))) {
    dump(add(add(std::string("[TEST_WARNING] Exchange "), exchangeName),
             std::string(" is disabled in python")));
    return true;
  }
  ccxt::any isDisabledPHP = callDynamically(
      exchange, std::string("safeBool"),
      ccxt::list{exchangeData, std::string("disabledPHP"), false});
  if (isTrue(isTrue((isEqual(isDisabledPHP, true))) &&
             isTrue((isEqual(this->lang, std::string("PHP")))))) {
    dump(add(add(std::string("[TEST_WARNING] Exchange "), exchangeName),
             std::string(" is disabled in php")));
    return true;
  }
  ccxt::any isDisabledCSharp = callDynamically(
      exchange, std::string("safeBool"),
      ccxt::list{exchangeData, std::string("disabledCS"), false});
  if (isTrue(isTrue((isEqual(isDisabledCSharp, true))) &&
             isTrue((isEqual(this->lang, std::string("C#")))))) {
    dump(add(add(std::string("[TEST_WARNING] Exchange "), exchangeName),
             std::string(" is disabled in c#")));
    return true;
  }
  ccxt::any isDisabledGO = callDynamically(
      exchange, std::string("safeBool"),
      ccxt::list{exchangeData, std::string("disabledGO"), false});
  if (isTrue(isTrue((isEqual(isDisabledGO, true))) &&
             isTrue((isEqual(this->lang, std::string("GO")))))) {
    dump(add(add(std::string("[TEST_WARNING] Exchange "), exchangeName),
             std::string(" is disabled in go")));
    return true;
  }
  ccxt::any isDisabledRust = callDynamically(
      exchange, std::string("safeBool"),
      ccxt::list{exchangeData, std::string("disabledRS"), false});
  if (isTrue(isTrue(isDisabledRust) &&
             isTrue((isEqual(this->lang, std::string("RUST")))))) {
    dump(add(add(std::string("[TEST_WARNING] Exchange "), exchangeName),
             std::string(" is disabled in rust")));
    return true;
  }
  ccxt::any isDisabledCpp = callDynamically(
      exchange, std::string("safeBool"),
      ccxt::list{exchangeData, std::string("disabledCPP"), false});
  if (isTrue(isTrue(isDisabledCpp) &&
             isTrue((isEqual(this->lang, std::string("C++")))))) {
    dump(add(add(std::string("[TEST_WARNING] Exchange "), exchangeName),
             std::string(" is disabled in c++")));
    return true;
  }
  ccxt::any isDisabledJava = callDynamically(
      exchange, std::string("safeBool"),
      ccxt::list{exchangeData, std::string("disabledJava"), false});
  if (isTrue(isTrue((isEqual(isDisabledJava, true))) &&
             isTrue((isEqual(this->lang, std::string("java")))))) {
    dump(add(add(std::string("[TEST_WARNING] Exchange "), exchangeName),
             std::string(" is disabled in java")));
    return true;
  }
  return false;
}

