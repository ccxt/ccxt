                 return false;
               }
               ccxt::any exchange =
                   this->initOfflineExchange(std::string("modetrade"));
               setProperty(
                   exchange, std::string("secret"),
                   std::string("secretsecretsecretsecretsecretsecretsecrets"));
               ccxt::any id = std::string("CCXTMODE");
               awaitValue(callDynamically(exchange, std::string("loadMarkets"),
                                          ccxt::list{}));
               ccxt::any request = ccxt::dict{};
               try {
                 awaitValue(
                     callDynamically(exchange, std::string("createOrder"),
                                     ccxt::list{std::string("BTC/USDC:USDC"),
                                                std::string("limit"),
                                                std::string("buy"), 1, 20000}));
               } catch (const std::exception &e) {
                 request = jsonParse(
                     getProperty(exchange, std::string("last_request_body")));
               }
               ccxt::any brokerId =
                   ::getValue(request, std::string("order_tag"));
               assertTrue(isEqual(brokerId, id),
                          add(add(add(std::string("modetrade - id: "), id),
                                  std::string(" different from  broker_id: ")),
                              brokerId));
               if (!isTrue(isSync())) {
                 awaitValue(close(exchange));
               }
               return true;
             })
      .share();
}

