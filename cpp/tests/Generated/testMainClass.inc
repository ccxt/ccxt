virtual void parseCliArgsAndProps() {
  this->responseTests =
      isTrue(getCliArgValue(std::string("--responseTests"))) ||
      isTrue(getCliArgValue(std::string("--response")));
  this->idTests = getCliArgValue(std::string("--idTests"));
  this->requestTests = isTrue(getCliArgValue(std::string("--requestTests"))) ||
                       isTrue(getCliArgValue(std::string("--request")));
  this->info = getCliArgValue(std::string("--info"));
  this->verbose = getCliArgValue(std::string("--verbose"));
  this->debug = getCliArgValue(std::string("--debug"));
  this->privateTest = getCliArgValue(std::string("--private"));
  this->privateTestOnly = getCliArgValue(std::string("--privateOnly"));
  this->sandbox = getCliArgValue(std::string("--sandbox"));
  this->loadKeys = getCliArgValue(std::string("--loadKeys"));
  this->wsTests = getCliArgValue(std::string("--ws"));
  this->staticWsTests = getCliArgValue(std::string("--wsTests"));
  // when set, static request/response tests are read from the
  // static/<type>/prediction/ subfolder
  this->predictionTests = getCliArgValue(std::string("--prediction"));
  this->lang = getLang();
  this->ext = getExt();
}

virtual std::shared_future<ccxt::any>
init(ccxt::any exchangeId, ccxt::any symbolArgv, ccxt::any methodArgv) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               try {
                 awaitValue(
                     this->initInner(exchangeId, symbolArgv, methodArgv));
               } catch (const std::exception &e) {
                 dump(std::string(
                     "[TEST_FAILURE]")); // tell run-tests.js this is failure
                 throw;
               }
               return true;
             })
      .share();
}

virtual std::shared_future<ccxt::any>
initInner(ccxt::any exchangeId, ccxt::any symbolArgv, ccxt::any methodArgv) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               this->parseCliArgsAndProps();
               if (isTrue(isTrue(this->requestTests) &&
                          isTrue(this->responseTests))) {
                 awaitValue(
                     this->runStaticRequestTests(exchangeId, symbolArgv));
                 awaitValue(
                     this->runStaticResponseTests(exchangeId, symbolArgv));
                 return true;
               }
               if (isTrue(this->responseTests)) {
                 awaitValue(
                     this->runStaticResponseTests(exchangeId, symbolArgv));
                 return true;
               }
               if (isTrue(this->staticWsTests)) {
                 awaitValue(this->runStaticWsTests(exchangeId, symbolArgv));
                 return true;
               }
               if (isTrue(this->requestTests)) {
                 awaitValue(this->runStaticRequestTests(
                     exchangeId, symbolArgv)); // symbol here is the testname
                 return true;
               }
               if (isTrue(this->idTests)) {
                 awaitValue(this->runBrokerIdTests());
                 return true;
               }
               ccxt::any newLine = std::string("\n");
               dump(add(add(add(add(newLine, std::string("")), newLine),
                            std::string("")),
                        std::string("[INFO] TESTING ")),
                    this->ext,
                    ccxt::dict{
                        {std::string("exchange"), exchangeId},
                        {std::string("symbol"), symbolArgv},
                        {std::string("method"), methodArgv},
                        {std::string("isWs"), this->wsTests},
                        {std::string("useProxy"),
                         getCliArgValue(std::string("--useProxy"))},
                    },
                    newLine);
               ccxt::any exchangeArgs = ccxt::dict{
                   {std::string("verbose"), this->verbose},
                   {std::string("debug"), this->debug},
                   {std::string("enableRateLimit"), true},
                   {std::string("timeout"), 30000},
               };
               ccxt::any exchange =
                   initExchange(exchangeId, exchangeArgs, this->wsTests);
               if (isTrue(getProperty(exchange, std::string("alias")))) {
                 dump(this->addPadding(std::string("[INFO] skipping alias"),
                                       25));
                 exitScript(0);
               }
               awaitValue(this->importFiles(exchange));
               // ensure test files are found & filled
               assertTrue(
                   isGreaterThan(getArrayLength(getObjectKeys(this->testFiles)),
                                 0),
                   std::string("Test files were not loaded"));
               this->expandSettings(exchange);
               this->checkIfSpecificTestIsChosen(methodArgv);
               awaitValue(this->startTest(exchange, symbolArgv));
               exitScript(0); // needed to be explicitly finished for WS tests
               return true;   // required for c#
             })
      .share();
}

virtual void checkIfSpecificTestIsChosen(ccxt::any methodArgv) {
  if (isTrue(!isEqual(methodArgv, ccxt::any{}))) {
    ccxt::any testFileNames = getObjectKeys(this->testFiles);
    ccxt::any possibleMethodNames = split(
        methodArgv,
        std::string(",")); // i.e. `test.ts binance fetchBalance,fetchDeposits`
    if (isTrue(isGreaterThanOrEqual(getArrayLength(possibleMethodNames), 1))) {
      for (ccxt::any i = 0; isLessThan(i, getArrayLength(testFileNames));
           postFixIncrement(i)) {
        ccxt::any testFileName = ::getValue(testFileNames, i);
        for (ccxt::any j = 0;
             isLessThan(j, getArrayLength(possibleMethodNames));
             postFixIncrement(j)) {
          ccxt::any methodName = ::getValue(possibleMethodNames, j);
          methodName = replace(methodName, std::string("()"), std::string(""));
          if (isTrue(isEqual(testFileName, methodName))) {
            arrayPush(this->onlySpecificTests, testFileName);
          }
        }
      }
    }
  }
}

virtual std::shared_future<ccxt::any> importFiles(ccxt::any exchange) {
  return std::async(std::launch::deferred,
                    [=]() mutable -> ccxt::any {
                      ccxt::any properties = getObjectKeys(
                          getProperty(exchange, std::string("has")));
                      arrayPush(properties, std::string("loadMarkets"));
                      arrayPush(properties, std::string("afterConstruct"));
                      if (isTrue(isSync())) {
                        this->testFiles =
                            getTestFilesSync(properties, this->wsTests);
                      } else {
                        this->testFiles =
                            awaitValue(getTestFiles(properties, this->wsTests));
                      }
                      return true;
                    })
      .share();
}

virtual void loadCredentialsFromEnv(ccxt::any exchange) {
  ccxt::any exchangeId = getProperty(exchange, std::string("id"));
  ccxt::any reqCreds = getExchangeProp(
      exchange,
      add(std::string("re"),
          std::string("quiredCredentials"))); // dont glue the r-e-q-u-i-r-e
                                              // phrase, because leads to messed
                                              // up transpilation
  ccxt::any objkeys = getObjectKeys(reqCreds);
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(objkeys));
       postFixIncrement(i)) {
    ccxt::any credential = ::getValue(objkeys, i);
    ccxt::any isRequired = ::getValue(reqCreds, credential);
    if (isTrue(isTrue((isEqual(isRequired, true))) &&
               isTrue((isEqual(getExchangeProp(exchange, credential),
                               ccxt::any{}))))) {
      ccxt::any fullKey = add(add(exchangeId, std::string("_")), credential);
      ccxt::any credentialEnvName =
          toUpperCase(fullKey); // example: KRAKEN_APIKEY
      ccxt::any envVars = getEnvVars();
      ccxt::any credentialValue =
          (isTrue((inOp(envVars, credentialEnvName)))
               ? ccxt::any(::getValue(envVars, credentialEnvName))
               : ccxt::any(ccxt::any{}));
      if (isTrue(isTrue(!isEqual(credentialValue, ccxt::any{})) &&
                 isTrue(!isEqual(credentialValue, std::string(""))))) {
        setExchangeProp(exchange, credential, credentialValue);
      }
    }
  }
}

virtual void expandSettings(ccxt::any exchange) {
  ccxt::any exchangeId = getProperty(exchange, std::string("id"));
  ccxt::any keysGlobal = add(getRootDir(), std::string("keys.json"));
  ccxt::any keysLocal = add(getRootDir(), std::string("keys.local.json"));
  ccxt::any keysGlobalExists = ioFileExists(keysGlobal);
  ccxt::any keysLocalExists = ioFileExists(keysLocal);
  ccxt::any globalSettings = ccxt::dict{};
  if (isTrue(keysGlobalExists)) {
    globalSettings = ioFileRead(keysGlobal);
  }
  ccxt::any localSettings = ccxt::dict{};
  if (isTrue(keysLocalExists)) {
    localSettings = ioFileRead(keysLocal);
  }
  ccxt::any allSettings =
      callDynamically(exchange, std::string("deepExtend"),
                      ccxt::list{globalSettings, localSettings});
  ccxt::any exchangeSettings =
      callDynamically(exchange, std::string("safeValue"),
                      ccxt::list{allSettings, exchangeId, ccxt::dict{}});
  if (isTrue(!isEqual(exchangeSettings, ccxt::any{}))) {
    ccxt::any settingKeys = getObjectKeys(exchangeSettings);
    for (ccxt::any i = 0; isLessThan(i, getArrayLength(settingKeys));
         postFixIncrement(i)) {
      ccxt::any key = ::getValue(settingKeys, i);
      ccxt::any settingValue = ::getValue(exchangeSettings, key);
      ccxt::any settingIsEmpty =
          isTrue(isTrue(isTrue(isTrue((isEqual(settingValue, ccxt::any{}))) ||
                               isTrue((isEqual(settingValue, null)))) ||
                        isTrue((isEqual(settingValue, std::string(""))))) ||
                 isTrue((isEqual(settingValue, false)))) ||
          isTrue((isEqual(settingValue, 0)));
      if (!isTrue(settingIsEmpty)) {
        ccxt::any finalValue = ccxt::any{};
        if (isTrue(callDynamically(
                exchange, std::string("isDictionary"),
                ccxt::list{::getValue(exchangeSettings, key)}))) {
          ccxt::any existing = getExchangeProp(exchange, key, ccxt::dict{});
          finalValue = callDynamically(
              exchange, std::string("deepExtend"),
              ccxt::list{existing, ::getValue(exchangeSettings, key)});
        } else {
          finalValue = ::getValue(exchangeSettings, key);
        }
        setExchangeProp(exchange, key, finalValue);
      }
    }
  }
  // credentials
  if (isTrue(this->loadKeys)) {
    this->loadCredentialsFromEnv(exchange);
  }
  // skipped tests
  ccxt::any skippedFile = add(getRootDir(), std::string("skip-tests.json"));
  ccxt::any skippedSettings = ioFileRead(skippedFile);
  this->skippedSettingsForExchange =
      callDynamically(exchange, std::string("safeValue"),
                      ccxt::list{skippedSettings, exchangeId, ccxt::dict{}});
  ccxt::any skippedSettingsForExchange = this->skippedSettingsForExchange;
  // others
  ccxt::any timeout = callDynamically(
      exchange, std::string("safeValue"),
      ccxt::list{skippedSettingsForExchange, std::string("timeout")});
  if (isTrue(!isEqual(timeout, ccxt::any{}))) {
    setProperty(exchange, std::string("timeout"),
                callDynamically(exchange, std::string("parseToInt"),
                                ccxt::list{timeout}));
  }
  if (isTrue(getCliArgValue(std::string("--useProxy")))) {
    setProperty(exchange, std::string("httpProxy"),
                callDynamically(exchange, std::string("safeString"),
                                ccxt::list{skippedSettingsForExchange,
                                           std::string("httpProxy")}));
    setProperty(exchange, std::string("httpsProxy"),
                callDynamically(exchange, std::string("safeString"),
                                ccxt::list{skippedSettingsForExchange,
                                           std::string("httpsProxy")}));
    setProperty(exchange, std::string("wsProxy"),
                callDynamically(exchange, std::string("safeString"),
                                ccxt::list{skippedSettingsForExchange,
                                           std::string("wsProxy")}));
    setProperty(exchange, std::string("wssProxy"),
                callDynamically(exchange, std::string("safeString"),
                                ccxt::list{skippedSettingsForExchange,
                                           std::string("wssProxy")}));
  }
  this->skippedMethods =
      callDynamically(exchange, std::string("safeValue"),
                      ccxt::list{skippedSettingsForExchange,
                                 std::string("skipMethods"), ccxt::dict{}});
  this->checkedPublicTests = ccxt::dict{};
}

virtual ccxt::any addPadding(ccxt::any message, ccxt::any size) {
  // has to be transpilable
  ccxt::any res = std::string("");
  ccxt::any messageLength =
      getStringLength(message); // avoid php transpilation issue
  ccxt::any missingSpace =
      subtract(subtract(size, messageLength),
               0); // - 0 is added just to trick transpile to treat the .length
                   // as a string for php
  if (isTrue(isGreaterThan(missingSpace, 0))) {
    for (ccxt::any i = 0; isLessThan(i, missingSpace); postFixIncrement(i)) {
      res = add(res, std::string(" "));
    }
  }
  return add(message, res);
}

virtual std::shared_future<ccxt::any> testMethod(ccxt::any methodName,
                                                 ccxt::any exchange,
                                                 ccxt::any args,
                                                 ccxt::any isPublic) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               // todo: temporary skip for c#
               if (isTrue(isTrue(isGreaterThanOrEqual(
                              getIndexOf(methodName, std::string("OrderBook")),
                              0)) &&
                          isTrue(isEqual(this->ext, std::string("cs"))))) {
                 ::setValue(getProperty(exchange, std::string("options")),
                            std::string("checksum"), false);
               }
               // todo: temporary skip for php
               if (isTrue(isTrue(isGreaterThanOrEqual(
                              getIndexOf(methodName, std::string("OrderBook")),
                              0)) &&
                          isTrue(isEqual(this->ext, std::string("php"))))) {
                 return true;
               }
               ccxt::any skippedPropertiesForMethod =
                   this->getSkips(exchange, methodName);
               ccxt::any isLoadMarkets =
                   (isEqual(methodName, std::string("loadMarkets")));
               ccxt::any isFetchCurrencies =
                   (isEqual(methodName, std::string("fetchCurrencies")));
               ccxt::any isProxyTest =
                   (isEqual(methodName, this->proxyTestFileName));
               ccxt::any isConstructorTest =
                   (isEqual(methodName, std::string("afterConstruct")));
               ccxt::any isFeatureTest =
                   (isEqual(methodName, std::string("features")));
               // if this is a private test, and the implementation was already
               // tested in public, then no need to re-test it in private test
               // (exception is fetchCurrencies, because our approach in base
               // exchange)
               if (isTrue(isTrue(!isTrue(isPublic) &&
                                 isTrue((inOp(this->checkedPublicTests,
                                              methodName)))) &&
                          !isTrue(isFetchCurrencies))) {
                 return true;
               }
               ccxt::any skipMessage = ccxt::any{};
               ccxt::any supportedByExchange =
                   isTrue(
                       isTrue((inOp(getProperty(exchange, std::string("has")),
                                    methodName))) &&
                       isTrue((!isEqual(
                           ::getValue(getProperty(exchange, std::string("has")),
                                      methodName),
                           ccxt::any{})))) &&
                   isTrue((!isEqual(
                       ::getValue(getProperty(exchange, std::string("has")),
                                  methodName),
                       false)));
               if (isTrue(!isTrue(isLoadMarkets) &&
                          isTrue((isTrue((isGreaterThan(
                                      getArrayLength(this->onlySpecificTests),
                                      0))) &&
                                  isTrue((!isEqual(
                                      callDynamically(
                                          exchange, std::string("inArray"),
                                          ccxt::list{methodName,
                                                     this->onlySpecificTests}),
                                      true))))))) {
                 skipMessage = std::string("[INFO] IGNORED_TEST");
               } else if (isTrue(
                              isTrue(
                                  isTrue(isTrue(!isTrue(isLoadMarkets) &&
                                                !isTrue(supportedByExchange)) &&
                                         !isTrue(isProxyTest)) &&
                                  !isTrue(isFeatureTest)) &&
                              !isTrue(isConstructorTest))) {
                 skipMessage = std::string(
                     "[INFO] UNSUPPORTED_TEST"); // keep it aligned with the
                                                 // longest message
               } else if (isTrue(isString(skippedPropertiesForMethod))) {
                 skipMessage = std::string("[INFO] SKIPPED_TEST");
               } else if (!isTrue((inOp(this->testFiles, methodName)))) {
                 skipMessage = std::string("[INFO] UNIMPLEMENTED_TEST");
               }
               ccxt::any name = getProperty(exchange, std::string("id"));
               // the TESTING / TESTING DONE / TESTING FAILED markers are dumped
               // unconditionally (not gated on `--info`) because run-tests.js
               // diffs them on RUNTEST_TIMED_OUT to report which method(s) were
               // still running when the per-exchange timeout fired
               // exceptionally for `loadMarkets` call, we call it before it's
               // even checked for "skip" as we need it to be called anyway (but
               // can skip "test.loadMarket" for it)
               if (isTrue(isLoadMarkets)) {
                 dump(this->addPadding(std::string("[INFO] TESTING"), 25), name,
                      methodName);
                 awaitValue(callDynamically(
                     exchange, std::string("loadMarkets"), ccxt::list{true}));
                 dump(this->addPadding(std::string("[INFO] TESTING DONE"), 25),
                      name, methodName);
               }
               if (isTrue(isTrue(!isEqual(skipMessage, ccxt::any{})) &&
                          isTrue(!isEqual(skipMessage, std::string(""))))) {
                 if (isTrue(this->info)) {
                   dump(this->addPadding(skipMessage, 25), name, methodName);
                 }
                 return true;
               }
               ccxt::any argsStringified = add(
                   add(std::string("("),
                       callDynamically(exchange, std::string("json"),
                                       ccxt::list{args})),
                   std::string(")")); // args.join() breaks when we provide a
                                      // list of symbols or multidimensional
                                      // array; "args.toString()" breaks bcz of
                                      // "array to string conversion"
               dump(this->addPadding(std::string("[INFO] TESTING"), 25), name,
                    methodName, argsStringified);
               if (isTrue(isSync())) {
                 callMethodSync(this->testFiles, methodName, exchange,
                                skippedPropertiesForMethod, args);
               } else {
                 awaitValue(callMethod(this->testFiles, methodName, exchange,
                                       skippedPropertiesForMethod, args));
               }
               dump(this->addPadding(std::string("[INFO] TESTING DONE"), 25),
                    name, methodName);
               // add to the list of successed tests
               if (isTrue(isPublic)) {
                 ::setValue(this->checkedPublicTests, methodName, true);
               }
               return true;
             })
      .share();
}

virtual ccxt::any getSkips(ccxt::any exchange, ccxt::any methodName) {
  ccxt::any finalSkips = ccxt::dict{};
  // check the exact method (i.e. `fetchTrades`) and language-specific (i.e.
  // `fetchTrades.php`)
  ccxt::any methodNames =
      ccxt::list{methodName, add(add(methodName, std::string(".")), this->ext)};
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(methodNames));
       postFixIncrement(i)) {
    ccxt::any mName = ::getValue(methodNames, i);
    if (isTrue(inOp(this->skippedMethods, mName))) {
      // if whole method is skipped, by assigning a string to it, i.e.
      // "fetchOrders":"blabla"
      if (isTrue(isString(::getValue(this->skippedMethods, mName)))) {
        return ::getValue(this->skippedMethods, mName);
      } else {
        finalSkips = callDynamically(
            exchange, std::string("deepExtend"),
            ccxt::list{finalSkips, ::getValue(this->skippedMethods, mName)});
      }
    }
  }
  // get "object-specific" skips
  ccxt::any objectSkips = ccxt::dict{
      {std::string("orderBook"),
       ccxt::list{std::string("fetchOrderBook"), std::string("fetchOrderBooks"),
                  std::string("fetchL2OrderBook"),
                  std::string("watchOrderBook"),
                  std::string("watchOrderBookForSymbols")}},
      {std::string("ticker"),
       ccxt::list{std::string("fetchTicker"), std::string("fetchTickers"),
                  std::string("watchTicker"), std::string("watchTickers")}},
      {std::string("trade"),
       ccxt::list{std::string("fetchTrades"), std::string("watchTrades"),
                  std::string("watchTradesForSymbols")}},
      {std::string("ohlcv"),
       ccxt::list{std::string("fetchOHLCV"), std::string("watchOHLCV"),
                  std::string("watchOHLCVForSymbols")}},
      {std::string("ledger"),
       ccxt::list{std::string("fetchLedger"), std::string("fetchLedgerEntry")}},
      {std::string("depositWithdraw"),
       ccxt::list{std::string("fetchDepositsWithdrawals"),
                  std::string("fetchDeposits"),
                  std::string("fetchWithdrawals")}},
      {std::string("depositWithdrawFee"),
       ccxt::list{std::string("fetchDepositWithdrawFee"),
                  std::string("fetchDepositWithdrawFees")}},
  };
  ccxt::any objectNames = getObjectKeys(objectSkips);
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(objectNames));
       postFixIncrement(i)) {
    ccxt::any objectName = ::getValue(objectNames, i);
    ccxt::any objectMethods = ::getValue(objectSkips, objectName);
    if (isTrue(callDynamically(exchange, std::string("inArray"),
                               ccxt::list{methodName, objectMethods}))) {
      // if whole object is skipped, by assigning a string to it, i.e.
      // "orderBook":"blabla"
      if (isTrue(isTrue((inOp(this->skippedMethods, objectName))) &&
                 isTrue((isString(
                     ::getValue(this->skippedMethods, objectName)))))) {
        return ::getValue(this->skippedMethods, objectName);
      }
      ccxt::any extraSkips = callDynamically(
          exchange, std::string("safeDict"),
          ccxt::list{this->skippedMethods, objectName, ccxt::dict{}});
      finalSkips = callDynamically(exchange, std::string("deepExtend"),
                                   ccxt::list{finalSkips, extraSkips});
    }
  }
  // extend related skips
  // - if 'timestamp' is skipped, we should do so for 'datetime' too
  // - if 'bid' is skipped, skip 'ask' too
  if (isTrue(isTrue((inOp(finalSkips, std::string("timestamp")))) &&
             !isTrue((inOp(finalSkips, std::string("datetime")))))) {
    ::setValue(finalSkips, std::string("datetime"),
               ::getValue(finalSkips, std::string("timestamp")));
  }
  if (isTrue(isTrue((inOp(finalSkips, std::string("bid")))) &&
             !isTrue((inOp(finalSkips, std::string("ask")))))) {
    ::setValue(finalSkips, std::string("ask"),
               ::getValue(finalSkips, std::string("bid")));
  }
  if (isTrue(isTrue((inOp(finalSkips, std::string("baseVolume")))) &&
             !isTrue((inOp(finalSkips, std::string("quoteVolume")))))) {
    ::setValue(finalSkips, std::string("quoteVolume"),
               ::getValue(finalSkips, std::string("baseVolume")));
  }
  return finalSkips;
}

virtual std::shared_future<ccxt::any> testSafe(ccxt::any methodName,
                                               ccxt::any exchange,
                                               ccxt::any args = ccxt::list{},
                                               ccxt::any isPublic = false) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               // `testSafe` method does not throw an exception, instead mutes
               // it. The reason we mute the thrown exceptions here is because
               // we don't want to stop the whole tests queue if any single
               // test-method fails. Instead, they are echoed with formatted
               // message "[TEST_FAILURE] ..." and that output is then
               // regex-matched by run-tests.js, so the exceptions are still
               // printed out to console from there.
               ccxt::any maxRetries = 3;
               ccxt::any argsStringified = callDynamically(
                   exchange, std::string("json"),
                   ccxt::list{args}); // args.join() breaks when we provide a
                                      // list of symbols or multidimensional
                                      // array; "args.toString()" breaks bcz of
                                      // "array to string conversion"
               for (ccxt::any i = 0; isLessThan(i, maxRetries);
                    postFixIncrement(i)) {
                 try {
                   awaitValue(
                       this->testMethod(methodName, exchange, args, isPublic));
                   return true;
                 } catch (const std::exception &ex) {
                   // close the TESTING marker (pairs with the dump in
                   // `testMethod`), so on a RUNTEST_TIMED_OUT run-tests.js
                   // doesn't misreport a failed method as hung
                   dump(this->addPadding(std::string("[INFO] TESTING FAILED"),
                                         25),
                        getProperty(exchange, std::string("id")), methodName);
                   ccxt::any e = getRootException(ex);
                   ccxt::any isLoadMarkets =
                       (isEqual(methodName, std::string("loadMarkets")));
                   ccxt::any isAuthError =
                       (isInstanceOf<AuthenticationError>(e));
                   ccxt::any isNotSupported = (isInstanceOf<NotSupported>(e));
                   ccxt::any isOperationFailed = (isInstanceOf<OperationFailed>(
                       e)); // includes "DDoSProtection", "RateLimitExceeded",
                            // "RequestTimeout", "ExchangeNotAvailable",
                            // "OperationFailed", "InvalidNonce", ...
                   ccxt::any lastUrlMsg =
                       (isTrue(this->wsTests)
                            ? ccxt::any(std::string(""))
                            : ccxt::any(
                                  add(add(std::string(" (Last url: "),
                                          getProperty(
                                              exchange,
                                              std::string("last_request_url"))),
                                      std::string(" )"))));
                   if (isTrue(isOperationFailed)) {
                     // if last retry was gone with same `tempFailure` error,
                     // then let's eventually return false
                     if (isTrue(isEqual(i, subtract(maxRetries, 1)))) {
                       ccxt::any isOnMaintenance =
                           (isInstanceOf<OnMaintenance>(e));
                       ccxt::any isExchangeNotAvailable =
                           (isInstanceOf<ExchangeNotAvailable>(e));
                       ccxt::any shouldFail = ccxt::any{};
                       ccxt::any retSuccess = ccxt::any{};
                       if (isTrue(isLoadMarkets)) {
                         // if "loadMarkets" does not succeed, we must return
                         // "false" to caller method, to stop tests continual
                         retSuccess = false;
                         // we might not break exchange tests, if exchange is on
                         // maintenance at this moment
                         if (isTrue(isOnMaintenance)) {
                           shouldFail = false;
                         } else {
                           shouldFail = true;
                         }
                       } else {
                         // for any other method tests:
                         if (isTrue(isTrue(isExchangeNotAvailable) &&
                                    !isTrue(isOnMaintenance))) {
                           // break exchange tests if "ExchangeNotAvailable"
                           // exception is thrown, but it's not maintenance
                           shouldFail = true;
                           retSuccess = false;
                         } else {
                           // in all other cases of
                           // std::string("OperationFailed"), show Warning, but
                           // don't mark test as failed
                           shouldFail = false;
                           retSuccess = true;
                         }
                       }
                       // output the message
                       ccxt::any failType =
                           (isTrue(shouldFail)
                                ? ccxt::any(std::string("[TEST_FAILURE]"))
                                : ccxt::any(std::string("[TEST_WARNING]")));
                       dump(failType, getProperty(exchange, std::string("id")),
                            methodName, argsStringified, lastUrlMsg,
                            std::string("Method could not be tested due to a "
                                        "repeated Network/Availability issues"),
                            std::string(" | "), exceptionMessage(e));
                       return retSuccess;
                     } else {
                       // wait and retry again
                       // (increase wait time on every retry)
                       awaitValue(callDynamically(
                           exchange, std::string("sleep"),
                           ccxt::list{multiply((add(i, 1)), 1000)}));
                     }
                   } else {
                     // if it's loadMarkets, then fail test, because it's
                     // mandatory for tests
                     if (isTrue(isLoadMarkets)) {
                       dump(std::string("[TEST_FAILURE]"),
                            getProperty(exchange, std::string("id")),
                            methodName, argsStringified, lastUrlMsg,
                            std::string("Exchange can not load markets"),
                            exceptionMessage(e));
                       return false;
                     }
                     // if the specific arguments to the test method throws
                     // "NotSupported" exception then let's don't fail the test
                     if (isTrue(isNotSupported)) {
                       if (isTrue(this->info)) {
                         dump(std::string("[INFO] NOT_SUPPORTED"),
                              getProperty(exchange, std::string("id")),
                              methodName, argsStringified, lastUrlMsg,
                              exceptionMessage(e));
                       }
                       return true;
                     }
                     // If public test faces authentication error, we don't
                     // break (see comments under `testSafe` method)
                     if (isTrue(isTrue(isPublic) && isTrue(isAuthError))) {
                       if (isTrue(this->info)) {
                         // todo - turn into warning
                         dump(std::string("[INFO]"),
                              getProperty(exchange, std::string("id")),
                              methodName, argsStringified, lastUrlMsg,
                              std::string(
                                  "Authentication problem for public method"),
                              exceptionMessage(e));
                       }
                       return true;
                     } else {
                       dump(std::string("[TEST_FAILURE]"),
                            getProperty(exchange, std::string("id")),
                            methodName, argsStringified, lastUrlMsg,
                            exceptionMessage(e));
                       return false;
                     }
                   }
                 }
               }
               return true;
             })
      .share();
}

virtual std::shared_future<ccxt::any> runPublicTests(ccxt::any exchange,
                                                     ccxt::any symbols) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               ccxt::any primarySymbol = ::getValue(symbols, 0);
               ccxt::any tests = ccxt::dict{
                   {std::string("features"), ccxt::list{}},
                   {std::string("afterConstruct"), ccxt::list{}},
                   {std::string("fetchCurrencies"), ccxt::list{}},
                   {std::string("fetchTicker"), ccxt::list{primarySymbol}},
                   {std::string("fetchTickers"), ccxt::list{primarySymbol}},
                   {std::string("fetchLastPrices"), ccxt::list{primarySymbol}},
                   {std::string("fetchOHLCV"), ccxt::list{primarySymbol}},
                   {std::string("fetchTrades"), ccxt::list{primarySymbol}},
                   {std::string("fetchOrderBook"), ccxt::list{primarySymbol}},
                   {std::string("fetchOrderBooks"), ccxt::list{}},
                   {std::string("fetchBidsAsks"), ccxt::list{}},
                   {std::string("fetchStatus"), ccxt::list{}},
                   {std::string("fetchTime"), ccxt::list{}},
               };
               if (isTrue(this->wsTests)) {
                 tests = ccxt::dict{
                     {std::string("watchOHLCV"), ccxt::list{primarySymbol}},
                     {std::string("watchOHLCVForSymbols"),
                      ccxt::list{primarySymbol}},
                     {std::string("watchTicker"), ccxt::list{primarySymbol}},
                     {std::string("watchTickers"), ccxt::list{primarySymbol}},
                     {std::string("watchBidsAsks"), ccxt::list{primarySymbol}},
                     {std::string("watchOrderBook"), ccxt::list{primarySymbol}},
                     {std::string("watchOrderBookForSymbols"),
                      ccxt::list{symbols}},
                     {std::string("watchTrades"), ccxt::list{primarySymbol}},
                     {std::string("watchTradesForSymbols"),
                      ccxt::list{symbols}},
                 };
               }
               ccxt::any market = callDynamically(
                   exchange, std::string("market"), ccxt::list{primarySymbol});
               ccxt::any isSpot = ::getValue(market, std::string("spot"));
               if (!isTrue(this->wsTests)) {
                 if (isTrue(isEqual(isSpot, true))) {
                   ::setValue(tests, std::string("fetchCurrencies"),
                              ccxt::list{});
                 } else {
                   ::setValue(tests, std::string("fetchFundingRates"),
                              ccxt::list{primarySymbol});
                   ::setValue(tests, std::string("fetchFundingRate"),
                              ccxt::list{primarySymbol});
                   ::setValue(tests, std::string("fetchFundingRateHistory"),
                              ccxt::list{primarySymbol});
                   ::setValue(tests, std::string("fetchIndexOHLCV"),
                              ccxt::list{primarySymbol});
                   ::setValue(tests, std::string("fetchMarkOHLCV"),
                              ccxt::list{primarySymbol});
                   ::setValue(tests, std::string("fetchPremiumIndexOHLCV"),
                              ccxt::list{primarySymbol});
                 }
               }
               this->publicTests = tests;
               awaitValue(this->runTests(exchange, tests, true));
               return true;
             })
      .share();
}

virtual std::shared_future<ccxt::any>
runTests(ccxt::any exchange, ccxt::any tests, ccxt::any isPublicTest) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               ccxt::any testNames = getObjectKeys(tests);
               ccxt::any promises = ccxt::list{};
               for (ccxt::any i = 0; isLessThan(i, getArrayLength(testNames));
                    postFixIncrement(i)) {
                 ccxt::any testName = ::getValue(testNames, i);
                 ccxt::any testArgs = ::getValue(tests, testName);
                 arrayPush(promises, this->testSafe(testName, exchange,
                                                    testArgs, isPublicTest));
               }
               // todo - not yet ready in other langs too
               // promises.push (testThrottle ());
               ccxt::any results = awaitValue(promiseAll(promises));
               // now count which test-methods retuned `false` from "testSafe"
               // and dump that info below
               ccxt::any failedMethods = ccxt::list{};
               for (ccxt::any i = 0; isLessThan(i, getArrayLength(testNames));
                    postFixIncrement(i)) {
                 ccxt::any testName = ::getValue(testNames, i);
                 ccxt::any testReturnedValue = ::getValue(results, i);
                 if (isTrue(!isEqual(testReturnedValue, true))) {
                   arrayPush(failedMethods, testName);
                 }
               }
               ccxt::any testPrefixString =
                   (isTrue(isPublicTest)
                        ? ccxt::any(std::string("PUBLIC_TESTS"))
                        : ccxt::any(std::string("PRIVATE_TESTS")));
               if (isTrue(isGreaterThan(getArrayLength(failedMethods), 0))) {
                 ccxt::any errorsString =
                     join(failedMethods, std::string(", "));
                 dump(std::string("[TEST_FAILURE]"),
                      getProperty(exchange, std::string("id")),
                      testPrefixString,
                      add(std::string("Failed methods : "), errorsString));
               }
               if (isTrue(this->info)) {
                 dump(this->addPadding(
                     add(add(add(std::string("[INFO] END "), testPrefixString),
                             std::string(" ")),
                         getProperty(exchange, std::string("id"))),
                     25));
               }
               return true;
             })
      .share();
}

virtual std::shared_future<ccxt::any> loadExchange(ccxt::any exchange) {
  return std::async(std::launch::deferred,
                    [=]() mutable -> ccxt::any {
                      ccxt::any result = awaitValue(
                          this->testSafe(std::string("loadMarkets"), exchange,
                                         ccxt::list{}, true));
                      if (!isTrue(result)) {
                        return false;
                      }
                      ccxt::any exchangeSymbolsLength = getArrayLength(
                          getProperty(exchange, std::string("symbols")));
                      dump(std::string("[INFO:MAIN] Exchange loaded"),
                           exchangeSymbolsLength, std::string("symbols"));
                      return true;
                    })
      .share();
}

virtual ccxt::any getTestSymbol(ccxt::any exchange, ccxt::any isSpot,
                                ccxt::any symbols) {
  ccxt::any symbol = ccxt::any{};
  ccxt::any preferredSpotSymbol =
      callDynamically(exchange, std::string("safeString"),
                      ccxt::list{this->skippedSettingsForExchange,
                                 std::string("preferredSpotSymbol")});
  ccxt::any preferredSwapSymbol =
      callDynamically(exchange, std::string("safeString"),
                      ccxt::list{this->skippedSettingsForExchange,
                                 std::string("preferredSwapSymbol")});
  if (isTrue(isTrue(isTrue((isEqual(isSpot, true))) &&
                    isTrue((!isEqual(preferredSpotSymbol, ccxt::any{})))) &&
             isTrue((!isEqual(preferredSpotSymbol, std::string("")))))) {
    return preferredSpotSymbol;
  } else if (isTrue(
                 isTrue(isTrue((!isEqual(isSpot, true))) &&
                        isTrue((!isEqual(preferredSwapSymbol, ccxt::any{})))) &&
                 isTrue((!isEqual(preferredSwapSymbol, std::string("")))))) {
    return preferredSwapSymbol;
  }
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(symbols));
       postFixIncrement(i)) {
    ccxt::any s = ::getValue(symbols, i);
    ccxt::any market = callDynamically(
        exchange, std::string("safeValue"),
        ccxt::list{getProperty(exchange, std::string("markets")), s});
    if (isTrue(!isEqual(market, ccxt::any{}))) {
      ccxt::any active =
          callDynamically(exchange, std::string("safeValue"),
                          ccxt::list{market, std::string("active")});
      if (isTrue(isTrue((isEqual(active, true))) ||
                 isTrue((isEqual(active, ccxt::any{}))))) {
        symbol = s;
        break;
      }
    }
  }
  return symbol;
}

virtual ccxt::any getExchangeCode(ccxt::any exchange,
                                  ccxt::any codes = ccxt::any{}) {
  if (isTrue(isEqual(codes, ccxt::any{}))) {
    codes =
        ccxt::list{std::string("BTC"), std::string("ETH"), std::string("XRP"),
                   std::string("LTC"), std::string("BCH"), std::string("EOS"),
                   std::string("BNB"), std::string("BSV"), std::string("USDT")};
  }
  ccxt::any code = ::getValue(codes, 0);
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(codes));
       postFixIncrement(i)) {
    if (isTrue(inOp(getProperty(exchange, std::string("currencies")),
                    ::getValue(codes, i)))) {
      return ::getValue(codes, i);
    }
  }
  return code;
}

virtual ccxt::any getMarketsFromExchange(ccxt::any exchange,
                                         ccxt::any spot = true) {
  ccxt::any res = ccxt::dict{};
  ccxt::any markets = getProperty(exchange, std::string("markets"));
  ccxt::any keys = getObjectKeys(markets);
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(keys));
       postFixIncrement(i)) {
    ccxt::any key = ::getValue(keys, i);
    ccxt::any market = ::getValue(markets, key);
    if (isTrue(
            isTrue(spot) &&
            isTrue((isEqual(::getValue(market, std::string("spot")), true))))) {
      ::setValue(res, ::getValue(market, std::string("symbol")), market);
    } else if (isTrue(!isTrue(spot) &&
                      isTrue((!isEqual(::getValue(market, std::string("spot")),
                                       true))))) {
      ::setValue(res, ::getValue(market, std::string("symbol")), market);
    }
  }
  return res;
}

virtual ccxt::any getValidSymbol(ccxt::any exchange, ccxt::any spot = true) {
  ccxt::any currentTypeMarkets = this->getMarketsFromExchange(exchange, spot);
  ccxt::any codes =
      ccxt::list{std::string("BTC"),  std::string("ETH"),  std::string("XRP"),
                 std::string("LTC"),  std::string("BNB"),  std::string("DASH"),
                 std::string("DOGE"), std::string("ETC"),  std::string("TRX"),
                 std::string("USDT"), std::string("USDC"), std::string("USD"),
                 std::string("GUSD"), std::string("EUR"),  std::string("TUSD"),
                 std::string("CNY"),  std::string("JPY"),  std::string("BRL")};
  ccxt::any spotSymbols = ccxt::list{
      std::string("BTC/USDT"), std::string("BTC/USDC"), std::string("BTC/USD"),
      std::string("BTC/CNY"),  std::string("BTC/EUR"),  std::string("BTC/AUD"),
      std::string("BTC/BRL"),  std::string("BTC/JPY"),  std::string("ETH/USDT"),
      std::string("ETH/USDC"), std::string("ETH/USD"),  std::string("ETH/CNY"),
      std::string("ETH/EUR"),  std::string("ETH/AUD"),  std::string("ETH/BRL"),
      std::string("ETH/JPY"),  std::string("EUR/USDT"), std::string("EUR/USD"),
      std::string("EUR/USDC"), std::string("USDT/EUR"), std::string("USD/EUR"),
      std::string("USDC/EUR"), std::string("BTC/ETH"),  std::string("ETH/BTC")};
  ccxt::any swapSymbols =
      ccxt::list{std::string("BTC/USDT:USDT"), std::string("BTC/USD:USDT"),
                 std::string("BTC/USDC:USDC"), std::string("BTC/USD:USDC"),
                 std::string("BTC/USD:USD"),   std::string("ETH/USDT:USDT"),
                 std::string("ETH/USD:USDT"),  std::string("ETH/USDC:USDC"),
                 std::string("ETH/USD:USDC"),  std::string("ETH/USD:USD"),
                 std::string("BTC/USD:BTC"),   std::string("ETH/USD:ETH")};
  ccxt::any targetSymbols =
      (isTrue(spot) ? ccxt::any(spotSymbols) : ccxt::any(swapSymbols));
  ccxt::any symbol = this->getTestSymbol(exchange, spot, targetSymbols);
  // if symbols wasn't found from above hardcoded list, then try to locate any
  // symbol which has our target hardcoded 'base' code
  if (isTrue(isEqual(symbol, ccxt::any{}))) {
    for (ccxt::any i = 0; isLessThan(i, getArrayLength(codes));
         postFixIncrement(i)) {
      ccxt::any currentCode = ::getValue(codes, i);
      ccxt::any marketsArrayForCurrentCode = callDynamically(
          exchange, std::string("filterBy"),
          ccxt::list{currentTypeMarkets, std::string("base"), currentCode});
      ccxt::any indexedMkts = callDynamically(
          exchange, std::string("indexBy"),
          ccxt::list{marketsArrayForCurrentCode, std::string("symbol")});
      ccxt::any symbolsArrayForCurrentCode = getObjectKeys(indexedMkts);
      ccxt::any symbolsLength = getArrayLength(symbolsArrayForCurrentCode);
      if (isTrue(isGreaterThan(symbolsLength, 0))) {
        symbol =
            this->getTestSymbol(exchange, spot, symbolsArrayForCurrentCode);
        break;
      }
    }
  }
  // if there wasn't found any symbol with our hardcoded 'base' code, then just
  // try to find symbols that are 'active'
  if (isTrue(isEqual(symbol, ccxt::any{}))) {
    ccxt::any activeMarkets = callDynamically(
        exchange, std::string("filterBy"),
        ccxt::list{currentTypeMarkets, std::string("active"), true});
    ccxt::any activeSymbols = ccxt::list{};
    for (ccxt::any i = 0; isLessThan(i, getArrayLength(activeMarkets));
         postFixIncrement(i)) {
      arrayPush(activeSymbols, ::getValue(::getValue(activeMarkets, i),
                                          std::string("symbol")));
    }
    symbol = this->getTestSymbol(exchange, spot, activeSymbols);
  }
  if (isTrue(isEqual(symbol, ccxt::any{}))) {
    ccxt::any values = getObjectValues(currentTypeMarkets);
    ccxt::any valuesLength = getArrayLength(values);
    if (isTrue(isGreaterThan(valuesLength, 0))) {
      ccxt::any first = ::getValue(values, 0);
      if (isTrue(!isEqual(first, ccxt::any{}))) {
        symbol = ::getValue(first, std::string("symbol"));
      }
    }
  }
  return symbol;
}

virtual ccxt::any getTickerVolume(ccxt::any exchange, ccxt::any ticker) {
  // all candidates compared with this helper share the same quote currency,
  // so `quoteVolume` is directly comparable between them. fall back to the
  // base volume converted with the last price, then to the raw base volume,
  // because not every exchange populates `quoteVolume`.
  ccxt::any quoteVolume =
      callDynamically(exchange, std::string("safeNumber"),
                      ccxt::list{ticker, std::string("quoteVolume")});
  if (isTrue(!isEqual(quoteVolume, ccxt::any{}))) {
    return quoteVolume;
  }
  ccxt::any baseVolume =
      callDynamically(exchange, std::string("safeNumber"),
                      ccxt::list{ticker, std::string("baseVolume")});
  if (isTrue(isEqual(baseVolume, ccxt::any{}))) {
    return 0;
  }
  ccxt::any last = callDynamically(exchange, std::string("safeNumber"),
                                   ccxt::list{ticker, std::string("last")});
  if (isTrue(!isEqual(last, ccxt::any{}))) {
    return multiply(baseVolume, last);
  }
  return baseVolume;
}

virtual std::shared_future<ccxt::any>
getMostActiveSymbols(ccxt::any exchange, ccxt::any defaultSymbols) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               // `watch*` methods only resolve when the exchange pushes an
               // update, so a thinly traded market makes the ws tests hang
               // until the harness timeout kills them. the 24h volume is our
               // proxy for "how often does this book change", so rank the
               // markets by it and watch the busiest ones instead. the ranking
               // is restricted to markets sharing the type/quote/settle of the
               // statically chosen symbol, which keeps the volumes comparable
               // (quote volumes denominated in different quote currencies are
               // not) and keeps a per-exchange
               // `preferredSpotSymbol`/`preferredSwapSymbol` meaningful.
               ccxt::any defaultSymbol = ::getValue(defaultSymbols, 0);
               ccxt::any defaultMarket = callDynamically(
                   exchange, std::string("safeDict"),
                   ccxt::list{getProperty(exchange, std::string("markets")),
                              defaultSymbol});
               if (isTrue(isEqual(defaultMarket, ccxt::any{}))) {
                 return defaultSymbols;
               }
               // an explicit per-exchange pin is a deliberate maintainer choice
               // (it usually works around a venue-specific quirk), so never
               // rank around it
               ccxt::any isSpot = callDynamically(
                   exchange, std::string("safeBool"),
                   ccxt::list{defaultMarket, std::string("spot"), false});
               ccxt::any preferredKey =
                   (isTrue((isEqual(isSpot, true)))
                        ? ccxt::any(std::string("preferredSpotSymbol"))
                        : ccxt::any(std::string("preferredSwapSymbol")));
               ccxt::any preferredSymbol = callDynamically(
                   exchange, std::string("safeString"),
                   ccxt::list{this->skippedSettingsForExchange, preferredKey});
               if (isTrue(!isEqual(preferredSymbol, ccxt::any{}))) {
                 return defaultSymbols;
               }
               if (isTrue(!isEqual(
                       callDynamically(
                           exchange, std::string("safeBool"),
                           ccxt::list{getProperty(exchange, std::string("has")),
                                      std::string("fetchTickers"), false}),
                       true))) {
                 return defaultSymbols;
               }
               ccxt::any tickers = ccxt::any{};
               try {
                 // dynamic dispatch: `fetchTickers` is not on the base exchange
                 // type in the statically typed ports (c#/go/java), same as the
                 // other call sites
                 tickers = awaitValue(callExchangeMethodDynamically(
                     exchange, std::string("fetchTickers"), ccxt::list{}));
               } catch (const std::exception &e) {
                 // choosing a symbol must never fail the run, keep the static
                 // choice
                 tickers = ccxt::any{};
               }
               if (isTrue(isEqual(tickers, ccxt::any{}))) {
                 return defaultSymbols;
               }
               ccxt::any marketType = callDynamically(
                   exchange, std::string("safeString"),
                   ccxt::list{defaultMarket, std::string("type")});
               ccxt::any quote = callDynamically(
                   exchange, std::string("safeString"),
                   ccxt::list{defaultMarket, std::string("quote")});
               ccxt::any settle = callDynamically(
                   exchange, std::string("safeString"),
                   ccxt::list{defaultMarket, std::string("settle")});
               ccxt::any candidates = ccxt::list{};
               ccxt::any tickerSymbols = getObjectKeys(tickers);
               for (ccxt::any i = 0;
                    isLessThan(i, getArrayLength(tickerSymbols));
                    postFixIncrement(i)) {
                 ccxt::any tickerSymbol = ::getValue(tickerSymbols, i);
                 ccxt::any market = callDynamically(
                     exchange, std::string("safeDict"),
                     ccxt::list{getProperty(exchange, std::string("markets")),
                                tickerSymbol});
                 if (isTrue(!isEqual(market, ccxt::any{}))) {
                   // exchanges keep returning tickers for delisted markets, and
                   // those never push a websocket update at all, so skip
                   // inactive markets
                   ccxt::any isActive = callDynamically(
                       exchange, std::string("safeBool"),
                       ccxt::list{market, std::string("active"), true});
                   ccxt::any sameType = isEqual(
                       callDynamically(exchange, std::string("safeString"),
                                       ccxt::list{market, std::string("type")}),
                       marketType);
                   ccxt::any sameQuote =
                       isEqual(callDynamically(
                                   exchange, std::string("safeString"),
                                   ccxt::list{market, std::string("quote")}),
                               quote);
                   ccxt::any sameSettle =
                       isEqual(callDynamically(
                                   exchange, std::string("safeString"),
                                   ccxt::list{market, std::string("settle")}),
                               settle);
                   if (isTrue(isTrue(isTrue(isTrue((isEqual(isActive, true))) &&
                                            isTrue(sameType)) &&
                                     isTrue(sameQuote)) &&
                              isTrue(sameSettle))) {
                     ccxt::any ticker = callDynamically(
                         exchange, std::string("safeDict"),
                         ccxt::list{tickers, tickerSymbol, ccxt::dict{}});
                     ccxt::any volume = this->getTickerVolume(exchange, ticker);
                     if (isTrue(isGreaterThan(volume, 0))) {
                       ccxt::any entry = ccxt::dict{};
                       ::setValue(entry, std::string("symbol"), tickerSymbol);
                       ::setValue(entry, std::string("volume"), volume);
                       arrayPush(candidates, entry);
                     }
                   }
                 }
               }
               ccxt::any ranked = callDynamically(
                   exchange, std::string("sortBy"),
                   ccxt::list{candidates, std::string("volume"), true});
               ccxt::any rankedLength = getArrayLength(ranked);
               if (isTrue(isEqual(rankedLength, 0))) {
                 return defaultSymbols;
               }
               ccxt::any result = ccxt::list{callDynamically(
                   exchange, std::string("safeString"),
                   ccxt::list{::getValue(ranked, 0), std::string("symbol")})};
               if (isTrue(isGreaterThan(rankedLength, 1))) {
                 arrayPush(result,
                           callDynamically(exchange, std::string("safeString"),
                                           ccxt::list{::getValue(ranked, 1),
                                                      std::string("symbol")}));
               }
               return result;
             })
      .share();
}

virtual std::shared_future<ccxt::any>
testExchange(ccxt::any exchange, ccxt::any providedSymbol = ccxt::any{}) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               // prediction-market exchanges have no spot/swap markets and
               // address methods by an outcome handle (not a market symbol), so
               // they take a dedicated test flow
               if (isTrue(isEqual(
                       callDynamically(
                           exchange, std::string("safeBool"),
                           ccxt::list{getProperty(exchange, std::string("has")),
                                      std::string("prediction"), false}),
                       true))) {
                 awaitValue(this->runPredictionTests(exchange));
                 return true;
               }
               ccxt::any spotSymbols = ccxt::any{};
               ccxt::any swapSymbols = ccxt::any{};
               // `has` values can be true, false, ccxt::any{} or 'emulated', so
               // only false/ccxt::any{} mean unsupported
               ccxt::any hasSpot =
                   isTrue((!isEqual(
                       ::getValue(getProperty(exchange, std::string("has")),
                                  std::string("spot")),
                       ccxt::any{}))) &&
                   isTrue((!isEqual(
                       ::getValue(getProperty(exchange, std::string("has")),
                                  std::string("spot")),
                       false)));
               ccxt::any hasSwap =
                   isTrue((!isEqual(
                       ::getValue(getProperty(exchange, std::string("has")),
                                  std::string("swap")),
                       ccxt::any{}))) &&
                   isTrue((!isEqual(
                       ::getValue(getProperty(exchange, std::string("has")),
                                  std::string("swap")),
                       false)));
               if (isTrue(!isEqual(providedSymbol, ccxt::any{}))) {
                 ccxt::any market =
                     callDynamically(exchange, std::string("market"),
                                     ccxt::list{providedSymbol});
                 if (isTrue(isEqual(::getValue(market, std::string("spot")),
                                    true))) {
                   spotSymbols = ccxt::list{providedSymbol};
                 } else {
                   swapSymbols = ccxt::list{providedSymbol};
                 }
               } else {
                 if (isTrue(hasSpot)) {
                   ccxt::any primarySymbol =
                       this->getValidSymbol(exchange, true);
                   if (isTrue(!isEqual(primarySymbol, ccxt::any{}))) {
                     ccxt::any secondarySymbol = replace(
                         primarySymbol, std::string("BTC"),
                         std::string("ETH")); // this should work any exchange
                     spotSymbols = ccxt::list{primarySymbol, secondarySymbol};
                   }
                 }
                 if (isTrue(hasSwap)) {
                   ccxt::any primarySymbol =
                       this->getValidSymbol(exchange, false);
                   // some exchanges advertise has['swap']=true via describe()
                   // but the live market list contains no swap entries (e.g.
                   // bequant inherits hitbtc swap support but exposes only spot
                   // pairs). getValidSymbol returns ccxt::any{} in that case —
                   // skip swap tests rather than crashing on
                   // `ccxt::any{}.replace(...)`.
                   if (isTrue(!isEqual(primarySymbol, ccxt::any{}))) {
                     ccxt::any secondarySymbol = replaceAll(
                         primarySymbol, std::string("BTC"),
                         std::string("ETH")); // this should work any exchange
                     swapSymbols = ccxt::list{primarySymbol, secondarySymbol};
                   }
                 }
                 // ws tests subscribe with `watch*`, which only resolves on an
                 // update, so re-target them at the most actively traded
                 // markets to avoid the harness timing out on a quiet book.
                 // rest tests keep the static choice.
                 if (isTrue(this->wsTests)) {
                   if (isTrue(!isEqual(spotSymbols, ccxt::any{}))) {
                     spotSymbols = awaitValue(
                         this->getMostActiveSymbols(exchange, spotSymbols));
                   }
                   if (isTrue(!isEqual(swapSymbols, ccxt::any{}))) {
                     swapSymbols = awaitValue(
                         this->getMostActiveSymbols(exchange, swapSymbols));
                   }
                 }
               }
               if (isTrue(!isEqual(spotSymbols, ccxt::any{}))) {
                 dump(std::string("[INFO:MAIN] Selected SPOT SYMBOL:"),
                      callDynamically(exchange, std::string("json"),
                                      ccxt::list{spotSymbols}));
               }
               if (isTrue(!isEqual(swapSymbols, ccxt::any{}))) {
                 dump(std::string("[INFO:MAIN] Selected SWAP SYMBOL:"),
                      callDynamically(exchange, std::string("json"),
                                      ccxt::list{swapSymbols}));
               }
               if (!isTrue(this->privateTestOnly)) {
                 // note, spot & swap tests should run sequentially, because of
                 // conflicting `getProperty(exchange,
                 // std::string("options"))['defaultType']` setting
                 if (isTrue(isTrue(hasSpot) &&
                            isTrue((!isEqual(spotSymbols, ccxt::any{}))))) {
                   if (isTrue(this->info)) {
                     dump(std::string("[INFO] ### SPOT TESTS ###"));
                   }
                   ::setValue(getProperty(exchange, std::string("options")),
                              std::string("defaultType"), std::string("spot"));
                   awaitValue(this->runPublicTests(exchange, spotSymbols));
                 }
                 if (isTrue(isTrue(hasSwap) &&
                            isTrue((!isEqual(swapSymbols, ccxt::any{}))))) {
                   if (isTrue(this->info)) {
                     dump(std::string("[INFO] ### SWAP TESTS ###"));
                   }
                   ::setValue(getProperty(exchange, std::string("options")),
                              std::string("defaultType"), std::string("swap"));
                   awaitValue(this->runPublicTests(exchange, swapSymbols));
                 }
               }
               if (isTrue(isTrue(this->privateTest) ||
                          isTrue(this->privateTestOnly))) {
                 if (isTrue(isTrue(hasSpot) &&
                            isTrue((!isEqual(spotSymbols, ccxt::any{}))))) {
                   ::setValue(getProperty(exchange, std::string("options")),
                              std::string("defaultType"), std::string("spot"));
                   awaitValue(this->runPrivateTests(exchange, spotSymbols));
                 }
                 if (isTrue(isTrue(hasSwap) &&
                            isTrue((!isEqual(swapSymbols, ccxt::any{}))))) {
                   ::setValue(getProperty(exchange, std::string("options")),
                              std::string("defaultType"), std::string("swap"));
                   awaitValue(this->runPrivateTests(exchange, swapSymbols));
                 }
               }
               return true;
             })
      .share();
}

virtual std::shared_future<ccxt::any> runPredictionTests(ccxt::any exchange) {
  return std::
      async(std::launch::deferred,
            [=]() mutable -> ccxt::any {
              // loadMarkets (already called by loadExchange) populates the
              // markets and their outcome tokens; resolve a tradeable outcome
              // handle from them (works in every language since
              // getProperty(exchange, std::string("markets")) is typed on the
              // base, unlike the prediction-only outcomes cache), then
              // fetchEvents for an event id and run every method by that
              // outcome handle a skip-tests.json preferredPredictionOutcome
              // pins a tradeable outcome — some venues list many
              // resolved/halted markets (e.g. hyperliquid testnet) whose first
              // outcome can't be traded
              ccxt::any outcomeSymbol = callDynamically(
                  exchange, std::string("safeString"),
                  ccxt::list{this->skippedSettingsForExchange,
                             std::string("preferredPredictionOutcome")});
              if (isTrue(!isEqual(outcomeSymbol, ccxt::any{}))) {
                // validate the pin against the live listing - venues can rotate
                // ids/handles (hyperliquid re-assigns outcome ids), which would
                // strand a stale pin
                ccxt::any pinFound = false;
                ccxt::any pinnedKeys = getObjectKeys(
                    getProperty(exchange, std::string("markets")));
                for (ccxt::any i = 0; isLessThan(i, getArrayLength(pinnedKeys));
                     postFixIncrement(i)) {
                  ccxt::any pinnedMarket =
                      ::getValue(getProperty(exchange, std::string("markets")),
                                 ::getValue(pinnedKeys, i));
                  ccxt::any pinnedOutcomes = callDynamically(
                      exchange, std::string("safeList"),
                      ccxt::list{pinnedMarket, std::string("outcomes"),
                                 ccxt::list{}});
                  for (ccxt::any j = 0;
                       isLessThan(j, getArrayLength(pinnedOutcomes));
                       postFixIncrement(j)) {
                    if (isTrue(isEqual(
                            callDynamically(
                                exchange, std::string("safeString"),
                                ccxt::list{::getValue(pinnedOutcomes, j),
                                           std::string("outcome")}),
                            outcomeSymbol))) {
                      pinFound = true;
                      break;
                    }
                  }
                  if (isTrue(pinFound)) {
                    break;
                  }
                }
                if (!isTrue(pinFound)) {
                  dump(std::string("[INFO:MAIN] preferredPredictionOutcome"),
                       outcomeSymbol,
                       std::string("not in the live listing (stale pin?) - "
                                   "falling back to market scan"));
                  outcomeSymbol = ccxt::any{};
                }
              }
              if (isTrue(isEqual(outcomeSymbol, ccxt::any{}))) {
                ccxt::any marketKeys = getObjectKeys(
                    getProperty(exchange, std::string("markets")));
                for (ccxt::any i = 0; isLessThan(i, getArrayLength(marketKeys));
                     postFixIncrement(i)) {
                  ccxt::any market =
                      ::getValue(getProperty(exchange, std::string("markets")),
                                 ::getValue(marketKeys, i));
                  ccxt::any outcomesList = callDynamically(
                      exchange, std::string("safeList"),
                      ccxt::list{market, std::string("outcomes"),
                                 ccxt::list{}});
                  ccxt::any outcomesListLength = getArrayLength(outcomesList);
                  if (isTrue(isGreaterThan(outcomesListLength, 0))) {
                    outcomeSymbol =
                        callDynamically(exchange, std::string("safeString"),
                                        ccxt::list{::getValue(outcomesList, 0),
                                                   std::string("outcome")});
                    if (isTrue(!isEqual(outcomeSymbol, ccxt::any{}))) {
                      break;
                    }
                  }
                }
              }
              if (isTrue(isEqual(outcomeSymbol, ccxt::any{}))) {
                dump(std::string("[TEST_FAILURE]"),
                     getProperty(exchange, std::string("id")),
                     std::string(
                         "no tradeable outcome available in loaded markets"));
                return false;
              }
              // fetchEvents/fetchEvent are prediction-only and not on every
              // language's typed base (Go's ICoreExchange / C# Exchange), so
              // invoke them dynamically by name and validate inline rather than
              // through a per-method test file
              ccxt::any eventId = ccxt::any{};
              if (!isTrue(this->wsTests)) {
                try {
                  // the scoping contract: an unscoped fetchEvents must throw
                  // ArgumentsRequired on every prediction venue — assert it so
                  // the contract can't silently regress. venues with bounded
                  // listings may opt out via
                  // options['allowUnscopedFetchEvents']
                  ccxt::any exchangeOptions = getExchangeProp(
                      exchange, std::string("options"), ccxt::dict{});
                  ccxt::any allowUnscopedFetchEvents = callDynamically(
                      exchange, std::string("safeBool"),
                      ccxt::list{exchangeOptions,
                                 std::string("allowUnscopedFetchEvents"),
                                 false});
                  if (isTrue(!isEqual(allowUnscopedFetchEvents, true))) {
                    ccxt::any unscopedError = std::string("");
                    try {
                      awaitValue(callExchangeMethodDynamically(
                          exchange, std::string("fetchEvents"),
                          ccxt::list{ccxt::dict{}}));
                    } catch (const std::exception &e) {
                      unscopedError = exceptionMessage(e);
                    }
                    assertTrue(
                        isGreaterThanOrEqual(
                            getIndexOf(unscopedError,
                                       std::string("requires at least one of")),
                            0),
                        add(add(getProperty(exchange, std::string("id")),
                                std::string(
                                    " fetchEvents () without a scope must "
                                    "throw ArgumentsRequired, got: ")),
                            unscopedError));
                  }
                  // every venue requires fetchEvents to be scoped; a
                  // skip-tests.json preferredEventQuery supplies a query known
                  // to match the venue's markets
                  ccxt::any eventQuery = callDynamically(
                      exchange, std::string("safeString"),
                      ccxt::list{this->skippedSettingsForExchange,
                                 std::string("preferredEventQuery")});
                  if (isTrue(isEqual(eventQuery, ccxt::any{}))) {
                    // derive one from the selected outcome handle (the market
                    // words with separators as spaces) so the scoped contract
                    // holds even without a pin
                    ccxt::any handleParts =
                        split(outcomeSymbol, std::string(":"));
                    ccxt::any marketPart = ::getValue(handleParts, 0);
                    ccxt::any lowerPart = toLowerCase(marketPart);
                    ccxt::any dedashed = replaceAll(lowerPart, std::string("-"),
                                                    std::string(" "));
                    eventQuery = replaceAll(dedashed, std::string("_"),
                                            std::string(" "));
                  }
                  ccxt::any eventParams = ccxt::dict{};
                  if (isTrue(!isEqual(eventQuery, ccxt::any{}))) {
                    ::setValue(eventParams, std::string("query"), eventQuery);
                  }
                  ccxt::any events = awaitValue(callExchangeMethodDynamically(
                      exchange, std::string("fetchEvents"),
                      ccxt::list{eventParams}));
                  assertTrue(
                      !isEqual(events, ccxt::any{}),
                      add(getProperty(exchange, std::string("id")),
                          std::string(" fetchEvents returned undefined")));
                  // coerce the dynamic (any) result to a typed list via
                  // safeList (on the core interface)
                  ccxt::any eventsList = callDynamically(
                      exchange, std::string("safeList"),
                      ccxt::list{ccxt::dict{
                                     {std::string("events"), events},
                                 },
                                 std::string("events"), ccxt::list{}});
                  this->assertPredictionEvents(exchange, eventsList);
                  ccxt::any eventsLength = getArrayLength(eventsList);
                  if (isTrue(isGreaterThan(eventsLength, 0))) {
                    eventId =
                        callDynamically(exchange, std::string("safeString"),
                                        ccxt::list{::getValue(eventsList, 0),
                                                   std::string("id")});
                  }
                  if (isTrue(
                          isTrue((!isEqual(eventId, ccxt::any{}))) &&
                          isTrue((isEqual(
                              callDynamically(
                                  exchange, std::string("safeBool"),
                                  ccxt::list{
                                      getProperty(exchange, std::string("has")),
                                      std::string("fetchEvent"), false}),
                              true))))) {
                    ccxt::any event = awaitValue(callExchangeMethodDynamically(
                        exchange, std::string("fetchEvent"),
                        ccxt::list{eventId}));
                    this->assertPredictionEvent(exchange, event);
                  }
                  // exercise EACH scoping parameter path, not just the initial
                  // query. a scope that silently returns [] (e.g. an eventId
                  // served from a cold cache, or an unresolved series filter)
                  // is a real bug that only surfaces if the path is actually
                  // asserted. build the scope list here (inline, not via a
                  // helper) so the callExchangeMethodDynamically calls stay
                  // inside this try/catch — Java can't propagate their checked
                  // exception otherwise
                  ccxt::any scopesToTest = ccxt::list{};
                  if (isTrue(!isEqual(eventId, ccxt::any{}))) {
                    // copy to a const so the dict capture is effectively-final
                    // (Java inner-class rule), since eventId is reassigned
                    // above. every venue must refetch an event by its own id
                    ccxt::any eventIdScope = eventId;
                    arrayPush(scopesToTest,
                              ccxt::dict{
                                  {std::string("eventId"), eventIdScope},
                              });
                  }
                  // optional exchange-specific server-side scopes (e.g. kalshi
                  // series_ticker / tags / category) declared in
                  // skip-tests.json preferredEventScopes as an array of param
                  // dicts
                  ccxt::any extraScopes = callDynamically(
                      exchange, std::string("safeList"),
                      ccxt::list{this->skippedSettingsForExchange,
                                 std::string("preferredEventScopes"),
                                 ccxt::list{}});
                  ccxt::any extraScopesLength = getArrayLength(extraScopes);
                  for (ccxt::any si = 0; isLessThan(si, extraScopesLength);
                       postFixIncrement(si)) {
                    arrayPush(scopesToTest, ::getValue(extraScopes, si));
                  }
                  ccxt::any scopesToTestLength = getArrayLength(scopesToTest);
                  for (ccxt::any sj = 0; isLessThan(sj, scopesToTestLength);
                       postFixIncrement(sj)) {
                    ccxt::any scope = ::getValue(scopesToTest, sj);
                    // fetchEvents scoped by a single parameter must return a
                    // non-empty, valid list
                    ccxt::any scopedEvents =
                        awaitValue(callExchangeMethodDynamically(
                            exchange, std::string("fetchEvents"),
                            ccxt::list{scope}));
                    ccxt::any scopedList = callDynamically(
                        exchange, std::string("safeList"),
                        ccxt::list{ccxt::dict{
                                       {std::string("events"), scopedEvents},
                                   },
                                   std::string("events"), ccxt::list{}});
                    ccxt::any scopedListLength = getArrayLength(scopedList);
                    assertTrue(
                        isGreaterThan(scopedListLength, 0),
                        add(add(add(getProperty(exchange, std::string("id")),
                                    std::string(" fetchEvents scoped by ")),
                                callDynamically(exchange, std::string("json"),
                                                ccxt::list{scope})),
                            std::string(" returned no events - the parameter "
                                        "path may be broken")));
                    this->assertPredictionEvents(exchange, scopedList);
                  }
                  if (isTrue(!isEqual(eventQuery, ccxt::any{}))) {
                    // limit must bound the number of events returned (applied
                    // by applyEventFetchParams)
                    ccxt::any limited =
                        awaitValue(callExchangeMethodDynamically(
                            exchange, std::string("fetchEvents"),
                            ccxt::list{ccxt::dict{
                                {std::string("query"), eventQuery},
                                {std::string("limit"), 1},
                            }}));
                    ccxt::any limitedList = callDynamically(
                        exchange, std::string("safeList"),
                        ccxt::list{ccxt::dict{
                                       {std::string("events"), limited},
                                   },
                                   std::string("events"), ccxt::list{}});
                    ccxt::any limitedListLength = getArrayLength(limitedList);
                    assertTrue(isLessThanOrEqual(limitedListLength, 1),
                               add(getProperty(exchange, std::string("id")),
                                   std::string(
                                       " fetchEvents did not honour limit=1")));
                  }
                } catch (const std::exception &e) {
                  dump(std::string("[TEST_FAILURE]"),
                       getProperty(exchange, std::string("id")),
                       std::string("fetchEvents/fetchEvent failed:"),
                       exceptionMessage(e));
                  return false;
                }
                // no-arg fetchTickers honesty: a venue that cannot serve every
                // ticker without an unbounded scan (options.loadAllOutcomes
                // false) must throw ArgumentsRequired instead of silently
                // returning a capped subset
                ccxt::any canServeAllTickers = callDynamically(
                    exchange, std::string("safeBool"),
                    ccxt::list{getProperty(exchange, std::string("options")),
                               std::string("loadAllOutcomes"), false});
                if (isTrue(
                        isTrue((!isEqual(canServeAllTickers, true))) &&
                        isTrue((isEqual(
                            callDynamically(
                                exchange, std::string("safeBool"),
                                ccxt::list{
                                    getProperty(exchange, std::string("has")),
                                    std::string("fetchTickers"), false}),
                            true))))) {
                  ccxt::any tickersError = std::string("");
                  try {
                    awaitValue(callExchangeMethodDynamically(
                        exchange, std::string("fetchTickers"), ccxt::list{}));
                  } catch (const std::exception &e) {
                    tickersError = exceptionMessage(e);
                  }
                  assertTrue(
                      isGreaterThanOrEqual(
                          getIndexOf(
                              tickersError,
                              std::string("requires an outcomes argument")),
                          0),
                      add(add(getProperty(exchange, std::string("id")),
                              std::string(
                                  " fetchTickers () without outcomes must "
                                  "throw ArgumentsRequired, got: ")),
                          tickersError));
                }
              }
              dump(std::string("[INFO:MAIN] Selected prediction OUTCOME:"),
                   outcomeSymbol, std::string("| EVENT:"),
                   callDynamically(exchange, std::string("json"),
                                   ccxt::list{eventId}));
              ccxt::any publicTests = ccxt::dict{
                  {std::string("fetchStatus"), ccxt::list{}},
                  {std::string("fetchTime"), ccxt::list{}},
                  {std::string("fetchTradingFee"), ccxt::list{outcomeSymbol}},
                  {std::string("fetchOpenInterest"), ccxt::list{outcomeSymbol}},
                  {std::string("fetchTicker"), ccxt::list{outcomeSymbol}},
                  {std::string("fetchTickers"), ccxt::list{outcomeSymbol}},
                  {std::string("fetchOrderBook"), ccxt::list{outcomeSymbol}},
                  {std::string("fetchOHLCV"), ccxt::list{outcomeSymbol}},
                  {std::string("fetchTrades"), ccxt::list{outcomeSymbol}},
              };
              if (isTrue(this->wsTests)) {
                publicTests = ccxt::dict{
                    {std::string("watchTicker"), ccxt::list{outcomeSymbol}},
                    {std::string("watchOrderBook"), ccxt::list{outcomeSymbol}},
                    {std::string("watchTrades"), ccxt::list{outcomeSymbol}},
                };
              }
              if (!isTrue(this->privateTestOnly)) {
                awaitValue(this->runTests(exchange, publicTests, true));
              }
              if (isTrue(isTrue((isTrue(this->privateTest) ||
                                 isTrue(this->privateTestOnly))) &&
                         !isTrue(this->wsTests))) {
                ccxt::any privateTests = ccxt::dict{
                    {std::string("fetchBalance"), ccxt::list{}},
                    {std::string("fetchPositions"), ccxt::list{outcomeSymbol}},
                    {std::string("fetchMyTrades"), ccxt::list{outcomeSymbol}},
                    {std::string("fetchOrders"), ccxt::list{outcomeSymbol}},
                    {std::string("fetchOpenOrders"), ccxt::list{outcomeSymbol}},
                    {std::string("fetchClosedOrders"),
                     ccxt::list{outcomeSymbol}},
                    {std::string("fetchOrder"), ccxt::list{outcomeSymbol}},
                };
                awaitValue(this->runTests(exchange, privateTests, false));
                // order placement is real money — gated behind --fundedTests,
                // like crypto createOrder
                if (isTrue(getCliArgValue(std::string("--fundedTests")))) {
                  awaitValue(this->testPredictionCreateCancelOrder(
                      exchange, outcomeSymbol));
                }
              }
              return true;
            })
          .share();
}

virtual ccxt::any assertPredictionEvents(ccxt::any exchange, ccxt::any events) {
  assertTrue(isArray(events),
             add(getProperty(exchange, std::string("id")),
                 std::string(" fetchEvents/fetchEvent should return a list")));
  ccxt::any eventsLength = getArrayLength(events);
  for (ccxt::any i = 0; isLessThan(i, eventsLength); postFixIncrement(i)) {
    this->assertPredictionEvent(exchange, ::getValue(events, i));
  }
  return true;
}

virtual ccxt::any assertPredictionEvent(ccxt::any exchange, ccxt::any event) {
  // validates one PredictionEvent structure (id, event handle, markets each
  // carrying an outcomes list, and the optional typed fields when present)
  ccxt::any logText =
      add(std::string(" event: "),
          callDynamically(exchange, std::string("json"), ccxt::list{event}));
  assertTrue(isEqual(callDynamically(exchange, std::string("isDictionary"),
                                     ccxt::list{event}),
                     true),
             add(add(getProperty(exchange, std::string("id")),
                     std::string(" event should be a dict")),
                 logText));
  assertTrue(!isEqual(callDynamically(exchange, std::string("safeString"),
                                      ccxt::list{event, std::string("id")}),
                      ccxt::any{}),
             add(add(getProperty(exchange, std::string("id")),
                     std::string(" event missing id")),
                 logText));
  assertTrue(!isEqual(callDynamically(exchange, std::string("safeString"),
                                      ccxt::list{event, std::string("event")}),
                      ccxt::any{}),
             add(add(getProperty(exchange, std::string("id")),
                     std::string(" event missing the unified event handle")),
                 logText));
  ccxt::any markets =
      callDynamically(exchange, std::string("safeList"),
                      ccxt::list{event, std::string("markets")});
  assertTrue(!isEqual(markets, ccxt::any{}),
             add(add(getProperty(exchange, std::string("id")),
                     std::string(" event missing markets")),
                 logText));
  ccxt::any marketsLength = getArrayLength(markets);
  assertTrue(
      isEqual(callDynamically(exchange, std::string("safeString"),
                              ccxt::list{event, std::string("symbol")}),
              ccxt::any{}),
      add(add(getProperty(exchange, std::string("id")),
              std::string(" event must not carry the deprecated symbol key")),
          logText));
  for (ccxt::any i = 0; isLessThan(i, marketsLength); postFixIncrement(i)) {
    ccxt::any market = ::getValue(markets, i);
    assertTrue(isEqual(callDynamically(exchange, std::string("isDictionary"),
                                       ccxt::list{market}),
                       true),
               add(add(getProperty(exchange, std::string("id")),
                       std::string(" event market should be a dict")),
                   logText));
    assertTrue(
        !isEqual(callDynamically(exchange, std::string("safeString"),
                                 ccxt::list{market, std::string("market")}),
                 ccxt::any{}),
        add(add(getProperty(exchange, std::string("id")),
                std::string(" event market missing the unified market handle")),
            logText));
    // 'symbol' is deprecated on prediction structures — the unified 'market'
    // handle is the identity
    assertTrue(
        isEqual(callDynamically(exchange, std::string("safeString"),
                                ccxt::list{market, std::string("symbol")}),
                ccxt::any{}),
        add(add(getProperty(exchange, std::string("id")),
                std::string(
                    " event market must not carry the deprecated symbol key")),
            logText));
    ccxt::any outcomes =
        callDynamically(exchange, std::string("safeList"),
                        ccxt::list{market, std::string("outcomes")});
    assertTrue(!isEqual(outcomes, ccxt::any{}),
               add(add(getProperty(exchange, std::string("id")),
                       std::string(" event market missing outcomes")),
                   logText));
    ccxt::any outcomesLength = getArrayLength(outcomes);
    for (ccxt::any j = 0; isLessThan(j, outcomesLength); postFixIncrement(j)) {
      assertTrue(isEqual(callDynamically(exchange, std::string("safeString"),
                                         ccxt::list{::getValue(outcomes, j),
                                                    std::string("symbol")}),
                         ccxt::any{}),
                 add(add(getProperty(exchange, std::string("id")),
                         std::string(" event outcome must not carry the "
                                     "deprecated symbol key")),
                     logText));
    }
  }
  // optional typed fields must have the right type when present
  ccxt::any active = callDynamically(exchange, std::string("safeValue"),
                                     ccxt::list{event, std::string("active")});
  if (isTrue(!isEqual(active, ccxt::any{}))) {
    // typeof check, not `=== true || === false` — the latter transpiles to `==
    // False` in Python, which ruff rejects (E712)
    assertTrue(isBool(active),
               add(add(getProperty(exchange, std::string("id")),
                       std::string(" event active must be a bool")),
                   logText));
  }
  ccxt::any tags = callDynamically(exchange, std::string("safeValue"),
                                   ccxt::list{event, std::string("tags")});
  if (isTrue(!isEqual(tags, ccxt::any{}))) {
    assertTrue(isArray(tags),
               add(add(getProperty(exchange, std::string("id")),
                       std::string(" event tags must be a list")),
                   logText));
  }
  ccxt::any info = callDynamically(exchange, std::string("safeValue"),
                                   ccxt::list{event, std::string("info")});
  assertTrue(!isEqual(info, ccxt::any{}),
             add(add(getProperty(exchange, std::string("id")),
                     std::string(" event missing info")),
                 logText));
  return true;
}

virtual std::shared_future<ccxt::any>
testPredictionCreateCancelOrder(ccxt::any exchange, ccxt::any outcome) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               // place a deliberately non-marketable limit BUY (low fixed price
               // * tiny amount), assert it, then always cancel it. Safe by
               // construction: 5 shares @ 0.02 = 0.10 USD notional, far under
               // the 25 USD live-test cap, and a 0.02 bid won't fill for a
               // normal outcome. createOrder/cancelOrder are invoked
               // dynamically since they aren't on every language's typed
               // core-exchange interface (e.g. Go's ICoreExchange).
               if (isTrue(!isEqual(
                       callDynamically(
                           exchange, std::string("safeBool"),
                           ccxt::list{getProperty(exchange, std::string("has")),
                                      std::string("createOrder"), false}),
                       true))) {
                 return true;
               }
               // honour a skip-tests.json createOrder skip — e.g. polymarket
               // geo-blocks order placement and CI runs via an EU proxy, so
               // live order placement is skipped and covered by fixtures
               ccxt::any createOrderSkip =
                   this->getSkips(exchange, std::string("createOrder"));
               if (isTrue(isString(createOrderSkip))) {
                 dump(
                     std::string("[INFO] skipping prediction createOrder test"),
                     getProperty(exchange, std::string("id")), createOrderSkip);
                 return true;
               }
               ccxt::any canCancel =
                   isTrue((isEqual(
                       callDynamically(
                           exchange, std::string("safeBool"),
                           ccxt::list{getProperty(exchange, std::string("has")),
                                      std::string("cancelOrder"), false}),
                       true))) ||
                   isTrue((isEqual(
                       callDynamically(
                           exchange, std::string("safeBool"),
                           ccxt::list{getProperty(exchange, std::string("has")),
                                      std::string("cancelAllOrders"), false}),
                       true)));
               if (!isTrue(canCancel)) {
                 dump(
                     std::string("[INFO] skipping prediction createOrder test"),
                     getProperty(exchange, std::string("id")),
                     std::string("no cancelOrder/cancelAllOrders"));
                 return true;
               }
               if (isTrue(!isEqual(
                       callDynamically(exchange,
                                       std::string("checkRequiredCredentials"),
                                       ccxt::list{false}),
                       true))) {
                 dump(
                     std::string("[INFO] skipping prediction createOrder test"),
                     getProperty(exchange, std::string("id")),
                     std::string("keys not found"));
                 return true;
               }
               // default 5 @ 0.02 = 0.10 USD notional. a venue with a higher
               // minimum (e.g. hyperliquid testnet's 10 USD min) overrides
               // amount/price via skip-tests.json fundedAmount/fundedPrice; any
               // override's notional (amount * price) MUST stay well under the
               // 25 USD live-test cap
               ccxt::any price =
                   callDynamically(exchange, std::string("parseToNumeric"),
                                   ccxt::list{std::string("0.02")});
               ccxt::any amount =
                   callDynamically(exchange, std::string("parseToNumeric"),
                                   ccxt::list{std::string("5")});
               ccxt::any fundedPrice =
                   callDynamically(exchange, std::string("safeString"),
                                   ccxt::list{this->skippedSettingsForExchange,
                                              std::string("fundedPrice")});
               if (isTrue(!isEqual(fundedPrice, ccxt::any{}))) {
                 price =
                     callDynamically(exchange, std::string("parseToNumeric"),
                                     ccxt::list{fundedPrice});
               }
               ccxt::any fundedAmount =
                   callDynamically(exchange, std::string("safeString"),
                                   ccxt::list{this->skippedSettingsForExchange,
                                              std::string("fundedAmount")});
               if (isTrue(!isEqual(fundedAmount, ccxt::any{}))) {
                 amount =
                     callDynamically(exchange, std::string("parseToNumeric"),
                                     ccxt::list{fundedAmount});
               }
               dump(std::string("[INFO:MAIN] prediction createOrder"),
                    getProperty(exchange, std::string("id")), outcome,
                    std::string("buy"), amount, std::string("@"), price);
               // no try/finally and no re-throw from the catch (the typed-lang
               // async lambdas can't do either): record any failure, ALWAYS
               // attempt the cancel, then report the failure
               ccxt::any order = ccxt::any{};
               ccxt::any placedId = ccxt::any{};
               ccxt::any failure = ccxt::any{};
               try {
                 order = awaitValue(callExchangeMethodDynamically(
                     exchange, std::string("createOrder"),
                     ccxt::list{outcome, std::string("limit"),
                                std::string("buy"), amount, price}));
                 assertTrue(
                     !isEqual(order, ccxt::any{}),
                     add(std::string("createOrder returned undefined for "),
                         getProperty(exchange, std::string("id"))));
                 assertTrue(isEqual(callDynamically(exchange,
                                                    std::string("isDictionary"),
                                                    ccxt::list{order}),
                                    true),
                            add(std::string("createOrder did not return an "
                                            "order structure for "),
                                getProperty(exchange, std::string("id"))));
                 placedId =
                     callDynamically(exchange, std::string("safeString"),
                                     ccxt::list{order, std::string("id")});
                 assertTrue(
                     !isEqual(placedId, ccxt::any{}),
                     add(std::string("createOrder returned no order id for "),
                         getProperty(exchange, std::string("id"))));
                 ccxt::any returnedOutcome =
                     callDynamically(exchange, std::string("safeString"),
                                     ccxt::list{order, std::string("outcome")});
                 assertTrue(
                     isTrue((isEqual(returnedOutcome, ccxt::any{}))) ||
                         isTrue((isEqual(returnedOutcome, outcome))),
                     add(add(add(add(add(std::string("createOrder outcome \""),
                                         callDynamically(
                                             exchange, std::string("json"),
                                             ccxt::list{returnedOutcome})),
                                     std::string(
                                         "\" should match requested \"")),
                                 outcome),
                             std::string("\" for ")),
                         getProperty(exchange, std::string("id"))));
               } catch (const std::exception &e) {
                 failure = exceptionMessage(e);
               }
               // always cancel any placed order (cancelPredictionOrder swallows
               // its own errors)
               awaitValue(
                   this->cancelPredictionOrder(exchange, placedId, outcome));
               if (isTrue(!isEqual(failure, ccxt::any{}))) {
                 dump(std::string("[TEST_FAILURE]"),
                      getProperty(exchange, std::string("id")),
                      std::string("prediction createOrder failed:"), failure);
                 return false;
               }
               return true;
             })
      .share();
}

virtual std::shared_future<ccxt::any> cancelPredictionOrder(ccxt::any exchange,
                                                            ccxt::any orderId,
                                                            ccxt::any outcome) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               if (isTrue(isEqual(orderId, ccxt::any{}))) {
                 return true;
               }
               try {
                 if (isTrue(isEqual(
                         callDynamically(
                             exchange, std::string("safeBool"),
                             ccxt::list{
                                 getProperty(exchange, std::string("has")),
                                 std::string("cancelOrder"), false}),
                         true))) {
                   awaitValue(callExchangeMethodDynamically(
                       exchange, std::string("cancelOrder"),
                       ccxt::list{orderId, outcome}));
                 } else {
                   awaitValue(callExchangeMethodDynamically(
                       exchange, std::string("cancelAllOrders"),
                       ccxt::list{outcome}));
                 }
                 dump(std::string("[INFO:MAIN] prediction order cancelled"),
                      getProperty(exchange, std::string("id")), orderId);
               } catch (const std::exception &e) {
                 dump(std::string("[WARN] prediction order cancel failed"),
                      getProperty(exchange, std::string("id")), orderId,
                      exceptionMessage(e));
               }
               return true;
             })
      .share();
}

virtual std::shared_future<ccxt::any> runPrivateTests(ccxt::any exchange,
                                                      ccxt::any symbols) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               // mirrors runPublicTests: the caller always passes the selected
               // symbols as an array (even a CLI-provided symbol arrives as a
               // one-element array), and private tests run on the primary
               // symbol per market type
               ccxt::any symbol = ::getValue(symbols, 0);
               if (isTrue(!isEqual(
                       callDynamically(exchange,
                                       std::string("checkRequiredCredentials"),
                                       ccxt::list{false}),
                       true))) {
                 dump(std::string("[INFO] Skipping private tests"),
                      std::string("Keys not found"));
                 return true;
               }
               ccxt::any code = this->getExchangeCode(exchange);
               // if (getProperty(exchange, std::string("deepExtendedTest"))) {
               //     await test ('InvalidNonce', exchange, symbol);
               //     await test ('OrderNotFound', exchange, symbol);
               //     await test ('InvalidOrder', exchange, symbol);
               //     await test ('InsufficientFunds', exchange, symbol,
               //     balance); // danger zone - won't execute with non-empty
               //     balance
               // }
               ccxt::any tests = ccxt::dict{
                   {std::string("signIn"), ccxt::list{}},
                   {std::string("fetchBalance"), ccxt::list{}},
                   {std::string("fetchAccounts"), ccxt::list{}},
                   {std::string("fetchTransactionFees"), ccxt::list{}},
                   {std::string("fetchTradingFees"), ccxt::list{}},
                   {std::string("fetchStatus"), ccxt::list{}},
                   {std::string("fetchOrders"), ccxt::list{symbol}},
                   {std::string("fetchOpenOrders"), ccxt::list{symbol}},
                   {std::string("fetchClosedOrders"), ccxt::list{symbol}},
                   {std::string("fetchMyTrades"), ccxt::list{symbol}},
                   {std::string("fetchLeverageTiers"),
                    ccxt::list{ccxt::list{symbol}}},
                   {std::string("fetchLedger"), ccxt::list{code}},
                   {std::string("fetchTransactions"), ccxt::list{code}},
                   {std::string("fetchDeposits"), ccxt::list{code}},
                   {std::string("fetchWithdrawals"), ccxt::list{code}},
                   {std::string("fetchTransfers"), ccxt::list{code}},
                   {std::string("fetchBorrowInterest"),
                    ccxt::list{code, symbol}},
                   {std::string("cancelAllOrders"), ccxt::list{symbol}},
                   {std::string("fetchCanceledOrders"), ccxt::list{symbol}},
                   {std::string("fetchMarginModes"), ccxt::list{symbol}},
                   {std::string("fetchPosition"), ccxt::list{symbol}},
                   {std::string("fetchDeposit"), ccxt::list{code}},
                   {std::string("createDepositAddress"), ccxt::list{code}},
                   {std::string("fetchDepositAddress"), ccxt::list{code}},
                   {std::string("fetchDepositAddresses"), ccxt::list{code}},
                   {std::string("fetchDepositAddressesByNetwork"),
                    ccxt::list{code}},
                   {std::string("fetchBorrowRateHistory"), ccxt::list{code}},
                   {std::string("fetchLedgerEntry"), ccxt::list{code}},
               };
               if (isTrue(getCliArgValue(std::string("--fundedTests")))) {
                 ::setValue(tests, std::string("createOrder"),
                            ccxt::list{symbol});
               }
               if (isTrue(this->wsTests)) {
                 tests = ccxt::dict{
                     {std::string("watchBalance"), ccxt::list{code}},
                     {std::string("watchMyTrades"), ccxt::list{symbol}},
                     {std::string("watchOrders"), ccxt::list{symbol}},
                     {std::string("watchPosition"), ccxt::list{symbol}},
                     {std::string("watchPositions"), ccxt::list{symbol}},
                 };
               }
               ccxt::any market = callDynamically(
                   exchange, std::string("market"), ccxt::list{symbol});
               ccxt::any isSpot = ::getValue(market, std::string("spot"));
               if (!isTrue(this->wsTests)) {
                 if (isTrue(isEqual(isSpot, true))) {
                   ::setValue(tests, std::string("fetchCurrencies"),
                              ccxt::list{});
                 } else {
                   // derivatives only
                   ::setValue(tests, std::string("fetchPositions"),
                              ccxt::list{symbol}); // this test fetches all
                                                   // positions for 1 symbol
                   ::setValue(tests, std::string("fetchPosition"),
                              ccxt::list{symbol});
                   ::setValue(tests, std::string("fetchPositionRisk"),
                              ccxt::list{symbol});
                   ::setValue(tests, std::string("setPositionMode"),
                              ccxt::list{symbol});
                   ::setValue(tests, std::string("setMarginMode"),
                              ccxt::list{symbol});
                   ::setValue(tests, std::string("fetchOpenInterestHistory"),
                              ccxt::list{symbol});
                   ::setValue(tests, std::string("fetchFundingRateHistory"),
                              ccxt::list{symbol});
                   ::setValue(tests, std::string("fetchFundingHistory"),
                              ccxt::list{symbol});
                 }
               }
               // const combinedTests = callDynamically(exchange,
               // std::string("deepExtend"), ccxt::list{this.publicTests,
               // privateTests});
               awaitValue(this->runTests(exchange, tests, false));
               return true; // required in c#
             })
      .share();
}

virtual std::shared_future<ccxt::any> testProxies(ccxt::any exchange) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               // these tests should be synchronously executed, because of
               // conflicting nature of proxy settings
               ccxt::any proxyTestName = this->proxyTestFileName;
               // todo: temporary skip for sync py
               if (isTrue(isTrue(isEqual(this->ext, std::string("py"))) &&
                          isTrue(isSync()))) {
                 return true;
               }
               // try proxy several times
               ccxt::any maxRetries = 3;
               ccxt::any exceptionMessageString = ccxt::any{};
               for (ccxt::any j = 0; isLessThan(j, maxRetries);
                    postFixIncrement(j)) {
                 try {
                   awaitValue(this->testMethod(proxyTestName, exchange,
                                               ccxt::list{}, true));
                   return true; // if successfull, then end the test
                 } catch (const std::exception &e) {
                   exceptionMessageString = exceptionMessage(e);
                   awaitValue(callDynamically(exchange, std::string("sleep"),
                                              ccxt::list{multiply(j, 1000)}));
                 }
               }
               // if exception was set, then throw it
               if (isTrue(!isEqual(exceptionMessageString, ccxt::any{}))) {
                 ccxt::any errorMessage =
                     add(add(add(std::string("[TEST_FAILURE] Failed "),
                                 proxyTestName),
                             std::string(" : ")),
                         exceptionMessageString);
                 // temporary comment the below, because c# transpilation
                 // failure throw new Exchange Error (errorMessage.toString ());
                 dump(add(std::string("[TEST_WARNING]"), errorMessage));
               }
               return true;
             })
      .share();
}

virtual void checkConstructor(ccxt::any exchange) {
  // todo: this might be moved in base tests later
  if (isTrue(isEqual(getProperty(exchange, std::string("id")),
                     std::string("binance")))) {
    assertTrue(
        isTrue(isEqual(getProperty(exchange, std::string("hostname")),
                       ccxt::any{})) ||
            isTrue(isEqual(getProperty(exchange, std::string("hostname")),
                           std::string(""))),
        std::string("binance.com hostname should be empty"));
    assertTrue(
        isEqual(
            ::getValue(::getValue(getProperty(exchange, std::string("urls")),
                                  std::string("api")),
                       std::string("public")),
            std::string("https://api.binance.com/api/v3")),
        add(std::string("https://api.binance.com/api/v3 does not match: "),
            ::getValue(::getValue(getProperty(exchange, std::string("urls")),
                                  std::string("api")),
                       std::string("public"))));
    assertTrue(
        (inOp(::getValue(::getValue(getProperty(exchange, std::string("api")),
                                    std::string("sapi")),
                         std::string("get")),
              std::string("lending/union/account"))),
        add(std::string(
                "SAPI should contain the endpoint lending/union/account, "),
            jsonStringify(
                ::getValue(::getValue(getProperty(exchange, std::string("api")),
                                      std::string("sapi")),
                           std::string("get")))));
  } else if (isTrue(isEqual(getProperty(exchange, std::string("id")),
                            std::string("binanceus")))) {
    assertTrue(isEqual(getProperty(exchange, std::string("hostname")),
                       std::string("binance.us")),
               add(std::string("binance.us hostname does not match "),
                   getProperty(exchange, std::string("hostname"))));
    assertTrue(
        isEqual(
            ::getValue(::getValue(getProperty(exchange, std::string("urls")),
                                  std::string("api")),
                       std::string("public")),
            std::string("https://api.binance.us/api/v3")),
        add(std::string("https://api.binance.us/api/v3 does not match: "),
            ::getValue(::getValue(getProperty(exchange, std::string("urls")),
                                  std::string("api")),
                       std::string("public"))));
  }
}

virtual std::shared_future<ccxt::any>
testReturnResponseHeaders(ccxt::any exchange) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               if (isTrue(!isEqual(getProperty(exchange, std::string("id")),
                                   std::string("binance")))) {
                 return false; // this test is only for binance exchange for now
               }
               setProperty(exchange, std::string("returnResponseHeaders"),
                           true);
               ccxt::any ticker = awaitValue(
                   callDynamically(exchange, std::string("fetchTicker"),
                                   ccxt::list{std::string("BTC/USDT")}));
               ccxt::any info = ::getValue(ticker, std::string("info"));
               ccxt::any headers =
                   ::getValue(info, std::string("responseHeaders"));
               ccxt::any headersKeys = getObjectKeys(headers);
               assertTrue(isGreaterThan(getArrayLength(headersKeys), 0),
                          std::string("Response headers should not be empty"));
               ccxt::any headerValues = getObjectValues(headers);
               assertTrue(
                   isGreaterThan(getArrayLength(headerValues), 0),
                   std::string("Response headers values should not be empty"));
               setProperty(exchange, std::string("returnResponseHeaders"),
                           false);
               return true;
             })
      .share();
}

virtual std::shared_future<ccxt::any> startTest(ccxt::any exchange,
                                                ccxt::any symbolArgv) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               // we do not need to test aliases
               if (isTrue(isEqual(getProperty(exchange, std::string("alias")),
                                  true))) {
                 return true;
               }
               this->checkConstructor(exchange);
               // await this.testReturnResponseHeaders (exchange);
               if (isTrue(isTrue(this->sandbox) ||
                          isTrue((isEqual(
                              getExchangeProp(exchange, std::string("sandbox")),
                              true))))) {
                 callDynamically(exchange, std::string("setSandboxMode"),
                                 ccxt::list{true});
               }
               this->testHasProps(exchange);
               try {
                 ccxt::any result = awaitValue(this->loadExchange(exchange));
                 if (!isTrue(result)) {
                   if (!isTrue(isSync())) {
                     awaitValue(close(exchange));
                   }
                   return true;
                 }
                 // if (setProperty(exchange, std::string("id"), == 'binance') {
                 //     // we test proxies functionality just for one random
                 //     exchange on each build, because proxy functionality is
                 //     not exchange-specific, instead it's all done from base
                 //     methods, so just one working sample would mean it works
                 //     for all ccxt exchanges
                 //     // await this.testProxies (exchange));
                 // }
                 awaitValue(this->testExchange(exchange, symbolArgv));
                 if (!isTrue(isSync())) {
                   awaitValue(close(exchange));
                 }
               } catch (const std::exception &e) {
                 if (!isTrue(isSync())) {
                   awaitValue(close(exchange));
                 }
                 throw;
               }
               return true; // required in c#
             })
      .share();
}

virtual void testHasProps(ccxt::any exchange) {
  ccxt::any watchOrderBookSkips =
      this->getSkips(exchange, std::string("watchOrderBook"));
  ccxt::any fetchOrderBookSkips =
      this->getSkips(exchange, std::string("fetchOrderBook"));
  // ensure with hardcoded list of required methods
  if (isTrue(
          isTrue(isTrue(this->wsTests) &&
                 isTrue((!isEqual(
                     callDynamically(
                         exchange, std::string("safeBool"),
                         ccxt::list{getProperty(exchange, std::string("has")),
                                    std::string("watchOrderBook"), false}),
                     true)))) &&
          isTrue(!isString(watchOrderBookSkips)))) {
    dump(std::string("[TEST_FAILURE] Method \"watchOrderBook\" is not set in "
                     "\"has\", please check the \"has\" property of exchange"));
    exitScript(1);
  } else if (isTrue(
                 isTrue(!isTrue(this->wsTests) &&
                        isTrue((!isEqual(
                            callDynamically(
                                exchange, std::string("safeBool"),
                                ccxt::list{
                                    getProperty(exchange, std::string("has")),
                                    std::string("fetchOrderBook"), false}),
                            true)))) &&
                 isTrue(!isString(fetchOrderBookSkips)))) {
    dump(std::string("[TEST_FAILURE] Method \"fetchOrderBook\" is not set in "
                     "\"has\", please check the \"has\" property of exchange"));
    exitScript(1);
  }
}

virtual void assertStaticError(ccxt::any cond, ccxt::any message,
                               ccxt::any calculatedOutput,
                               ccxt::any storedOutput,
                               ccxt::any key = ccxt::any{}) {
  //  -----------------------------------------------------------------------------
  //  --- Init of static tests
  //  functions------------------------------------------
  //  -----------------------------------------------------------------------------
  // Fast path: the error message is only consumed when the assertion
  // fails, but `jsonStringify` of the (possibly large) computed and
  // stored outputs happens here on EVERY leaf/branch comparison.
  // That is cheap in JS but O(tree²) in the Rust port (each level
  // re-serialises its whole subtree) — it made `--responseTests`
  // take minutes. Bail out before stringifying when the check holds.
  if (isTrue(cond)) {
    return;
  }
  ccxt::any calculatedString = jsonStringify(calculatedOutput);
  ccxt::any storedString = jsonStringify(storedOutput);
  ccxt::any errorMessage = message;
  if (isTrue(!isEqual(key, ccxt::any{}))) {
    errorMessage = add(add(std::string("["), key), std::string("]"));
  }
  errorMessage =
      add(errorMessage, add(add(add(std::string(" computed: "), storedString),
                                std::string(" stored: ")),
                            calculatedString));
  assertTrue(cond, errorMessage);
}

