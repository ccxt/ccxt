                   this->initOfflineExchange(std::string("weex"));
               ccxt::any id = std::string("b-WEEX111125");
               assertTrue(
                   isEqual(
                       ::getValue(getProperty(exchange, std::string("options")),
                                  std::string("partner")),
                       id),
                   add(add(std::string("weex - id: "), id),
                       std::string(" not in options")));
               ccxt::any request = ccxt::dict{};
               try {
                 awaitValue(callDynamically(
                     exchange, std::string("createOrder"),
                     ccxt::list{std::string("BTC/USDT"), std::string("limit"),
                                std::string("buy"), 1, 20000}));
               } catch (const std::exception &e) {
                 request = jsonParse(
                     getProperty(exchange, std::string("last_request_body")));
               }
               ccxt::any clientOrderId =
                   ::getValue(request, std::string("newClientOrderId"));
               assertTrue(
                   isEqual(startsWith(clientOrderId, id), true),
                   add(add(add(std::string("weex - newClientOrderId: "),
                               clientOrderId),
                           std::string(
                               " for spot order does not start with id: ")),
                       id));
               try {
                 awaitValue(
                     callDynamically(exchange, std::string("createOrder"),
                                     ccxt::list{std::string("BTC/USDT:USDT"),
                                                std::string("limit"),
                                                std::string("buy"), 1, 20000}));
               } catch (const std::exception &e) {
                 request = jsonParse(
                     getProperty(exchange, std::string("last_request_body")));
               }
               clientOrderId =
                   ::getValue(request, std::string("newClientOrderId"));
               assertTrue(
                   isEqual(startsWith(clientOrderId, id), true),
                   add(add(add(std::string("weex - newClientOrderId: "),
                               clientOrderId),
                           std::string(
                               " for swap order does not start with id: ")),
                       id));
               return ccxt::any{};
             })
      .share();
}

