                    postFixIncrement(i)) {
                 assertInArray(exchange, skippedProperties,
                               std::string("features"), keys, i, marketTypes);
                 ccxt::any marketType = ::getValue(keys, i);
                 ccxt::any value = ::getValue(features, marketType);
