std::shared_future<ccxt::any> testFetchCurrencies(ccxt::any exchange,
                                                  ccxt::any skippedProperties) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               ccxt::any method = std::string("fetchCurrencies");
               ccxt::any currencies = awaitValue(callDynamically(
                   exchange, std::string("fetchCurrencies"), ccxt::list{}));
               // todo: try to invent something to avoid ccxt::any{}
               // ccxt::any{}, i.e. maybe move into private and force it to have
               // a value
               ccxt::any numInactiveCurrencies = 0;
               ccxt::any maxInactiveCurrenciesPercentage = callDynamically(
                   exchange, std::string("safeInteger"),
                   ccxt::list{
                       skippedProperties,
                       std::string("maxInactiveCurrenciesPercentage"),
                       50}); // no more than X% currencies should be inactive
               ccxt::any requiredActiveCurrencies =
                   ccxt::list{std::string("BTC"), std::string("ETH"),
                              std::string("USDT"), std::string("USDC")};
               ccxt::any features =
                   getProperty(exchange, std::string("features"));
               ccxt::any featuresSpot = callDynamically(
                   exchange, std::string("safeDict"),
                   ccxt::list{features, std::string("spot"), ccxt::dict{}});
               ccxt::any fetchCurrencies = callDynamically(
                   exchange, std::string("safeDict"),
                   ccxt::list{featuresSpot, std::string("fetchCurrencies"),
                              ccxt::dict{}});
               ccxt::any isFetchCurrenciesPrivate = callDynamically(
                   exchange, std::string("safeValue"),
                   ccxt::list{fetchCurrencies, std::string("private"), false});
               if (isTrue(!isEqual(isFetchCurrenciesPrivate, true))) {
                 ccxt::any values = getObjectValues(currencies);
                 assertNonEmtpyArray(exchange, skippedProperties, method,
                                     values);
                 ccxt::any currenciesLength = getArrayLength(values);
                 // ensure exchange returns enough length of currencies
                 ccxt::any skipAmount = (inOp(
                     skippedProperties, std::string("amountOfCurrencies")));
                 assertTrue(
                     isTrue(skipAmount) ||
                         isTrue(isGreaterThan(currenciesLength, 5)),
                     add(add(add(add(getProperty(exchange, std::string("id")),
                                     std::string(" ")),
                                 method),
                             std::string(" must return at least several "
                                         "currencies, but it returned ")),
                         toString(currenciesLength)));
                 // allow skipped exchanges
                 ccxt::any skipActive = (inOp(
                     skippedProperties, std::string("activeCurrenciesQuota")));
                 ccxt::any skipMajorCurrencyCheck = (inOp(
                     skippedProperties, std::string("activeMajorCurrencies")));
                 // loop
                 for (ccxt::any i = 0; isLessThan(i, currenciesLength);
                      postFixIncrement(i)) {
                   ccxt::any currency = ::getValue(values, i);
                   testCurrency(exchange, skippedProperties, method, currency);
                   // detailed check for deposit/withdraw
                   ccxt::any active = callDynamically(
                       exchange, std::string("safeBool"),
                       ccxt::list{currency, std::string("active")});
                   if (isTrue(isEqual(active, false))) {
                     numInactiveCurrencies = add(numInactiveCurrencies, 1);
                   }
                   // ensure that major currencies are active and enabled for
                   // deposit and withdrawal
                   ccxt::any code = callDynamically(
                       exchange, std::string("safeString"),
                       ccxt::list{currency, std::string("code")});
                   ccxt::any withdraw = callDynamically(
                       exchange, std::string("safeBool"),
                       ccxt::list{currency, std::string("withdraw")});
                   ccxt::any deposit = callDynamically(
                       exchange, std::string("safeBool"),
                       ccxt::list{currency, std::string("deposit")});
                   ccxt::any isMicaCompliant = callDynamically(
                       exchange, std::string("safeBool"),
                       ccxt::list{getProperty(exchange, std::string("options")),
                                  std::string("mica"), false});
                   ccxt::any skipUsdtForMica =
                       isTrue((isEqual(isMicaCompliant, true))) &&
                       isTrue((isEqual(code, std::string("USDT"))));
                   if (isTrue(
                           isTrue(isTrue(callDynamically(
                                      exchange, std::string("inArray"),
                                      ccxt::list{code,
                                                 requiredActiveCurrencies})) &&
                                  !isTrue(skipMajorCurrencyCheck)) &&
                           isTrue((!isEqual(skipUsdtForMica, true))))) {
                     assertTrue(
                         isTrue((isEqual(withdraw, true))) &&
                             isTrue((isEqual(deposit, true))),
                         add(add(add(std::string("Major currency "), code),
                                 std::string(" should have withdraw and "
                                             "deposit flags enabled ::: ")),
                             callDynamically(exchange, std::string("json"),
                                             ccxt::list{currency})));
                   }
                 }
                 // check at least X% of currencies are active
                 ccxt::any inactiveCurrenciesPercentage = multiply(
                     (divide(numInactiveCurrencies, currenciesLength)), 100);
                 assertTrue(
                     isTrue(skipActive) ||
                         isTrue((isLessThan(inactiveCurrenciesPercentage,
                                            maxInactiveCurrenciesPercentage))),
                     add(add(add(add(std::string("Percentage of inactive "
                                                 "currencies is too high at "),
                                     toString(inactiveCurrenciesPercentage)),
                                 std::string("% that is more than the allowed "
                                             "maximum of ")),
                             toString(maxInactiveCurrenciesPercentage)),
                         std::string("%")));
                 detectCurrencyConflicts(exchange, currencies);
               }
               return true;
             })
      .share();
}

ccxt::any detectCurrencyConflicts(ccxt::any exchange,
                                  ccxt::any currencyValues) {
  // detect if there are currencies with different ids for the same code
  ccxt::any ids = ccxt::dict{};
  ccxt::any keys = getObjectKeys(currencyValues);
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(keys));
       postFixIncrement(i)) {
    ccxt::any key = ::getValue(keys, i);
    ccxt::any currency = ::getValue(currencyValues, key);
    ccxt::any code = ::getValue(currency, std::string("code"));
    if (!isTrue((inOp(ids, code)))) {
      ::setValue(ids, code, ::getValue(currency, std::string("id")));
    } else {
      ccxt::any isDifferent = !isEqual(::getValue(ids, code),
                                       ::getValue(currency, std::string("id")));
      assertTrue(
          !isTrue(isDifferent),
          add(add(add(add(add(add(getProperty(exchange, std::string("id")),
                                  std::string(
                                      " fetchCurrencies() has different ids "
                                      "for the same code: ")),
                              code),
                          std::string(" ")),
                      ::getValue(ids, code)),
                  std::string(" ")),
              ::getValue(currency, std::string("id"))));
    }
  }
  return true;
}
