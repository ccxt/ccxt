std::shared_future<std::any> testLoadMarkets(std::any exchange,
                                             std::any skippedProperties) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> std::any {
               std::any method = std::string("loadMarkets");
               std::any markets = awaitValue(callDynamically(
                   exchange, std::string("loadMarkets"), ccxt::list{}));
               assertTrue(
                   callDynamically(exchange, std::string("isDictionary"),
                                   ccxt::list{getProperty(
                                       exchange, std::string("markets"))}),
                   std::string(".markets is not a dict"));
               assertTrue(
                   isArray(getProperty(exchange, std::string("symbols"))),
                   std::string(".symbols is not an array"));
               std::any symbolsLength = getArrayLength(
                   getProperty(exchange, std::string("symbols")));
               assertTrue(
                   !isEqual(getProperty(exchange, std::string("markets")),
                            std::any{}),
                   std::string(".markets is undefined"));
               std::any marketKeys =
                   getObjectKeys(getProperty(exchange, std::string("markets")));
               std::any marketKeysLength = getArrayLength(marketKeys);
               assertTrue(
                   isGreaterThan(symbolsLength, 0),
                   std::string(
                       ".symbols count <= 0 (less than or equal to zero)"));
               assertTrue(isGreaterThan(marketKeysLength, 0),
                          std::string(".markets objects keys length <= 0 (less "
                                      "than or equal to zero)"));
               assertTrue(isEqual(symbolsLength, marketKeysLength),
                          std::string("number of .symbols is not equal to the "
                                      "number of .markets"));
               std::any marketValues = getObjectValues(markets);
               for (std::any i = 0; isLessThan(i, getArrayLength(marketValues));
                    postFixIncrement(i)) {
                 testMarket(exchange, skippedProperties, method,
                            ::getValue(marketValues, i));
               }
               // market-type coverage (inlined: a nested helper breaks Java
               // emit into a missing TestLoadedMarketTypes class)
               std::any marketTypes =
                   ccxt::list{std::string("spot"), std::string("swap"),
                              std::string("future"), std::string("option"),
                              std::string("index")};
               std::any collectedTypes = ccxt::list{};
               std::any allMarkets = getObjectValues(
                   getProperty(exchange, std::string("markets")));
               for (std::any i = 0; isLessThan(i, getArrayLength(allMarkets));
                    postFixIncrement(i)) {
                 std::any market = ::getValue(allMarkets, i);
                 if (!isTrue(callDynamically(
                         exchange, std::string("inArray"),
                         ccxt::list{::getValue(market, std::string("type")),
                                    collectedTypes}))) {
                   arrayPush(collectedTypes,
                             ::getValue(market, std::string("type")));
                 }
               }
               for (std::any i = 0; isLessThan(i, getArrayLength(marketTypes));
                    postFixIncrement(i)) {
                 std::any mType = ::getValue(marketTypes, i);
                 if (isTrue(isTrue(!isEqual(
                                ::getValue(
                                    getProperty(exchange, std::string("has")),
                                    mType),
                                std::any{})) &&
                            isTrue(!isEqual(
                                ::getValue(
                                    getProperty(exchange, std::string("has")),
                                    mType),
                                false)))) {
                   std::any skipMarketTypes =
                       isTrue(
                           (inOp(skippedProperties,
                                 std::string("optionsNotLoadedByDefault")))) &&
                       isTrue(isEqual(mType, std::string("option")));
                   assertTrue(
                       isTrue(callDynamically(
                           exchange, std::string("inArray"),
                           ccxt::list{mType, collectedTypes})) ||
                           isTrue(skipMarketTypes),
                       add(add(add(add(std::string("exchange.has["), mType),
                                   std::string(
                                       "] is true, but no markets of type ")),
                               mType),
                           std::string(" were found in exchange.markets")));
                 } else if (isTrue(isEqual(
                                ::getValue(
                                    getProperty(exchange, std::string("has")),
                                    mType),
                                false))) {
                   // some exchanges might have a couple of markets of a certain
                   // type loaded even though 'has[type]' is marked as false
                   // (e.g. a legacy/edge-case market); such known exceptions
                   // can be whitelisted per-exchange in skip-tests.json by
                   // adding a key matching the market type (e.g. "swap") under
                   // that method's skips
                   std::any isKnownException = (inOp(skippedProperties, mType));
                   assertTrue(
                       !isTrue(callDynamically(
                           exchange, std::string("inArray"),
                           ccxt::list{mType, collectedTypes})) ||
                           isTrue(isKnownException),
                       add(add(add(add(std::string("exchange.has["), mType),
                                   std::string(
                                       "] is false, but markets of type ")),
                               mType),
                           std::string(" were found in exchange.markets")));
                 }
               }
               return true;
             })
      .share();
}
