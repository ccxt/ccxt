// PLEASE DO NOT EDIT THIS FILE, IT IS GENERATED AND WILL BE OVERWRITTEN:
// https://github.com/ccxt/ccxt/blob/master/CONTRIBUTING.md#how-to-contribute-code
void testOrder(std::any exchange, std::any skippedProperties, std::any method,
               std::any entry, std::any symbol, std::any now) {
  // prediction-market orders are keyed by an outcome handle, not a `symbol`
  if (isTrue(
          callDynamically(exchange, std::string("safeBool"),
                          ccxt::list{getProperty(exchange, std::string("has")),
                                     std::string("prediction"), false}))) {
    skippedProperties =
        callDynamically(exchange, std::string("extend"),
                        ccxt::list{ccxt::dict{
                                       {std::string("symbol"), true},
                                   },
                                   skippedProperties});
  }
  std::any format = ccxt::dict{
      {std::string("info"), ccxt::dict{}},
      {std::string("id"), std::string("123")},
      {std::string("clientOrderId"), std::string("1234")},
      {std::string("timestamp"), 1649373600000},
      {std::string("datetime"), std::string("2022-04-07T23:20:00.000Z")},
      {std::string("lastTradeTimestamp"), 1649373610000},
      {std::string("symbol"), std::string("XYZ/USDT")},
      {std::string("type"), std::string("limit")},
      {std::string("timeInForce"), std::string("GTC")},
      {std::string("postOnly"), true},
      {std::string("side"), std::string("sell")},
      {std::string("price"),
       callDynamically(exchange, std::string("parseNumber"),
                       ccxt::list{std::string("1.23456")})},
      {std::string("stopPrice"),
       callDynamically(exchange, std::string("parseNumber"),
                       ccxt::list{std::string("1.1111")})},
      {std::string("amount"),
       callDynamically(exchange, std::string("parseNumber"),
                       ccxt::list{std::string("1.23")})},
      {std::string("cost"),
       callDynamically(exchange, std::string("parseNumber"),
                       ccxt::list{std::string("2.34")})},
      {std::string("average"),
       callDynamically(exchange, std::string("parseNumber"),
                       ccxt::list{std::string("1.234")})},
      {std::string("filled"),
       callDynamically(exchange, std::string("parseNumber"),
                       ccxt::list{std::string("1.23")})},
      {std::string("remaining"),
       callDynamically(exchange, std::string("parseNumber"),
                       ccxt::list{std::string("0.123")})},
      {std::string("status"), std::string("ok")},
      {std::string("fee"), ccxt::dict{}},
      {std::string("trades"), ccxt::list{}},
  };
  std::any emptyAllowedFor = ccxt::list{
      std::string("clientOrderId"),
      std::string("stopPrice"),
      std::string("trades"),
      std::string("timestamp"),
      std::string("datetime"),
      std::string("lastTradeTimestamp"),
      std::string("average"),
      std::string("type"),
      std::string("timeInForce"),
      std::string("postOnly"),
      std::string("side"),
      std::string("price"),
      std::string("amount"),
      std::string("cost"),
      std::string("filled"),
      std::string("remaining"),
      std::string("status"),
      std::string(
          "fee")}; // there are exchanges that return only order id, so we don't
                   // need to strictly requite all props to be set.
  assertStructure(exchange, skippedProperties, method, entry, format,
                  emptyAllowedFor);
  assertTimestampAndDatetime(exchange, skippedProperties, method, entry, now);
  //
  assertInArray(
      exchange, skippedProperties, method, entry, std::string("timeInForce"),
      ccxt::list{std::string("GTC"), std::string("GTK"), std::string("IOC"),
                 std::string("FOK"), std::string("PO")});
  assertInArray(exchange, skippedProperties, method, entry,
                std::string("status"),
                ccxt::list{std::string("open"), std::string("closed"),
                           std::string("canceled")});
  assertInArray(exchange, skippedProperties, method, entry, std::string("side"),
                ccxt::list{std::string("buy"), std::string("sell")});
  assertInArray(exchange, skippedProperties, method, entry,
                std::string("postOnly"), ccxt::list{true, false});
  assertSymbol(exchange, skippedProperties, method, entry,
               std::string("symbol"), symbol);
  assertGreater(exchange, skippedProperties, method, entry,
                std::string("price"), std::string("0"));
  assertGreater(exchange, skippedProperties, method, entry,
                std::string("stopPrice"), std::string("0"));
  assertGreaterOrEqual(exchange, skippedProperties, method, entry,
                       std::string("cost"), std::string("0"));
  assertGreater(exchange, skippedProperties, method, entry,
                std::string("average"), std::string("0"));
  assertGreaterOrEqual(exchange, skippedProperties, method, entry,
                       std::string("filled"), std::string("0"));
  assertGreaterOrEqual(exchange, skippedProperties, method, entry,
                       std::string("remaining"), std::string("0"));
  assertGreaterOrEqual(exchange, skippedProperties, method, entry,
                       std::string("amount"), std::string("0"));
  assertGreaterOrEqual(
      exchange, skippedProperties, method, entry, std::string("amount"),
      callDynamically(exchange, std::string("safeString"),
                      ccxt::list{entry, std::string("remaining")}));
  assertGreaterOrEqual(
      exchange, skippedProperties, method, entry, std::string("amount"),
      callDynamically(exchange, std::string("safeString"),
                      ccxt::list{entry, std::string("filled")}));
  if (!isTrue((inOp(skippedProperties, std::string("trades"))))) {
    std::any skippedNew = callDynamically(
        exchange, std::string("deepExtend"),
        ccxt::list{skippedProperties, ccxt::dict{
                                          {std::string("timestamp"), true},
                                          {std::string("datetime"), true},
                                          {std::string("side"), true},
                                      }});
    if (isTrue(
            !isEqual(::getValue(entry, std::string("trades")), std::any{}))) {
      for (std::any i = 0; isLessThan(
               i, getArrayLength(::getValue(entry, std::string("trades"))));
           postFixIncrement(i)) {
        testTrade(exchange, skippedNew, method,
                  ::getValue(::getValue(entry, std::string("trades")), i),
                  symbol, now);
      }
    }
  }
  assertFeeStructure(exchange, skippedProperties, method, entry,
                     std::string("fee"));
}
