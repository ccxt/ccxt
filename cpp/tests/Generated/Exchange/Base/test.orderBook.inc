void testOrderBook(std::any exchange, std::any skippedProperties, std::any method, std::any orderbook, std::any symbol)
{
    // prediction-market structures are keyed by an outcome handle, not a `symbol`
    if (isTrue(callDynamically(exchange, std::string("safeBool"), ccxt::list{getProperty(exchange, std::string("has")), std::string("prediction"), false})))
    {
        skippedProperties = callDynamically(exchange, std::string("extend"), ccxt::list{ccxt::dict {
            { std::string("symbol"), true },
        }, skippedProperties});
    }
    std::any format = ccxt::dict {
        { std::string("symbol"), std::string("ETH/BTC") },
        { std::string("asks"), ccxt::list{ccxt::list{callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.24")}), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("0.453")})}, ccxt::list{callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.25")}), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("0.157")})}} },
        { std::string("bids"), ccxt::list{ccxt::list{callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.23")}), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("0.123")})}, ccxt::list{callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.22")}), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("0.543")})}} },
        { std::string("timestamp"), 1504224000000 },
        { std::string("datetime"), std::string("2017-09-01T00:00:00") },
        { std::string("nonce"), 134234234 },
    };
    std::any emptyAllowedFor = ccxt::list{std::string("nonce")};
    assertStructure(exchange, skippedProperties, method, orderbook, format, emptyAllowedFor);
    assertTimestampAndDatetime(exchange, skippedProperties, method, orderbook);
    assertSymbol(exchange, skippedProperties, method, orderbook, std::string("symbol"), symbol);
    std::any logText = logTemplate(exchange, method, orderbook);
    // todo: check non-emtpy arrays for bids/asks for toptier exchanges
    std::any bids = ::getValue(orderbook, std::string("bids"));
    std::any bidsLength = getArrayLength(bids);
    for (std::any i = 0; isLessThan(i, bidsLength); postFixIncrement(i))
    {
        std::any currentBidString = callDynamically(exchange, std::string("safeString"), ccxt::list{::getValue(bids, i), 0});
        if (!isTrue((inOp(skippedProperties, std::string("compareToNextItem")))))
        {
            std::any nextI = add(i, 1);
            if (isTrue(isGreaterThan(bidsLength, nextI)))
            {
                std::any nextBidString = callDynamically(exchange, std::string("safeString"), ccxt::list{::getValue(bids, nextI), 0});
                assertTrue(ccxt::Precise::stringGt(currentBidString, nextBidString), add(add(add(add(std::string("current bid should be > than the next one: "), currentBidString), std::string(">")), nextBidString), logText));
            }
        }
        if (!isTrue((inOp(skippedProperties, std::string("compareToZero")))))
        {
            // compare price & volume to zero
            assertGreater(exchange, skippedProperties, method, ::getValue(bids, i), 0, std::string("0"));
            assertGreater(exchange, skippedProperties, method, ::getValue(bids, i), 1, std::string("0"));
        }
    }
    std::any asks = ::getValue(orderbook, std::string("asks"));
    std::any asksLength = getArrayLength(asks);
    for (std::any i = 0; isLessThan(i, asksLength); postFixIncrement(i))
    {
        std::any currentAskString = callDynamically(exchange, std::string("safeString"), ccxt::list{::getValue(asks, i), 0});
        if (!isTrue((inOp(skippedProperties, std::string("compareToNextItem")))))
        {
            std::any nextI = add(i, 1);
            if (isTrue(isGreaterThan(asksLength, nextI)))
            {
                std::any nextAskString = callDynamically(exchange, std::string("safeString"), ccxt::list{::getValue(asks, nextI), 0});
                assertTrue(ccxt::Precise::stringLt(currentAskString, nextAskString), add(add(add(add(std::string("current ask should be < than the next one: "), currentAskString), std::string("<")), nextAskString), logText));
            }
        }
        if (!isTrue((inOp(skippedProperties, std::string("compareToZero")))))
        {
            // compare price & volume to zero
            assertGreater(exchange, skippedProperties, method, ::getValue(asks, i), 0, std::string("0"));
            assertGreater(exchange, skippedProperties, method, ::getValue(asks, i), 1, std::string("0"));
        }
    }
    if (!isTrue((inOp(skippedProperties, std::string("spread")))))
    {
        if (isTrue(isTrue((isGreaterThan(bidsLength, 0))) && isTrue((isGreaterThan(asksLength, 0)))))
        {
            std::any firstBid = callDynamically(exchange, std::string("safeString"), ccxt::list{::getValue(bids, 0), 0});
            std::any firstAsk = callDynamically(exchange, std::string("safeString"), ccxt::list{::getValue(asks, 0), 0});
            // check bid-ask spread
            assertTrue(ccxt::Precise::stringLt(firstBid, firstAsk), add(add(add(add(add(std::string("bids[0][0] ("), firstBid), std::string(") should be < than asks[0][0] (")), firstAsk), std::string(")")), logText));
        }
    }
}
