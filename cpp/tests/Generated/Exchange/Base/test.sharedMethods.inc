    assertTrue(!isTrue(ccxt::Precise::stringEq(value, compareTo)),
               add(add(add(add(add(stringValue(key),
                                   std::string(" key (with a value of ")),
                               stringValue(value)),
                           std::string(") was expected not to be equal to ")),
                       stringValue(compareTo)),
                   logText));
  }
}

void assertInArray(ccxt::any exchange, ccxt::any skippedProperties,
                   ccxt::any method, ccxt::any entry, ccxt::any key,
                   ccxt::any expectedArray, ccxt::any allowNull = true) {
  if (isTrue(inOp(skippedProperties, key))) {
    return;
  }
  ccxt::any logText = logTemplate(exchange, method, entry);
  ccxt::any value = callDynamically(exchange, std::string("safeValue"),
                                    ccxt::list{entry, key});
  assertTrue(isTrue(!isEqual(value, ccxt::any{})) || isTrue(allowNull),
             add(std::string("value is null"), logText));
  // todo: remove ccxt::any{} check
  if (isTrue(!isEqual(value, ccxt::any{}))) {
    ccxt::any stingifiedArrayValue = callDynamically(
        exchange, std::string("json"),
        ccxt::list{expectedArray}); // don't use expectedArray.join (','), as it
                                    // bugs in other languages, if values are
                                    // bool, ccxt::any{} or etc..
    assertTrue(
        callDynamically(exchange, std::string("inArray"),
                        ccxt::list{value, expectedArray}),
        add(add(add(add(add(add(add(std::string("\""), stringValue(key)),
                                std::string("\" key (value \"")),
                            stringValue(value)),
                        std::string("\") is not from the expected list : [")),
                    stingifiedArrayValue),
                std::string("]")),
            logText));
  }
}

void assertFeeStructure(ccxt::any exchange, ccxt::any skippedProperties,
                        ccxt::any method, ccxt::any entry, ccxt::any key,
                        ccxt::any allowNull = true) {
  ccxt::any logText = logTemplate(exchange, method, entry);
  ccxt::any keyString = stringValue(key);
  if (isTrue(isInteger(key))) {
    assertTrue(
        isArray(entry),
        add(std::string("fee container is expected to be an array"), logText));
    assertTrue(isLessThan(key, getArrayLength(entry)),
               add(add(add(std::string("fee key "), keyString),
                       std::string(" was expected to be present in entry")),
                   logText));
  } else {
    assertTrue(
        callDynamically(exchange, std::string("isDictionary"),
                        ccxt::list{entry}),
        add(std::string("fee container is expected to be a dict"), logText));
    assertTrue(inOp(entry, key),
               add(add(add(std::string("fee key \""), key),
                       std::string("\" was expected to be present in entry")),
                   logText));
  }
  ccxt::any feeObject = callDynamically(exchange, std::string("safeValue"),
                                        ccxt::list{entry, key});
  assertTrue(isTrue(!isEqual(feeObject, ccxt::any{})) || isTrue(allowNull),
             add(std::string("fee object is null"), logText));
  // todo: remove ccxt::any{} check to make stricter
  if (isTrue(!isEqual(feeObject, ccxt::any{}))) {
    assertTrue(inOp(feeObject, std::string("cost")),
               add(add(keyString,
                       std::string(" fee object should contain \"cost\" key")),
                   logText));
    if (isTrue(
            isEqual(::getValue(feeObject, std::string("cost")), ccxt::any{}))) {
      return; // todo: remove ccxt::any{} check to make stricter
    }
    assertTrue(
        isNumber(::getValue(feeObject, std::string("cost"))),
        add(add(keyString, std::string(" \"cost\" must be numeric type")),
            logText));
    // assertGreaterOrEqual (exchange, skippedProperties, method, feeObject,
    // 'cost', '0'); // fee might be negative in the case of a rebate or reward
    assertTrue(
        inOp(feeObject, std::string("currency")),
        add(add(add(std::string("\""), keyString),
                std::string("\" fee object should contain \"currency\" key")),
            logText));
    assertCurrencyCode(exchange, skippedProperties, method, entry,
                       ::getValue(feeObject, std::string("currency")));
  }
}

void assertTimestampOrder(ccxt::any exchange, ccxt::any method,
                          ccxt::any codeOrSymbol, ccxt::any items,
                          ccxt::any ascending = true) {
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(items));
       postFixIncrement(i)) {
    if (isTrue(isGreaterThan(i, 0))) {
      ccxt::any currentTs = ::getValue(::getValue(items, subtract(i, 1)),
                                       std::string("timestamp"));
      ccxt::any nextTs =
          ::getValue(::getValue(items, i), std::string("timestamp"));
      if (isTrue(isTrue(!isEqual(currentTs, ccxt::any{})) &&
                 isTrue(!isEqual(nextTs, ccxt::any{})))) {
        ccxt::any ascendingOrDescending =
            (isTrue(ascending) ? ccxt::any(std::string("ascending"))
                               : ccxt::any(std::string("descending")));
        ccxt::any comparison =
            (isTrue(ascending)
                 ? ccxt::any((isLessThanOrEqual(currentTs, nextTs)))
                 : ccxt::any((isGreaterThanOrEqual(currentTs, nextTs))));
        assertTrue(
            comparison,
            add(add(add(add(add(add(add(add(add(add(add(add(getProperty(
                                                                exchange,
                                                                std::string(
                                                                    "id")),
                                                            std::string(" ")),
                                                        method),
                                                    std::string(" ")),
                                                stringValue(codeOrSymbol)),
                                            std::string(" must return a ")),
                                        ascendingOrDescending),
                                    std::string(" sorted array of items by "
                                                "timestamp, but ")),
                                toString(currentTs)),
                            std::string(" is opposite with its next ")),
                        toString(nextTs)),
                    std::string(" ")),
                callDynamically(exchange, std::string("json"),
                                ccxt::list{items})));
      }
    }
  }
}

void assertInteger(ccxt::any exchange, ccxt::any skippedProperties,
                   ccxt::any method, ccxt::any entry, ccxt::any key,
                   ccxt::any allowNull = true) {
  if (isTrue(inOp(skippedProperties, key))) {
    return;
  }
  ccxt::any logText = logTemplate(exchange, method, entry);
  if (isTrue(!isEqual(entry, ccxt::any{}))) {
    ccxt::any value = callDynamically(exchange, std::string("safeValue"),
                                      ccxt::list{entry, key});
    assertTrue(isTrue(!isEqual(value, ccxt::any{})) || isTrue(allowNull),
               add(std::string("value is null"), logText));
    if (isTrue(!isEqual(value, ccxt::any{}))) {
      ccxt::any isInteger = ::isInteger(value);
      assertTrue(isInteger,
                 add(add(add(add(add(std::string("\""), stringValue(key)),
                                 std::string("\" key (value \"")),
                             stringValue(value)),
                         std::string("\") is not an integer")),
                     logText));
    }
  }
}

void checkPrecisionAccuracy(ccxt::any exchange, ccxt::any skippedProperties,
                            ccxt::any method, ccxt::any entry, ccxt::any key) {
  if (isTrue(inOp(skippedProperties, key))) {
    return;
  }
  if (isTrue(callDynamically(exchange, std::string("isTickPrecision"),
                             ccxt::list{}))) {
    // TICK_SIZE should be above zero
    assertGreater(exchange, skippedProperties, method, entry, key,
                  std::string("0"));
    // the below array of integers are inexistent tick-sizes (theoretically
    // technically possible, but not in real-world cases), so in our case, such
    // values probably indicate an incorrectly implemented tick-sizes
    // calculation, so we throw error
    ccxt::any decimalNumbers =
        ccxt::list{std::string("2"),  std::string("3"),  std::string("4"),
                   std::string("5"),  std::string("6"),  std::string("7"),
                   std::string("8"),  std::string("9"),  std::string("11"),
                   std::string("12"), std::string("13"), std::string("14"),
                   std::string("15"), std::string("16")};
    if (isTrue(isTrue(isEqual(key, std::string("amount"))) &&
               isTrue(inOp(skippedProperties,
                           std::string("precisionAmountAbnormal"))))) {
      return;
    }
    for (ccxt::any i = 0; isLessThan(i, getArrayLength(decimalNumbers));
         postFixIncrement(i)) {
      ccxt::any num = ::getValue(decimalNumbers, i);
      ccxt::any numStr = num;
      assertNonEqual(exchange, skippedProperties, method, entry, key, numStr);
    }
  } else {
    // todo: significant-digits return doubles from `this.parseNumber`, so for
    // now can't assert against integer atm assertInteger (exchange,
    // skippedProperties, method, entry, key); // should be integer
    assertLessOrEqual(exchange, skippedProperties, method, entry, key,
                      std::string("18")); // should be under 18 decimals
    assertGreaterOrEqual(
        exchange, skippedProperties, method, entry, key,
        std::string(
            "-8")); // in real-world cases, there would not be less than that
  }
}

std::shared_future<ccxt::any>
fetchBestBidAsk(ccxt::any exchange, ccxt::any method, ccxt::any symbol) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               ccxt::any logText = logTemplate(exchange, method, ccxt::dict{});
               // find out best bid/ask price
               ccxt::any bestBid = ccxt::any{};
               ccxt::any bestAsk = ccxt::any{};
               ccxt::any usedMethod = ccxt::any{};
               if (isTrue(
                       isTrue((!isEqual(
                           ::getValue(getProperty(exchange, std::string("has")),
                                      std::string("fetchOrderBook")),
                           ccxt::any{}))) &&
                       isTrue((!isEqual(
                           ::getValue(getProperty(exchange, std::string("has")),
                                      std::string("fetchOrderBook")),
                           false))))) {
                 usedMethod = std::string("fetchOrderBook");
                 ccxt::any orderbook = awaitValue(
                     callDynamically(exchange, std::string("fetchOrderBook"),
                                     ccxt::list{symbol}));
                 ccxt::any bids = callDynamically(
                     exchange, std::string("safeList"),
                     ccxt::list{orderbook, std::string("bids")});
                 ccxt::any asks = callDynamically(
                     exchange, std::string("safeList"),
                     ccxt::list{orderbook, std::string("asks")});
                 ccxt::any bestBidArray = callDynamically(
                     exchange, std::string("safeList"), ccxt::list{bids, 0});
                 ccxt::any bestAskArray = callDynamically(
                     exchange, std::string("safeList"), ccxt::list{asks, 0});
                 bestBid = callDynamically(exchange, std::string("safeNumber"),
                                           ccxt::list{bestBidArray, 0});
                 bestAsk = callDynamically(exchange, std::string("safeNumber"),
                                           ccxt::list{bestAskArray, 0});
               } else if (isTrue(isTrue((!isEqual(
                                     ::getValue(getProperty(exchange,
                                                            std::string("has")),
                                                std::string("fetchBidsAsks")),
                                     ccxt::any{}))) &&
                                 isTrue((!isEqual(
                                     ::getValue(getProperty(exchange,
                                                            std::string("has")),
                                                std::string("fetchBidsAsks")),
                                     false))))) {
                 usedMethod = std::string("fetchBidsAsks");
                 ccxt::any tickers = awaitValue(
                     callDynamically(exchange, std::string("fetchBidsAsks"),
                                     ccxt::list{ccxt::list{symbol}}));
                 ccxt::any ticker =
                     callDynamically(exchange, std::string("safeDict"),
                                     ccxt::list{tickers, symbol});
                 bestBid =
                     callDynamically(exchange, std::string("safeNumber"),
                                     ccxt::list{ticker, std::string("bid")});
                 bestAsk =
                     callDynamically(exchange, std::string("safeNumber"),
                                     ccxt::list{ticker, std::string("ask")});
               } else if (isTrue(isTrue((!isEqual(
                                     ::getValue(getProperty(exchange,
                                                            std::string("has")),
                                                std::string("fetchTicker")),
                                     ccxt::any{}))) &&
                                 isTrue((!isEqual(
                                     ::getValue(getProperty(exchange,
                                                            std::string("has")),
                                                std::string("fetchTicker")),
                                     false))))) {
                 usedMethod = std::string("fetchTicker");
                 ccxt::any ticker = awaitValue(callDynamically(
                     exchange, std::string("fetchTicker"), ccxt::list{symbol}));
                 bestBid =
                     callDynamically(exchange, std::string("safeNumber"),
                                     ccxt::list{ticker, std::string("bid")});
                 bestAsk =
                     callDynamically(exchange, std::string("safeNumber"),
                                     ccxt::list{ticker, std::string("ask")});
               } else if (isTrue(isTrue((!isEqual(
                                     ::getValue(getProperty(exchange,
                                                            std::string("has")),
                                                std::string("fetchTickers")),
                                     ccxt::any{}))) &&
                                 isTrue((!isEqual(
                                     ::getValue(getProperty(exchange,
                                                            std::string("has")),
                                                std::string("fetchTickers")),
                                     false))))) {
                 usedMethod = std::string("fetchTickers");
                 ccxt::any tickers = awaitValue(
                     callDynamically(exchange, std::string("fetchTickers"),
                                     ccxt::list{ccxt::list{symbol}}));
                 ccxt::any ticker =
                     callDynamically(exchange, std::string("safeDict"),
                                     ccxt::list{tickers, symbol});
                 bestBid =
                     callDynamically(exchange, std::string("safeNumber"),
                                     ccxt::list{ticker, std::string("bid")});
                 bestAsk =
                     callDynamically(exchange, std::string("safeNumber"),
                                     ccxt::list{ticker, std::string("ask")});
               }
               //
               assertTrue(
                   isTrue(!isEqual(bestBid, ccxt::any{})) &&
                       isTrue(!isEqual(bestAsk, ccxt::any{})),
                   add(add(add(add(add(add(add(add(logText, std::string(" ")),
                                               getProperty(exchange,
                                                           std::string("id"))),
                                           std::string(" could not get best "
                                                       "bid/ask for ")),
                                       symbol),
                                   std::string(" using ")),
                               usedMethod),
                           std::string(" while testing ")),
                       method));
               return ccxt::list{bestBid, bestAsk};
             })
      .share();
}

std::shared_future<ccxt::any> fetchOrder(ccxt::any exchange, ccxt::any symbol,
                                         ccxt::any orderId,
                                         ccxt::any skippedProperties) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               ccxt::any fetchedOrder = ccxt::any{};
               ccxt::any originalId = orderId;
               // set 'since' to 5 minute ago for optimal results
               ccxt::any sinceTime = subtract(
                   callDynamically(exchange, std::string("milliseconds"),
                                   ccxt::list{}),
                   multiply(multiply(1000, 60), 5));
               // iterate
               ccxt::any methods_singular = ccxt::list{
                   std::string("fetchOrder"), std::string("fetchOpenOrder"),
                   std::string("fetchClosedOrder"),
                   std::string("fetchCanceledOrder")};
               for (ccxt::any i = 0;
                    isLessThan(i, getArrayLength(methods_singular));
                    postFixIncrement(i)) {
                 ccxt::any singularFetchName = ::getValue(methods_singular, i);
                 if (isTrue(isTrue((!isEqual(
                                ::getValue(
                                    getProperty(exchange, std::string("has")),
                                    singularFetchName),
                                ccxt::any{}))) &&
                            isTrue((!isEqual(
                                ::getValue(
                                    getProperty(exchange, std::string("has")),
                                    singularFetchName),
                                false))))) {
                   ccxt::any currentOrder = awaitValue(
                       callDynamically(exchange, singularFetchName,
                                       ccxt::list{originalId, symbol}));
                   // if there is an id inside the order, it means the order was
                   // fetched successfully
                   if (isTrue(
                           isEqual(::getValue(currentOrder, std::string("id")),
                                   originalId))) {
                     fetchedOrder = currentOrder;
                     break;
                   }
                 }
               }
               //
               // search through plural methods
               if (isTrue(isEqual(fetchedOrder, ccxt::any{}))) {
                 ccxt::any methods_plural = ccxt::list{
                     std::string("fetchOrders"), std::string("fetchOpenOrders"),
                     std::string("fetchClosedOrders"),
                     std::string("fetchCanceledOrders")};
                 for (ccxt::any i = 0;
                      isLessThan(i, getArrayLength(methods_plural));
                      postFixIncrement(i)) {
                   ccxt::any pluralFetchName = ::getValue(methods_plural, i);
                   if (isTrue(isTrue((!isEqual(
                                  ::getValue(
                                      getProperty(exchange, std::string("has")),
                                      pluralFetchName),
                                  ccxt::any{}))) &&
                              isTrue((!isEqual(
                                  ::getValue(
                                      getProperty(exchange, std::string("has")),
                                      pluralFetchName),
                                  false))))) {
                     ccxt::any orders = awaitValue(
                         callDynamically(exchange, pluralFetchName,
                                         ccxt::list{symbol, sinceTime}));
                     ccxt::any found = false;
                     for (ccxt::any j = 0;
                          isLessThan(j, getArrayLength(orders));
                          postFixIncrement(j)) {
                       ccxt::any currentOrder = ::getValue(orders, j);
                       if (isTrue(isEqual(
                               ::getValue(currentOrder, std::string("id")),
                               originalId))) {
                         fetchedOrder = currentOrder;
                         found = true;
                         break;
                       }
                     }
                     if (isTrue(found)) {
                       break;
                     }
                   }
                 }
               }
               return fetchedOrder;
             })
      .share();
}

void assertOrderState(ccxt::any exchange, ccxt::any skippedProperties,
                      ccxt::any method, ccxt::any order,
                      ccxt::any assertedStatus, ccxt::any strictCheck) {
  // note, `strictCheck` is `true` only from "fetchOrder" cases
  ccxt::any logText = logTemplate(exchange, method, order);
  ccxt::any msg = add(add(add(std::string("order should be "), assertedStatus),
                          std::string(", but it was not asserted")),
                      logText);
  ccxt::any filled = callDynamically(exchange, std::string("safeString"),
                                     ccxt::list{order, std::string("filled")});
  ccxt::any amount = callDynamically(exchange, std::string("safeString"),
                                     ccxt::list{order, std::string("amount")});
  // shorthand variables
  ccxt::any statusUndefined =
      (isEqual(::getValue(order, std::string("status")), ccxt::any{}));
  ccxt::any statusOpen =
      (isEqual(::getValue(order, std::string("status")), std::string("open")));
  ccxt::any statusClosed = (isEqual(::getValue(order, std::string("status")),
                                    std::string("closed")));
  ccxt::any statusClanceled = (isEqual(::getValue(order, std::string("status")),
                                       std::string("canceled")));
  ccxt::any filledDefined = (!isEqual(filled, ccxt::any{}));
  ccxt::any amountDefined = (!isEqual(amount, ccxt::any{}));
  ccxt::any condition = ccxt::any{};
  //
  // ### OPEN STATUS
  //
  // if strict check, then 'status' must be 'open' and filled amount should be
  // less then whole order amount
  ccxt::any strictOpen =
      isTrue(statusOpen) &&
      isTrue((isTrue(isTrue(filledDefined) && isTrue(amountDefined)) &&
              isTrue(isLessThan(filled, amount))));
  // if non-strict check, then accept & ignore ccxt::any{} values
  ccxt::any nonstrictOpen =
      isTrue((isTrue(statusOpen) || isTrue(statusUndefined))) &&
      isTrue((isTrue((!isTrue(filledDefined) || !isTrue(amountDefined))) ||
              isTrue(ccxt::Precise::stringLt(filled, amount))));
  // check
  if (isTrue(isEqual(assertedStatus, std::string("open")))) {
    condition = (isTrue(strictCheck) ? ccxt::any(strictOpen)
                                     : ccxt::any(nonstrictOpen));
    assertTrue(condition, msg);
    return;
  }
  //
  // ### CLOSED STATUS
  //
  // if strict check, then 'status' must be 'closed' and filled amount should be
  // equal to the whole order amount
  ccxt::any closedStrict =
      isTrue(statusClosed) &&
      isTrue((isTrue(isTrue(filledDefined) && isTrue(amountDefined)) &&
              isTrue(ccxt::Precise::stringEq(filled, amount))));
  // if non-strict check, then accept & ignore ccxt::any{} values
  ccxt::any closedNonStrict =
      isTrue((isTrue(statusClosed) || isTrue(statusUndefined))) &&
      isTrue((isTrue((!isTrue(filledDefined) || !isTrue(amountDefined))) ||
              isTrue(ccxt::Precise::stringEq(filled, amount))));
  // check
  if (isTrue(isEqual(assertedStatus, std::string("closed")))) {
    condition = (isTrue(strictCheck) ? ccxt::any(closedStrict)
                                     : ccxt::any(closedNonStrict));
    assertTrue(condition, msg);
    return;
  }
  //
  // ### CANCELED STATUS
  //
  // if strict check, then 'status' must be 'canceled' and filled amount should
  // be less then whole order amount
  ccxt::any canceledStrict =
      isTrue(statusClanceled) &&
      isTrue((isTrue(isTrue(filledDefined) && isTrue(amountDefined)) &&
              isTrue(ccxt::Precise::stringLt(filled, amount))));
  // if non-strict check, then accept & ignore ccxt::any{} values
  ccxt::any canceledNonStrict =
      isTrue((isTrue(statusClanceled) || isTrue(statusUndefined))) &&
      isTrue((isTrue((!isTrue(filledDefined) || !isTrue(amountDefined))) ||
              isTrue(ccxt::Precise::stringLt(filled, amount))));
  // check
  if (isTrue(isEqual(assertedStatus, std::string("canceled")))) {
    condition = (isTrue(strictCheck) ? ccxt::any(canceledStrict)
                                     : ccxt::any(canceledNonStrict));
    assertTrue(condition, msg);
    return;
  }
  //
  // ### CLOSED_or_CANCELED STATUS
  //
  if (isTrue(isEqual(assertedStatus, std::string("closed_or_canceled")))) {
    condition =
        (isTrue(strictCheck)
             ? ccxt::any((isTrue(closedStrict) || isTrue(canceledStrict)))
             : ccxt::any(
                   (isTrue(closedNonStrict) || isTrue(canceledNonStrict))));
    assertTrue(condition, msg);
    return;
  }
}

ccxt::any getActiveMarkets(ccxt::any exchange,
                           ccxt::any includeUnknown = true) {
  ccxt::any filteredActive =
      callDynamically(exchange, std::string("filterBy"),
                      ccxt::list{getProperty(exchange, std::string("markets")),
                                 std::string("active"), true});
  if (isTrue(includeUnknown)) {
    ccxt::any filteredUndefined = callDynamically(
        exchange, std::string("filterBy"),
        ccxt::list{getProperty(exchange, std::string("markets")),
                   std::string("active"), ccxt::any{}});
    return callDynamically(exchange, std::string("arrayConcat"),
                           ccxt::list{filteredActive, filteredUndefined});
  }
  return filteredActive;
}

ccxt::any removeProxyOptions(ccxt::any exchange, ccxt::any skippedProperties) {
  ccxt::any proxyUrl = callDynamically(
      exchange, std::string("checkProxyUrlSettings"), ccxt::list{});
  ccxt::any httpProxyhttpsProxysocksProxyVariable = callDynamically(
      exchange, std::string("checkProxySettings"), ccxt::list{});
  ccxt::any httpProxy = ::getValue(httpProxyhttpsProxysocksProxyVariable, 0);
  ccxt::any httpsProxy = ::getValue(httpProxyhttpsProxysocksProxyVariable, 1);
  ccxt::any socksProxy = ::getValue(httpProxyhttpsProxysocksProxyVariable, 2);
  // because of bug in transpiled, about `.proxyUrl` being transpiled into
  // `.proxy_url`, we have to use this workaround
  callDynamically(exchange, std::string("setProperty"),
                  ccxt::list{exchange, std::string("proxyUrl"), ccxt::any{}});
  callDynamically(exchange, std::string("setProperty"),
                  ccxt::list{exchange, std::string("proxy_url"), ccxt::any{}});
  callDynamically(exchange, std::string("setProperty"),
                  ccxt::list{exchange, std::string("httpProxy"), ccxt::any{}});
  callDynamically(exchange, std::string("setProperty"),
                  ccxt::list{exchange, std::string("http_proxy"), ccxt::any{}});
  callDynamically(exchange, std::string("setProperty"),
                  ccxt::list{exchange, std::string("httpsProxy"), ccxt::any{}});
  callDynamically(
      exchange, std::string("setProperty"),
      ccxt::list{exchange, std::string("https_proxy"), ccxt::any{}});
  callDynamically(exchange, std::string("setProperty"),
                  ccxt::list{exchange, std::string("socksProxy"), ccxt::any{}});
  callDynamically(
      exchange, std::string("setProperty"),
      ccxt::list{exchange, std::string("socks_proxy"), ccxt::any{}});
  return ccxt::list{proxyUrl, httpProxy, httpsProxy, socksProxy};
}

void setProxyOptions(ccxt::any exchange, ccxt::any skippedProperties,
                     ccxt::any proxyUrl, ccxt::any httpProxy,
                     ccxt::any httpsProxy, ccxt::any socksProxy) {
  setProperty(exchange, std::string("proxyUrl"), proxyUrl);
  setProperty(exchange, std::string("httpProxy"), httpProxy);
  setProperty(exchange, std::string("httpsProxy"), httpsProxy);
  setProperty(exchange, std::string("socksProxy"), socksProxy);
}

ccxt::any concat(ccxt::any a = ccxt::any{}, ccxt::any b = ccxt::any{}) {
  // we use this method temporarily, because of ast-transpiler issue across
  // langs
  if (isTrue(isEqual(a, ccxt::any{}))) {
    return b;
  } else if (isTrue(isEqual(b, ccxt::any{}))) {
    return a;
  } else {
    ccxt::any result = ccxt::list{};
    for (ccxt::any i = 0; isLessThan(i, getArrayLength(a));
         postFixIncrement(i)) {
      arrayPush(result, ::getValue(a, i));
    }
    for (ccxt::any j = 0; isLessThan(j, getArrayLength(b));
         postFixIncrement(j)) {
      arrayPush(result, ::getValue(b, j));
    }
    return result;
  }
}

void assertDictionaryResponse(ccxt::any exchange, ccxt::any method,
                              ccxt::any response,
                              ccxt::any hint = ccxt::any{}) {
  // php cannot distinguish an empty dict from an empty list, both are a plain
  // array there, so an empty array response is shape indeterminate and
  // accepted, observed as false positive FAILs in the live tests on
  // https://github.com/ccxt/ccxt/pull/29696
  ccxt::any isEmptyArrayResponse = false;
  if (isTrue(isArray(response))) {
    ccxt::any responseLength = getArrayLength(response);
    isEmptyArrayResponse = (isEqual(responseLength, 0));
  }
  ccxt::any hintText = std::string("");
  if (isTrue(!isEqual(hint, ccxt::any{}))) {
    hintText = add(std::string(" "), hint);
  }
  assertTrue(isTrue(callDynamically(exchange, std::string("isDictionary"),
                                    ccxt::list{response})) ||
                 isTrue(isEmptyArrayResponse),
             add(add(add(add(add(getProperty(exchange, std::string("id")),
                                 std::string(" ")),
                             method),
                         hintText),
                     std::string(" must return a dict. ")),
                 callDynamically(exchange, std::string("json"),
                                 ccxt::list{response})));
}

void assertNonEmtpyArray(ccxt::any exchange, ccxt::any skippedProperties,
                         ccxt::any method, ccxt::any entry,
                         ccxt::any hint = ccxt::any{}) {
  ccxt::any logText = logTemplate(exchange, method, entry);
  if (isTrue(!isEqual(hint, ccxt::any{}))) {
    logText = add(add(logText, std::string(" ")), hint);
  }
  assertTrue(isArray(entry),
             add(std::string("response is expected to be an array"), logText));
  if (!isTrue((inOp(skippedProperties, std::string("emptyResponse"))))) {
    return;
  }
  assertTrue(
      isGreaterThan(getArrayLength(entry), 0),
      add(add(std::string("response is expected to be a non-empty array"),
              logText),
          std::string(" (add \"emptyResponse\" in skip-tests.json to skip this "
                      "check)")));
}

void assertRoundMinuteTimestamp(ccxt::any exchange, ccxt::any skippedProperties,
                                ccxt::any method, ccxt::any entry,
                                ccxt::any key) {
  if (isTrue(inOp(skippedProperties, key))) {
    return;
  }
  ccxt::any logText = logTemplate(exchange, method, entry);
  ccxt::any ts = callDynamically(exchange, std::string("safeString"),
                                 ccxt::list{entry, key});
  assertTrue(isEqual(ccxt::Precise::stringMod(ts, std::string("60000")),
                     std::string("0")),
             add(std::string(
                     "timestamp should be a multiple of 60 seconds (1 minute)"),
                 logText));
}

ccxt::any deepEqual(ccxt::any exchange, ccxt::any a, ccxt::any b) {
  return isEqual(callDynamically(exchange, std::string("jsonStringifyWithNull"),
                                 ccxt::list{a}),
                 callDynamically(exchange, std::string("jsonStringifyWithNull"),
                                 ccxt::list{b}));
}

void assertDeepEqual(ccxt::any exchange, ccxt::any skippedProperties,
                     ccxt::any method, ccxt::any a, ccxt::any b) {
  ccxt::any logText = logTemplate(exchange, method, ccxt::dict{});
  assertTrue(
      deepEqual(exchange, a, b),
      add(add(add(add(std::string("two dicts do not match: "),
                      callDynamically(exchange,
                                      std::string("jsonStringifyWithNull"),
                                      ccxt::list{a})),
                  std::string(" != ")),
              callDynamically(exchange, std::string("jsonStringifyWithNull"),
                              ccxt::list{b})),
          logText));
}

ccxt::any exchangeProp(ccxt::any exchange, ccxt::any key,
                       ccxt::any defaultValue = ccxt::any{}) {
  ccxt::any value = callDynamically(exchange, std::string("getProperty"),
                                    ccxt::list{exchange, toString(key)});
  if (isTrue(!isEqual(value, ccxt::any{}))) {
    return value;
  }
  // try UpperCase key also, for other langs
  ccxt::any keyUpper = callDynamically(exchange, std::string("capitalize"),
                                       ccxt::list{toString(key)});
  return callDynamically(exchange, std::string("getProperty"),
                         ccxt::list{exchange, keyUpper, defaultValue});
}

ccxt::any tickerExceptionNeedsOhlcv(ccxt::any ex, ccxt::any exchange,
                                    ccxt::any ticker) {
  // pure helper (no awaits): files under test/Exchange/base transpile into a
  // single sync-flavored php shared by both lanes, so the actual fetchOHLCV
  // await must live in the per-lane callers - this tells them whether the probe
  // is needed
  ccxt::any eMessage = callDynamically(
      exchange, std::string("exceptionMessage"),
      ccxt::list{ex, false}); // typed string so the php transpile uses
                              // mb_strpos, not in_array
  if (isTrue(
          isTrue(isGreaterThanOrEqual(
              getIndexOf(eMessage, std::string("percentage should be above")),
              0)) ||
          isTrue(isGreaterThanOrEqual(
              getIndexOf(eMessage, std::string("percentage should be below")),
              0)))) {
    ccxt::any symbol = ::getValue(ticker, std::string("symbol"));
    if (isTrue(!isEqual(symbol, ccxt::any{}))) {
      if (isTrue(isTrue((!isEqual(getProperty(exchange, std::string("markets")),
                                  ccxt::any{}))) &&
                 isTrue((inOp(getProperty(exchange, std::string("markets")),
                              symbol))))) {
        if (isTrue(!isEqual(
                callDynamically(exchange, std::string("featureValue"),
                                ccxt::list{symbol, std::string("fetchOHLCV")}),
                ccxt::any{}))) {
          return true;
        }
      }
    }
  }
  return false;
}

void validateTickerExceptionForPercentage(ccxt::any ex, ccxt::any exchange,
                                          ccxt::any ticker,
                                          ccxt::any ohlcv = ccxt::any{}) {
  // only skip cases of "too far price" when it's the first day of listing,
  // otherwise rethrow abnormality pure (no awaits) for the sync-shared php
  // transpile - the ohlcv candles, when needed per tickerExceptionNeedsOhlcv,
  // are fetched by the per-lane caller and passed in
  ccxt::any eMessage = callDynamically(
      exchange, std::string("exceptionMessage"),
      ccxt::list{ex, false}); // typed string so the php transpile uses
                              // mb_strpos, not in_array
  if (isTrue(
          isTrue(isGreaterThanOrEqual(
              getIndexOf(eMessage, std::string("percentage should be above")),
              0)) ||
          isTrue(isGreaterThanOrEqual(
              getIndexOf(eMessage, std::string("percentage should be below")),
              0)))) {
    ccxt::any symbol = ::getValue(ticker, std::string("symbol"));
    if (isTrue(!isEqual(symbol, ccxt::any{}))) {
      // if it's not in markets, then maybe newly added symbol, so can can
      // compromise there
      if (isTrue(isTrue((isEqual(getProperty(exchange, std::string("markets")),
                                 ccxt::any{}))) ||
                 !isTrue((inOp(getProperty(exchange, std::string("markets")),
                               symbol))))) {
        return;
      }
      if (isTrue(!isEqual(ohlcv, ccxt::any{}))) {
        ccxt::any ohlcvLength = getArrayLength(ohlcv);
        if (isTrue(isLessThanOrEqual(ohlcvLength, 1))) {
          // if only 1 day of listing, then allow it
          return;
        }
      }
    }
  }
  assertTrue(isEqual(eMessage, std::string("")), eMessage); // trigger error
}
