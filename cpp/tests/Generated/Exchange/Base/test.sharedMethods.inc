std::any logTemplate(std::any exchange, std::any method, std::any entry)
{
    // there are cases when exchange is std::any{} (eg. base tests)
    std::any id = (isTrue((!isEqual(exchange, std::any{}))) ? std::any(getProperty(exchange, std::string("id"))) : std::any(std::string("undefined")));
    std::any methodString = (isTrue((!isEqual(method, std::any{}))) ? std::any(method) : std::any(std::string("undefined")));
    std::any entryString = (isTrue((isTrue(!isEqual(exchange, std::any{})) && isTrue(!isEqual(entry, std::any{})))) ? std::any(callDynamically(exchange, std::string("json"), ccxt::list{entry})) : std::any(std::string("")));
    return add(add(add(add(add(add(std::string(" <<< "), id), std::string(" ")), methodString), std::string(" ::: ")), entryString), std::string(" >>> "));
}

std::any isTemporaryFailure(std::any e)
{
    return isTrue((isInstanceOf<OperationFailed>(e))) && isTrue((!isTrue((isInstanceOf<OnMaintenance>(e)))));
}

std::any stringValue(std::any value)
{
    std::any stringVal = std::any{};
    if (isTrue(isString(value)))
    {
        stringVal = value;
    } else if (isTrue(isEqual(value, std::any{})))
    {
        stringVal = std::string("undefined");
    } else
    {
        stringVal = toString(value);
    }
    return stringVal;
}

std::any assertType(std::any exchange, std::any skippedProperties, std::any entry, std::any key, std::any format)
{
    if (isTrue(inOp(skippedProperties, key)))
    {
        return std::any{};
    }
    // because "typeof" string is not transpilable without === 'name', we list them manually at this moment
    std::any entryKeyVal = callDynamically(exchange, std::string("safeValue"), ccxt::list{entry, key});
    std::any formatKeyVal = callDynamically(exchange, std::string("safeValue"), ccxt::list{format, key});
    std::any same_string = isTrue((isString(entryKeyVal))) && isTrue((isString(formatKeyVal)));
    std::any same_numeric = isTrue((isNumber(entryKeyVal))) && isTrue((isNumber(formatKeyVal)));
    std::any same_boolean = isTrue((isTrue((isEqual(entryKeyVal, true))) || isTrue((isEqual(entryKeyVal, false))))) && isTrue((isTrue((isEqual(formatKeyVal, true))) || isTrue((isEqual(formatKeyVal, false)))));
    std::any same_array = isTrue(isArray(entryKeyVal)) && isTrue(isArray(formatKeyVal));
    // PHP cannot tell an empty dict {} from an empty list [] (both are array()), so isDictionary
    // returns false for an empty {} format marker — accept a dict entry against an empty-array format
    std::any formatIsEmptyArray = false;
    if (isTrue(isArray(formatKeyVal)))
    {
        std::any formatLen = getArrayLength(formatKeyVal);
        formatIsEmptyArray = (isEqual(formatLen, 0));
    }
    std::any same_object = isTrue(callDynamically(exchange, std::string("isDictionary"), ccxt::list{entryKeyVal})) && isTrue((isTrue(callDynamically(exchange, std::string("isDictionary"), ccxt::list{formatKeyVal})) || isTrue(formatIsEmptyArray)));
    std::any result = isTrue(isTrue(isTrue(isTrue(isTrue((isEqual(entryKeyVal, std::any{}))) || isTrue(same_string)) || isTrue(same_numeric)) || isTrue(same_boolean)) || isTrue(same_array)) || isTrue(same_object);
    return result;
}

void assertStructure(std::any exchange, std::any skippedProperties, std::any method, std::any entry, std::any format, std::any emptyAllowedFor = std::any{}, std::any deep = false)
{
    std::any logText = logTemplate(exchange, method, entry);
    assertTrue(!isEqual(entry, std::any{}), add(std::string("item is null/undefined"), logText));
    // get all expected & predefined keys for this specific item and ensure thos ekeys exist in parsed structure
    std::any allowEmptySkips = callDynamically(exchange, std::string("safeList"), ccxt::list{skippedProperties, std::string("allowNull"), ccxt::list{}});
    if (isTrue(!isEqual(emptyAllowedFor, std::any{})))
    {
        emptyAllowedFor = concat(emptyAllowedFor, allowEmptySkips);
    }
    if (isTrue(isArray(format)))
    {
        assertTrue(isArray(entry), add(std::string("entry is not an array"), logText));
        std::any realLength = getArrayLength(entry);
        std::any expectedLength = getArrayLength(format);
        assertTrue(isEqual(realLength, expectedLength), add(add(std::string("entry length is not equal to expected length of "), toString(expectedLength)), logText));
        for (std::any i = 0; isLessThan(i, getArrayLength(format)); postFixIncrement(i))
        {
            std::any emptyAllowedForThisKey = isTrue((isEqual(emptyAllowedFor, std::any{}))) || isTrue(callDynamically(exchange, std::string("inArray"), ccxt::list{i, emptyAllowedFor}));
            std::any value = ::getValue(entry, i);
            // check when:
            // - it's not inside "allowe empty values" list
            // - it's not std::any{}
            if (isTrue(isTrue((isTrue(emptyAllowedForThisKey) && isTrue((isEqual(value, std::any{}))))) || isTrue((inOp(skippedProperties, i)))))
            {
                continue;
            }
            assertTrue(!isEqual(value, std::any{}), add(add(toString(i), std::string(" index is expected to have a value")), logText));
            // because of other langs, this is needed for arrays
            std::any typeAssertion = assertType(exchange, ccxt::dict {}, entry, i, format);
            assertTrue(isEqual(typeAssertion, true), add(add(toString(i), std::string(" index does not have an expected type ")), logText));
        }
    } else
    {
        assertTrue(callDynamically(exchange, std::string("isDictionary"), ccxt::list{entry}), add(std::string("entry is not a dict"), logText));
        std::any keys = getObjectKeys(format);
        for (std::any i = 0; isLessThan(i, getArrayLength(keys)); postFixIncrement(i))
        {
            std::any key = ::getValue(keys, i);
            if (isTrue(inOp(skippedProperties, key)))
            {
                continue;
            }
            assertTrue(inOp(entry, key), add(add(add(std::string("\""), stringValue(key)), std::string("\" key is missing from structure")), logText));
            std::any emptyAllowedForThisKey = isTrue((isEqual(emptyAllowedFor, std::any{}))) || isTrue(callDynamically(exchange, std::string("inArray"), ccxt::list{key, emptyAllowedFor}));
            std::any value = ::getValue(entry, key);
            // check when:
            // - it's not inside "allowed empty values" list
            // - it's not std::any{}
            if (isTrue(isTrue(emptyAllowedForThisKey) && isTrue((isEqual(value, std::any{})))))
            {
                continue;
            }
            // if it was in needed keys, then it should have value.
            assertTrue(!isEqual(value, std::any{}), add(add(add(std::string("\""), stringValue(key)), std::string("\" key is expected to have a value")), logText));
            // add exclusion for info key, as it can be any type
            if (isTrue(!isEqual(key, std::string("info"))))
            {
                std::any typeAssertion = assertType(exchange, ccxt::dict {}, entry, key, format);
                assertTrue(isEqual(typeAssertion, true), add(add(add(std::string("\""), stringValue(key)), std::string("\" key is neither undefined, neither of expected type")), logText));
                if (isTrue(deep))
                {
                    if (isTrue(isTrue(callDynamically(exchange, std::string("isDictionary"), ccxt::list{value})) || isTrue(isArray(value))))
                    {
                        assertStructure(exchange, skippedProperties, method, value, ::getValue(format, key), emptyAllowedFor, deep);
                    }
                }
            }
        }
    }
}

void assertTimestamp(std::any exchange, std::any skippedProperties, std::any method, std::any entry, std::any nowToCheck = std::any{}, std::any keyNameOrIndex = std::string("timestamp"), std::any allowNull = true)
{
    std::any logText = logTemplate(exchange, method, entry);
    std::any skipValue = callDynamically(exchange, std::string("safeValue"), ccxt::list{skippedProperties, keyNameOrIndex});
    if (isTrue(!isEqual(skipValue, std::any{})))
    {
        return;  // skipped
    }
    std::any isDateTimeObject = isString(keyNameOrIndex);
    if (isTrue(isDateTimeObject))
    {
        assertTrue((inOp(entry, keyNameOrIndex)), add(add(add(std::string("timestamp key \""), keyNameOrIndex), std::string("\" is missing from structure")), logText));
    } else
    {
        // if index was provided (mostly from fetchOHLCV) then we check if it exists, as mandatory
        assertTrue(!isTrue((isEqual(::getValue(entry, keyNameOrIndex), std::any{}))), add(add(add(std::string("timestamp index "), stringValue(keyNameOrIndex)), std::string(" is undefined")), logText));
    }
    std::any ts = ::getValue(entry, keyNameOrIndex);
    assertTrue(isTrue(!isEqual(ts, std::any{})) || isTrue(allowNull), add(std::string("timestamp is null"), logText));
    if (isTrue(!isEqual(ts, std::any{})))
    {
        assertTrue(isNumber(ts), add(std::string("timestamp is not numeric"), logText));
        assertTrue(isInteger(ts), add(std::string("timestamp should be an integer"), logText));
        std::any minTs = 1230940800000; // 03 Jan 2009 - first block
        std::any maxTs = 2147483648000; // 19 Jan 2038 - max int
        assertTrue(isGreaterThan(ts, minTs), add(add(add(std::string("timestamp is impossible to be before "), toString(minTs)), std::string(" (03.01.2009)")), logText)); // 03 Jan 2009 - first block
        assertTrue(isLessThan(ts, maxTs), add(add(add(std::string("timestamp more than "), toString(maxTs)), std::string(" (19.01.2038)")), logText)); // 19 Jan 2038 - int32 overflows // 7258118400000  -> Jan 1 2200
        if (isTrue(!isEqual(nowToCheck, std::any{})))
        {
            std::any maxMsOffset = 60000; // 1 min
            assertTrue(isLessThan(ts, add(nowToCheck, maxMsOffset)), add(add(add(add(add(std::string("returned item timestamp ("), callDynamically(exchange, std::string("iso8601"), ccxt::list{ts})), std::string(") is ahead of the current time (")), callDynamically(exchange, std::string("iso8601"), ccxt::list{nowToCheck})), std::string(")")), logText));
        }
    }
}

void assertTimestampAndDatetime(std::any exchange, std::any skippedProperties, std::any method, std::any entry, std::any nowToCheck = std::any{}, std::any keyNameOrIndex = std::string("timestamp"), std::any allowNull = true)
{
    std::any logText = logTemplate(exchange, method, entry);
    std::any skipValue = callDynamically(exchange, std::string("safeValue"), ccxt::list{skippedProperties, keyNameOrIndex});
    if (isTrue(!isEqual(skipValue, std::any{})))
    {
        return;
    }
    assertTimestamp(exchange, skippedProperties, method, entry, nowToCheck, keyNameOrIndex);
    std::any isDateTimeObject = isString(keyNameOrIndex);
    // only in case if the entry is a dictionary, thus it must have 'timestamp' & 'datetime' string keys
    if (isTrue(isDateTimeObject))
    {
        // we also test 'datetime' here because it's certain sibling of 'timestamp'
        assertTrue((inOp(entry, std::string("datetime"))), add(std::string("\"datetime\" key is missing from structure"), logText));
        std::any dt = ::getValue(entry, std::string("datetime"));
        assertTrue(isTrue(!isEqual(dt, std::any{})) || isTrue(allowNull), add(std::string("timestamp is null"), logText));
        if (isTrue(!isEqual(dt, std::any{})))
        {
            assertTrue(isString(dt), add(std::string("\"datetime\" key does not have a string value"), logText));
            // there are exceptional cases, like getting microsecond-targeted string '2022-08-08T22:03:19.014680Z', so parsed unified timestamp, which carries only 13 digits (millisecond precision) can not be stringified back to microsecond accuracy, causing the bellow assertion to fail
            //    assertTrue(dt === callDynamically(exchange, std::string("iso8601"), ccxt::list{entry['timestamp']}))
            // so, we have to compare with millisecond accururacy
            std::any dtParsed = callDynamically(exchange, std::string("parse8601"), ccxt::list{dt});
            std::any tsMs = ::getValue(entry, std::string("timestamp"));
            if (isTrue(isEqual(dtParsed, std::any{})))
            {
                assertTrue(false, add(add(std::string("datetime is not parseable: "), dt), logText));
            }
            std::any diff = mathAbs(subtract(dtParsed, tsMs));
            if (isTrue(isGreaterThanOrEqual(diff, 500)))
            {
                std::any dtParsedString = callDynamically(exchange, std::string("iso8601"), ccxt::list{dtParsed});
                std::any dtEntryString = callDynamically(exchange, std::string("iso8601"), ccxt::list{tsMs});
                assertTrue(false, add(add(add(add(add(std::string("datetime is not iso8601 of timestamp:"), dtParsedString), std::string("(string) != ")), dtEntryString), std::string("(from ts)")), logText));
            }
        }
    }
}

