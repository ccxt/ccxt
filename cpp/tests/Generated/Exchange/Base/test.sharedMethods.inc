        if (isTrue(!isEqual(value, std::any{})))
        {
            std::any isInteger = ::isInteger(value);
            assertTrue(isInteger, add(add(add(add(add(std::string("\""), stringValue(key)), std::string("\" key (value \"")), stringValue(value)), std::string("\") is not an integer")), logText));
        }
    }
}

void checkPrecisionAccuracy(std::any exchange, std::any skippedProperties, std::any method, std::any entry, std::any key)
{
    if (isTrue(inOp(skippedProperties, key)))
    {
        return;
    }
    if (isTrue(callDynamically(exchange, std::string("isTickPrecision"), ccxt::list{})))
    {
        // TICK_SIZE should be above zero
        assertGreater(exchange, skippedProperties, method, entry, key, std::string("0"));
        // the below array of integers are inexistent tick-sizes (theoretically technically possible, but not in real-world cases), so in our case, such values probably indicate an incorrectly implemented tick-sizes calculation, so we throw error
        std::any decimalNumbers = ccxt::list{std::string("2"), std::string("3"), std::string("4"), std::string("5"), std::string("6"), std::string("7"), std::string("8"), std::string("9"), std::string("11"), std::string("12"), std::string("13"), std::string("14"), std::string("15"), std::string("16")};
        if (isTrue(isTrue(isEqual(key, std::string("amount"))) && isTrue(inOp(skippedProperties, std::string("precisionAmountAbnormal")))))
        {
            return;
        }
        for (std::any i = 0; isLessThan(i, getArrayLength(decimalNumbers)); postFixIncrement(i))
        {
            std::any num = ::getValue(decimalNumbers, i);
            std::any numStr = num;
            assertNonEqual(exchange, skippedProperties, method, entry, key, numStr);
        }
    } else
    {
        // todo: significant-digits return doubles from `this.parseNumber`, so for now can't assert against integer atm
        // assertInteger (exchange, skippedProperties, method, entry, key); // should be integer
        assertLessOrEqual(exchange, skippedProperties, method, entry, key, std::string("18")); // should be under 18 decimals
        assertGreaterOrEqual(exchange, skippedProperties, method, entry, key, std::string("-8")); // in real-world cases, there would not be less than that
    }
}

std::shared_future<std::any> fetchBestBidAsk(std::any exchange, std::any method, std::any symbol)
{
    return std::async(std::launch::deferred, [=]() mutable -> std::any {
        std::any logText = logTemplate(exchange, method, ccxt::dict {});
        // find out best bid/ask price
        std::any bestBid = std::any{};
        std::any bestAsk = std::any{};
        std::any usedMethod = std::any{};
        if (isTrue(isTrue((!isEqual(::getValue(getProperty(exchange, std::string("has")), std::string("fetchOrderBook")), std::any{}))) && isTrue((!isEqual(::getValue(getProperty(exchange, std::string("has")), std::string("fetchOrderBook")), false)))))
        {
            usedMethod = std::string("fetchOrderBook");
            std::any orderbook = awaitValue(callDynamically(exchange, std::string("fetchOrderBook"), ccxt::list{symbol}));
            std::any bids = callDynamically(exchange, std::string("safeList"), ccxt::list{orderbook, std::string("bids")});
            std::any asks = callDynamically(exchange, std::string("safeList"), ccxt::list{orderbook, std::string("asks")});
            std::any bestBidArray = callDynamically(exchange, std::string("safeList"), ccxt::list{bids, 0});
            std::any bestAskArray = callDynamically(exchange, std::string("safeList"), ccxt::list{asks, 0});
            bestBid = callDynamically(exchange, std::string("safeNumber"), ccxt::list{bestBidArray, 0});
            bestAsk = callDynamically(exchange, std::string("safeNumber"), ccxt::list{bestAskArray, 0});
        } else if (isTrue(isTrue((!isEqual(::getValue(getProperty(exchange, std::string("has")), std::string("fetchBidsAsks")), std::any{}))) && isTrue((!isEqual(::getValue(getProperty(exchange, std::string("has")), std::string("fetchBidsAsks")), false)))))
        {
            usedMethod = std::string("fetchBidsAsks");
            std::any tickers = awaitValue(callDynamically(exchange, std::string("fetchBidsAsks"), ccxt::list{ccxt::list{symbol}}));
            std::any ticker = callDynamically(exchange, std::string("safeDict"), ccxt::list{tickers, symbol});
            bestBid = callDynamically(exchange, std::string("safeNumber"), ccxt::list{ticker, std::string("bid")});
            bestAsk = callDynamically(exchange, std::string("safeNumber"), ccxt::list{ticker, std::string("ask")});
        } else if (isTrue(isTrue((!isEqual(::getValue(getProperty(exchange, std::string("has")), std::string("fetchTicker")), std::any{}))) && isTrue((!isEqual(::getValue(getProperty(exchange, std::string("has")), std::string("fetchTicker")), false)))))
        {
            usedMethod = std::string("fetchTicker");
            std::any ticker = awaitValue(callDynamically(exchange, std::string("fetchTicker"), ccxt::list{symbol}));
            bestBid = callDynamically(exchange, std::string("safeNumber"), ccxt::list{ticker, std::string("bid")});
            bestAsk = callDynamically(exchange, std::string("safeNumber"), ccxt::list{ticker, std::string("ask")});
        } else if (isTrue(isTrue((!isEqual(::getValue(getProperty(exchange, std::string("has")), std::string("fetchTickers")), std::any{}))) && isTrue((!isEqual(::getValue(getProperty(exchange, std::string("has")), std::string("fetchTickers")), false)))))
        {
            usedMethod = std::string("fetchTickers");
            std::any tickers = awaitValue(callDynamically(exchange, std::string("fetchTickers"), ccxt::list{ccxt::list{symbol}}));
            std::any ticker = callDynamically(exchange, std::string("safeDict"), ccxt::list{tickers, symbol});
            bestBid = callDynamically(exchange, std::string("safeNumber"), ccxt::list{ticker, std::string("bid")});
            bestAsk = callDynamically(exchange, std::string("safeNumber"), ccxt::list{ticker, std::string("ask")});
        }
        //
        assertTrue(isTrue(!isEqual(bestBid, std::any{})) && isTrue(!isEqual(bestAsk, std::any{})), add(add(add(add(add(add(add(add(logText, std::string(" ")), getProperty(exchange, std::string("id"))), std::string(" could not get best bid/ask for ")), symbol), std::string(" using ")), usedMethod), std::string(" while testing ")), method));
        return ccxt::list{bestBid, bestAsk};
    }).share();
}

std::shared_future<std::any> fetchOrder(std::any exchange, std::any symbol, std::any orderId, std::any skippedProperties)
{
    return std::async(std::launch::deferred, [=]() mutable -> std::any {
        std::any fetchedOrder = std::any{};
        std::any originalId = orderId;
        // set 'since' to 5 minute ago for optimal results
        std::any sinceTime = subtract(callDynamically(exchange, std::string("milliseconds"), ccxt::list{}), multiply(multiply(1000, 60), 5));
        // iterate
        std::any methods_singular = ccxt::list{std::string("fetchOrder"), std::string("fetchOpenOrder"), std::string("fetchClosedOrder"), std::string("fetchCanceledOrder")};
        for (std::any i = 0; isLessThan(i, getArrayLength(methods_singular)); postFixIncrement(i))
        {
            std::any singularFetchName = ::getValue(methods_singular, i);
            if (isTrue(isTrue((!isEqual(::getValue(getProperty(exchange, std::string("has")), singularFetchName), std::any{}))) && isTrue((!isEqual(::getValue(getProperty(exchange, std::string("has")), singularFetchName), false)))))
            {
                std::any currentOrder = awaitValue(callDynamically(exchange, singularFetchName, ccxt::list{originalId, symbol}));
                // if there is an id inside the order, it means the order was fetched successfully
                if (isTrue(isEqual(::getValue(currentOrder, std::string("id")), originalId)))
                {
                    fetchedOrder = currentOrder;
                    break;
                }
            }
        }
        //
        // search through plural methods
        if (isTrue(isEqual(fetchedOrder, std::any{})))
        {
            std::any methods_plural = ccxt::list{std::string("fetchOrders"), std::string("fetchOpenOrders"), std::string("fetchClosedOrders"), std::string("fetchCanceledOrders")};
            for (std::any i = 0; isLessThan(i, getArrayLength(methods_plural)); postFixIncrement(i))
            {
                std::any pluralFetchName = ::getValue(methods_plural, i);
                if (isTrue(isTrue((!isEqual(::getValue(getProperty(exchange, std::string("has")), pluralFetchName), std::any{}))) && isTrue((!isEqual(::getValue(getProperty(exchange, std::string("has")), pluralFetchName), false)))))
                {
                    std::any orders = awaitValue(callDynamically(exchange, pluralFetchName, ccxt::list{symbol, sinceTime}));
                    std::any found = false;
                    for (std::any j = 0; isLessThan(j, getArrayLength(orders)); postFixIncrement(j))
                    {
                        std::any currentOrder = ::getValue(orders, j);
                        if (isTrue(isEqual(::getValue(currentOrder, std::string("id")), originalId)))
                        {
                            fetchedOrder = currentOrder;
                            found = true;
                            break;
                        }
                    }
                    if (isTrue(found))
                    {
                        break;
                    }
                }
            }
        }
        return fetchedOrder;
    }).share();
}

void assertOrderState(std::any exchange, std::any skippedProperties, std::any method, std::any order, std::any assertedStatus, std::any strictCheck)
{
    // note, `strictCheck` is `true` only from "fetchOrder" cases
    std::any logText = logTemplate(exchange, method, order);
    std::any msg = add(add(add(std::string("order should be "), assertedStatus), std::string(", but it was not asserted")), logText);
    std::any filled = callDynamically(exchange, std::string("safeString"), ccxt::list{order, std::string("filled")});
    std::any amount = callDynamically(exchange, std::string("safeString"), ccxt::list{order, std::string("amount")});
    // shorthand variables
    std::any statusUndefined = (isEqual(::getValue(order, std::string("status")), std::any{}));
    std::any statusOpen = (isEqual(::getValue(order, std::string("status")), std::string("open")));
    std::any statusClosed = (isEqual(::getValue(order, std::string("status")), std::string("closed")));
    std::any statusClanceled = (isEqual(::getValue(order, std::string("status")), std::string("canceled")));
    std::any filledDefined = (!isEqual(filled, std::any{}));
    std::any amountDefined = (!isEqual(amount, std::any{}));
    std::any condition = std::any{};
    //
    // ### OPEN STATUS
    //
    // if strict check, then 'status' must be 'open' and filled amount should be less then whole order amount
    std::any strictOpen = isTrue(statusOpen) && isTrue((isTrue(isTrue(filledDefined) && isTrue(amountDefined)) && isTrue(isLessThan(filled, amount))));
    // if non-strict check, then accept & ignore std::any{} values
    std::any nonstrictOpen = isTrue((isTrue(statusOpen) || isTrue(statusUndefined))) && isTrue((isTrue((!isTrue(filledDefined) || !isTrue(amountDefined))) || isTrue(ccxt::Precise::stringLt(filled, amount))));
    // check
    if (isTrue(isEqual(assertedStatus, std::string("open"))))
    {
        condition = (isTrue(strictCheck) ? std::any(strictOpen) : std::any(nonstrictOpen));
        assertTrue(condition, msg);
        return;
    }
    //
    // ### CLOSED STATUS
    //
    // if strict check, then 'status' must be 'closed' and filled amount should be equal to the whole order amount
    std::any closedStrict = isTrue(statusClosed) && isTrue((isTrue(isTrue(filledDefined) && isTrue(amountDefined)) && isTrue(ccxt::Precise::stringEq(filled, amount))));
    // if non-strict check, then accept & ignore std::any{} values
    std::any closedNonStrict = isTrue((isTrue(statusClosed) || isTrue(statusUndefined))) && isTrue((isTrue((!isTrue(filledDefined) || !isTrue(amountDefined))) || isTrue(ccxt::Precise::stringEq(filled, amount))));
    // check
    if (isTrue(isEqual(assertedStatus, std::string("closed"))))
    {
        condition = (isTrue(strictCheck) ? std::any(closedStrict) : std::any(closedNonStrict));
        assertTrue(condition, msg);
        return;
    }
    //
    // ### CANCELED STATUS
    //
    // if strict check, then 'status' must be 'canceled' and filled amount should be less then whole order amount
    std::any canceledStrict = isTrue(statusClanceled) && isTrue((isTrue(isTrue(filledDefined) && isTrue(amountDefined)) && isTrue(ccxt::Precise::stringLt(filled, amount))));
    // if non-strict check, then accept & ignore std::any{} values
    std::any canceledNonStrict = isTrue((isTrue(statusClanceled) || isTrue(statusUndefined))) && isTrue((isTrue((!isTrue(filledDefined) || !isTrue(amountDefined))) || isTrue(ccxt::Precise::stringLt(filled, amount))));
    // check
    if (isTrue(isEqual(assertedStatus, std::string("canceled"))))
    {
        condition = (isTrue(strictCheck) ? std::any(canceledStrict) : std::any(canceledNonStrict));
        assertTrue(condition, msg);
        return;
    }
    //
    // ### CLOSED_or_CANCELED STATUS
    //
    if (isTrue(isEqual(assertedStatus, std::string("closed_or_canceled"))))
    {
        condition = (isTrue(strictCheck) ? std::any((isTrue(closedStrict) || isTrue(canceledStrict))) : std::any((isTrue(closedNonStrict) || isTrue(canceledNonStrict))));
        assertTrue(condition, msg);
        return;
    }
}

std::any getActiveMarkets(std::any exchange, std::any includeUnknown = true)
{
