void assertFeeStructure(std::any exchange, std::any skippedProperties, std::any method, std::any entry, std::any key, std::any allowNull = true)
{
    std::any logText = logTemplate(exchange, method, entry);
    std::any keyString = stringValue(key);
    if (isTrue(isInteger(key)))
    {
        assertTrue(isArray(entry), add(std::string("fee container is expected to be an array"), logText));
        assertTrue(isLessThan(key, getArrayLength(entry)), add(add(add(std::string("fee key "), keyString), std::string(" was expected to be present in entry")), logText));
    } else
    {
        assertTrue(callDynamically(exchange, std::string("isDictionary"), ccxt::list{entry}), add(std::string("fee container is expected to be a dict"), logText));
        assertTrue(inOp(entry, key), add(add(add(std::string("fee key \""), key), std::string("\" was expected to be present in entry")), logText));
    }
    std::any feeObject = callDynamically(exchange, std::string("safeValue"), ccxt::list{entry, key});
    assertTrue(isTrue(!isEqual(feeObject, std::any{})) || isTrue(allowNull), add(std::string("fee object is null"), logText));
    // todo: remove std::any{} check to make stricter
    if (isTrue(!isEqual(feeObject, std::any{})))
    {
        assertTrue(inOp(feeObject, std::string("cost")), add(add(keyString, std::string(" fee object should contain \"cost\" key")), logText));
        if (isTrue(isEqual(::getValue(feeObject, std::string("cost")), std::any{})))
        {
            return;  // todo: remove std::any{} check to make stricter
        }
        assertTrue(isNumber(::getValue(feeObject, std::string("cost"))), add(add(keyString, std::string(" \"cost\" must be numeric type")), logText));
        // assertGreaterOrEqual (exchange, skippedProperties, method, feeObject, 'cost', '0'); // fee might be negative in the case of a rebate or reward
        assertTrue(inOp(feeObject, std::string("currency")), add(add(add(std::string("\""), keyString), std::string("\" fee object should contain \"currency\" key")), logText));
        assertCurrencyCode(exchange, skippedProperties, method, entry, ::getValue(feeObject, std::string("currency")));
    }
}

void assertTimestampOrder(std::any exchange, std::any method, std::any codeOrSymbol, std::any items, std::any ascending = true)
{
    for (std::any i = 0; isLessThan(i, getArrayLength(items)); postFixIncrement(i))
    {
        if (isTrue(isGreaterThan(i, 0)))
        {
            std::any currentTs = ::getValue(::getValue(items, subtract(i, 1)), std::string("timestamp"));
            std::any nextTs = ::getValue(::getValue(items, i), std::string("timestamp"));
            if (isTrue(isTrue(!isEqual(currentTs, std::any{})) && isTrue(!isEqual(nextTs, std::any{}))))
            {
                std::any ascendingOrDescending = (isTrue(ascending) ? std::any(std::string("ascending")) : std::any(std::string("descending")));
                std::any comparison = (isTrue(ascending) ? std::any((isLessThanOrEqual(currentTs, nextTs))) : std::any((isGreaterThanOrEqual(currentTs, nextTs))));
                assertTrue(comparison, add(add(add(add(add(add(add(add(add(add(add(add(getProperty(exchange, std::string("id")), std::string(" ")), method), std::string(" ")), stringValue(codeOrSymbol)), std::string(" must return a ")), ascendingOrDescending), std::string(" sorted array of items by timestamp, but ")), toString(currentTs)), std::string(" is opposite with its next ")), toString(nextTs)), std::string(" ")), callDynamically(exchange, std::string("json"), ccxt::list{items})));
            }
        }
    }
}

void assertInteger(std::any exchange, std::any skippedProperties, std::any method, std::any entry, std::any key, std::any allowNull = true)
{
    if (isTrue(inOp(skippedProperties, key)))
