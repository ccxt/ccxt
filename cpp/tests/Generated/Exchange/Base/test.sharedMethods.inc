void assertValidCurrencyIdAndCode(std::any exchange, std::any skippedProperties, std::any method, std::any entry, std::any currencyId, std::any currencyCode, std::any allowNull = true)
{
    // this is exclusive exceptional key name to be used in `skip-tests.json`, to skip check for currency id and code
    if (isTrue(isTrue((inOp(skippedProperties, std::string("currency")))) || isTrue((inOp(skippedProperties, std::string("currencyIdAndCode"))))))
    {
        return;
    }
    std::any logText = logTemplate(exchange, method, entry);
    std::any undefinedValues = isTrue(isEqual(currencyId, std::any{})) && isTrue(isEqual(currencyCode, std::any{}));
    std::any definedValues = isTrue(!isEqual(currencyId, std::any{})) && isTrue(!isEqual(currencyCode, std::any{}));
    assertTrue(isTrue(undefinedValues) || isTrue(definedValues), add(std::string("currencyId and currencyCode should be either both defined or both undefined"), logText));
    assertTrue(isTrue(definedValues) || isTrue(allowNull), add(std::string("currency code and id is not defined"), logText));
    if (isTrue(definedValues))
    {
        // check by code
        std::any currencyByCode = callDynamically(exchange, std::string("currency"), ccxt::list{currencyCode});
        assertTrue(isEqual(::getValue(currencyByCode, std::string("id")), currencyId), add(add(add(add(add(std::string("currencyId \""), stringValue(currencyId)), std::string("\" does not match currency id from instance: \"")), stringValue(::getValue(currencyByCode, std::string("id")))), std::string("\"")), logText));
        // check by id
        std::any currencyById = callDynamically(exchange, std::string("safeCurrency"), ccxt::list{currencyId});
        assertTrue(isEqual(::getValue(currencyById, std::string("code")), currencyCode), add(add(add(add(std::string("currencyCode "), stringValue(currencyCode)), std::string(" does not match currency of id: ")), stringValue(currencyId)), logText));
    }
}

