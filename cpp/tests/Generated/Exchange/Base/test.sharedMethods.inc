// PLEASE DO NOT EDIT THIS FILE, IT IS GENERATED AND WILL BE OVERWRITTEN:
// https://github.com/ccxt/ccxt/blob/master/CONTRIBUTING.md#how-to-contribute-code
ccxt::any logTemplate(ccxt::any exchange, ccxt::any method, ccxt::any entry) {
  // there are cases when exchange is ccxt::any{} (eg. base tests)
  ccxt::any id = (isTrue((!isEqual(exchange, ccxt::any{})))
                      ? ccxt::any(getProperty(exchange, std::string("id")))
                      : ccxt::any(std::string("undefined")));
  ccxt::any methodString = (isTrue((!isEqual(method, ccxt::any{})))
                                ? ccxt::any(method)
                                : ccxt::any(std::string("undefined")));
  ccxt::any entryString =
      (isTrue((isTrue(!isEqual(exchange, ccxt::any{})) &&
               isTrue(!isEqual(entry, ccxt::any{}))))
           ? ccxt::any(callDynamically(exchange, std::string("json"),
                                       ccxt::list{entry}))
           : ccxt::any(std::string("")));
  return add(add(add(add(add(add(std::string(" <<< "), id), std::string(" ")),
                         methodString),
                     std::string(" ::: ")),
                 entryString),
             std::string(" >>> "));
}

ccxt::any isTemporaryFailure(ccxt::any e) {
  return isTrue((isInstanceOf<OperationFailed>(e))) &&
         isTrue((!isTrue((isInstanceOf<OnMaintenance>(e)))));
}

ccxt::any stringValue(ccxt::any value) {
  ccxt::any stringVal = ccxt::any{};
  if (isTrue(isString(value))) {
    stringVal = value;
  } else if (isTrue(isEqual(value, ccxt::any{}))) {
    stringVal = std::string("undefined");
  } else {
    stringVal = toString(value);
  }
  return stringVal;
}

ccxt::any assertType(ccxt::any exchange, ccxt::any skippedProperties,
                     ccxt::any entry, ccxt::any key, ccxt::any format) {
  if (isTrue(inOp(skippedProperties, key))) {
    return ccxt::any{};
  }
  // because "typeof" string is not transpilable without === 'name', we list
  // them manually at this moment
  ccxt::any entryKeyVal = callDynamically(exchange, std::string("safeValue"),
                                          ccxt::list{entry, key});
  ccxt::any formatKeyVal = callDynamically(exchange, std::string("safeValue"),
                                           ccxt::list{format, key});
  ccxt::any same_string =
      isTrue((isString(entryKeyVal))) && isTrue((isString(formatKeyVal)));
  ccxt::any same_numeric =
      isTrue((isNumber(entryKeyVal))) && isTrue((isNumber(formatKeyVal)));
  ccxt::any same_boolean = isTrue((isTrue((isEqual(entryKeyVal, true))) ||
                                   isTrue((isEqual(entryKeyVal, false))))) &&
                           isTrue((isTrue((isEqual(formatKeyVal, true))) ||
                                   isTrue((isEqual(formatKeyVal, false)))));
  ccxt::any same_array =
      isTrue(isArray(entryKeyVal)) && isTrue(isArray(formatKeyVal));
  // PHP cannot tell an empty dict {} from an empty list [] (both are array()),
  // so isDictionary returns false for an empty {} format marker — accept a dict
  // entry against an empty-array format
  ccxt::any formatIsEmptyArray = false;
  if (isTrue(isArray(formatKeyVal))) {
    ccxt::any formatLen = getArrayLength(formatKeyVal);
    formatIsEmptyArray = (isEqual(formatLen, 0));
  }
  ccxt::any same_object =
      isTrue(callDynamically(exchange, std::string("isDictionary"),
                             ccxt::list{entryKeyVal})) &&
      isTrue((isTrue(callDynamically(exchange, std::string("isDictionary"),
                                     ccxt::list{formatKeyVal})) ||
              isTrue(formatIsEmptyArray)));
  ccxt::any result =
      isTrue(isTrue(isTrue(isTrue(isTrue((isEqual(entryKeyVal, ccxt::any{}))) ||
                                  isTrue(same_string)) ||
                           isTrue(same_numeric)) ||
                    isTrue(same_boolean)) ||
             isTrue(same_array)) ||
      isTrue(same_object);
  return result;
}

void assertStructure(ccxt::any exchange, ccxt::any skippedProperties,
                     ccxt::any method, ccxt::any entry, ccxt::any format,
                     ccxt::any emptyAllowedFor = ccxt::any{},
                     ccxt::any deep = false) {
  ccxt::any logText = logTemplate(exchange, method, entry);
  assertTrue(!isEqual(entry, ccxt::any{}),
             add(std::string("item is null/undefined"), logText));
  // get all expected & predefined keys for this specific item and ensure thos
  // ekeys exist in parsed structure
  ccxt::any allowEmptySkips = callDynamically(
      exchange, std::string("safeList"),
      ccxt::list{skippedProperties, std::string("allowNull"), ccxt::list{}});
  if (isTrue(!isEqual(emptyAllowedFor, ccxt::any{}))) {
    emptyAllowedFor = concat(emptyAllowedFor, allowEmptySkips);
  }
  if (isTrue(isArray(format))) {
    assertTrue(isArray(entry),
               add(std::string("entry is not an array"), logText));
    ccxt::any realLength = getArrayLength(entry);
    ccxt::any expectedLength = getArrayLength(format);
    assertTrue(
        isEqual(realLength, expectedLength),
        add(add(std::string("entry length is not equal to expected length of "),
                toString(expectedLength)),
            logText));
    for (ccxt::any i = 0; isLessThan(i, getArrayLength(format));
         postFixIncrement(i)) {
      ccxt::any emptyAllowedForThisKey =
          isTrue((isEqual(emptyAllowedFor, ccxt::any{}))) ||
          isTrue(callDynamically(exchange, std::string("inArray"),
                                 ccxt::list{i, emptyAllowedFor}));
      ccxt::any value = ::getValue(entry, i);
      // check when:
      // - it's not inside "allowe empty values" list
      // - it's not ccxt::any{}
      if (isTrue(isTrue((isTrue(emptyAllowedForThisKey) &&
                         isTrue((isEqual(value, ccxt::any{}))))) ||
                 isTrue((inOp(skippedProperties, i))))) {
        continue;
      }
      assertTrue(!isEqual(value, ccxt::any{}),
                 add(add(toString(i),
                         std::string(" index is expected to have a value")),
                     logText));
      // because of other langs, this is needed for arrays
      ccxt::any typeAssertion =
          assertType(exchange, ccxt::dict{}, entry, i, format);
      assertTrue(isEqual(typeAssertion, true),
                 add(add(toString(i),
                         std::string(" index does not have an expected type ")),
                     logText));
    }
  } else {
    assertTrue(callDynamically(exchange, std::string("isDictionary"),
                               ccxt::list{entry}),
               add(std::string("entry is not a dict"), logText));
    ccxt::any keys = getObjectKeys(format);
    for (ccxt::any i = 0; isLessThan(i, getArrayLength(keys));
         postFixIncrement(i)) {
      ccxt::any key = ::getValue(keys, i);
      if (isTrue(inOp(skippedProperties, key))) {
        continue;
      }
      assertTrue(inOp(entry, key),
                 add(add(add(std::string("\""), stringValue(key)),
                         std::string("\" key is missing from structure")),
                     logText));
      ccxt::any emptyAllowedForThisKey =
          isTrue((isEqual(emptyAllowedFor, ccxt::any{}))) ||
          isTrue(callDynamically(exchange, std::string("inArray"),
                                 ccxt::list{key, emptyAllowedFor}));
      ccxt::any value = ::getValue(entry, key);
      // check when:
      // - it's not inside "allowed empty values" list
      // - it's not ccxt::any{}
      if (isTrue(isTrue(emptyAllowedForThisKey) &&
                 isTrue((isEqual(value, ccxt::any{}))))) {
        continue;
      }
      // if it was in needed keys, then it should have value.
      assertTrue(!isEqual(value, ccxt::any{}),
                 add(add(add(std::string("\""), stringValue(key)),
                         std::string("\" key is expected to have a value")),
                     logText));
      // add exclusion for info key, as it can be any type
      if (isTrue(!isEqual(key, std::string("info")))) {
        ccxt::any typeAssertion =
            assertType(exchange, ccxt::dict{}, entry, key, format);
        assertTrue(isEqual(typeAssertion, true),
                   add(add(add(std::string("\""), stringValue(key)),
                           std::string("\" key is neither undefined, neither "
                                       "of expected type")),
                       logText));
        if (isTrue(deep)) {
          if (isTrue(
                  isTrue(callDynamically(exchange, std::string("isDictionary"),
                                         ccxt::list{value})) ||
                  isTrue(isArray(value)))) {
            assertStructure(exchange, skippedProperties, method, value,
                            ::getValue(format, key), emptyAllowedFor, deep);
          }
        }
      }
    }
  }
}

void assertTimestamp(ccxt::any exchange, ccxt::any skippedProperties,
                     ccxt::any method, ccxt::any entry,
                     ccxt::any nowToCheck = ccxt::any{},
                     ccxt::any keyNameOrIndex = std::string("timestamp"),
                     ccxt::any allowNull = true) {
  ccxt::any logText = logTemplate(exchange, method, entry);
  ccxt::any skipValue =
      callDynamically(exchange, std::string("safeValue"),
                      ccxt::list{skippedProperties, keyNameOrIndex});
  if (isTrue(!isEqual(skipValue, ccxt::any{}))) {
    return; // skipped
  }
  ccxt::any isDateTimeObject = isString(keyNameOrIndex);
  if (isTrue(isDateTimeObject)) {
    assertTrue((inOp(entry, keyNameOrIndex)),
               add(add(add(std::string("timestamp key \""), keyNameOrIndex),
                       std::string("\" is missing from structure")),
                   logText));
  } else {
    // if index was provided (mostly from fetchOHLCV) then we check if it
    // exists, as mandatory
    assertTrue(
        !isTrue((isEqual(::getValue(entry, keyNameOrIndex), ccxt::any{}))),
        add(add(add(std::string("timestamp index "),
                    stringValue(keyNameOrIndex)),
                std::string(" is undefined")),
            logText));
  }
  ccxt::any ts = ::getValue(entry, keyNameOrIndex);
  assertTrue(isTrue(!isEqual(ts, ccxt::any{})) || isTrue(allowNull),
             add(std::string("timestamp is null"), logText));
  if (isTrue(!isEqual(ts, ccxt::any{}))) {
    assertTrue(isNumber(ts),
               add(std::string("timestamp is not numeric"), logText));
    assertTrue(isInteger(ts),
               add(std::string("timestamp should be an integer"), logText));
    ccxt::any minTs = 1230940800000; // 03 Jan 2009 - first block
    ccxt::any maxTs = 2147483648000; // 19 Jan 2038 - max int
    assertTrue(isGreaterThan(ts, minTs),
               add(add(add(std::string("timestamp is impossible to be before "),
                           toString(minTs)),
                       std::string(" (03.01.2009)")),
                   logText)); // 03 Jan 2009 - first block
    assertTrue(
        isLessThan(ts, maxTs),
        add(add(add(std::string("timestamp more than "), toString(maxTs)),
                std::string(" (19.01.2038)")),
            logText)); // 19 Jan 2038 - int32 overflows // 7258118400000  -> Jan
                       // 1 2200
    if (isTrue(!isEqual(nowToCheck, ccxt::any{}))) {
      ccxt::any maxMsOffset = 60000; // 1 min
      assertTrue(
          isLessThan(ts, add(nowToCheck, maxMsOffset)),
          add(add(add(add(add(std::string("returned item timestamp ("),
                              callDynamically(exchange, std::string("iso8601"),
                                              ccxt::list{ts})),
                          std::string(") is ahead of the current time (")),
                      callDynamically(exchange, std::string("iso8601"),
                                      ccxt::list{nowToCheck})),
                  std::string(")")),
              logText));
    }
  }
}

void assertTimestampAndDatetime(
    ccxt::any exchange, ccxt::any skippedProperties, ccxt::any method,
    ccxt::any entry, ccxt::any nowToCheck = ccxt::any{},
    ccxt::any keyNameOrIndex = std::string("timestamp"),
    ccxt::any allowNull = true) {
  ccxt::any logText = logTemplate(exchange, method, entry);
  ccxt::any skipValue =
      callDynamically(exchange, std::string("safeValue"),
                      ccxt::list{skippedProperties, keyNameOrIndex});
  if (isTrue(!isEqual(skipValue, ccxt::any{}))) {
    return;
  }
  assertTimestamp(exchange, skippedProperties, method, entry, nowToCheck,
                  keyNameOrIndex);
  ccxt::any isDateTimeObject = isString(keyNameOrIndex);
  // only in case if the entry is a dictionary, thus it must have 'timestamp' &
  // 'datetime' string keys
  if (isTrue(isDateTimeObject)) {
    // we also test 'datetime' here because it's certain sibling of 'timestamp'
    assertTrue((inOp(entry, std::string("datetime"))),
               add(std::string("\"datetime\" key is missing from structure"),
                   logText));
    ccxt::any dt = ::getValue(entry, std::string("datetime"));
    assertTrue(isTrue(!isEqual(dt, ccxt::any{})) || isTrue(allowNull),
               add(std::string("timestamp is null"), logText));
    if (isTrue(!isEqual(dt, ccxt::any{}))) {
      assertTrue(
          isString(dt),
          add(std::string("\"datetime\" key does not have a string value"),
              logText));
      // there are exceptional cases, like getting microsecond-targeted string
      // '2022-08-08T22:03:19.014680Z', so parsed unified timestamp, which
      // carries only 13 digits (millisecond precision) can not be stringified
      // back to microsecond accuracy, causing the bellow assertion to fail
      //    assertTrue(dt === callDynamically(exchange, std::string("iso8601"),
      //    ccxt::list{entry['timestamp']}))
      // so, we have to compare with millisecond accururacy
      ccxt::any dtParsed =
          callDynamically(exchange, std::string("parse8601"), ccxt::list{dt});
      ccxt::any tsMs = ::getValue(entry, std::string("timestamp"));
      if (isTrue(isEqual(dtParsed, ccxt::any{}))) {
        assertTrue(
            false,
            add(add(std::string("datetime is not parseable: "), dt), logText));
      }
      ccxt::any diff = mathAbs(subtract(dtParsed, tsMs));
      if (isTrue(isGreaterThanOrEqual(diff, 500))) {
        ccxt::any dtParsedString = callDynamically(
            exchange, std::string("iso8601"), ccxt::list{dtParsed});
        ccxt::any dtEntryString =
            callDynamically(exchange, std::string("iso8601"), ccxt::list{tsMs});
        assertTrue(
            false,
            add(add(add(add(add(std::string(
                                    "datetime is not iso8601 of timestamp:"),
                                dtParsedString),
                            std::string("(string) != ")),
                        dtEntryString),
                    std::string("(from ts)")),
                logText));
      }
    }
  }
}

void assertCurrencyCode(ccxt::any exchange, ccxt::any skippedProperties,
                        ccxt::any method, ccxt::any entry, ccxt::any actualCode,
                        ccxt::any expectedCode = ccxt::any{},
                        ccxt::any allowNull = true) {
  if (isTrue(isTrue((inOp(skippedProperties, std::string("currency")))) ||
             isTrue((
                 inOp(skippedProperties, std::string("currencyIdAndCode")))))) {
    return;
  }
  ccxt::any logText = logTemplate(exchange, method, entry);
  assertTrue(isTrue(!isEqual(actualCode, ccxt::any{})) || isTrue(allowNull),
             add(std::string("currency code is null"), logText));
  if (isTrue(!isEqual(actualCode, ccxt::any{}))) {
    assertTrue(
        isString(actualCode),
        add(std::string("currency code should be either undefined or a string"),
            logText));
    assertTrue(
        (inOp(getProperty(exchange, std::string("currencies")), actualCode)),
        add(add(add(std::string("currency code (\""), actualCode),
                std::string("\") should be present in exchange.currencies")),
            logText));
    if (isTrue(!isEqual(expectedCode, ccxt::any{}))) {
      assertTrue(
          isEqual(actualCode, expectedCode),
          add(add(add(add(add(std::string("currency code in response (\""),
                              stringValue(actualCode)),
                          std::string(
                              "\") should be equal to expected code (\"")),
                      stringValue(expectedCode)),
                  std::string("\")")),
              logText));
    }
  }
}

void assertValidCurrencyIdAndCode(ccxt::any exchange,
                                  ccxt::any skippedProperties, ccxt::any method,
                                  ccxt::any entry, ccxt::any currencyId,
                                  ccxt::any currencyCode,
                                  ccxt::any allowNull = true) {
  // this is exclusive exceptional key name to be used in `skip-tests.json`, to
  // skip check for currency id and code
  if (isTrue(isTrue((inOp(skippedProperties, std::string("currency")))) ||
             isTrue((
                 inOp(skippedProperties, std::string("currencyIdAndCode")))))) {
    return;
  }
  ccxt::any logText = logTemplate(exchange, method, entry);
  ccxt::any undefinedValues = isTrue(isEqual(currencyId, ccxt::any{})) &&
                              isTrue(isEqual(currencyCode, ccxt::any{}));
  ccxt::any definedValues = isTrue(!isEqual(currencyId, ccxt::any{})) &&
                            isTrue(!isEqual(currencyCode, ccxt::any{}));
  assertTrue(isTrue(undefinedValues) || isTrue(definedValues),
             add(std::string("currencyId and currencyCode should be either "
                             "both defined or both undefined"),
                 logText));
  assertTrue(isTrue(definedValues) || isTrue(allowNull),
             add(std::string("currency code and id is not defined"), logText));
  if (isTrue(definedValues)) {
    // check by code
    ccxt::any currencyByCode = callDynamically(
        exchange, std::string("currency"), ccxt::list{currencyCode});
    assertTrue(
        isEqual(::getValue(currencyByCode, std::string("id")), currencyId),
        add(add(add(add(add(std::string("currencyId \""),
                            stringValue(currencyId)),
                        std::string(
                            "\" does not match currency id from instance: \"")),
                    stringValue(::getValue(currencyByCode, std::string("id")))),
                std::string("\"")),
            logText));
    // check by id
    ccxt::any currencyById = callDynamically(
        exchange, std::string("safeCurrency"), ccxt::list{currencyId});
    assertTrue(
        isEqual(::getValue(currencyById, std::string("code")), currencyCode),
        add(add(add(add(std::string("currencyCode "),
                        stringValue(currencyCode)),
                    std::string(" does not match currency of id: ")),
                stringValue(currencyId)),
            logText));
  }
}

void assertSymbol(ccxt::any exchange, ccxt::any skippedProperties,
                  ccxt::any method, ccxt::any entry, ccxt::any key,
                  ccxt::any expectedSymbol = ccxt::any{},
                  ccxt::any allowNull = true) {
  if (isTrue(inOp(skippedProperties, key))) {
    return;
  }
  ccxt::any logText = logTemplate(exchange, method, entry);
  ccxt::any actualSymbol = callDynamically(exchange, std::string("safeString"),
                                           ccxt::list{entry, key});
  if (isTrue(!isEqual(actualSymbol, ccxt::any{}))) {
    assertTrue(isString(actualSymbol),
               add(std::string("symbol should be either undefined or a string"),
                   logText));
  }
  if (isTrue(!isEqual(expectedSymbol, ccxt::any{}))) {
    assertTrue(
        isEqual(actualSymbol, expectedSymbol),
        add(add(add(add(add(std::string("symbol in response (\""),
                            stringValue(actualSymbol)),
                        std::string(
                            "\") should be equal to expected symbol (\"")),
                    stringValue(expectedSymbol)),
                std::string("\")")),
            logText));
  }
  ccxt::any definedValues = isTrue(!isEqual(actualSymbol, ccxt::any{})) &&
                            isTrue(!isEqual(expectedSymbol, ccxt::any{}));
  assertTrue(isTrue(definedValues) || isTrue(allowNull),
             add(std::string("symbols are not defined"), logText));
}

void assertSymbolInMarkets(ccxt::any exchange, ccxt::any skippedProperties,
                           ccxt::any method, ccxt::any symbol) {
  ccxt::any logText = logTemplate(exchange, method, ccxt::dict{});
  assertTrue(
      isTrue((!isEqual(getProperty(exchange, std::string("markets")),
                       ccxt::any{}))) &&
          isTrue((inOp(getProperty(exchange, std::string("markets")), symbol))),
      add(std::string("symbol should be present in exchange.symbols"),
          logText));
}

void assertGreater(ccxt::any exchange, ccxt::any skippedProperties,
                   ccxt::any method, ccxt::any entry, ccxt::any key,
                   ccxt::any compareTo, ccxt::any allowNull = true) {
  if (isTrue(inOp(skippedProperties, key))) {
    return;
  }
  ccxt::any logText = logTemplate(exchange, method, entry);
  ccxt::any value = callDynamically(exchange, std::string("safeString"),
                                    ccxt::list{entry, key});
  assertTrue(isTrue(!isEqual(value, ccxt::any{})) || isTrue(allowNull),
             add(std::string("value is null"), logText));
  if (isTrue(!isEqual(value, ccxt::any{}))) {
    assertTrue(ccxt::Precise::stringGt(value, compareTo),
               add(add(add(add(add(stringValue(key),
                                   std::string(" key (with a value of ")),
                               stringValue(value)),
                           std::string(") was expected to be > ")),
                       stringValue(compareTo)),
                   logText));
  }
}

