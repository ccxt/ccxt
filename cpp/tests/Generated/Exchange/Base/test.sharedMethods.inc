    callDynamically(exchange, std::string("setProperty"), ccxt::list{exchange, std::string("proxyUrl"), std::any{}});
    callDynamically(exchange, std::string("setProperty"), ccxt::list{exchange, std::string("proxy_url"), std::any{}});
