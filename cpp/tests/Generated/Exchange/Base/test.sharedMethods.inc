std::any concat(std::any a = std::any{}, std::any b = std::any{})
{
    // we use this method temporarily, because of ast-transpiler issue across langs
    if (isTrue(isEqual(a, std::any{})))
    {
        return b;
    } else if (isTrue(isEqual(b, std::any{})))
    {
        return a;
    } else
    {
        std::any result = ccxt::list{};
        for (std::any i = 0; isLessThan(i, getArrayLength(a)); postFixIncrement(i))
        {
            arrayPush(result, ::getValue(a, i));
        }
        for (std::any j = 0; isLessThan(j, getArrayLength(b)); postFixIncrement(j))
        {
            arrayPush(result, ::getValue(b, j));
        }
        return result;
    }
}

void assertDictionaryResponse(std::any exchange, std::any method, std::any response, std::any hint = std::any{})
{
    // php cannot distinguish an empty dict from an empty list, both are a plain array
    // there, so an empty array response is shape indeterminate and accepted, observed
    // as false positive FAILs in the live tests on https://github.com/ccxt/ccxt/pull/29696
    std::any isEmptyArrayResponse = false;
    if (isTrue(isArray(response)))
    {
        std::any responseLength = getArrayLength(response);
        isEmptyArrayResponse = (isEqual(responseLength, 0));
    }
    std::any hintText = std::string("");
    if (isTrue(!isEqual(hint, std::any{})))
    {
        hintText = add(std::string(" "), hint);
    }
    assertTrue(isTrue(callDynamically(exchange, std::string("isDictionary"), ccxt::list{response})) || isTrue(isEmptyArrayResponse), add(add(add(add(add(getProperty(exchange, std::string("id")), std::string(" ")), method), hintText), std::string(" must return a dict. ")), callDynamically(exchange, std::string("json"), ccxt::list{response})));
}

