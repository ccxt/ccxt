// PLEASE DO NOT EDIT THIS FILE, IT IS GENERATED AND WILL BE OVERWRITTEN:
// https://github.com/ccxt/ccxt/blob/master/CONTRIBUTING.md#how-to-contribute-code
void testCurrency(std::any exchange, std::any skippedProperties, std::any method, std::any entry)
{
    if (isTrue(isEqual(entry, std::any{})))
    {
        return;
    }
    std::any format = ccxt::dict {
        { std::string("id"), std::string("btc") },
        { std::string("code"), std::string("BTC") },
    };
    // todo: remove fee from empty
    std::any emptyAllowedFor = ccxt::list{std::string("name"), std::string("fee")};
    // todo: info key needs to be added in base, when exchange does not have fetchCurrencies
    std::any isNative = isTrue(isTrue((!isEqual(::getValue(getProperty(exchange, std::string("has")), std::string("fetchCurrencies")), std::any{}))) && isTrue((!isEqual(::getValue(getProperty(exchange, std::string("has")), std::string("fetchCurrencies")), false)))) && isTrue((!isEqual(::getValue(getProperty(exchange, std::string("has")), std::string("fetchCurrencies")), std::string("emulated"))));
    std::any currencyType = callDynamically(exchange, std::string("safeString"), ccxt::list{entry, std::string("type")});
    if (isTrue(isEqual(isNative, true)))
    {
        ::setValue(format, std::string("info"), ccxt::dict {});
        // todo: 'name': 'Bitcoin', // uppercase string, base currency, 2 or more letters
        ::setValue(format, std::string("withdraw"), true); // withdraw enabled
        ::setValue(format, std::string("deposit"), true); // deposit enabled
        ::setValue(format, std::string("precision"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("0.0001")})); // in case of SIGNIFICANT_DIGITS it will be 4 - number of digits "after the dot"
        ::setValue(format, std::string("fee"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("0.001")}));
        ::setValue(format, std::string("networks"), ccxt::dict {});
        ::setValue(format, std::string("limits"), ccxt::dict {
    { std::string("withdraw"), ccxt::dict {
        { std::string("min"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("0.01")}) },
        { std::string("max"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1000")}) },
    } },
    { std::string("deposit"), ccxt::dict {
        { std::string("min"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("0.01")}) },
        { std::string("max"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1000")}) },
    } },
});
        ::setValue(format, std::string("type"), std::string("crypto")); // crypto, fiat, leverage, other
        assertInArray(exchange, skippedProperties, method, entry, std::string("type"), ccxt::list{std::string("fiat"), std::string("crypto"), std::string("leveraged"), std::string("other"), std::any{}}); // todo: remove std::any{}
        // only require "deposit" & "withdraw" values, when currency is not fiat, or when it's fiat, but not skipped
        if (isTrue(isTrue(!isEqual(currencyType, std::string("crypto"))) && isTrue((inOp(skippedProperties, std::string("depositForNonCrypto"))))))
        {
            arrayPush(emptyAllowedFor, std::string("deposit"));
        }
        if (isTrue(isTrue(!isEqual(currencyType, std::string("crypto"))) && isTrue((inOp(skippedProperties, std::string("withdrawForNonCrypto"))))))
        {
            arrayPush(emptyAllowedFor, std::string("withdraw"));
        }
        if (isTrue(isTrue(isEqual(currencyType, std::string("leveraged"))) || isTrue(isEqual(currencyType, std::string("other")))))
        {
            arrayPush(emptyAllowedFor, std::string("precision"));
        }
    }
    //
    assertCurrencyCode(exchange, skippedProperties, method, entry, ::getValue(entry, std::string("code")));
    // check if empty networks should be skipped
    std::any networks = callDynamically(exchange, std::string("safeDict"), ccxt::list{entry, std::string("networks"), ccxt::dict {}});
    std::any networkKeys = getObjectKeys(networks);
    std::any networkKeysLength = getArrayLength(networkKeys);
    if (isTrue(isTrue(isEqual(networkKeysLength, 0)) && isTrue((inOp(skippedProperties, std::string("skipCurrenciesWithoutNetworks"))))))
    {
        return;
    }
    try
    {
        assertStructure(exchange, skippedProperties, method, entry, format, emptyAllowedFor);
    } catch(const std::exception& e)
    {
        std::any message = callDynamically(exchange, std::string("exceptionMessage"), ccxt::list{e});
        // check structure if key is numeric, not string
        if (isTrue(isGreaterThanOrEqual(getIndexOf(message, std::string("\"id\" key")), 0)))
        {
            // @ts-ignore
            ::setValue(format, std::string("id"), 123);
            assertStructure(exchange, skippedProperties, method, entry, format, emptyAllowedFor);
        } else
        {
            assertTrue(isEqual(message, std::string("")), message);
        }
    }
    //
    checkPrecisionAccuracy(exchange, skippedProperties, method, entry, std::string("precision"));
    assertGreaterOrEqual(exchange, skippedProperties, method, entry, std::string("fee"), std::string("0"));
    if (!isTrue((inOp(skippedProperties, std::string("limits")))))
    {
        std::any limits = callDynamically(exchange, std::string("safeValue"), ccxt::list{entry, std::string("limits"), ccxt::dict {}});
        std::any withdrawLimits = callDynamically(exchange, std::string("safeValue"), ccxt::list{limits, std::string("withdraw"), ccxt::dict {}});
        std::any depositLimits = callDynamically(exchange, std::string("safeValue"), ccxt::list{limits, std::string("deposit"), ccxt::dict {}});
        assertGreaterOrEqual(exchange, skippedProperties, method, withdrawLimits, std::string("min"), std::string("0"));
        assertGreaterOrEqual(exchange, skippedProperties, method, withdrawLimits, std::string("max"), std::string("0"));
        assertGreaterOrEqual(exchange, skippedProperties, method, depositLimits, std::string("min"), std::string("0"));
        assertGreaterOrEqual(exchange, skippedProperties, method, depositLimits, std::string("max"), std::string("0"));
        // max should be more than min (withdrawal limits)
        std::any minStringWithdrawal = callDynamically(exchange, std::string("safeString"), ccxt::list{withdrawLimits, std::string("min")});
        if (isTrue(!isEqual(minStringWithdrawal, std::any{})))
        {
            assertGreaterOrEqual(exchange, skippedProperties, method, withdrawLimits, std::string("max"), minStringWithdrawal);
        }
        // max should be more than min (deposit limits)
        std::any minStringDeposit = callDynamically(exchange, std::string("safeString"), ccxt::list{depositLimits, std::string("min")});
        if (isTrue(!isEqual(minStringDeposit, std::any{})))
        {
            assertGreaterOrEqual(exchange, skippedProperties, method, depositLimits, std::string("max"), minStringDeposit);
        }
        // check valid ID & CODE
        assertValidCurrencyIdAndCode(exchange, skippedProperties, method, entry, ::getValue(entry, std::string("id")), ::getValue(entry, std::string("code")));
    }
}
