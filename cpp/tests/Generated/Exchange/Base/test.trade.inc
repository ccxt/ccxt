// PLEASE DO NOT EDIT THIS FILE, IT IS GENERATED AND WILL BE OVERWRITTEN:
// https://github.com/ccxt/ccxt/blob/master/CONTRIBUTING.md#how-to-contribute-code
void testTrade(std::any exchange, std::any skippedProperties, std::any method,
               std::any entry, std::any symbol, std::any now) {
  // prediction-market structures are keyed by an outcome handle, not a
  // `symbol`, and the PredictionTrade type carries a single `fee` but omits the
  // `fees` list entirely
  if (isTrue(
          callDynamically(exchange, std::string("safeBool"),
                          ccxt::list{getProperty(exchange, std::string("has")),
                                     std::string("prediction"), false}))) {
    skippedProperties =
        callDynamically(exchange, std::string("extend"),
                        ccxt::list{ccxt::dict{
                                       {std::string("symbol"), true},
                                       {std::string("fees"), true},
                                   },
                                   skippedProperties});
  }
  std::any format = ccxt::dict{
      {std::string("info"), ccxt::dict{}},
      {std::string("id"), std::string("12345-67890:09876/54321")},
      {std::string("timestamp"), 1502962946216},
      {std::string("datetime"), std::string("2017-08-17 12:42:48.000")},
      {std::string("symbol"), std::string("ETH/BTC")},
      {std::string("order"), std::string("12345-67890:09876/54321")},
      {std::string("side"), std::string("buy")},
      {std::string("takerOrMaker"), std::string("taker")},
      {std::string("price"),
       callDynamically(exchange, std::string("parseNumber"),
                       ccxt::list{std::string("0.06917684")})},
      {std::string("amount"),
       callDynamically(exchange, std::string("parseNumber"),
                       ccxt::list{std::string("1.5")})},
      {std::string("cost"),
       callDynamically(exchange, std::string("parseNumber"),
                       ccxt::list{std::string("0.10376526")})},
      {std::string("fees"), ccxt::list{}},
      {std::string("fee"),
       ccxt::dict{
           {std::string("cost"),
            callDynamically(exchange, std::string("parseNumber"),
                            ccxt::list{std::string("0.001")})},
           {std::string("currency"), std::string("USDT")},
       }},
  };
  // todo: add takeOrMaker as mandatory (atm, many exchanges fail)
  // removed side because some public endpoints return trades without side
  std::any emptyAllowedFor = ccxt::list{
      std::string("fees"),  std::string("fee"), std::string("symbol"),
      std::string("order"), std::string("id"),  std::string("takerOrMaker")};
  assertStructure(exchange, skippedProperties, method, entry, format,
                  emptyAllowedFor);
  assertTimestampAndDatetime(exchange, skippedProperties, method, entry, now);
  assertSymbol(exchange, skippedProperties, method, entry,
               std::string("symbol"), symbol);
  //
  assertInArray(exchange, skippedProperties, method, entry, std::string("side"),
                ccxt::list{std::string("buy"), std::string("sell")});
  assertInArray(exchange, skippedProperties, method, entry,
                std::string("takerOrMaker"),
                ccxt::list{std::string("taker"), std::string("maker")});
  assertFeeStructure(exchange, skippedProperties, method, entry,
                     std::string("fee"));
  if (!isTrue((inOp(skippedProperties, std::string("fees"))))) {
    // todo: remove std::any{} check and probably non-empty array check later
    if (isTrue(!isEqual(::getValue(entry, std::string("fees")), std::any{}))) {
      for (std::any i = 0; isLessThan(
               i, getArrayLength(::getValue(entry, std::string("fees"))));
           postFixIncrement(i)) {
        assertFeeStructure(exchange, skippedProperties, method,
                           ::getValue(entry, std::string("fees")), i);
      }
    }
  }
}
