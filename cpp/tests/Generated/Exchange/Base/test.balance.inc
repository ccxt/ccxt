void testBalance(std::any exchange, std::any skippedProperties, std::any method,
                 std::any entry) {
  std::any format = ccxt::dict{
      {std::string("free"), ccxt::dict{}},
      {std::string("used"), ccxt::dict{}},
      {std::string("total"), ccxt::dict{}},
      {std::string("info"), ccxt::dict{}},
  };
  assertStructure(exchange, skippedProperties, method, entry, format);
  std::any logText = logTemplate(exchange, method, entry);
  //
  std::any codesTotal = getObjectKeys(::getValue(entry, std::string("total")));
  std::any codesFree = getObjectKeys(::getValue(entry, std::string("free")));
  std::any codesUsed = getObjectKeys(::getValue(entry, std::string("used")));
  assertNonEmtpyArray(exchange, skippedProperties, method, codesTotal,
                      std::string("total"));
  assertNonEmtpyArray(exchange, skippedProperties, method, codesFree,
                      std::string("free"));
  assertNonEmtpyArray(exchange, skippedProperties, method, codesUsed,
                      std::string("used"));
  std::any allCodes = callDynamically(exchange, std::string("arrayConcat"),
                                      ccxt::list{codesTotal, codesFree});
  allCodes = callDynamically(exchange, std::string("arrayConcat"),
                             ccxt::list{allCodes, codesUsed});
  std::any codesLength = getArrayLength(codesTotal);
  std::any freeLength = getArrayLength(codesFree);
  std::any usedLength = getArrayLength(codesUsed);
  assertTrue(
      isTrue((isEqual(codesLength, freeLength))) ||
          isTrue((isEqual(codesLength, usedLength))),
      add(std::string("free and total and used codes have different lengths"),
          logText));
  for (std::any i = 0; isLessThan(i, getArrayLength(allCodes));
       postFixIncrement(i)) {
    std::any code = ::getValue(allCodes, i);
    // assertCurrencyCode (exchange, skippedProperties, method, entry, code);
    assertTrue(
        inOp(::getValue(entry, std::string("total")), code),
        add(add(add(std::string("code "), code), std::string(" not in total")),
            logText));
    assertTrue(
        inOp(::getValue(entry, std::string("free")), code),
        add(add(add(std::string("code "), code), std::string(" not in free")),
            logText));
    assertTrue(
        inOp(::getValue(entry, std::string("used")), code),
        add(add(add(std::string("code "), code), std::string(" not in used")),
            logText));
    std::any total = callDynamically(
        exchange, std::string("safeString"),
        ccxt::list{::getValue(entry, std::string("total")), code});
    std::any free = callDynamically(
        exchange, std::string("safeString"),
        ccxt::list{::getValue(entry, std::string("free")), code});
    std::any used = callDynamically(
        exchange, std::string("safeString"),
        ccxt::list{::getValue(entry, std::string("used")), code});
    assertTrue(!isEqual(total, std::any{}),
               add(std::string("total is undefined"), logText));
    assertTrue(!isEqual(free, std::any{}),
               add(std::string("free is undefined"), logText));
    assertTrue(!isEqual(used, std::any{}),
               add(std::string("used is undefined"), logText));
    assertTrue(ccxt::Precise::stringGe(total, std::string("0")),
               add(std::string("total is not positive"), logText));
    assertTrue(ccxt::Precise::stringGe(free, std::string("0")),
               add(std::string("free is not positive"), logText));
    assertTrue(ccxt::Precise::stringGe(used, std::string("0")),
               add(std::string("used is not positive"), logText));
    std::any sumFreeUsed = ccxt::Precise::stringAdd(free, used);
    assertTrue(ccxt::Precise::stringEq(total, sumFreeUsed),
               add(std::string("free and used do not sum to total"), logText));
  }
}
