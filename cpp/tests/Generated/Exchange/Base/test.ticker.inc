// PLEASE DO NOT EDIT THIS FILE, IT IS GENERATED AND WILL BE OVERWRITTEN:
// https://github.com/ccxt/ccxt/blob/master/CONTRIBUTING.md#how-to-contribute-code
void testTicker(std::any exchange, std::any skippedProperties, std::any method, std::any entry, std::any symbol)
{
    // prediction outcomes are keyed by an outcome handle (not a `symbol`) and trade thin 0..1
    // books where bid==ask and a stale `last` far from the median are normal — skip the
    // crypto-oriented price-relationship checks for them. the PredictionTicker type also
    // omits vwap/previousClose entirely, so their presence must not be asserted
    if (isTrue(callDynamically(exchange, std::string("safeBool"), ccxt::list{getProperty(exchange, std::string("has")), std::string("prediction"), false})))
    {
        skippedProperties = callDynamically(exchange, std::string("extend"), ccxt::list{ccxt::dict {
            { std::string("symbol"), true },
            { std::string("spread"), true },
            { std::string("lastBetweenBidAsk"), true },
            { std::string("maxIncrease"), true },
            { std::string("vwap"), true },
            { std::string("previousClose"), true },
        }, skippedProperties});
    }
    std::any format = ccxt::dict {
        { std::string("info"), ccxt::dict {} },
        { std::string("symbol"), std::string("ETH/BTC") },
        { std::string("timestamp"), 1502962946216 },
        { std::string("datetime"), std::string("2017-09-01T00:00:00") },
        { std::string("high"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.234")}) },
        { std::string("low"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.234")}) },
        { std::string("bid"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.234")}) },
        { std::string("bidVolume"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.234")}) },
        { std::string("ask"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.234")}) },
        { std::string("askVolume"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.234")}) },
        { std::string("vwap"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.234")}) },
        { std::string("open"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.234")}) },
        { std::string("close"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.234")}) },
        { std::string("last"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.234")}) },
        { std::string("previousClose"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.234")}) },
        { std::string("change"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.234")}) },
        { std::string("percentage"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.234")}) },
        { std::string("average"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.234")}) },
        { std::string("baseVolume"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.234")}) },
        { std::string("quoteVolume"), callDynamically(exchange, std::string("parseNumber"), ccxt::list{std::string("1.234")}) },
    };
    // todo: atm, many exchanges fail, so temporarily decrease stict mode
    std::any emptyAllowedFor = ccxt::list{std::string("timestamp"), std::string("datetime"), std::string("open"), std::string("high"), std::string("low"), std::string("close"), std::string("last"), std::string("baseVolume"), std::string("quoteVolume"), std::string("previousClose"), std::string("bidVolume"), std::string("askVolume"), std::string("vwap"), std::string("change"), std::string("percentage"), std::string("average")};
    // trick csharp-transpiler for string
    if (!isTrue((includes(toString(method), std::string("BidsAsks")))))
    {
        arrayPush(emptyAllowedFor, std::string("bid"));
        arrayPush(emptyAllowedFor, std::string("ask"));
    }
    assertStructure(exchange, skippedProperties, method, entry, format, emptyAllowedFor);
    assertTimestampAndDatetime(exchange, skippedProperties, method, entry);
    std::any logText = logTemplate(exchange, method, entry);
    // check market
    std::any market = std::any{};
    std::any isUnrecognizedSymbol = false;
    std::any isFetchTickerCalled = isEqual(method, std::string("fetchTicker"));
    std::any symbolForMarket = (isTrue((!isEqual(symbol, std::any{}))) ? std::any(symbol) : std::any(callDynamically(exchange, std::string("safeString"), ccxt::list{entry, std::string("symbol")})));
    if (isTrue(!isEqual(symbolForMarket, std::any{})))
    {
        if (isTrue(isTrue((!isEqual(getProperty(exchange, std::string("markets")), std::any{}))) && isTrue((inOp(getProperty(exchange, std::string("markets")), symbolForMarket)))))
        {
            market = callDynamically(exchange, std::string("market"), ccxt::list{symbolForMarket});
        } else
        {
            isUnrecognizedSymbol = true;
        }
    }
    // temp todo: skip inactive markets for now, as they sometimes have weird values and causing issues:
    if (!isTrue((inOp(skippedProperties, std::string("checkInactiveMarkets")))))
    {
        if (isTrue(isTrue(!isEqual(market, std::any{})) && isTrue(isEqual(::getValue(market, std::string("active")), false))))
        {
            return;
        }
    }
    if (isTrue(inOp(skippedProperties, std::string("skipNonActiveMarkets"))))
    {
        if (isTrue(isTrue(isEqual(market, std::any{})) || isTrue((!isEqual(::getValue(market, std::string("active")), true)))))
        {
            return;
        }
    }
    // only check "above zero" values if exchange is not supposed to have exotic index markets
    std::any isStandardMarket = (isTrue(!isEqual(market, std::any{})) && isTrue(callDynamically(exchange, std::string("inArray"), ccxt::list{::getValue(market, std::string("type")), ccxt::list{std::string("spot"), std::string("swap"), std::string("future"), std::string("option")}})));
    std::any valuesShouldBePositive = isStandardMarket; // || (market === std::any{}) atm, no check for index markets
    if (isTrue(isTrue(valuesShouldBePositive) && !isTrue((inOp(skippedProperties, std::string("positiveValues"))))))
    {
        assertGreater(exchange, skippedProperties, method, entry, std::string("open"), std::string("0"));
        assertGreater(exchange, skippedProperties, method, entry, std::string("high"), std::string("0"));
        assertGreater(exchange, skippedProperties, method, entry, std::string("low"), std::string("0"));
        assertGreater(exchange, skippedProperties, method, entry, std::string("close"), std::string("0"));
        assertGreater(exchange, skippedProperties, method, entry, std::string("ask"), std::string("0"));
        assertGreater(exchange, skippedProperties, method, entry, std::string("bid"), std::string("0"));
        assertGreater(exchange, skippedProperties, method, entry, std::string("average"), std::string("0"));
        assertGreaterOrEqual(exchange, skippedProperties, method, entry, std::string("vwap"), std::string("0"));
    }
    // volume can not be negative
    assertGreaterOrEqual(exchange, skippedProperties, method, entry, std::string("askVolume"), std::string("0"));
    assertGreaterOrEqual(exchange, skippedProperties, method, entry, std::string("bidVolume"), std::string("0"));
    assertGreaterOrEqual(exchange, skippedProperties, method, entry, std::string("baseVolume"), std::string("0"));
    assertGreaterOrEqual(exchange, skippedProperties, method, entry, std::string("quoteVolume"), std::string("0"));
    //
    // close price
    //
    std::any lastString = callDynamically(exchange, std::string("safeString"), ccxt::list{entry, std::string("last")});
    std::any closeString = callDynamically(exchange, std::string("safeString"), ccxt::list{entry, std::string("close")});
    assertTrue(isTrue((isTrue((isEqual(closeString, std::any{}))) && isTrue((isEqual(lastString, std::any{}))))) || isTrue(ccxt::Precise::stringEq(lastString, closeString)), add(std::string("`last` != `close`"), logText));
    std::any openPrice = callDynamically(exchange, std::string("safeString"), ccxt::list{entry, std::string("open")});
    //
    // base & quote volumes
    //
    std::any baseVolume = callDynamically(exchange, std::string("omitZero"), ccxt::list{callDynamically(exchange, std::string("safeString"), ccxt::list{entry, std::string("baseVolume")})});
    std::any quoteVolume = callDynamically(exchange, std::string("omitZero"), ccxt::list{callDynamically(exchange, std::string("safeString"), ccxt::list{entry, std::string("quoteVolume")})});
    std::any high = callDynamically(exchange, std::string("omitZero"), ccxt::list{callDynamically(exchange, std::string("safeString"), ccxt::list{entry, std::string("high")})});
    std::any low = callDynamically(exchange, std::string("omitZero"), ccxt::list{callDynamically(exchange, std::string("safeString"), ccxt::list{entry, std::string("low")})});
    std::any open = callDynamically(exchange, std::string("omitZero"), ccxt::list{callDynamically(exchange, std::string("safeString"), ccxt::list{entry, std::string("open")})});
    std::any close = callDynamically(exchange, std::string("omitZero"), ccxt::list{callDynamically(exchange, std::string("safeString"), ccxt::list{entry, std::string("close")})});
    if (!isTrue((inOp(skippedProperties, std::string("compareQuoteVolumeBaseVolume")))))
    {
        // assertTrue(baseVolumeDefined === quoteVolumeDefined, 'baseVolume or quoteVolume should be either both defined or both std::any{}' + logText); // No, exchanges might not report both values
        // skip the quoteVolume/baseVolume identity for inverse (coin-margined) contracts: their
        // volumes carry contract-denominated units (e.g. binance DOGEUSD_PERP reports quoteVolume
        // far above baseVolume * high), so the spot-derived invariant does not hold there,
        // see https://github.com/ccxt/ccxt/pull/29563
        std::any isInverse = callDynamically(exchange, std::string("safeBool"), ccxt::list{market, std::string("inverse"), false});
        if (isTrue(isTrue(isTrue(isTrue(isTrue((!isEqual(baseVolume, std::any{}))) && isTrue((!isEqual(quoteVolume, std::any{})))) && isTrue((!isEqual(high, std::any{})))) && isTrue((!isEqual(low, std::any{})))) && isTrue((!isEqual(isInverse, true)))))
        {
            std::any baseLow = ccxt::Precise::stringMul(baseVolume, low);
            std::any baseHigh = ccxt::Precise::stringMul(baseVolume, high);
            // to avoid abnormal long precision issues (like https://discord.com/channels/690203284119617602/1338828283902689280/1338846071278927912 )
            std::any mPrecision = callDynamically(exchange, std::string("safeDict"), ccxt::list{market, std::string("precision")});
            std::any amountPrecision = callDynamically(exchange, std::string("safeString"), ccxt::list{mPrecision, std::string("amount")});
            std::any tolerance = std::string("1.0001");
            if (isTrue(!isEqual(amountPrecision, std::any{})))
            {
                baseLow = ccxt::Precise::stringMul(ccxt::Precise::stringSub(baseVolume, amountPrecision), low);
                baseHigh = ccxt::Precise::stringMul(ccxt::Precise::stringAdd(baseVolume, amountPrecision), high);
            } else
            {
                // if nothing found, as an exclusion, just add 0.001%
                baseLow = ccxt::Precise::stringMul(ccxt::Precise::stringDiv(baseVolume, tolerance), low);
                baseHigh = ccxt::Precise::stringMul(ccxt::Precise::stringMul(baseVolume, tolerance), high);
            }
            // because of exchange engines might not rounding numbers propertly, we add some tolerance of calculated 24hr high/low
            baseLow = ccxt::Precise::stringDiv(baseLow, tolerance);
            baseHigh = ccxt::Precise::stringMul(baseHigh, tolerance);
            // some exchanges round quoteVolume before reporting it - aster,
            // for example, returns 8.07 when the true traded value is 8.0651,
            // which on micro-price contracts (1000WOJAK etc) is enough to
            // break the quoteVolume <= baseVolume * high sanity check below.
            // the reported string reveals its own rounding step (trailing
            // zeros are padding, so 8.07000000 -> 2 real decimals -> step
            // 0.01), so we widen the acceptance window by one such step on
            // each side - big enough to forgive rounding, far too small to
            // hide a real bug like mismatched units or a wrong-field parse
            std::any quoteVolumeDecimals = callDynamically(exchange, std::string("precisionFromString"), ccxt::list{quoteVolume});
            std::any quoteQuantum = callDynamically(exchange, std::string("parsePrecision"), ccxt::list{callDynamically(exchange, std::string("numberToString"), ccxt::list{quoteVolumeDecimals})});
            baseLow = ccxt::Precise::stringSub(baseLow, quoteQuantum);
            baseHigh = ccxt::Precise::stringAdd(baseHigh, quoteQuantum);
            assertTrue(ccxt::Precise::stringGe(quoteVolume, baseLow), add(std::string("quoteVolume should be => baseVolume * low"), logText));
            assertTrue(ccxt::Precise::stringLe(quoteVolume, baseHigh), add(std::string("quoteVolume should be <= baseVolume * high"), logText));
        }
    }
    // open and close should be between High & Low
    if (isTrue(isTrue(isTrue(!isEqual(high, std::any{})) && isTrue(!isEqual(low, std::any{}))) && !isTrue((inOp(skippedProperties, std::string("compareOHLC"))))))
    {
        if (isTrue(!isEqual(open, std::any{})))
        {
            assertTrue(ccxt::Precise::stringGe(open, low), add(std::string("open should be >= low"), logText));
            assertTrue(ccxt::Precise::stringLe(open, high), add(std::string("open should be <= high"), logText));
        }
        if (isTrue(!isEqual(close, std::any{})))
        {
            assertTrue(ccxt::Precise::stringGe(close, low), add(std::string("close should be >= low"), logText));
            assertTrue(ccxt::Precise::stringLe(close, high), add(std::string("close should be <= high"), logText));
        }
    }
    //
    // vwap
    //
    std::any vwap = callDynamically(exchange, std::string("safeString"), ccxt::list{entry, std::string("vwap")});
    if (isTrue(!isEqual(vwap, std::any{})))
    {
        // todo
        // assertTrue(high !== std::any{}, 'vwap is defined, but high is not' + logText);
        // assertTrue(low !== std::any{}, 'vwap is defined, but low is not' + logText);
        // assertTrue(vwap >= low && vwap <= high)
        // todo: calc compare
        assertTrue(!isTrue(valuesShouldBePositive) || isTrue(ccxt::Precise::stringGe(vwap, std::string("0"))), add(std::string("vwap is not greater than zero"), logText));
        if (isTrue(!isEqual(baseVolume, std::any{})))
        {
            assertTrue(!isEqual(quoteVolume, std::any{}), add(std::string("baseVolume & vwap is defined, but quoteVolume is not"), logText));
        }
        if (isTrue(!isEqual(quoteVolume, std::any{})))
        {
            assertTrue(!isEqual(baseVolume, std::any{}), add(std::string("quoteVolume & vwap is defined, but baseVolume is not"), logText));
        }
    }
    std::any askString = callDynamically(exchange, std::string("safeString"), ccxt::list{entry, std::string("ask")});
    std::any bidString = callDynamically(exchange, std::string("safeString"), ccxt::list{entry, std::string("bid")});
    if (isTrue(isTrue(isTrue((!isEqual(askString, std::any{}))) && isTrue((!isEqual(bidString, std::any{})))) && !isTrue((inOp(skippedProperties, std::string("spread"))))))
    {
        // greater-or-equal: a locked book (bid == ask) is legitimate on thin markets, only a crossed book (ask < bid) is anomalous
        assertGreaterOrEqual(exchange, skippedProperties, method, entry, std::string("ask"), callDynamically(exchange, std::string("safeString"), ccxt::list{entry, std::string("bid")}));
    }
    // last price should be within 1% of the bid/ask median price, but let's check only targeted fetchTicker (where tests use major pair like BTC/USDT) to ensure the precision
    std::any allowedPercentageVariation = std::string("0.01");
    if (isTrue(isTrue(isTrue(isTrue(isTrue(isFetchTickerCalled) && isTrue(!isEqual(lastString, std::any{}))) && isTrue(!isEqual(bidString, std::any{}))) && isTrue(!isEqual(askString, std::any{}))) && !isTrue((inOp(skippedProperties, std::string("lastBetweenBidAsk"))))))
    {
        std::any medianPrice = ccxt::Precise::stringDiv(ccxt::Precise::stringAdd(bidString, askString), std::string("2"));
        std::any medianLow = ccxt::Precise::stringMul(medianPrice, ccxt::Precise::stringSub(std::string("1"), allowedPercentageVariation));
        std::any medianHigh = ccxt::Precise::stringMul(medianPrice, ccxt::Precise::stringAdd(std::string("1"), allowedPercentageVariation));
        assertTrue(isTrue(ccxt::Precise::stringGe(lastString, medianLow)) && isTrue(ccxt::Precise::stringLe(lastString, medianHigh)), add(std::string("last price should be within 1% of the bid/ask median price"), logText));
    }
    std::any percentage = callDynamically(exchange, std::string("safeString"), ccxt::list{entry, std::string("percentage")});
    std::any change = callDynamically(exchange, std::string("safeString"), ccxt::list{entry, std::string("change")});
    // option markets are exempt from the UPPER percentage/change caps only:
    // expiry-day convexity makes any finite cap wrong - a formerly-OTM
    // contract moving into the money legitimately gains 1000x+ (observed: a
    // paradex call at +109055% on its expiry date, mark price equal to
    // intrinsic). the floors stay: a long option cannot lose more than its
    // premium, so percentage >= -100 and change >= -open hold for options too
    std::any isOptionMarket = callDynamically(exchange, std::string("safeBool"), ccxt::list{market, std::string("option"), false});
    if (isTrue(!isTrue((inOp(skippedProperties, std::string("maxIncrease")))) && !isTrue(isUnrecognizedSymbol)))
    {
        //
        // percentage
        //
        std::any maxIncrease = std::string("1000"); // if the increase is more than 1000x the implementation is probably wrong - the bound needs to stay above real meme-coin pumps, which routinely exceed the old 100x cap (e.g. a legitimate +50000% daily move observed on poloniex MAME/USDT)
        if (isTrue(!isEqual(percentage, std::any{})))
        {
            // - should be above -100 and (for non-options) below MAX
            assertTrue(ccxt::Precise::stringGe(percentage, std::string("-100")), add(std::string("percentage should be above -100% "), logText));
            if (isTrue(!isEqual(isOptionMarket, true)))
            {
                assertTrue(ccxt::Precise::stringLe(percentage, ccxt::Precise::stringMul(std::string("+100"), maxIncrease)), add(add(add(std::string("percentage should be below "), maxIncrease), std::string("00% ")), logText));
            }
        }
        //
        // change
        //
        std::any approxValue = callDynamically(exchange, std::string("safeStringN"), ccxt::list{entry, ccxt::list{std::string("open"), std::string("close"), std::string("average"), std::string("bid"), std::string("ask"), std::string("vwap"), std::string("previousClose")}});
        if (isTrue(!isEqual(change, std::any{})))
        {
            // - should be above -price and (for non-options) below +price*maxIncrease
            assertTrue(ccxt::Precise::stringGe(change, ccxt::Precise::stringNeg(approxValue)), add(std::string("change should be above -price "), logText));
            if (isTrue(!isEqual(isOptionMarket, true)))
            {
                assertTrue(ccxt::Precise::stringLe(change, ccxt::Precise::stringMul(approxValue, maxIncrease)), add(add(add(std::string("change should be below "), maxIncrease), std::string("x price ")), logText));
            }
        }
    }
    //
    // ensure all expected values are defined
    //
    if (isTrue(!isEqual(lastString, std::any{})))
    {
        if (isTrue(!isEqual(percentage, std::any{})))
        {
            // if one knows 'last' and 'percentage' values, then 'change', 'open' and 'average' values should be determinable.
            assertTrue(isTrue(!isEqual(openPrice, std::any{})) && isTrue(!isEqual(change, std::any{})), add(std::string("open & change should be defined if last & percentage are defined"), logText)); // todo : add average price too
        } else if (isTrue(!isEqual(change, std::any{})))
        {
            // if one knows 'last' and 'change' values, then 'percentage', 'open' and 'average' values should be determinable.
            assertTrue(isTrue(!isEqual(openPrice, std::any{})) && isTrue(!isEqual(percentage, std::any{})), add(std::string("open & percentage should be defined if last & change are defined"), logText)); // todo : add average price too
        }
    } else if (isTrue(!isEqual(openPrice, std::any{})))
    {
        if (isTrue(!isEqual(percentage, std::any{})))
        {
            // if one knows 'open' and 'percentage' values, then 'last', 'change' and 'average' values should be determinable.
            assertTrue(isTrue(!isEqual(lastString, std::any{})) && isTrue(!isEqual(change, std::any{})), add(std::string("last & change should be defined if open & percentage are defined"), logText)); // todo : add average price too
        } else if (isTrue(!isEqual(change, std::any{})))
        {
            // if one knows 'open' and 'change' values, then 'last', 'percentage' and 'average' values should be determinable.
            assertTrue(isTrue(!isEqual(lastString, std::any{})) && isTrue(!isEqual(percentage, std::any{})), add(std::string("last & percentage should be defined if open & change are defined"), logText)); // todo : add average price too
        }
    }
    //
    // todo: rethink about this
    // else {
    //    assertTrue((askString === std::any{}) && (bidString === std::any{}), 'ask & bid should be both defined or both std::any{}' + logText);
    // }
    assertSymbol(exchange, skippedProperties, method, entry, std::string("symbol"), symbol);
}
