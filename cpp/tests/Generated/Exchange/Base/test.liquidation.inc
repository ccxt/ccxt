      {std::string("price"),
       callDynamically(exchange, std::string("parseNumber"),
                       ccxt::list{std::string("1.234")})},
      {std::string("baseValue"),
       callDynamically(exchange, std::string("parseNumber"),
                       ccxt::list{std::string("1.234")})},
      {std::string("quoteValue"),
       callDynamically(exchange, std::string("parseNumber"),
                       ccxt::list{std::string("1.234")})},
      {std::string("timestamp"), 1502962946216},
      {std::string("datetime"), std::string("2017-09-01T00:00:00")},
  };
  // todo: atm, many exchanges fail, so temporarily decrease stict mode
  ccxt::any emptyAllowedFor =
