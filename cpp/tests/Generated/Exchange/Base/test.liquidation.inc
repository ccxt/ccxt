                std::string("contracts"), std::string("0"));
  assertGreater(exchange, skippedProperties, method, entry,
                std::string("contractSize"), std::string("0"));
  assertGreater(exchange, skippedProperties, method, entry,
                std::string("price"), std::string("0"));
  assertGreater(exchange, skippedProperties, method, entry,
                std::string("baseValue"), std::string("0"));
  assertGreater(exchange, skippedProperties, method, entry,
                std::string("quoteValue"), std::string("0"));
  ccxt::any contracts =
      callDynamically(exchange, std::string("safeString"),
                      ccxt::list{entry, std::string("contracts")});
  ccxt::any contractSize =
