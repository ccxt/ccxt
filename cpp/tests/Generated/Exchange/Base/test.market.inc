// PLEASE DO NOT EDIT THIS FILE, IT IS GENERATED AND WILL BE OVERWRITTEN:
// https://github.com/ccxt/ccxt/blob/master/CONTRIBUTING.md#how-to-contribute-code
void testMarket(ccxt::any exchange, ccxt::any skippedProperties,
                ccxt::any method, ccxt::any market) {
  if (isTrue(isEqual(market, ccxt::any{}))) {
    return;
  }
  ccxt::any format = ccxt::dict{
      {std::string("id"), std::string("btcusd")},
      {std::string("symbol"), std::string("BTC/USD")},
      {std::string("base"), std::string("BTC")},
      {std::string("quote"), std::string("USD")},
      {std::string("taker"),
       callDynamically(exchange, std::string("parseNumber"),
                       ccxt::list{std::string("0.0011")})},
      {std::string("maker"),
       callDynamically(exchange, std::string("parseNumber"),
                       ccxt::list{std::string("0.0009")})},
      {std::string("baseId"), std::string("btc")},
      {std::string("quoteId"), std::string("usd")},
      {std::string("active"), false},
      {std::string("type"), std::string("spot")},
      {std::string("linear"), false},
      {std::string("inverse"), false},
      {std::string("spot"), false},
      {std::string("swap"), false},
      {std::string("future"), false},
      {std::string("option"), false},
      {std::string("margin"), false},
      {std::string("contract"), false},
      {std::string("contractSize"),
       callDynamically(exchange, std::string("parseNumber"),
                       ccxt::list{std::string("0.001")})},
      {std::string("expiry"), 1656057600000},
      {std::string("expiryDatetime"), std::string("2022-06-24T08:00:00.000Z")},
      {std::string("optionType"), std::string("put")},
      {std::string("strike"),
       callDynamically(exchange, std::string("parseNumber"),
                       ccxt::list{std::string("56000")})},
      {std::string("settle"), std::string("XYZ")},
      {std::string("settleId"), std::string("Xyz")},
      {std::string("precision"),
       ccxt::dict{
           {std::string("price"),
            callDynamically(exchange, std::string("parseNumber"),
                            ccxt::list{std::string("0.001")})},
           {std::string("amount"),
            callDynamically(exchange, std::string("parseNumber"),
                            ccxt::list{std::string("0.001")})},
           {std::string("cost"),
            callDynamically(exchange, std::string("parseNumber"),
                            ccxt::list{std::string("0.001")})},
       }},
      {std::string("limits"),
       ccxt::dict{
           {std::string("amount"),
            ccxt::dict{
                {std::string("min"),
                 callDynamically(exchange, std::string("parseNumber"),
                                 ccxt::list{std::string("0.01")})},
                {std::string("max"),
                 callDynamically(exchange, std::string("parseNumber"),
                                 ccxt::list{std::string("1000")})},
            }},
           {std::string("price"),
            ccxt::dict{
                {std::string("min"),
                 callDynamically(exchange, std::string("parseNumber"),
                                 ccxt::list{std::string("0.01")})},
                {std::string("max"),
                 callDynamically(exchange, std::string("parseNumber"),
                                 ccxt::list{std::string("1000")})},
            }},
           {std::string("cost"),
            ccxt::dict{
                {std::string("min"),
                 callDynamically(exchange, std::string("parseNumber"),
                                 ccxt::list{std::string("0.01")})},
                {std::string("max"),
                 callDynamically(exchange, std::string("parseNumber"),
                                 ccxt::list{std::string("1000")})},
            }},
       }},
      {std::string("marginModes"),
       ccxt::dict{
           {std::string("cross"), true},
           {std::string("isolated"), false},
       }},
      {std::string("info"), ccxt::dict{}},
  };
  // temporary: only test QUANTO markets where that prop exists (todo: add in
  // type later)
  if (isTrue(inOp(market, std::string("quanto")))) {
    ::setValue(format, std::string("quanto"),
               false); // whether the market is QUANTO or not
  }
  // define locals
  ccxt::any spot = ::getValue(market, std::string("spot"));
  ccxt::any contract = ::getValue(market, std::string("contract"));
  ccxt::any swap = ::getValue(market, std::string("swap"));
  ccxt::any future = ::getValue(market, std::string("future"));
  ccxt::any option = ::getValue(market, std::string("option"));
  ccxt::any index =
      callDynamically(exchange, std::string("safeBool"),
                      ccxt::list{market, std::string("index")}); // todo: unify
  ccxt::any isIndex = isTrue((!isEqual(index, ccxt::any{}))) && isTrue(index);
  ccxt::any linear = ::getValue(market, std::string("linear"));
  ccxt::any inverse = ::getValue(market, std::string("inverse"));
  ccxt::any quanto =
      callDynamically(exchange, std::string("safeBool"),
                      ccxt::list{market, std::string("quanto")}); // todo: unify
  ccxt::any isQuanto =
      isTrue((!isEqual(quanto, ccxt::any{}))) && isTrue(quanto);
  ccxt::any isInactiveMarket =
      isEqual(::getValue(market, std::string("active")), false);
  //
  ccxt::any emptyAllowedFor = ccxt::list{std::string("margin")};
  if (isTrue(!isEqual(contract, true))) {
    arrayPush(emptyAllowedFor, std::string("contractSize"));
    arrayPush(emptyAllowedFor, std::string("linear"));
    arrayPush(emptyAllowedFor, std::string("inverse"));
    arrayPush(emptyAllowedFor, std::string("quanto"));
    arrayPush(emptyAllowedFor, std::string("settle"));
    arrayPush(emptyAllowedFor, std::string("settleId"));
  }
  if (isTrue(isTrue((!isEqual(future, true))) &&
             isTrue((!isEqual(option, true))))) {
    arrayPush(emptyAllowedFor, std::string("expiry"));
    arrayPush(emptyAllowedFor, std::string("expiryDatetime"));
  }
  if (isTrue(!isEqual(option, true))) {
    arrayPush(emptyAllowedFor, std::string("optionType"));
    arrayPush(emptyAllowedFor, std::string("strike"));
  }
  if (isTrue(isInactiveMarket)) {
    arrayPush(emptyAllowedFor, std::string("contractSize"));
    arrayPush(emptyAllowedFor, std::string("settle"));
    arrayPush(emptyAllowedFor, std::string("settleId"));
    arrayPush(emptyAllowedFor, std::string("baseId"));
    arrayPush(emptyAllowedFor, std::string("quoteId"));
    arrayPush(emptyAllowedFor, std::string("base"));
    arrayPush(emptyAllowedFor, std::string("quote"));
  }
  if (isTrue(isEqual(callDynamically(exchange, std::string("safeString"),
                                     ccxt::list{market, std::string("type")}),
                     std::string("prediction")))) {
    // prediction market rows carry the unified 'market' handle, the
    // deprecated 'symbol' key is intentionally absent from their structures
    format =
        callDynamically(exchange, std::string("omit"),
                        ccxt::list{format, ccxt::list{std::string("symbol")}});
  }
  assertStructure(exchange, skippedProperties, method, market, format,
                  emptyAllowedFor);
  // prediction market rows are keyed by `market`; `symbol` internally by
  // setMarkets
  if (isTrue(!isEqual(::getValue(market, std::string("type")),
                      std::string("prediction")))) {
    assertSymbol(exchange, skippedProperties, method, market,
                 std::string("symbol"));
  }
  ccxt::any logText = logTemplate(exchange, method, market);
  // check taker/maker
  // todo: check not all to be within 0-1.0
  assertGreater(exchange, skippedProperties, method, market,
                std::string("taker"), std::string("-100"));
  assertLess(exchange, skippedProperties, method, market, std::string("taker"),
             std::string("100"));
  assertGreater(exchange, skippedProperties, method, market,
                std::string("maker"), std::string("-100"));
  assertLess(exchange, skippedProperties, method, market, std::string("maker"),
             std::string("100"));
  // validate type ('prediction' for prediction-market exchanges)
  ccxt::any validTypes = ccxt::list{
      std::string("spot"),       std::string("margin"), std::string("swap"),
      std::string("future"),     std::string("option"), std::string("index"),
      std::string("prediction"), std::string("other")};
  assertInArray(exchange, skippedProperties, method, market,
                std::string("type"), validTypes);
  // validate subTypes
  ccxt::any validSubTypes =
      ccxt::list{std::string("linear"), std::string("inverse"),
                 std::string("quanto"), ccxt::any{}};
  assertInArray(exchange, skippedProperties, method, market,
                std::string("subType"), validSubTypes);
  // check if 'type' is consistent
  ccxt::any checkedTypes =
      ccxt::list{std::string("spot"), std::string("swap"),
                 std::string("future"), std::string("option")};
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(checkedTypes));
       postFixIncrement(i)) {
    ccxt::any type = ::getValue(checkedTypes, i);
    if (isTrue(isEqual(::getValue(market, type), true))) {
      assertTrue(isEqual(type, ::getValue(market, std::string("type"))),
                 add(add(add(add(add(std::string("market.type ("),
                                     ::getValue(market, std::string("type"))),
                                 std::string(") not equal to \"")),
                             type),
                         std::string("\"")),
                     logText));
    }
  }
  // check if 'subType' is consistent
  if (isTrue(isTrue((isEqual(swap, true))) ||
             isTrue((isEqual(future, true))))) {
    ccxt::any checkedSubTypes =
        ccxt::list{std::string("linear"), std::string("inverse")};
    for (ccxt::any i = 0; isLessThan(i, getArrayLength(checkedSubTypes));
         postFixIncrement(i)) {
      ccxt::any subType = ::getValue(checkedSubTypes, i);
      if (isTrue(isEqual(::getValue(market, subType), true))) {
        assertTrue(
            isEqual(subType, ::getValue(market, std::string("subType"))),
            add(add(add(add(add(std::string("market.subType ("),
                                ::getValue(market, std::string("subType"))),
                            std::string(") not equal to \"")),
                        subType),
                    std::string("\"")),
                logText));
      }
    }
  }
  // margin check (todo: add margin as mandatory, instead of ccxt::any{})
  if (isTrue(isEqual(spot, true))) {
    // for spot market, 'margin' can be either true/false or ccxt::any{}
    assertInArray(exchange, skippedProperties, method, market,
                  std::string("margin"), ccxt::list{true, false, ccxt::any{}});
  } else {
    // otherwise, it must be false or ccxt::any{}
    assertInArray(exchange, skippedProperties, method, market,
                  std::string("margin"), ccxt::list{false, ccxt::any{}});
  }
  // check mutually exclusive fields
  ccxt::any isPrediction = (isEqual(::getValue(market, std::string("type")),
                                    std::string("prediction")));
  if (isTrue(isPrediction)) {
    // prediction markets trade outcome shares — neither spot nor a derivative
    // contract
    assertTrue(
        isTrue(isTrue(isTrue(isTrue((!isEqual(spot, true))) &&
                             isTrue((!isEqual(contract, true)))) &&
                      isTrue((!isEqual(future, true)))) &&
               isTrue((!isEqual(swap, true)))) &&
            isTrue((!isEqual(option, true))),
        add(std::string("for prediction market, none of "
                        "spot/contract/future/swap/option should be set"),
            logText));
  } else if (isTrue(isEqual(spot, true))) {
    assertTrue(
        isTrue(isTrue(isTrue(isTrue(isTrue((!isEqual(contract, true))) &&
                                    isTrue((isEqual(linear, ccxt::any{})))) &&
                             isTrue((isEqual(inverse, ccxt::any{})))) &&
                      isTrue((!isEqual(option, true)))) &&
               isTrue((!isEqual(swap, true)))) &&
            isTrue((!isEqual(future, true))),
        add(std::string(
                "for spot market, none of "
                "contract/linear/inverse/option/swap/future should be set"),
            logText));
  } else {
    // if not spot, any of the below should be true
    assertTrue(isTrue((isEqual(contract, true))) &&
                   isTrue((isTrue(isTrue(isTrue((isEqual(future, true))) ||
                                         isTrue((isEqual(swap, true)))) ||
                                  isTrue((isEqual(option, true)))) ||
                           isTrue((isEqual(isIndex, true))))),
               add(std::string("for non-spot markets, any of "
                               "(future/swap/option/index) should be set"),
                   logText));
  }
  ccxt::any contractSize =
      callDynamically(exchange, std::string("safeString"),
                      ccxt::list{market, std::string("contractSize")});
  // contract fields
  if (isTrue(isTrue((isEqual(contract, true))) && !isTrue(isInactiveMarket))) {
    if (isTrue(isQuanto)) {
      assertTrue(
          isEqual(linear, false),
          add(std::string("linear must be false when \"quanto\" is true"),
              logText));
      assertTrue(
          isEqual(inverse, false),
          add(std::string("inverse must be false when \"quanto\" is true"),
              logText));
    } else {
      // if false or ccxt::any{}
      assertTrue(
          !isEqual(inverse, ccxt::any{}),
          add(std::string("inverse must be defined when \"contract\" is true"),
              logText));
      assertTrue(
          !isEqual(linear, ccxt::any{}),
          add(std::string("linear must be defined when \"contract\" is true"),
              logText));
      assertTrue(
          !isEqual(linear, inverse),
          add(std::string("linear and inverse must not be the same"), logText));
    }
    // contract size should be defined
    assertTrue(
        (isTrue((inOp(skippedProperties, std::string("contractSize")))) ||
         isTrue(!isEqual(contractSize, ccxt::any{}))),
        add(std::string(
                "\"contractSize\" must be defined when \"contract\" is true"),
            logText));
    // contract size should be above zero
    assertTrue(
        isTrue((inOp(skippedProperties, std::string("contractSize")))) ||
            isTrue(ccxt::Precise::stringGt(contractSize, std::string("0"))),
        add(std::string(
                "\"contractSize\" must be > 0 when \"contract\" is true"),
            logText));
    // settle should be defined
    assertTrue(
        isTrue((inOp(skippedProperties, std::string("settle")))) ||
            isTrue((isTrue(!isEqual(::getValue(market, std::string("settle")),
                                    ccxt::any{})) &&
                    isTrue(!isEqual(::getValue(market, std::string("settleId")),
                                    ccxt::any{})))),
        add(std::string("\"settle\" & \"settleId\" must be defined when "
                        "\"contract\" is true"),
            logText));
  } else if (isTrue(!isEqual(contract, true))) {
    // linear & inverse needs to be ccxt::any{}
    assertTrue(isTrue(isTrue(isEqual(linear, ccxt::any{})) &&
                      isTrue(isEqual(inverse, ccxt::any{}))) &&
                   isTrue(isEqual(quanto, ccxt::any{})),
               add(std::string("market linear and inverse (and quanto) must be "
                               "undefined when \"contract\" is false"),
                   logText));
    // contract size should be ccxt::any{}
    assertTrue(isEqual(contractSize, ccxt::any{}),
               add(std::string("\"contractSize\" must be undefined when "
                               "\"contract\" is false"),
                   logText));
    // settle should be ccxt::any{}
    assertTrue(
        isTrue((
            isEqual(::getValue(market, std::string("settle")), ccxt::any{}))) &&
            isTrue((isEqual(::getValue(market, std::string("settleId")),
                            ccxt::any{}))),
        add(std::string(
                "\"settle\" must be undefined when \"contract\" is false"),
            logText));
  }
  // future, swap and option should be mutually exclusive
  if (isTrue(isEqual(::getValue(market, std::string("future")), true))) {
    assertTrue(
        isTrue(
            isTrue((!isEqual(::getValue(market, std::string("swap")), true))) &&
            isTrue(
                (!isEqual(::getValue(market, std::string("option")), true)))) &&
            isTrue((!isEqual(isIndex, true))),
        add(std::string(
                "market swap and option must be false when \"future\" is true"),
            logText));
  } else if (isTrue(isEqual(::getValue(market, std::string("swap")), true))) {
    assertTrue(
        isTrue((!isEqual(future, true))) && isTrue((!isEqual(option, true))),
        add(std::string(
                "market future and option must be false when \"swap\" is true"),
            logText));
  } else if (isTrue(isEqual(::getValue(market, std::string("option")), true))) {
    assertTrue(
        isTrue((!isEqual(future, true))) && isTrue((!isEqual(swap, true))),
        add(std::string(
                "market future and swap must be false when \"option\" is true"),
            logText));
  }
  // check specific fields for options & futures
  if (isTrue(isTrue((isEqual(option, true))) ||
             isTrue((isEqual(future, true))))) {
    // future or option markets need 'expiry' and 'expiryDatetime'
    assertTrue(
        !isEqual(::getValue(market, std::string("expiry")), ccxt::any{}),
        add(std::string("\"expiry\" must be defined when \"future\" is true"),
            logText));
    assertTrue(
        !isEqual(::getValue(market, std::string("expiryDatetime")),
                 ccxt::any{}),
        add(std::string(
                "\"expiryDatetime\" must be defined when \"future\" is true"),
            logText));
    // expiry datetime should be correct
    ccxt::any isoString =
        callDynamically(exchange, std::string("iso8601"),
                        ccxt::list{::getValue(market, std::string("expiry"))});
    assertTrue(
        isEqual(::getValue(market, std::string("expiryDatetime")), isoString),
        add(add(add(add(add(std::string("expiryDatetime (\""),
                            ::getValue(market, std::string("expiryDatetime"))),
                        std::string("\") must be equal to expiry in iso8601 "
                                    "format \"")),
                    isoString),
                std::string("\"")),
            logText));
    assertGreater(exchange, skippedProperties, method, market,
                  std::string("expiry"), std::string("0"));
    if (isTrue(isEqual(option, true))) {
      // strike should be defined
      assertTrue(
          (isTrue((inOp(skippedProperties, std::string("strike")))) ||
           isTrue(!isEqual(::getValue(market, std::string("strike")),
                           ccxt::any{}))),
          add(std::string("\"strike\" must be defined when \"option\" is true"),
              logText));
      assertGreater(exchange, skippedProperties, method, market,
                    std::string("strike"), std::string("0"));
      // optionType should be defined
      assertTrue(
          (isTrue((inOp(skippedProperties, std::string("optionType")))) ||
           isTrue(!isEqual(::getValue(market, std::string("optionType")),
                           ccxt::any{}))),
          add(std::string(
                  "\"optionType\" must be defined when \"option\" is true"),
              logText));
      assertInArray(exchange, skippedProperties, method, market,
                    std::string("optionType"),
                    ccxt::list{std::string("put"), std::string("call")});
    } else {
      // if not option, then strike and optionType should be ccxt::any{}
      assertTrue(
          isEqual(::getValue(market, std::string("strike")), ccxt::any{}),
          add(std::string(
                  "\"strike\" must be undefined when \"option\" is false"),
              logText));
      assertTrue(
          isEqual(::getValue(market, std::string("optionType")), ccxt::any{}),
          add(std::string(
                  "\"optionType\" must be undefined when \"option\" is false"),
              logText));
    }
  } else if (isTrue(isEqual(spot, true))) {
    // otherwise, expiry needs to be ccxt::any{}
    assertTrue(
        isTrue((
            isEqual(::getValue(market, std::string("expiry")), ccxt::any{}))) &&
            isTrue((isEqual(::getValue(market, std::string("expiryDatetime")),
                            ccxt::any{}))),
        add(std::string("\"expiry\" and \"expiryDatetime\" must be undefined "
                        "when it is not future|option market"),
            logText));
  }
  // check precisions
  ccxt::any precisionKeys =
      getObjectKeys(::getValue(market, std::string("precision")));
  ccxt::any precisionKeysLen = getArrayLength(precisionKeys);
  assertTrue(
      isGreaterThanOrEqual(precisionKeysLen, 2),
      add(std::string(
              "precision should have \"amount\" and \"price\" keys at least"),
          logText));
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(precisionKeys));
       postFixIncrement(i)) {
    ccxt::any priceOrAmountKey = ::getValue(precisionKeys, i);
    // only allow very high priced markets (wher coin costs around 100k) to have
    // a 5$ price tickSize
    ccxt::any isExclusivePair =
        isEqual(::getValue(market, std::string("baseId")), std::string("BTC"));
    ccxt::any isNonSpot = !isEqual(
        spot, true); // such high precision is only allowed in contract markets
    ccxt::any isPrice = isEqual(priceOrAmountKey, std::string("price"));
    ccxt::any isTickSize5 = ccxt::Precise::stringEq(
        std::string("5"),
        callDynamically(exchange, std::string("safeString"),
                        ccxt::list{::getValue(market, std::string("precision")),
                                   priceOrAmountKey}));
    if (isTrue(isTrue(isTrue(isTrue(isNonSpot) && isTrue(isPrice)) &&
                      isTrue(isExclusivePair)) &&
               isTrue(isTickSize5))) {
      continue;
    }
    if (!isTrue((inOp(skippedProperties, std::string("precision"))))) {
      checkPrecisionAccuracy(exchange, skippedProperties, method,
                             ::getValue(market, std::string("precision")),
                             priceOrAmountKey);
    }
  }
  // check limits
  ccxt::any limitsKeys =
      getObjectKeys(::getValue(market, std::string("limits")));
  ccxt::any limitsKeysLength = getArrayLength(limitsKeys);
  assertTrue(isGreaterThanOrEqual(limitsKeysLength, 3),
             add(std::string("limits should have \"amount\", \"price\" and "
                             "\"cost\" keys at least"),
                 logText));
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(limitsKeys));
       postFixIncrement(i)) {
    ccxt::any key = ::getValue(limitsKeys, i);
    ccxt::any limitEntry =
        ::getValue(::getValue(market, std::string("limits")), key);
    if (isTrue(isInactiveMarket)) {
      continue;
    } // check limits
    if (!isTrue((inOp(skippedProperties, std::string("limits"))))) {
      // min >= 0
      assertGreaterOrEqual(exchange, skippedProperties, method, limitEntry,
                           std::string("min"), std::string("0"));
      // max >= 0
      assertGreater(exchange, skippedProperties, method, limitEntry,
                    std::string("max"), std::string("0"));
      // max >= min
      ccxt::any minString =
          callDynamically(exchange, std::string("safeString"),
                          ccxt::list{limitEntry, std::string("min")});
      if (isTrue(!isEqual(minString, ccxt::any{}))) {
        assertGreaterOrEqual(exchange, skippedProperties, method, limitEntry,
                             std::string("max"), minString);
      }
    }
  }
  // check currencies (skip for prediction markets: the "base" is a tradeable
  // outcome, not a currency, so baseId is the market/outcome id and won't map
  // to a currency code)
  if (isTrue(!isTrue(isInactiveMarket) && !isTrue(isPrediction))) {
    assertValidCurrencyIdAndCode(exchange, skippedProperties, method, market,
                                 ::getValue(market, std::string("baseId")),
                                 ::getValue(market, std::string("base")));
    assertValidCurrencyIdAndCode(exchange, skippedProperties, method, market,
                                 ::getValue(market, std::string("quoteId")),
                                 ::getValue(market, std::string("quote")));
    assertValidCurrencyIdAndCode(exchange, skippedProperties, method, market,
                                 ::getValue(market, std::string("settleId")),
                                 ::getValue(market, std::string("settle")));
  }
  // check ts
  assertTimestamp(exchange, skippedProperties, method, market, ccxt::any{},
                  std::string("created"));
  // margin modes
  if (!isTrue((inOp(skippedProperties, std::string("marginModes"))))) {
    ccxt::any marginModes =
        callDynamically(exchange, std::string("safeDict"),
                        ccxt::list{market, std::string("marginModes"),
                                   ccxt::dict{}}); // in future, remove safeDict
    assertTrue(
        inOp(marginModes, std::string("cross")),
        add(std::string("marginModes should have \"cross\" key"), logText));
    assertTrue(
        inOp(marginModes, std::string("isolated")),
        add(std::string("marginModes should have \"isolated\" key"), logText));
    assertInArray(exchange, skippedProperties, method, marginModes,
                  std::string("cross"), ccxt::list{true, false, ccxt::any{}});
    assertInArray(exchange, skippedProperties, method, marginModes,
                  std::string("isolated"),
                  ccxt::list{true, false, ccxt::any{}});
  }
}
