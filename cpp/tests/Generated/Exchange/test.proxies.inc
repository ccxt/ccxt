std::shared_future<ccxt::any>
testProxyForExceptions(ccxt::any exchange, ccxt::any skippedProperties) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               ccxt::any method = std::string("testProxyForExceptions");
               ccxt::any proxyUrlhttpProxyhttpsProxysocksProxyVariable =
                   removeProxyOptions(exchange, skippedProperties);
               ccxt::any proxyUrl =
                   ::getValue(proxyUrlhttpProxyhttpsProxysocksProxyVariable, 0);
               ccxt::any httpProxy =
                   ::getValue(proxyUrlhttpProxyhttpsProxysocksProxyVariable, 1);
               ccxt::any httpsProxy =
                   ::getValue(proxyUrlhttpProxyhttpsProxysocksProxyVariable, 2);
               ccxt::any socksProxy =
                   ::getValue(proxyUrlhttpProxyhttpsProxysocksProxyVariable, 3);
               ccxt::any possibleOptionsArray =
                   ccxt::list{std::string("proxyUrl"),
                              std::string("proxyUrlCallback"),
                              std::string("proxy_url"),
                              std::string("proxy_url_callback"),
                              std::string("httpProxy"),
                              std::string("httpProxyCallback"),
                              std::string("http_proxy"),
                              std::string("http_proxy_callback"),
                              std::string("httpsProxy"),
                              std::string("httpsProxyCallback"),
                              std::string("https_proxy"),
                              std::string("https_proxy_callback"),
                              std::string("socksProxy"),
                              std::string("socksProxyCallback"),
                              std::string("socks_proxy"),
                              std::string("socks_proxy_callback")};
               for (ccxt::any i = 0;
                    isLessThan(i, getArrayLength(possibleOptionsArray));
                    postFixIncrement(i)) {
                 for (ccxt::any j = 0;
                      isLessThan(j, getArrayLength(possibleOptionsArray));
                      postFixIncrement(j)) {
                   if (isTrue(!isEqual(j, i))) {
                     ccxt::any proxyFirst = ::getValue(possibleOptionsArray, i);
                     ccxt::any proxySecond =
                         ::getValue(possibleOptionsArray, j);
                     callDynamically(
                         exchange, std::string("setProperty"),
                         ccxt::list{
                             exchange, proxyFirst,
                             std::string(
                                 "0.0.0.0")}); // actual value does not matter
                     callDynamically(
                         exchange, std::string("setProperty"),
                         ccxt::list{
                             exchange, proxySecond,
                             std::string(
                                 "0.0.0.0")}); // actual value does not matter
                     ccxt::any exceptionCaught = false;
                     try {
                       awaitValue(callDynamically(
                           exchange, std::string("fetch"),
                           ccxt::list{std::string(
                               "http://example.com")})); // url does not matter,
                                                         // it will not be
                                                         // called
                     } catch (const std::exception &e) {
                       exceptionCaught = true;
                     }
                     assertTrue(
                         exceptionCaught,
                         add(add(add(add(add(add(add(getProperty(
                                                         exchange,
                                                         std::string("id")),
                                                     std::string(" ")),
                                                 method),
                                             std::string(
                                                 " test failed. No exception "
                                                 "was thrown, while ")),
                                         proxyFirst),
                                     std::string(" and ")),
                                 proxySecond),
                             std::string(" were set together")));
                     // reset to ccxt::any{}
                     callDynamically(
                         exchange, std::string("setProperty"),
                         ccxt::list{exchange, proxyFirst, ccxt::any{}});
                     callDynamically(
                         exchange, std::string("setProperty"),
                         ccxt::list{exchange, proxySecond, ccxt::any{}});
                   }
                 }
               }
               // reset the instance property
               setProxyOptions(exchange, skippedProperties, proxyUrl, httpProxy,
                               httpsProxy, socksProxy);
               return true;
             })
      .share();
}
