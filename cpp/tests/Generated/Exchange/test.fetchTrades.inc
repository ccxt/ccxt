std::shared_future<ccxt::any> testFetchTrades(ccxt::any exchange,
                                              ccxt::any skippedProperties,
                                              ccxt::any symbol) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               ccxt::any method = std::string("fetchTrades");
               ccxt::any trades = awaitValue(callDynamically(
                   exchange, std::string("fetchTrades"),
                   ccxt::list{symbol, ccxt::any{},
                              12000})); // test with unrealistically high amount
               assertNonEmtpyArray(exchange, skippedProperties, method, trades);
               //
               // test structure
               //
               ccxt::any now = callDynamically(
                   exchange, std::string("milliseconds"), ccxt::list{});
               ccxt::any isPublicTrade = true;
               for (ccxt::any i = 0; isLessThan(i, getArrayLength(trades));
                    postFixIncrement(i)) {
                 testTrade(exchange, skippedProperties, method,
                           ::getValue(trades, i), symbol, now, isPublicTrade);
               }
               //
               // test if both sides are being returned
               //
               ccxt::any minTradesForBothSidesCheck = 99;
               if (isTrue(!isTrue((inOp(skippedProperties,
                                        std::string("requireBothSides")))) &&
                          isTrue(isGreaterThan(getArrayLength(trades),
                                               minTradesForBothSidesCheck)))) {
                 //
                 //  Check whether both "buy" and "sell" are returned from
                 //  trades, when there are enough trades for a one-sided result
                 //  to be an implausible coincidence (see
                 //  minTradesForBothSidesCheck)
                 //
                 ccxt::any grouped =
                     callDynamically(exchange, std::string("groupBy"),
                                     ccxt::list{trades, std::string("side")});
                 ccxt::any msg = add(
                     std::string("Both sides of trades are not being returned, "
                                 "instead only one side is being returned. If "
                                 "this error happens consistently, then it "
                                 "might be an implementation issue"),
                     logTemplate(exchange, method, trades));
                 assertTrue((inOp(grouped, std::string("buy"))), msg);
                 assertTrue((inOp(grouped, std::string("sell"))), msg);
               }
               if (!isTrue((inOp(skippedProperties,
                                 std::string("timestampSort"))))) {
                 assertTimestampOrder(exchange, method, symbol, trades);
               }
               if (isTrue(!isTrue(
                              (inOp(skippedProperties, std::string("side")))) &&
                          !isTrue((inOp(skippedProperties,
                                        std::string("sideSequence")))))) {
                 awaitValue(helperTestFetchTradesSideSequence(
                     exchange, skippedProperties, symbol, method, trades));
               }
               return true;
             })
      .share();
}

std::shared_future<ccxt::any>
helperTestFetchTradesSideSequence(ccxt::any exchange,
                                  ccxt::any skippedProperties, ccxt::any symbol,
                                  ccxt::any method, ccxt::any trades) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               //
               // Check whether returned trades are sorted correctly by side -
               // multi-trade orders at the same timestamp would definitely have
               // an increasing (in case of buy) price. For instance, if we have
               // trades like:
               //     [ 1600000000003 ] 1.4 ETH at 1750.41
               //     [ 1600000000111 ] 0.2 ETH at 1750.40
               //     [ 1600000000111 ] 0.3 ETH at 1750.41
               //     [ 1600000000111 ] 0.9 ETH at 1750.42
               //     [ 1600000000555 ] 2.4 ETH at 1750.40
               // it's obviously `buy` order on same timestamp.
               // In case any specific exchange does not return correctly sorted
               // results, either implementation might need a fix, or the
               // exchange needs `timestampSort` skip to be added.
               //
               ccxt::any lastTs = ccxt::any{};
               ccxt::any lastPrice = ccxt::any{};
               ccxt::any lastSide = ccxt::any{};
               ccxt::any lastTrade = ccxt::any{};
               for (ccxt::any i = 0; isLessThan(i, getArrayLength(trades));
                    postFixIncrement(i)) {
                 ccxt::any trade = ::getValue(trades, i);
                 ccxt::any ts = ::getValue(trade, std::string("timestamp"));
                 ccxt::any price =
                     callDynamically(exchange, std::string("safeString"),
                                     ccxt::list{trade, std::string("price")});
                 ccxt::any side = ::getValue(trade, std::string("side"));
                 //
                 ccxt::any isSameTs = isEqual(ts, lastTs);
                 ccxt::any isSamePrice =
                     ccxt::Precise::stringEq(price, lastPrice);
                 ccxt::any isSameSide = isEqual(side, lastSide);
                 // we are only interested in trades that have: same timestamp,
                 // same side, but different(!) price
                 if (isTrue(isTrue(isTrue(isSameTs) && isTrue(isSameSide)) &&
                            !isTrue(isSamePrice))) {
                   ccxt::any pair = ccxt::dict{
                       {std::string("previous"), lastTrade},
                       {std::string("current"), trade},
                   };
                   ccxt::any priceIncreasing =
                       ccxt::Precise::stringGt(price, lastPrice);
                   ccxt::any priceDecreasing =
                       ccxt::Precise::stringLt(price, lastPrice);
                   if (isTrue(priceIncreasing)) {
                     assertTrue(isEqual(side, std::string("buy")),
                                add(std::string(
                                        "Price is increasing, but side is not "
                                        "`buy`, either implementation needs "
                                        "fix or exchange returns unsorted "
                                        "trades, so add \"sideSequence\" skip"),
                                    logTemplate(exchange, method, pair)));
                   } else if (isTrue(priceDecreasing)) {
                     assertTrue(isEqual(side, std::string("sell")),
                                add(std::string(
                                        "Price is decreasing, but side is not "
                                        "`sell`, either implementation needs "
                                        "fix or exchange returns unsorted "
                                        "trades, so add \"sideSequence\" skip"),
                                    logTemplate(exchange, method, pair)));
                   }
                 }
                 lastPrice = price;
                 lastTs = ts;
                 lastSide = side;
                 lastTrade = trade;
               }
               return true;
             })
      .share();
}
