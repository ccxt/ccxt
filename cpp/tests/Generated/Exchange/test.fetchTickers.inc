std::shared_future<std::any> testFetchTickers(std::any exchange,
                                              std::any skippedProperties,
                                              std::any symbol) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> std::any {
               // prediction venues list thousands of outcome markets, so
               // fetching ALL tickers (no-arg) is impractical and the "every
               // active market has a ticker" check doesn't apply — test
               // fetchTickers by the outcome handle instead
               if (isTrue(callDynamically(
                       exchange, std::string("safeBool"),
                       ccxt::list{getProperty(exchange, std::string("has")),
                                  std::string("prediction"), false}))) {
                 std::any predictionResult = awaitValue(fetchTickersHelperTest(
                     exchange, skippedProperties, ccxt::list{symbol}));
                 return ccxt::list{predictionResult};
               }
               std::any withoutSymbol = fetchTickersHelperTest(
                   exchange, skippedProperties, std::any{});
               std::any withSymbol = fetchTickersHelperTest(
                   exchange, skippedProperties, ccxt::list{symbol});
               std::any results = awaitValue(
                   promiseAll(ccxt::list{withoutSymbol, withSymbol}));
               fetchTickersAmountsTest(exchange, skippedProperties,
                                       ::getValue(results, 0));
               return results;
             })
      .share();
}

std::shared_future<std::any>
fetchTickersHelperTest(std::any exchange, std::any skippedProperties,
                       std::any argSymbols, std::any argParams = ccxt::dict{}) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> std::any {
               std::any method = std::string("fetchTickers");
               std::any response = awaitValue(
                   callDynamically(exchange, std::string("fetchTickers"),
                                   ccxt::list{argSymbols, argParams}));
               assertDictionaryResponse(
                   exchange, method, response,
                   callDynamically(exchange, std::string("json"),
                                   ccxt::list{argSymbols}));
               std::any values = getObjectValues(response);
               std::any checkedSymbol = std::any{};
               if (isTrue(isTrue(!isEqual(argSymbols, std::any{})) &&
                          isTrue(isEqual(getArrayLength(argSymbols), 1)))) {
                 checkedSymbol = ::getValue(argSymbols, 0);
               }
               assertNonEmtpyArray(exchange, skippedProperties, method, values,
                                   checkedSymbol);
               for (std::any i = 0; isLessThan(i, getArrayLength(values));
                    postFixIncrement(i)) {
                 // todo: symbol check here
                 std::any ticker = ::getValue(values, i);
                 try {
                   testTicker(exchange, skippedProperties, method, ticker,
                              checkedSymbol);
                 } catch (const std::exception &ex) {
                   std::any ohlcv = std::any{};
                   std::any tickerSymbol =
                       ::getValue(ticker, std::string("symbol"));
                   if (isTrue(isTrue((!isEqual(tickerSymbol, std::any{}))) &&
                              isTrue(tickerExceptionNeedsOhlcv(ex, exchange,
                                                               ticker)))) {
                     ohlcv = awaitValue(callDynamically(
                         exchange, std::string("fetchOHLCV"),
                         ccxt::list{tickerSymbol, std::string("1d"), std::any{},
                                    5}));
                   }
                   validateTickerExceptionForPercentage(ex, exchange, ticker,
                                                        ohlcv);
                 }
               }
               return response;
             })
      .share();
}

void fetchTickersAmountsTest(std::any exchange, std::any skippedProperties,
                             std::any tickers) {
  std::any tickersValues = getObjectValues(tickers);
  if (!isTrue((inOp(skippedProperties, std::string("checkActiveSymbols"))))) {
    //
    // ensure all "active" symbols have tickers
    //
    std::any nonInactiveMarkets = getActiveMarkets(exchange);
    std::any notInactiveSymbolsLength = getArrayLength(nonInactiveMarkets);
    std::any obtainedTickersLength = getArrayLength(tickersValues);
    std::any minRatio = 0.99; // 1.0 - 0.01 = 0.99, hardcoded to avoid C#
                              // transpiler type casting issues
    assertTrue(
        isGreaterThanOrEqual(obtainedTickersLength,
                             multiply(notInactiveSymbolsLength, minRatio)),
        add(add(add(add(add(add(add(getProperty(exchange, std::string("id")),
                                    std::string(" ")),
                                std::string("fetchTickers")),
                            std::string(" must return tickers for all active "
                                        "markets. but returned: ")),
                        toString(obtainedTickersLength)),
                    std::string(" tickers, ")),
                toString(notInactiveSymbolsLength)),
            std::string(" active markets")));
    //
    // ensure tickers length is less than markets length
    //
    std::any allMarkets = getProperty(exchange, std::string("markets"));
    if (isTrue(isEqual(allMarkets, std::any{}))) {
      return;
    }
    std::any allMarketsLength = getArrayLength(getObjectKeys(allMarkets));
    assertTrue(
        isLessThanOrEqual(obtainedTickersLength, allMarketsLength),
        add(add(add(add(add(add(add(getProperty(exchange, std::string("id")),
                                    std::string(" ")),
                                std::string("fetchTickers")),
                            std::string(" must return <= than all markets, but "
                                        "returned: ")),
                        toString(obtainedTickersLength)),
                    std::string(" tickers, ")),
                toString(allMarketsLength)),
            std::string(" markets")));
  }
}
