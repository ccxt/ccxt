std::shared_future<ccxt::any> testFetchPositions(ccxt::any exchange,
                                                 ccxt::any skippedProperties,
                                                 ccxt::any symbol) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               ccxt::any method = std::string("fetchPositions");
               ccxt::any now = callDynamically(
                   exchange, std::string("milliseconds"), ccxt::list{});
               // without symbol
               ccxt::any positions = awaitValue(callDynamically(
                   exchange, std::string("fetchPositions"), ccxt::list{}));
               assertNonEmtpyArray(exchange, skippedProperties, method,
                                   positions, symbol);
               for (ccxt::any i = 0; isLessThan(i, getArrayLength(positions));
                    postFixIncrement(i)) {
                 testPosition(exchange, skippedProperties, method,
                              ::getValue(positions, i), ccxt::any{}, now);
               }
               // assertTimestampOrder (exchange, method, ccxt::any{},
               // positions); // currently order of positions does not make
               // sense with symbol
               ccxt::any positionsForSymbol = awaitValue(
                   callDynamically(exchange, std::string("fetchPositions"),
                                   ccxt::list{ccxt::list{symbol}}));
               assertTrue(
                   isArray(positionsForSymbol),
                   add(add(add(add(getProperty(exchange, std::string("id")),
                                   std::string(" ")),
                               method),
                           std::string(" must return an array, returned ")),
                       callDynamically(exchange, std::string("json"),
                                       ccxt::list{positionsForSymbol})));
               ccxt::any positionsForSymbolLength =
                   getArrayLength(positionsForSymbol);
               assertTrue(
                   isLessThanOrEqual(positionsForSymbolLength, 4),
                   add(add(add(add(getProperty(exchange, std::string("id")),
                                   std::string(" ")),
                               method),
                           std::string(
                               " positions length for particular symbol should "
                               "be less than 4, returned ")),
                       callDynamically(exchange, std::string("json"),
                                       ccxt::list{positionsForSymbol})));
               for (ccxt::any i = 0;
                    isLessThan(i, getArrayLength(positionsForSymbol));
                    postFixIncrement(i)) {
                 testPosition(exchange, skippedProperties, method,
                              ::getValue(positionsForSymbol, i), symbol, now);
               }
               // assertTimestampOrder (exchange, method, symbol,
               // positionsForSymbol);
               return true;
             })
      .share();
}
