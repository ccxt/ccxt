std::shared_future<ccxt::any> testAfterConstruct(ccxt::any exchange,
                                                 ccxt::any skippedProperties) {
  return std::async(std::launch::deferred,
                    [=]() mutable -> ccxt::any {
                      if (!isTrue((inOp(skippedProperties,
                                        std::string("networks"))))) {
                        testOptionsNetworks(exchange, skippedProperties);
                      }
                      return true;
                    })
      .share();
}

void testOptionsNetworks(ccxt::any exchange, ccxt::any skippedProperties) {
  if (!isTrue((inOp(skippedProperties, std::string("networks"))))) {
    // only allow these whitelisted unified networkCodes to be repeated
    ccxt::any allowedUnifiedAliases = ccxt::list{
        std::string("BTC"),      std::string("ERC20"),   std::string("ETH"),
        std::string("TRX"),      std::string("TRC20"),   std::string("BRC20"),
        std::string("CRONOS"),   std::string("CRC20"),   std::string("CRO"),
        std::string("BEP20"),    std::string("BSC"),     std::string("HECO"),
        std::string("HRC20"),    std::string("HT"),      std::string("OP"),
        std::string("OPTIMISM"), std::string("SOL"),     std::string("POLYGON"),
        std::string("MATIC"),    std::string("CARDANO"), std::string("ADA"),
        std::string("ATOM"),     std::string("COSMOS")};
    // safeDict, not getProperty(exchange, std::string("options"))['networks']:
    // a direct missing-key access throws KeyError in Python (e.g. an exchange
    // whose options has no 'networks', like the hyperliquid prediction market)
    ccxt::any networks = callDynamically(
        exchange, std::string("safeDict"),
        ccxt::list{getProperty(exchange, std::string("options")),
                   std::string("networks")});
    if (isTrue(isEqual(networks, ccxt::any{}))) {
      return;
    }
    // 1) ensure 'networks' dictionary exists in options
    assertTrue(callDynamically(exchange, std::string("isDictionary"),
                               ccxt::list{networks}),
               std::string("exchange.options[\"networks\"] is not a dict"));
    if (isTrue(isEqual(getArrayLength(getObjectKeys(networks)), 0))) {
      return;
    }
    // 2) ensure 'networksById' dictionary exists in options
    assertTrue(inOp(getProperty(exchange, std::string("options")),
                    std::string("networksById")),
               std::string("exchange.options[\"networksById\"] is not set"));
    assertTrue(
        callDynamically(
            exchange, std::string("isDictionary"),
            ccxt::list{::getValue(getProperty(exchange, std::string("options")),
                                  std::string("networksById"))}),
        std::string("exchange.options[\"networksById\"] is not a dict"));
    //
    ccxt::any networkCodes =
        getObjectKeys(::getValue(getProperty(exchange, std::string("options")),
                                 std::string("networks")));
    // 3) ensure that the same network-id is not assigned to multiple
    // networkCodes
    ccxt::any collectedNetworkIds = ccxt::list{};
    for (ccxt::any i = 0; isLessThan(i, getArrayLength(networkCodes));
         postFixIncrement(i)) {
      ccxt::any networkCode = ::getValue(networkCodes, i);
      ccxt::any networkId =
          ::getValue(::getValue(getProperty(exchange, std::string("options")),
                                std::string("networks")),
                     networkCode);
      if (!isTrue(callDynamically(
              exchange, std::string("inArray"),
              ccxt::list{networkCode, allowedUnifiedAliases}))) {
        assertTrue(
            !isTrue(
                callDynamically(exchange, std::string("inArray"),
                                ccxt::list{networkId, collectedNetworkIds})),
            add(add(std::string(
                        "exchange.options[\"networks\"] should not contain "
                        "multiple non-unified networkCodes (in the list of "
                        "unified-networks) with the same networkId: \""),
                    networkId),
                std::string("\"")));
      }
      arrayPush(collectedNetworkIds, networkId);
    }
    // 4) ensure that there are no same networkCode with different case
    // (uppercase/lowercase)
    ccxt::any collectedNetworkCodes = ccxt::list{};
    for (ccxt::any i = 0; isLessThan(i, getArrayLength(networkCodes));
         postFixIncrement(i)) {
      ccxt::any networkCodeLower = toLowerCase((::getValue(networkCodes, i)));
      assertTrue(
          !isTrue(callDynamically(
              exchange, std::string("inArray"),
              ccxt::list{networkCodeLower, collectedNetworkCodes})),
          add(add(std::string(
                      "exchange.options[\"networks\"] contains multiple "
                      "networkCodes with the same networkCode \""),
                  ::getValue(networkCodes, i)),
              std::string("\" in different uppercase/lowercase format")));
      arrayPush(collectedNetworkCodes, networkCodeLower);
    }
    // 5) test networkCodeToId & networkIdToCode
    for (ccxt::any i = 0; isLessThan(i, getArrayLength(networkCodes));
         postFixIncrement(i)) {
      ccxt::any networkCode = ::getValue(networkCodes, i);
      ccxt::any networkId =
          ::getValue(::getValue(getProperty(exchange, std::string("options")),
                                std::string("networks")),
                     networkCode);
      // check networkCodeToId
      ccxt::any networkIdConverted = callDynamically(
          exchange, std::string("networkCodeToId"), ccxt::list{networkCode});
      assertTrue(
          isEqual(networkId, networkIdConverted),
          add(add(add(add(add(add(add(add(std::string(
                                              "exchange.networkCodeToId (\""),
                                          networkCode),
                                      std::string("\")=\"")),
                                  networkIdConverted),
                              std::string("\" does not match "
                                          "exchange.options[\"networks\"][\"")),
                          networkCode),
                      std::string("\"]=\"")),
                  networkId),
              std::string("\"")));
      // ensure it exists in networksById
      assertTrue(inOp(::getValue(getProperty(exchange, std::string("options")),
                                 std::string("networksById")),
                      networkId),
                 add(add(std::string("exchange.options[\"networksById\"] does "
                                     "not contain networkId \""),
                         networkId),
                     std::string("\"")));
      // ensure networkCode matches for networksById (however, it only works if
      // one mapping is set)
      if (!isTrue(callDynamically(
              exchange, std::string("inArray"),
              ccxt::list{networkCode, allowedUnifiedAliases}))) {
        assertTrue(
            isEqual(::getValue(::getValue(getProperty(exchange,
                                                      std::string("options")),
                                          std::string("networksById")),
                               networkId),
                    networkCode),
            add(add(add(add(add(add(std::string("exchange.options["
                                                "\"networksById\"][\""),
                                    networkId),
                                std::string("\"] value is not expected \"")),
                            networkCode),
                        std::string("\", but: \"")),
                    ::getValue(::getValue(getProperty(exchange,
                                                      std::string("options")),
                                          std::string("networksById")),
                               networkId)),
                std::string("\"")));
        // check networkIdToCode conversion back
        ccxt::any networkCodeConverted = callDynamically(
            exchange, std::string("networkIdToCode"), ccxt::list{networkId});
        assertTrue(
            isEqual(networkCode, networkCodeConverted),
            add(add(add(add(add(add(std::string("exchange.networkIdToCode (\""),
                                    networkId),
                                std::string("\")=\"")),
                            networkCodeConverted),
                        std::string("\" does not match key \"")),
                    networkCode),
                std::string("\" of exchange.options[\"networks\"]")));
      }
    }
  }
}
