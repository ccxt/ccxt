ccxt::any detectMarketConflicts(ccxt::any exchange, ccxt::any marketValues) {
  // detect if there are markets with different ids for the same symbol
  ccxt::any ids = ccxt::dict{};
  for (ccxt::any i = 0; isLessThan(i, getArrayLength(marketValues));
       postFixIncrement(i)) {
    ccxt::any market = ::getValue(marketValues, i);
    ccxt::any symbol = ::getValue(market, std::string("symbol"));
    if (!isTrue((inOp(ids, symbol)))) {
      ::setValue(ids, symbol, ::getValue(market, std::string("id")));
    } else {
      ccxt::any isDifferent = !isEqual(::getValue(ids, symbol),
                                       ::getValue(market, std::string("id")));
      assertTrue(
          !isTrue(isDifferent),
          add(add(add(add(add(add(getProperty(exchange, std::string("id")),
                                  std::string(" fetchMarkets() has different "
                                              "ids for the same symbol: ")),
                              symbol),
                          std::string(" ")),
                      ::getValue(ids, symbol)),
                  std::string(" ")),
              ::getValue(market, std::string("id"))));
    }
  }
  return true;
}
