std::shared_future<ccxt::any> testCreateOrder(ccxt::any exchange,
                                              ccxt::any skippedProperties,
                                              ccxt::any symbol) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               ccxt::any logPrefix = logTemplate(
                   exchange, std::string("createOrder"), ccxt::list{symbol});
               ccxt::any hasCancelOrder =
                   isTrue((!isEqual(
                       ::getValue(getProperty(exchange, std::string("has")),
                                  std::string("cancelOrder")),
                       ccxt::any{}))) &&
                   isTrue((!isEqual(
                       ::getValue(getProperty(exchange, std::string("has")),
                                  std::string("cancelOrder")),
                       false)));
               ccxt::any hasCancelOrders =
                   isTrue((!isEqual(
                       ::getValue(getProperty(exchange, std::string("has")),
                                  std::string("cancelOrders")),
                       ccxt::any{}))) &&
                   isTrue((!isEqual(
                       ::getValue(getProperty(exchange, std::string("has")),
                                  std::string("cancelOrders")),
                       false)));
               ccxt::any hasCancelAllOrders =
                   isTrue((!isEqual(
                       ::getValue(getProperty(exchange, std::string("has")),
                                  std::string("cancelAllOrders")),
                       ccxt::any{}))) &&
                   isTrue((!isEqual(
                       ::getValue(getProperty(exchange, std::string("has")),
                                  std::string("cancelAllOrders")),
                       false)));
               assertTrue(
                   isTrue(isTrue(hasCancelOrder) || isTrue(hasCancelOrders)) ||
                       isTrue(hasCancelAllOrders),
                   add(logPrefix,
                       std::string(
                           " does not have "
                           "cancelOrder|cancelOrders|canelAllOrders method, "
                           "which is needed to make tests for `createOrder` "
                           "method. Skipping the test...")));
               // pre-define some coefficients, which will be used down below
               ccxt::any limitPriceSafetyMultiplierFromMedian =
                   1.045; // todo: when this
                          // https://github.com/ccxt/ccxt/issues/22442 is
                          // implemented, we'll remove hardcoded value. atm 5%
                          // is enough
               ccxt::any market = callDynamically(
                   exchange, std::string("market"), ccxt::list{symbol});
               ccxt::any isSwapFuture =
                   isTrue((isEqual(::getValue(market, std::string("swap")),
                                   true))) ||
                   isTrue((isEqual(::getValue(market, std::string("future")),
                                   true)));
               ccxt::any hasFetchBalance =
                   isTrue((!isEqual(
                       ::getValue(getProperty(exchange, std::string("has")),
                                  std::string("fetchBalance")),
                       ccxt::any{}))) &&
                   isTrue((!isEqual(
                       ::getValue(getProperty(exchange, std::string("has")),
                                  std::string("fetchBalance")),
                       false)));
               assertTrue(hasFetchBalance,
                          add(logPrefix,
                              std::string(
                                  " does not have fetchBalance() method, which "
                                  "is needed to make tests for `createOrder` "
                                  "method. Skipping the test...")));
               ccxt::any balance = awaitValue(callDynamically(
                   exchange, std::string("fetchBalance"), ccxt::list{}));
               ccxt::any initialBaseBalance = ::getValue(
                   ::getValue(balance, ::getValue(market, std::string("base"))),
                   std::string("free"));
               ccxt::any initialQuoteBalance = ::getValue(
                   ::getValue(balance,
                              ::getValue(market, std::string("quote"))),
                   std::string("free"));
               assertTrue(
                   !isEqual(initialQuoteBalance, ccxt::any{}),
                   add(add(add(logPrefix,
                               std::string(
                                   " - testing account not have balance of")),
                           ::getValue(market, std::string("quote"))),
                       std::string(
                           " in fetchBalance() which is required to test")));
               tcoDebug(
                   exchange, symbol,
                   add(add(add(add(add(add(add(add(add(std::string(
                                                           "fetched balance "
                                                           "for "),
                                                       symbol),
                                                   std::string(" : ")),
                                               toString(initialBaseBalance)),
                                           std::string(" ")),
                                       ::getValue(market, std::string("base"))),
                                   std::string("/")),
                               initialQuoteBalance),
                           std::string(" ")),
                       ::getValue(market, std::string("quote"))));
               ccxt::any bestBidbestAskVariable = awaitValue(fetchBestBidAsk(
                   exchange, std::string("createOrder"), symbol));
               ccxt::any bestBid = ::getValue(bestBidbestAskVariable, 0);
               ccxt::any bestAsk = ::getValue(bestBidbestAskVariable, 1);
               // **************** [Scenario 1 - START] **************** //
               tcoDebug(exchange, symbol, std::string("### SCENARIO 1 ###"));
               // create a "limit order" which IS GUARANTEED not to have a fill
               // (i.e. being far from the real price)
               awaitValue(tcoCreateUnfillableOrder(
                   exchange, market, logPrefix, skippedProperties, bestBid,
                   bestAsk, limitPriceSafetyMultiplierFromMedian,
                   std::string("buy")));
               if (isTrue(isSwapFuture)) {
                 // for swap markets, we test sell orders too
                 awaitValue(tcoCreateUnfillableOrder(
                     exchange, market, logPrefix, skippedProperties, bestBid,
                     bestAsk, limitPriceSafetyMultiplierFromMedian,
                     std::string("sell")));
               }
               tcoDebug(exchange, symbol,
                        std::string("### SCENARIO 1 PASSED ###"));
               // **************** [Scenario 2 - START] **************** //
               tcoDebug(exchange, symbol, std::string("### SCENARIO 2 ###"));
               // create an order which IS GUARANTEED to have a fill (full or
               // partial)
               awaitValue(tcoCreateFillableOrder(
                   exchange, market, logPrefix, skippedProperties, bestBid,
                   bestAsk, limitPriceSafetyMultiplierFromMedian,
                   std::string("buy")));
               if (isTrue(isSwapFuture)) {
                 // for swap markets, we test sell orders too
                 awaitValue(tcoCreateFillableOrder(
                     exchange, market, logPrefix, skippedProperties, bestBid,
                     bestAsk, limitPriceSafetyMultiplierFromMedian,
                     std::string("sell")));
               }
               tcoDebug(exchange, symbol,
                        std::string("### SCENARIO 2 PASSED ###"));
               // **************** [Scenario 3 - START] **************** //
               return true;
             })
      .share();
}

std::shared_future<ccxt::any> tcoCreateUnfillableOrder(
    ccxt::any exchange, ccxt::any market, ccxt::any logPrefix,
    ccxt::any skippedProperties, ccxt::any bestBid, ccxt::any bestAsk,
    ccxt::any limitPriceSafetyMultiplierFromMedian, ccxt::any buyOrSell,
    ccxt::any predefinedAmount = ccxt::any{}) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               try {
                 ccxt::any symbol = ::getValue(market, std::string("symbol"));
                 ccxt::any minimunPrices = callDynamically(
                     exchange, std::string("safeDict"),
                     ccxt::list{::getValue(market, std::string("limits")),
                                std::string("price"), ccxt::dict{}});
                 ccxt::any minimumPrice =
                     ::getValue(minimunPrices, std::string("min"));
                 ccxt::any maximumPrice =
                     ::getValue(minimunPrices, std::string("max"));
                 // below we set limit price, where the order will not be
                 // completed. We do not use the extreme "limits" values for
                 // that market, because, even though min purchase amount for
                 // BTC/USDT can be 0.01 BTC, it means with 10$ you can buy 1000
                 // BTC, which leads to unrealistic outcome. So, we just use
                 // around 5%-10% far price from the current price.
                 ccxt::any limitBuyPrice_nonFillable =
                     divide(bestBid, limitPriceSafetyMultiplierFromMedian);
                 if (isTrue(isTrue(!isEqual(minimumPrice, ccxt::any{})) &&
                            isTrue(isLessThan(limitBuyPrice_nonFillable,
                                              minimumPrice)))) {
                   limitBuyPrice_nonFillable = minimumPrice;
                 }
                 ccxt::any limitSellPrice_nonFillable =
                     multiply(bestAsk, limitPriceSafetyMultiplierFromMedian);
                 if (isTrue(isTrue(!isEqual(maximumPrice, ccxt::any{})) &&
                            isTrue(isGreaterThan(limitSellPrice_nonFillable,
                                                 maximumPrice)))) {
                   limitSellPrice_nonFillable = maximumPrice;
                 }
                 ccxt::any createdOrder = ccxt::any{};
                 if (isTrue(isEqual(buyOrSell, std::string("buy")))) {
                   ccxt::any orderAmount = tcoGetMinimumAmountForLimitPrice(
                       exchange, market, limitBuyPrice_nonFillable,
                       predefinedAmount);
                   createdOrder = awaitValue(tcoCreateOrderSafe(
                       exchange, symbol, std::string("limit"),
                       std::string("buy"), orderAmount,
                       limitBuyPrice_nonFillable, ccxt::dict{},
                       skippedProperties));
                 } else {
                   ccxt::any orderAmount = tcoGetMinimumAmountForLimitPrice(
                       exchange, market, limitSellPrice_nonFillable,
                       predefinedAmount);
                   createdOrder = awaitValue(tcoCreateOrderSafe(
                       exchange, symbol, std::string("limit"),
                       std::string("sell"), orderAmount,
                       limitSellPrice_nonFillable, ccxt::dict{},
                       skippedProperties));
                 }
                 ccxt::any fetchedOrder = awaitValue(
                     fetchOrder(exchange, symbol,
                                ::getValue(createdOrder, std::string("id")),
                                skippedProperties));
                 // test fetched order object
                 if (isTrue(!isEqual(fetchedOrder, ccxt::any{}))) {
                   testOrder(exchange, skippedProperties,
                             std::string("createOrder"), fetchedOrder, symbol,
                             callDynamically(exchange,
                                             std::string("milliseconds"),
                                             ccxt::list{}));
                 }
                 // ensure that order is not filled
                 assertOrderState(exchange, skippedProperties,
                                  std::string("createdOrder"), createdOrder,
                                  std::string("open"), false);
                 assertOrderState(exchange, skippedProperties,
                                  std::string("fetchedOrder"), fetchedOrder,
                                  std::string("open"), true);
                 // ensure that order side matches
                 assertInArray(exchange, skippedProperties,
                               std::string("createdOrder"), createdOrder,
                               std::string("side"),
                               ccxt::list{ccxt::any{}, buyOrSell});
                 assertInArray(exchange, skippedProperties,
                               std::string("fetchedOrder"), fetchedOrder,
                               std::string("side"),
                               ccxt::list{ccxt::any{}, buyOrSell});
                 awaitValue(tcoCancelOrder(
                     exchange, symbol,
                     ::getValue(createdOrder, std::string("id"))));
               } catch (const std::exception &e) {
                 throw Error(toString(add(
                     add(logPrefix, std::string(" failed for Scenario 1: ")),
                     toString(e))));
               }
               return true;
             })
      .share();
}

std::shared_future<ccxt::any> tcoCreateFillableOrder(
    ccxt::any exchange, ccxt::any market, ccxt::any logPrefix,
    ccxt::any skippedProperties, ccxt::any bestBid, ccxt::any bestAsk,
    ccxt::any limitPriceSafetyMultiplierFromMedian, ccxt::any buyOrSellString,
    ccxt::any predefinedAmount = ccxt::any{}) {
  return std::
      async(std::launch::deferred,
            [=]() mutable -> ccxt::any {
              try {
                ccxt::any isSwapFuture =
                    isTrue((isEqual(::getValue(market, std::string("swap")),
                                    true))) ||
                    isTrue((isEqual(::getValue(market, std::string("future")),
                                    true)));
                ccxt::any isBuy =
                    (isEqual(buyOrSellString, std::string("buy")));
                ccxt::any entrySide =
                    (isTrue(isBuy) ? ccxt::any(std::string("buy"))
                                   : ccxt::any(std::string("sell")));
                ccxt::any exitSide =
                    (isTrue(isBuy) ? ccxt::any(std::string("sell"))
                                   : ccxt::any(std::string("buy")));
                ccxt::any entryorderPrice =
                    (isTrue(isBuy)
                         ? ccxt::any(multiply(
                               bestAsk, limitPriceSafetyMultiplierFromMedian))
                         : ccxt::any(divide(
                               bestBid, limitPriceSafetyMultiplierFromMedian)));
                ccxt::any exitorderPrice =
                    (isTrue(isBuy)
                         ? ccxt::any(divide(
                               bestBid, limitPriceSafetyMultiplierFromMedian))
                         : ccxt::any(multiply(
                               bestAsk,
                               limitPriceSafetyMultiplierFromMedian))); // todo
                                                                        // revise:
                                                                        // (tcoMininumCost
                                                                        // (exchange,
                                                                        // market)
                                                                        // /
                                                                        // amountToClose)
                                                                        // /
                                                                        // limitPriceSafetyMultiplierFromMedian;
                //
                //
                ccxt::any symbol = ::getValue(market, std::string("symbol"));
                ccxt::any entryAmount = tcoGetMinimumAmountForLimitPrice(
                    exchange, market, entryorderPrice);
                ccxt::any entryorderFilled = awaitValue(
                    tcoCreateOrderSafe(exchange, symbol, std::string("limit"),
                                       entrySide, entryAmount, entryorderPrice,
                                       ccxt::dict{}, skippedProperties));
                // just for case, cancel any possible unfilled amount (though it
                // is not be expected because the order was fillable)
                awaitValue(tcoTryCancelOrder(exchange, symbol, entryorderFilled,
                                             skippedProperties));
                // now, as order is closed/canceled, we can reliably fetch the
                // order information
                ccxt::any entryorderFetched = awaitValue(
                    fetchOrder(exchange, symbol,
                               ::getValue(entryorderFilled, std::string("id")),
                               skippedProperties));
                tcoAssertFilledOrder(exchange, market, logPrefix,
                                     skippedProperties, entryorderFilled,
                                     entryorderFetched, entrySide, entryAmount);
                //
                // ### close the traded position ###
                //
                ccxt::any amountToClose = callDynamically(
                    exchange, std::string("parseToNumeric"),
                    ccxt::list{callDynamically(
                        exchange, std::string("safeString"),
                        ccxt::list{entryorderFetched, std::string("filled")})});
                ccxt::any params = ccxt::dict{};
                // as we want to close position, we should use 'reduceOnly' to
                // ensure we don't open a margined position accidentally,
                // because some exchanges might have automatically enabled
                // margin-mode (on spot) or hedge-mode (on contracts)
                if (isTrue(isSwapFuture)) {
                  ::setValue(params, std::string("reduceOnly"), true);
                }
                ccxt::any exitorderPriceArg =
                    (isTrue((isEqual(::getValue(market, std::string("spot")),
                                     true)))
                         ? ccxt::any(ccxt::any{})
                         : ccxt::any(exitorderPrice));
                ccxt::any exitorderFilled = awaitValue(tcoCreateOrderSafe(
                    exchange, symbol, std::string("market"), exitSide,
                    amountToClose, exitorderPriceArg, params,
                    skippedProperties));
                ccxt::any exitorderFetched = awaitValue(
                    fetchOrder(exchange, symbol,
                               ::getValue(exitorderFilled, std::string("id")),
                               skippedProperties));
                tcoAssertFilledOrder(exchange, market, logPrefix,
                                     skippedProperties, exitorderFilled,
                                     exitorderFetched, exitSide, amountToClose);
              } catch (const std::exception &e) {
                throw Error(toString(
                    add(std::string("failed for Scenario 2: "), toString(e))));
              }
              return true;
            })
          .share();
}

ccxt::any tcoAssertFilledOrder(ccxt::any exchange, ccxt::any market,
                               ccxt::any logPrefix, ccxt::any skippedProperties,
                               ccxt::any createdOrder, ccxt::any fetchedOrder,
                               ccxt::any requestedSide,
                               ccxt::any requestedAmount) {
  // test filled amount
  ccxt::any precisionAmount =
      callDynamically(exchange, std::string("safeString"),
                      ccxt::list{::getValue(market, std::string("precision")),
                                 std::string("amount")});
  ccxt::any entryorderAmountString = callDynamically(
      exchange, std::string("numberToString"), ccxt::list{requestedAmount});
  ccxt::any filledString =
      callDynamically(exchange, std::string("safeString"),
                      ccxt::list{fetchedOrder, std::string("filled")});
  assertTrue(!isEqual(filledString, ccxt::any{}),
             add(add(logPrefix,
                     std::string(" order should be filled, but it is not. ")),
                 callDynamically(exchange, std::string("json"),
                                 ccxt::list{fetchedOrder})));
  // filled amount should be whithin the expected range i.e. if you buy 100
  // DOGECOIN and amount-precision is 1, and also considering possible roundings
  // in implementation, then filled amount should be between 99 and 101
  ccxt::any maxExpectedFilledAmount =
      ccxt::Precise::stringAdd(entryorderAmountString, precisionAmount);
  ccxt::any minExpectedFilledAmount =
      ccxt::Precise::stringSub(entryorderAmountString, precisionAmount);
  assertTrue(
      ccxt::Precise::stringLe(filledString, maxExpectedFilledAmount),
      add(add(logPrefix, std::string(" filled amount is more than expected, "
                                     "possibly some implementation issue. ")),
          callDynamically(exchange, std::string("json"),
                          ccxt::list{fetchedOrder})));
  assertTrue(
      ccxt::Precise::stringGe(filledString, minExpectedFilledAmount),
      add(add(logPrefix, std::string(" filled amount is less than expected, "
                                     "possibly some implementation issue. ")),
          callDynamically(exchange, std::string("json"),
                          ccxt::list{fetchedOrder})));
  // order state should be "closed"
  assertOrderState(exchange, skippedProperties, std::string("createdOrder"),
                   createdOrder, std::string("closed"), false);
  assertOrderState(exchange, skippedProperties, std::string("fetchedOrder"),
                   fetchedOrder, std::string("closed"), true);
  // ensure that order side matches
  assertInArray(exchange, skippedProperties, std::string("createdOrder"),
                createdOrder, std::string("side"),
                ccxt::list{ccxt::any{}, requestedSide});
  assertInArray(exchange, skippedProperties, std::string("fetchedOrder"),
                fetchedOrder, std::string("side"),
                ccxt::list{ccxt::any{}, requestedSide});
  return true;
}

std::shared_future<ccxt::any> tcoCancelOrder(ccxt::any exchange,
                                             ccxt::any symbol,
                                             ccxt::any orderId = ccxt::any{}) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               ccxt::any logPrefix = logTemplate(
                   exchange, std::string("createOrder"), ccxt::list{symbol});
               ccxt::any usedMethod = std::string("");
               ccxt::any cancelResult = ccxt::any{};
               if (isTrue(isTrue(isTrue((!isEqual(
                                     ::getValue(getProperty(exchange,
                                                            std::string("has")),
                                                std::string("cancelOrder")),
                                     ccxt::any{}))) &&
                                 isTrue((!isEqual(
                                     ::getValue(getProperty(exchange,
                                                            std::string("has")),
                                                std::string("cancelOrder")),
                                     false)))) &&
                          isTrue((!isEqual(orderId, ccxt::any{}))))) {
                 usedMethod = std::string("cancelOrder");
                 cancelResult = awaitValue(
                     callDynamically(exchange, std::string("cancelOrder"),
                                     ccxt::list{orderId, symbol}));
               } else if (isTrue(isTrue((!isEqual(
                                     ::getValue(getProperty(exchange,
                                                            std::string("has")),
                                                std::string("cancelAllOrders")),
                                     ccxt::any{}))) &&
                                 isTrue((!isEqual(
                                     ::getValue(getProperty(exchange,
                                                            std::string("has")),
                                                std::string("cancelAllOrders")),
                                     false))))) {
                 usedMethod = std::string("cancelAllOrders");
                 cancelResult = awaitValue(
                     callDynamically(exchange, std::string("cancelAllOrders"),
                                     ccxt::list{symbol}));
               } else if (isTrue(isTrue((!isEqual(
                                     ::getValue(getProperty(exchange,
                                                            std::string("has")),
                                                std::string("cancelOrders")),
                                     ccxt::any{}))) &&
                                 isTrue((!isEqual(
                                     ::getValue(getProperty(exchange,
                                                            std::string("has")),
                                                std::string("cancelOrders")),
                                     false))))) {
                 throw Error(toString(add(
                     logPrefix, std::string(" cancelOrders method is not "
                                            "unified yet, coming soon..."))));
               }
               tcoDebug(exchange, symbol,
                        add(add(add(std::string("canceled order using "),
                                    usedMethod),
                                std::string(":")),
                            ::getValue(cancelResult, std::string("id"))));
               // todo:
               // assertOrderState (exchange, skippedProperties, 'cancelOrder',
               // cancelResult, 'canceled', false); assertOrderState (exchange,
               // skippedProperties, 'cancelOrder', cancelResult, 'closed',
               // true);
               return true;
             })
      .share();
}

std::shared_future<ccxt::any>
tcoCreateOrderSafe(ccxt::any exchange, ccxt::any symbol, ccxt::any orderType,
                   ccxt::any side, ccxt::any amount,
                   ccxt::any price = ccxt::any{},
                   ccxt::any params = ccxt::dict{},
                   ccxt::any skippedProperties = ccxt::dict{}) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               tcoDebug(exchange, symbol,
                        add(add(add(add(add(add(add(add(add(std::string(
                                                                "Executing "
                                                                "createOrder "),
                                                            orderType),
                                                        std::string(" ")),
                                                    side),
                                                std::string(" ")),
                                            amount),
                                        std::string(" ")),
                                    price),
                                std::string(" ")),
                            callDynamically(exchange, std::string("json"),
                                            ccxt::list{params})));
               ccxt::any order = awaitValue(callDynamically(
                   exchange, std::string("createOrder"),
                   ccxt::list{symbol, orderType, side, amount, price, params}));
               try {
                 testOrder(exchange, skippedProperties,
                           std::string("createOrder"), order, symbol,
                           getCurrentTimestamp());
               } catch (const std::exception &e) {
                 if (isTrue(!isEqual(orderType, std::string("market")))) {
                   // if it was limit order, try to cancel it before exiting the
                   // script
                   awaitValue(tcoTryCancelOrder(exchange, symbol, order,
                                                skippedProperties));
                 }
                 throw;
               }
               return order;
             })
      .share();
}

ccxt::any tcoMininumAmount(ccxt::any exchange, ccxt::any market) {
  ccxt::any amountValues =
      callDynamically(exchange, std::string("safeDict"),
                      ccxt::list{::getValue(market, std::string("limits")),
                                 std::string("amount"), ccxt::dict{}});
  ccxt::any amountMin =
      callDynamically(exchange, std::string("safeNumber"),
                      ccxt::list{amountValues, std::string("min")});
  assertTrue(
      !isEqual(amountMin, ccxt::any{}),
      add(add(add(getProperty(exchange, std::string("id")), std::string(" ")),
              ::getValue(market, std::string("symbol"))),
          std::string(" can not determine minimum amount for order")));
  return amountMin;
}

ccxt::any tcoMininumCost(ccxt::any exchange, ccxt::any market) {
  ccxt::any costValues =
      callDynamically(exchange, std::string("safeDict"),
                      ccxt::list{::getValue(market, std::string("limits")),
                                 std::string("cost"), ccxt::dict{}});
  ccxt::any costMin =
      callDynamically(exchange, std::string("safeNumber"),
                      ccxt::list{costValues, std::string("min")});
  assertTrue(
      !isEqual(costMin, ccxt::any{}),
      add(add(add(getProperty(exchange, std::string("id")), std::string(" ")),
              ::getValue(market, std::string("symbol"))),
          std::string(" can not determine minimum cost for order")));
  return costMin;
}

ccxt::any
tcoGetMinimumAmountForLimitPrice(ccxt::any exchange, ccxt::any market,
                                 ccxt::any price,
                                 ccxt::any predefinedAmount = ccxt::any{}) {
  // this method calculates the minimum realistic order amount:
  // at first it checks the "minimum hardcap limit" (i.e. 7 DOGE), however, if
  // exchange also has "minimum cost" limits, then we need to calculate the
  // amount using cost, because of price is volatile, today's 7 DOGE cost could
  // be 1$ but "minimum cost" requirement could be 5$ (which translates to 35
  // DOGE amount)
  ccxt::any minimumAmount = tcoMininumAmount(exchange, market);
  ccxt::any minimumCost = tcoMininumCost(exchange, market);
  ccxt::any finalAmount = minimumAmount;
  if (isTrue(!isEqual(minimumCost, ccxt::any{}))) {
    if (isTrue(isLessThan(multiply(finalAmount, price), minimumCost))) {
      finalAmount = divide(minimumCost, price);
    }
  }
  if (isTrue(!isEqual(predefinedAmount, ccxt::any{}))) {
    finalAmount = mathMax(finalAmount, predefinedAmount);
  }
  // because it's possible that calculated value might get truncated down in
  // "createOrder" (i.e. 0.129 -> 0.12), we should ensure that final amount *
  // price would bypass minimum cost requirements, by adding the "minimum
  // precision"
  ccxt::any amountPrecision =
      callDynamically(exchange, std::string("safeNumber"),
                      ccxt::list{::getValue(market, std::string("precision")),
                                 std::string("amount")});
  ccxt::any isTickSizePrecision =
      isEqual(getProperty(exchange, std::string("precisionMode")), 4);
  if (isTrue(isEqual(amountPrecision, ccxt::any{}))) {
    amountPrecision = 1e-15; // todo: revise this for better way in future
  } else {
    // todo: remove after TICK_SIZE unification
    if (!isTrue(isTickSizePrecision)) {
      amountPrecision = divide(
          1, mathPow(10, amountPrecision)); // this converts DECIMAL_PRECISION
                                            // into TICK_SIZE
    }
  }
  finalAmount = add(finalAmount, amountPrecision);
  finalAmount =
      multiply(finalAmount, 1.1); // add around 10% to ensure "cost" is enough
  finalAmount = parseFloat(callDynamically(
      exchange, std::string("decimalToPrecision"),
      ccxt::list{
          finalAmount, 2,
          ::getValue(::getValue(market, std::string("precision")),
                     std::string("amount")),
          getProperty(
              exchange,
              std::string(
                  "precisionMode"))})); // 2 stands for ROUND_UP constant, 0
                                        // stands for TRUNCATE
  return finalAmount;
}

std::shared_future<ccxt::any> tcoTryCancelOrder(ccxt::any exchange,
                                                ccxt::any symbol,
                                                ccxt::any order,
                                                ccxt::any skippedProperties) {
  return std::async(
             std::launch::deferred,
             [=]() mutable -> ccxt::any {
               ccxt::any orderFetched = awaitValue(fetchOrder(
                   exchange, symbol, ::getValue(order, std::string("id")),
                   skippedProperties));
               if (isTrue(isEqual(orderFetched, ccxt::any{}))) {
                 return true;
               }
               ccxt::any needsCancel = callDynamically(
                   exchange, std::string("inArray"),
                   ccxt::list{::getValue(orderFetched, std::string("status")),
                              ccxt::list{std::string("open"),
                                         std::string("pending"), ccxt::any{}}});
               // if it was not reported as closed/filled, then try to cancel it
               if (isTrue(isEqual(needsCancel, true))) {
                 tcoDebug(exchange, symbol,
                          std::string("trying to cancel the remaining amount "
                                      "of partially filled order..."));
                 try {
                   awaitValue(tcoCancelOrder(
                       exchange, symbol, ::getValue(order, std::string("id"))));
                 } catch (const std::exception &e) {
                   // order might have been closed/filled already, before
                   // 'cancelOrder' call reaches server, so it is tolerable, we
                   // don't throw exception
                   tcoDebug(
                       exchange, symbol,
                       add(std::string(" a moment ago order was reported as "
                                       "pending, but could not be cancelled at "
                                       "this moment. Exception message: "),
                           toString(e)));
                 }
               } else {
                 tcoDebug(exchange, symbol,
                          std::string("order is already closed/filled, no need "
                                      "to cancel it"));
               }
               return true;
             })
      .share();
}
