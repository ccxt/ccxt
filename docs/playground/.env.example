# Chat-completions endpoint the AI assistant posts to: a JSON
# {stream, messages} request in, an SSE stream back. The playground holds no
# inference credential of its own — that endpoint owns the backend, its keys
# and its quotas. Unset disables the assistant.
PLAYGROUND_AI_URL=

# Optional: override the default per-run timeout (milliseconds).
# RUN_TIMEOUT_MS=15000
