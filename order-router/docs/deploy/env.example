# /opt/order-router/env — SHARED by all three units (EnvironmentFile= in each).
#
# Copy to /opt/order-router/env, fill in the secrets, `chmod 0640`, `chown root:order-router`.
# Do NOT commit the filled-in copy: DATABASE_URL and ORDER_ROUTER_CSRF_SECRET are credentials.
#
# systemd parses this itself — it is NOT a shell script. No `export`, no command substitution, no
# quoting rules beyond systemd's own. An interactive shell does not source it either, which is the
# trap behind the admin CLI: `npm run admin` reads ORDER_ROUTER_KEYS_FILE from YOUR environment,
# so an operator who has not exported it administers a key store the running service never reads
# and every key they mint looks fine while the API keeps returning 401.

# ---- state paths: all three processes must agree, all outside the release dir ------------------
# keys.json defaults to ./data/keys.json — i.e. INSIDE the release, which the next deploy discards.
# The ingest runner writes this file; the router only reads it.
ORDER_ROUTER_KEYS_FILE=/opt/order-router/keys.json
# The router and console append here; the ingest runner tails it. Unset, the ingest runner exits 1
# on boot and takes the key projector with it (open finding #11).
ORDER_ROUTER_AUDIT_LOG_FILE=/var/log/order-router/audit.log
DATABASE_URL=postgres://order_router@localhost/order_router

# ---- the router process -------------------------------------------------------------------------
# Loopback only. On 0.0.0.0 (the default) the API is reachable on :8080 bypassing nginx and
# therefore bypassing TLS, and the API key crosses the wire in cleartext to anyone who skips it.
HOST=127.0.0.1
PORT=8080
# A HOP COUNT, not a boolean: 1 for nginx alone, 2 for a CDN in front of nginx. Set higher than the
# number of proxies you control and you hand a client-written X-Forwarded-For entry to the rate
# limiter and the audit log.
ORDER_ROUTER_TRUST_PROXY=1
# Must stay UNDER nginx's proxy_read_timeout for /router/api/stream/ (120s there), or nginx reaps
# quiet streams first and the drop only shows on illiquid symbols.
ORDER_ROUTER_WS_IDLE_TIMEOUT_MS=30000
# JSON logs. Without it pino-pretty engages and every documented log query stops working.
NODE_ENV=production
# The diagnostic stream only. A misbehaving exchange once wrote 930MB of retry chatter; the audit
# stream has its own level and is unaffected by this.
LOG_LEVEL=warn

# ---- the console process ------------------------------------------------------------------------
ORDER_ROUTER_WEB_PORT=8090
ORDER_ROUTER_WEB_HOST=127.0.0.1
ORDER_ROUTER_WEB_BASE=/router
# Must be true wherever TLS terminates in front, or the session cookie loses the __Host- prefix.
ORDER_ROUTER_WEB_SECURE_COOKIES=true
ORDER_ROUTER_WEB_ORIGINS=https://docs.ccxt.com
# Stable across restarts on purpose: regenerated per boot, every in-flight form is rejected and
# users see a spurious "your session expired" the first time they submit after a deploy.
# Generate once: openssl rand -base64 32
ORDER_ROUTER_CSRF_SECRET=

# ---- retiring the shared key --------------------------------------------------------------------
# ORDER_ROUTER_API_KEY is a migration bridge loaded as a synthetic k_legacy record. Unsetting it
# here is only half of retiring it — see README § "Retiring the shared key" for the tombstone that
# stops the running process honouring it without a restart. Do both, or the next restart brings the
# key back.
# ORDER_ROUTER_API_KEY=
