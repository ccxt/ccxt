# The router: the public API on loopback:8080. nginx puts it on :443 under /router/api/.
#
# Install: cp to /etc/systemd/system/, then `systemctl daemon-reload`.
# This file is the source of truth for the unit; README § "One-time setup on the box" quotes the
# load-bearing lines of it, and src/docs.test.ts asserts that quote keeps Restart= and an
# ExecReload= whose signal src/index.ts actually handles.

[Unit]
Description=CCXT order router API
Documentation=https://github.com/ccxt/ccxt/tree/master/order-router
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=order-router
Group=order-router

# The symlink, never a release directory. The deploy swaps `current` with `mv -Tf`; a unit pinned
# to /opt/order-router/releases/<sha> would keep running the release the retention prune deletes
# five deploys later.
WorkingDirectory=/opt/order-router/current
ExecStart=/usr/bin/node /opt/order-router/current/dist/index.js

# Shared by all three units — see env.example. Every piece of STATE (keys.json, the audit log,
# DATABASE_URL) is pinned to a path outside the release dir here, because anything inside a release
# is silently discarded on the next deploy.
EnvironmentFile=/opt/order-router/env

# The crash handlers (src/crashHandlers.ts) log, flush and exit non-zero ON PURPOSE, on the
# assumption that something restarts the process. Without this line that assumption is false and
# the first unhandled rejection ends the service until a human notices.
Restart=on-failure
RestartSec=2

# What makes `systemctl reload order-router` a key reload rather than an error: src/index.ts
# handles SIGHUP by re-reading keys.json. Without it the only way to pick up a revocation before
# the 10-second mtime poll is a restart, which rebuilds the entire book cache and degrades /route
# for minutes.
ExecReload=/bin/kill -HUP $MAINPID

# A restart costs a full book-cache rebuild, so give the process room to close its ~28 exchange
# sockets cleanly rather than having systemd SIGKILL it mid-flush.
KillSignal=SIGTERM
TimeoutStopSec=30

# The process needs to read the release tree, read keys.json and append to the audit log. Nothing
# else on a box shared with two other production deploys.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/order-router /var/log/order-router

[Install]
WantedBy=multi-user.target
