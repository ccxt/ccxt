# Configuration of the hosted CCXT MCP server. Copy to .env and edit; never commit .env.
# Every value below is the code default, a recommended production value (DEPLOYMENT_ENV,
# TRUSTED_PROXY is set by docker-compose.yml) or a safe example. An empty value means
# "default".
#
# docker compose reads this file twice: as the container's environment and to fill in
# docker-compose.yml. It expands $NAME and ${NAME} in unquoted values, so generate secrets
# without '$' (openssl rand -hex 32) or single-quote them ('like$this').

# ---- deployment ----
# the deployed build: the git short sha the image is built from and tagged with. The deploy
# and upgrade steps write it (README.md, "Deploy"); compose refuses to run without it
BUILD_ID=

# ---- endpoint ----
# canonical MCP URL = PUBLIC_BASE_URL + MCP_PATH. It is also the phase-2 OAuth resource id,
# the input of Claude's ui.domain hash and the registry URL: never change it once published
PUBLIC_BASE_URL=https://docs.ccxt.com
MCP_PATH=/mcp
# HOST / PORT are fixed by docker-compose.yml (0.0.0.0:8080 in the container); for a run
# without Docker the defaults are 127.0.0.1:8080
#HOST=127.0.0.1
#PORT=8080
# Host header allowlist (DNS-rebinding protection). Default: the PUBLIC_BASE_URL host plus
# localhost, 127.0.0.1 and [::1]
ALLOWED_HOSTS=
# browser origins allowed to read responses (CORS). Empty = no CORS headers at all: MCP
# hosts call from their servers, not from browsers
CORS_ALLOWED_ORIGINS=
# where the client address comes from: none (socket peer), nginx-x-real-ip, or a hop count
# for X-Forwarded-For. docker-compose.yml sets nginx-x-real-ip
TRUSTED_PROXY=none
# OpenAI directory domain verification token, served at /.well-known/openai-apps-challenge
OPENAI_APPS_CHALLENGE=

# ---- exchanges ----
# allowlist; run scripts/check-exchanges.mjs on the machine first and drop what it cannot reach
EXCHANGES=binance,bitfinex,bitget,bitstamp,bybit,coinbase,gate,kraken,kucoin,okx
EXCHANGE_TIMEOUT_MS=10000
MARKETS_REFRESH_MINUTES=360
MARKETS_LOAD_TIMEOUT_MS=60000
PREWARM_CONCURRENCY=3
# /readyz waits for every exchange; after this long it is enough that one is warm
READY_GRACE_MS=120000

# ---- protection ----
REQUEST_DEADLINE_MS=20000
MAX_CONCURRENT_REQUESTS=64
MAX_BODY_BYTES=262144
MAX_JSON_DEPTH=32
# open subscriptions/listen streams, in total and per client; each holds sockets here and
# at nginx indefinitely, and this server never publishes list changes
MAX_SUBSCRIPTIONS=200
MAX_LISTENS_PER_CLIENT=4
# time to receive a whole request (headers + body); a slow body is cut with 408
REQUEST_READ_TIMEOUT_MS=15000
UPSTREAM_CONCURRENCY_PER_EXCHANGE=4
UPSTREAM_QUEUE_PER_EXCHANGE=16
MAX_UPSTREAM_CALLS_PER_TOOL=10
CACHE_MAX_ENTRIES=2000
BREAKER_THRESHOLD=3
BREAKER_WINDOW_MS=60000
BREAKER_COOLDOWN_MS=30000
BREAKER_MAX_COOLDOWN_MS=600000
# per client (IPv4 address, IPv6 /64, or openai/subject from OpenAI's ranges): tool calls
# per minute and burst
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=30
# per host egress address (Anthropic, OpenAI without a subject): all their users share it
HOST_RATE_LIMIT_PER_MINUTE=3000
HOST_RATE_LIMIT_BURST=600
RATE_LIMIT_MAX_KEYS=100000
DRAIN_TIMEOUT_MS=25000

# ---- views ----
# show_* results when the client did not state its capabilities (2025-era stateless
# requests): attach the view payload, or omit it
UI_WHEN_UNKNOWN=attach
# view mode for show_* results: auto (follow the client's stated capabilities, else
# UI_WHEN_UNKNOWN), always (send the dataset to every client) or off. Anything else = auto
#CCXT_MCP_UI=auto

# ---- runtime ----
# heap below the container's mem_limit (1536m) so Node collects before the kernel kills it
NODE_OPTIONS=--max-old-space-size=1024

# ---- telemetry (see README.md, "Telemetry") ----
# no token = no analytics and stdout-only logs. The token is a secret: only in .env
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_SAMPLE_RATE=1
SERVICE_NAME=ccxt-mcp-hosted
DEPLOYMENT_ENV=production
LOG_LEVEL=info
# HMAC key for the daily client_hash; share it between instances. A secret: only in .env.
# Generate it with `openssl rand -hex 32` (see the note on '$' at the top)
CLIENT_HASH_SECRET=
# the analytics feature flags (POSTHOG_CONTEXT, POSTHOG_CAPTURE_MODEL, ...) are documented
# in README.md, "Telemetry"
