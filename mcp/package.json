{
  "name": "ccxt-mcp",
  "version": "0.1.3",
  "description": "Official CCXT MCP server — unified access to 100+ cryptocurrency exchanges for AI agents via the Model Context Protocol",
  "main": "./js/server.js",
  "type": "module",
  "workspaces": [
    "hosted"
  ],
  "mcpName": "io.github.ccxt/ccxt-mcp",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-ui.mjs && node scripts/build-doc-manifest.mjs",
    "test": "node --import tsx --test test/unit/*.test.ts test/schema/*.test.ts test/integration/*.test.ts",
    "test:live": "node --import tsx --test test/live/*.test.ts",
    "prepublishOnly": "npm run build",
    "publishPackage": "npm run build && npm publish",
    "sync-versions": "node scripts/sync-versions.mjs",
    "ui:preview": "node scripts/preview-ui.mjs",
    "mcpb": "npm run build && node scripts/build-mcpb.mjs"
  },
  "bin": {
    "ccxt-mcp": "js/server.js"
  },
  "author": "CCXT",
  "license": "MIT",
  "keywords": [
    "ccxt",
    "mcp",
    "model-context-protocol",
    "crypto",
    "exchange",
    "trading",
    "ai",
    "agent"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "ccxt": "^4.5.84",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/hono": "^2.0.2",
    "@modelcontextprotocol/sdk": "~1.32.2",
    "@types/node": "^22.20.1",
    "happy-dom": "^21.0.4",
    "hono": "^4.13.22",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccxt/ccxt.git"
  },
  "readme": "README.md",
  "bugs": {
    "url": "https://github.com/ccxt/ccxt/issues"
  },
  "homepage": "https://ccxt.com"
}
